{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "1.0.0",
	"configurations": [
		{
			"name": "DoL Compile for Windows",
			"type": "PowerShell",
			"request": "launch",
			"script": ".\\compile.bat",
			"cwd": "${cwd}"
		},
		{
			"name": "DoL Compile for Linux",
			"type": "node",
			"request": "launch",
			"preLaunchTask": "DoL Compile",
			"cwd": "${cwd}"
		},
		{
			"name": "Open DoL in Browser for Windows",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "explorer",
			"runtimeArgs": ["Degrees of Lewdity VERSION.html"]
		},
		{
			"name": "Open DoL in Browser for Linux",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "xdg-open",
			"runtimeArgs": ["Degrees of Lewdity.html"]
		}
	],
	"compounds": [
		{
			"name": "Compile and Open DoL in Browser for Windows",
			"configurations": ["DoL Compile for Windows", "Open DoL in Browser for Windows"]
		},
		{
			"name": "Compile and Open DoL in Browser for Linux",
			"configurations": ["DoL Compile for Linux", "Open DoL in Browser for Linux"]
		}
	]
}
