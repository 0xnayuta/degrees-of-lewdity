# run with some Procfile runner, like hivemind or overmind or prox or goreman or node-foreman
browsersync: npx --yes browser-sync start --server --files Degrees\ of\ Lewdity.html --startPath Degrees\ of\ Lewdity.html --no-online --no-open --port 26969 --no-ui
compile: npx --yes nodemon --exec "compile.bat" --watch game --watch modules --ext "css,js,twee"
