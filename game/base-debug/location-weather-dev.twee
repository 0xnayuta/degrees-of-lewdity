:: Location Weather Dev

<<link [[Bedroom|Bedroom]]>><</link>>
<br><br>
<button id="location-gallery-copy">Copy Bounds</button>
<br><br>

<<nobr>>
<div id="location-image-gallery">
  <div id="location-gallery-row"></div>
</div>
<</nobr>>

<<script>>
$(document).one(":passageend", () => {
  const locations = Object.entries(window.setup?.LocationImages ?? {});
  const row = document.getElementById("location-gallery-row");
  if (!row) return;
  const copyButton = document.getElementById("location-gallery-copy");

  const styleId = "location-gallery-style";
  if (!document.getElementById(styleId)) {
    const style = document.createElement("style");
    style.id = styleId;
    style.textContent = `#location-image-gallery {
  border: 1px solid #3a3a3a;
  background: #faf7f0;
  padding: 12px;
  overflow-x: auto;
  overflow-y: visible;
}
#location-gallery-row {
  display: inline-flex;
  gap: 24px;
  align-items: flex-start;
}
.location-gallery-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.location-gallery-item-inner {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.location-gallery-image-wrap {
  position: relative;
  display: inline-block;
}
.location-gallery-image {
  display: block;
  image-rendering: auto;
}
.location-gallery-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  pointer-events: none;
}
.location-gallery-line.blue {
  background: #2b6cff;
}
.location-gallery-line.red {
  background: #ff2b2b;
}
.location-gallery-inputs {
  display: grid;
  grid-template-columns: auto auto;
  gap: 4px 8px;
  font-family: monospace;
  font-size: 12px;
  color: #1f1f1f;
}
.location-gallery-inputs input {
  width: 70px;
}
.location-gallery-label {
  font-family: monospace;
  font-size: 12px;
  color: #1f1f1f;
  max-width: 220px;
  text-align: center;
  word-break: break-word;
}`;
    document.head.appendChild(style);
  }

  const pickImage = config => {
    const base = config?.base ?? {};
    const preferredBaseKeys = ["default", "spring", "summer", "autumn", "winter", "snow"];
    const accessoryKeys = new Set(["overlay", "water", "waves", "wind", "watchtower", "smoke", "glimmer", "reflective", "foam"]);
    const isAccessory = name =>
      accessoryKeys.has(name) ||
      name.startsWith("front_") ||
      /emissive|overlay|reflective|water|waves|wind|watchtower|glimmer|smoke|foam/i.test(name);

    for (const key of preferredBaseKeys) {
      if (base[key]?.image) return base[key].image;
    }

    for (const [key, entry] of Object.entries(base)) {
      if (!entry?.image) continue;
      if (key.startsWith("base") || /base/i.test(entry.image)) return entry.image;
    }

    for (const [key, entry] of Object.entries(base)) {
      if (!entry?.image) continue;
      if (isAccessory(key) || isAccessory(entry.image)) continue;
      return entry.image;
    }

    const layerTop = config?.layerTop ?? {};
    const layerEntry = Object.values(layerTop).find(entry => entry?.image);
    if (layerEntry?.image) return layerEntry.image;

    const reflective = config?.reflective ?? {};
    if (reflective.overlay?.image) return reflective.overlay.image;
    const reflectiveEntry = Object.values(reflective).find(entry => entry?.image);
    if (reflectiveEntry?.image) return reflectiveEntry.image;

    return null;
  };

  row.innerHTML = "";
  for (const [name, config] of locations) {
    const folder = config?.folder ?? name;
    const imageName = pickImage(config);
    if (!imageName) continue;
    const path = `img/misc/locations/${folder}/${imageName}`;
    const item = document.createElement("div");
    item.className = "location-gallery-item";

    const label = document.createElement("div");
    label.className = "location-gallery-label";
    label.textContent = name;

    const inner = document.createElement("div");
    inner.className = "location-gallery-item-inner";

    const imageWrap = document.createElement("div");
    imageWrap.className = "location-gallery-image-wrap";

    const img = document.createElement("img");
    img.className = "location-gallery-image";
    img.loading = "lazy";
    img.decoding = "async";
    img.src = encodeURI(path);

    const rainLine = document.createElement("div");
    rainLine.className = "location-gallery-line blue";
    const fogLine = document.createElement("div");
    fogLine.className = "location-gallery-line red";

    imageWrap.appendChild(img);
    imageWrap.appendChild(rainLine);
    imageWrap.appendChild(fogLine);

    inner.appendChild(imageWrap);
    item.appendChild(inner);

    const inputs = document.createElement("div");
    inputs.className = "location-gallery-inputs";

    const fogTopLabel = document.createElement("div");
    fogTopLabel.textContent = "fogTop:";
    const fogTopInput = document.createElement("input");
    fogTopInput.type = "number";
    fogTopInput.min = "0";

    const rainTopLabel = document.createElement("div");
    rainTopLabel.textContent = "rainTop:";
    const rainTopInput = document.createElement("input");
    rainTopInput.type = "number";
    rainTopInput.min = "0";

    const maxFogLabel = document.createElement("div");
    maxFogLabel.textContent = "maxFogParticles:";
    const maxFogValue = document.createElement("div");
    maxFogValue.textContent = "-";

    const fogCurveLabel = document.createElement("div");
    fogCurveLabel.textContent = "fogDistributionCurve:";
    const fogCurveInput = document.createElement("input");
    fogCurveInput.type = "number";
    fogCurveInput.min = "0";
    fogCurveInput.step = "0.1";

    const rainSplashLabel = document.createElement("div");
    rainSplashLabel.textContent = "rainSplashEnabled:";
    const rainSplashInput = document.createElement("input");
    rainSplashInput.type = "checkbox";

    const fogEnabledLabel = document.createElement("div");
    fogEnabledLabel.textContent = "fogEnabled:";
    const fogEnabledInput = document.createElement("input");
    fogEnabledInput.type = "checkbox";

    inputs.appendChild(fogTopLabel);
    inputs.appendChild(fogTopInput);
    inputs.appendChild(rainTopLabel);
    inputs.appendChild(rainTopInput);
    inputs.appendChild(maxFogLabel);
    inputs.appendChild(maxFogValue);
    inputs.appendChild(fogCurveLabel);
    inputs.appendChild(fogCurveInput);
    inputs.appendChild(rainSplashLabel);
    inputs.appendChild(rainSplashInput);
    inputs.appendChild(fogEnabledLabel);
    inputs.appendChild(fogEnabledInput);

    item.appendChild(label);
    item.appendChild(inputs);
    row.appendChild(item);

    const updateLine = (lineEl, value, height) => {
      if (typeof value !== "number" || !Number.isFinite(value)) {
        lineEl.style.display = "none";
        return;
      }
      const y = height - value;
      lineEl.style.display = "block";
      lineEl.style.top = `${Math.round(y)}px`;
    };

    const getMaxFogParticles = bandHeight => {
      if (bandHeight <= 10) return Constants.weather.fogParticles.globalLocationCapMin;
      if (bandHeight >= 25) return Constants.weather.fogParticles.globalLocationCapMax;
      const ratio = (bandHeight - 10) / 15;
      return (
        Constants.weather.fogParticles.globalLocationCapMin +
        ratio * (Constants.weather.fogParticles.globalLocationCapMax - Constants.weather.fogParticles.globalLocationCapMin)
      );
    };

    const render = () => {
      const height = img.naturalHeight || img.height || 1;
      imageWrap.style.width = `${img.naturalWidth || img.width || 1}px`;
      imageWrap.style.height = `${height}px`;
      updateLine(rainLine, Number(rainTopInput.value), height);
      updateLine(fogLine, Number(fogTopInput.value), height);

      const fogTop = Number(fogTopInput.value);
      const fogBottom = typeof initialFogBottom === "number" ? initialFogBottom : 0;
      if (Number.isFinite(fogTop)) {
        const bandHeight = Math.max(0, fogTop - fogBottom);
        maxFogValue.textContent = String(Math.round(getMaxFogParticles(bandHeight)));
      } else {
        maxFogValue.textContent = "-";
      }
    };

    label.addEventListener("click", () => {
      const name = label.textContent || "";
      if (!name) return;
      navigator.clipboard?.writeText(name);
    });

    const onInput = () => render();
    fogTopInput.addEventListener("input", onInput);
    rainTopInput.addEventListener("input", onInput);
    fogCurveInput.addEventListener("input", onInput);
    rainSplashInput.addEventListener("change", onInput);
    fogEnabledInput.addEventListener("change", onInput);

    const locationWeather = window.setup?.LocationImages?.[name]?.weather;
    const locationConfig = locationWeather?.groundBounds;
    const initialFogTop = locationConfig?.fog?.top;
    const initialFogBottom = locationConfig?.fog?.bottom;
    const initialRainTop = locationConfig?.splashes?.top;
    const initialRainSplashEnabled = locationWeather?.rainSplashEnabled;
    const initialFogEnabled = locationWeather?.fogEnabled;
    const initialFogCurve = locationWeather?.fogDistributionCurve;
    if (typeof initialFogTop === "number") {
      fogTopInput.value = String(initialFogTop);
    }
    if (typeof initialRainTop === "number") {
      rainTopInput.value = String(initialRainTop);
    }
    if (typeof initialFogCurve === "number") {
      fogCurveInput.value = String(initialFogCurve);
    }
    if (typeof initialRainSplashEnabled === "boolean") {
      rainSplashInput.checked = initialRainSplashEnabled;
    }
    if (typeof initialFogEnabled === "boolean") {
      fogEnabledInput.checked = initialFogEnabled;
    }

    if (img.complete) {
      render();
    } else {
      img.addEventListener("load", render);
    }
  }

  copyButton?.addEventListener("click", () => {
    const output = {};
    for (const item of row.querySelectorAll(".location-gallery-item")) {
      const name = item.querySelector(".location-gallery-label")?.textContent?.trim();
      const inputs = item.querySelectorAll(".location-gallery-inputs input");
      if (!name || inputs.length < 3) continue;
      const [fogTop, rainTop, fogCurve, rainSplashEnabled, fogEnabled] = Array.from(inputs);
      const fogTopValue = fogTop.value === "" ? null : Number(fogTop.value);
      const rainTopValue = rainTop.value === "" ? null : Number(rainTop.value);
      const fogCurveValue = fogCurve.value === "" ? null : Number(fogCurve.value);
      if ([fogTopValue, rainTopValue, fogCurveValue].some(v => typeof v !== "number" || Number.isNaN(v))) continue;
      output[name] = {
        weather: {
          fogDistributionCurve: fogCurveValue,
          rainSplashEnabled: Boolean(rainSplashEnabled?.checked),
          fogEnabled: Boolean(fogEnabled?.checked),
          groundBounds: {
            splashes: {
              top: rainTopValue,
            },
            fog: {
              top: fogTopValue,
            },
          },
        },
      };
    }
    const format = value => {
      if (typeof value === "number") return String(value);
      if (typeof value === "boolean") return value ? "true" : "false";
      return String(value);
    };

    const lines = [];
    for (const [key, value] of Object.entries(output)) {
      lines.push(`${key}: {`);
      lines.push(`\\tweather: {`);
      lines.push(`\\t\\tfogDistributionCurve: ${format(value.weather.fogDistributionCurve)},`);
      lines.push(`\\t\\trainSplashEnabled: ${format(value.weather.rainSplashEnabled)},`);
      lines.push(`\\t\\tfogEnabled: ${format(value.weather.fogEnabled)},`);
      lines.push(``);
      lines.push(`\\t\\tgroundBounds: {`);
      lines.push(`\\t\\t\\tsplashes: {`);
      lines.push(`\\t\\t\\t\\ttop: ${format(value.weather.groundBounds.splashes.top)},`);
      lines.push(`\\t\\t\\t},`);
      lines.push(`\\t\\t\\tfog: {`);
      lines.push(`\\t\\t\\t\\ttop: ${format(value.weather.groundBounds.fog.top)},`);
      lines.push(`\\t\\t\\t},`);
      lines.push(`\\t\\t},`);
      lines.push(`\\t},`);
      lines.push(`},`);
    }

    navigator.clipboard?.writeText(lines.join("\\n"));
  });
});
<</script>>
