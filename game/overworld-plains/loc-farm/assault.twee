:: Farm Assault
<<set $outside to 1>><<set $location to "alex_farm">><<effects>>
<<farm_work_update>>
<<if $alexFarm.assault.fight.movement is "field">>
	You keep low as you hurry across the farm.
<<elseif $alexFarm.assault.fight.movement is "tower">>
	You keep low as you hurry towards the watchtower.
<<elseif $alexFarm.assault.fight.movement is "climb">>
	You enter the watchtower. The stairs creak as you climb.
<<elseif $alexFarm.assault.fight.movement is "wait">>
	You wait in the shadows, watching for intruders.
<<elseif $alexFarm.assault.fight.movement is "struggle">>
	<<if $alexFarm.assault.fight.pcBindings lte 0>>
		You struggle against your bindings. <span class="green">They come loose.</span>
		<<if $worn.face.type.includes("gag")>>You tear the gag from your mouth.<</if>>
		<<if $alexFarm.assault.fight.alexState is "bound">>
			<<npc Alex>><<person1>>
			You find Alex not far away, remove the gag from <<his>> mouth, and untie <<his>> bonds. "Fuckers," <<he>> says. "There's no time to waste."
			<<set $alexFarm.assault.fight.alexBindings to 0>>
			<<set $alexFarm.assault.fight.alexState to "patrol">>
			<<endevent>>
		<</if>>
		<<farm_assault_unbind>>
	<<else>>
		You struggle against your bindings. <span class="teal">They feel a little looser.</span>
	<</if>>
<<else>>
	You keep your head on a swivel, watching for intruders.
<</if>>
<<set $alexFarm.assault.fight.movement to "none">>
<br><br>
<<wearProp "walkie talkie">>
<<set _turn to {}>>
<<farm_assault_progress _turn>>

<<farm_assault_alex _turn>>

<<if _turn.fieldSetAlight>>
	<span class="red">You smell smoke on the breeze.</span>
	<br><br>
<</if>>

<<if $alexFarm.assault.fight.towerState is "manned" or $alexFarm.assault.fight.towerState is "attacked" or _turn.guardWon or _turn.guardLost>>
	<<farm_assault_info _turn "guard">>
<<elseif $alexFarm.assault.fight.towerState is "defeated">>
	<span class="red">$alexFarm.towerGuard.name has been defeated, and can't help for the remainder of the assault.</span>
	<br><br>
<</if>>

<<if $bus is "tower_top">>
	<<farm_assault_info _turn>>
<</if>>

<<if _turn.dogsResult is "victorious">>
	<span class="green">You hear a triumphant howling.</span>
	<br><br>
<<elseif _turn.dogsResult is "defeated">>
	<span class="red">You hear a panicked howling.</span>
	<br><br>
<</if>>

<<if $alexFarm.assault.noFieldsLeftToBurn is true>>
	<<farm_assault_unbind>>
	<<if $alexFarm.assault.burntFields.length is 0>>
		<span class="purple">With no fields to burn, the thugs flee the field.</span><<lcontrol>><<gtrauma>><<control -10>><<trauma 6>>
		<br><br>
		<<npc Remy>><<person1>>
		Remy watches from a nearby hill. <<He>> turns <<his>> steed and rides away.
		<br><br>
		<<link [[Next|Farm Assault Victory]]>><<endevent>><</link>>
		<br>
	<<else>>
		<span class="red">Their job done, the thugs flee the fields, leaving a smouldering waste behind them.</span>
		<<lllcontrol>><<gggtrauma>><<control -50>><<trauma 24>>
		<<world_corruption "soft" 15>>
		<br><br>
		<<npc Remy>><<person1>>
		Remy watches from a nearby hill. <<He>> turns <<his>> steed and rides away.
		<br><br>
		<<link [[Next|Farm Assault Defeat]]>><<endevent>><</link>>
		<br>
	<</if>>
<<elseif !_turn.teamsStillAttacking>>
	<<farm_assault_unbind>>
	<span class="green">Driven back, the thugs flee the farm.</span>
	<<if $alexFarm.assault.burntFields.length gte 2>>
		<span class="pink">They managed to torch the <<ordinalList $alexFarm.assault.burntFields.map(x=>x+1).toSorted()>> fields.</span><<llcontrol>><<ggtrauma>><<control -25>><<trauma 12>>
	<<elseif $alexFarm.assault.burntFields.length gte 1>>
		<span class="blue">They managed to torch a field.</span><<lcontrol>><<gtrauma>><<control -10>><<trauma 6>>
	<<else>>
		<span class="green">They failed to torch a single field.</span><<ggcontrol>><<lltrauma>><<control 25>><<trauma -25>>
		<<if $alexFarm.stage gte 12>>
			<<earnFeat "Heroic Victory">>
			<<set $specialClothesEvents.pushUnique("farm_defended")>>
			<<specialClothesUnlock "set" "scarecrow">>
		<</if>>
	<</if>>
	<br><br>
	<<npc Remy>><<person1>>
	Remy watches from a nearby hill. <<He>> turns <<his>> steed and rides away.
	<br><br>
	<<link [[Next|Farm Assault Victory]]>><<endevent>><</link>>
	<br>
<<else>>

	<<farm_assault_actions _turn>>

<</if>>


:: Farm Assault Defeat
<<effects>>

<<npc Alex>><<person1>>
You find Alex lying on <<his>> face, an empty bottle beside <<him>>. <<Hes>> unconscious.<<llldom>><<npcincr Alex dom -15>>
<br><br>

<<if $alexFarm.assault.fight.towerState is "defeated">>
	You carry <<him>> back to the cottage, and lay <<him>> in <<his>> bed, before returning to search for $alexFarm.towerGuard.name.
	<<endevent>>
	<<loadNPC 0 "farm_tower_guard">><<person1>>
	You find <<him>> sitting at the base of the watchtower,
	<<if $NPCList[0].traits.includes("relaxed")>>
		trying to light a cigarette butt. "That was rougher than I expected," <<he>> says. "Could you help me up?"
	<<elseif $NPCList[0].traits.includes("sociable")>>
		chatting on <<his>> phone. "—boss is here. Call you back." <<He>> smiles at you. "You should have seen how many I took on before they got me."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		gazing at the sky. "Sorry boss," <<he>> says. "I like to think I gave as good as I got."
	<<else>>
		watching you. "Are you an angel come to take me away?" <<he>> laughs.
	<</if>>
	You help <<him>> to <<his>> feet.
	<<if $NPCList[0].traits.includes("relaxed")>>
		"I'll be alright," <<he>> continues. "Just need to stretch."
	<<elseif $NPCList[0].traits.includes("sociable")>>
		"There's a stool just inside," <<he>> continues. "A little rest would do me good."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		"Don't worry about me," <<he>> continues. "I'll walk it off."
	<<else>>
		"Your touch has me feeling better already," <<he>> continues. "I think I can limp back to my post."
	<</if>>
	<br><br>
	You return to the cottage. Remy won this round, but the war continues.
	<br><br>
<<elseif $alexFarm.assault.fight.towerState is "manned" or $alexFarm.assault.fight.towerState is "attacked">>
	$alexFarm.towerGuard.name limps over.

	<<endevent>>
	<<loadNPC 0 "farm_tower_guard">><<person1>>

	<<if $NPCList[0].traits.includes("relaxed")>>
		"Let's get <<nnpc_him Alex>> inside," <<he>> says, nodding at Alex. "Then I need a smoke."
	<<elseif $NPCList[0].traits.includes("sociable")>>
		"Is <<nnpc_he Alex>> alright?" <<he>> asks, then notices the bottle. "Ah."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		"Sorry boss," <<he>> says. "You're handling this better than Alex at least. Let's get <<nnpc_him Alex>> inside."
	<<else>>
		"That was a mess," <<he>> says. "Alex has the right idea. Odd choice of bed though."
	<</if>>
	<br><br>

	<<endevent>>
	<<npc Alex>><<person1>>
	Together, you carry Alex back to the cottage, and lay <<him>> in <<his>> bed. Remy won this round, but the war continues.
	<br><br>
<<else>>
	You carry <<him>> back to the cottage, and lay <<him>> in <<his>> bed. Remy won this round, but the war continues.
	<br><br>
<</if>>

<<farm_assault_end>>

<<link [[Next|Farm Bedroom]]>><<endevent>><</link>>
<br>

:: Farm Assault Victory
<<effects>>

<<npc Alex>><<person1>>

<<if $alexFarm.assault.noFieldsLeftToBurn is true>>
	"You better stay the fuck away," Alex shouts after them. <<He>> turns to you. "I'm glad they wasted their time, but we shouldn't let them run rampant through the farm."
	<br><br>
<<elseif $alexFarm.assault.burntFields.length gte 1>>
	"You better stay the fuck away," Alex shouts after them. <<He>> turns to you, then to the smouldering field behind <<him>>. "We limited the damage," <<he>> says. "We'll be more prepared next time."
	<br><br>
<<else>>
	"You better stay the fuck away," Alex shouts after them. <<He>> turns to you. Mud coats <<his>> body, but <<his>> smile is broad. "We did it. And we can do it again!"
	<br><br>
<</if>>

<<if $alexFarm.assault.fight.towerState is "defeated">>
	<<He>> looks at the watchtower. "Fuck, is $alexFarm.towerGuard.name okay?"
	<br><br>
	<<endevent>>
	<<loadNPC 0 "farm_tower_guard">><<person1>>
	You find the lookout sat at the base of the tower,
	<<if $NPCList[0].traits.includes("relaxed")>>
		trying to light a cigarette butt. "That was rougher than I expected," <<he>> says. "Could you help me up?"
	<<elseif $NPCList[0].traits.includes("sociable")>>
		chatting on <<his>> phone. "—bosses are here. Call you back." <<He>> smiles at you. "You should have seen how many I took on before they got me."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		gazing at the sky. "Sorry boss," <<he>> says. "I like to think I gave as good as I got."
	<<else>>
		watching you. "Have the angels come to take me away?" <<he>> laughs.
	<</if>>
	You and Alex help <<him>> to <<his>> feet.
	<<if $NPCList[0].traits.includes("relaxed")>>
		"I'll be alright," <<he>> continues. "Just need to stretch."
	<<elseif $NPCList[0].traits.includes("sociable")>>
		"There's a stool just inside," <<he>> continues. "A little rest would do me good."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		"Don't worry about me," <<he>> continues. "I'll walk it off."
	<<else>>
		"Your touch has me feeling better already," <<he>> continues. "I think I can limp back to my post."
	<</if>>
	<br><br>

<<elseif $alexFarm.assault.fight.towerState is "manned" or $alexFarm.assault.fight.towerState is "attacked">>
	$alexFarm.towerGuard.name approaches.
	<<endevent>>
	<<loadNPC 0 "farm_tower_guard">><<person1>>
	<<if $NPCList[0].traits.includes("relaxed")>>
		"Glad you guys are alright," <<he>> says. "That was almost too exciting."
	<<elseif $NPCList[0].traits.includes("sociable")>>
		"That livened things up," <<he>> says. "I think I need a breather."
	<<elseif $NPCList[0].traits.includes("brooding")>>
		"Good job," <<he>> says. "Hope I helped."
	<<else>>
		"You should've seen me up there," <<he>> says. "Three—" <<He>> pauses. "I mean, five, burly monsters came climbing the side of the tower, but I sent them packing."
	<</if>>
	<br><br>
<<else>>

<</if>>

<<endevent>>
<<npc Alex>><<person1>>
You walk back to the cottage.
<<if isLoveInterest("Alex")>>
	Alex wraps an arm around your shoulder.
<<else>>
	Alex pats your shoulder.
<</if>>
"We won, but Remy will be back. We'll be ready."
<br><br>
<span class="red">Remy will attack again in <<number $alexFarm.assault.daysUntilNext>> days.</span>
<br><br>

<<farm_assault_end>>

<<link [[Next|Farm Cottage]]>><<endevent>><</link>>
<br>

:: Farm Assault Intro
<<effects>><<wearProp "walkie talkie">>
<<set $bus to "yard">>
<<farm_assault_init>>

You rush outside, and find Alex stood in the yard.
<br><br>
<<set $alexFarm.assault.daysUntilNext to random(17, 24)>>
<<npc Alex>><<person1>>
"They're not coming through here," <<he>> says, nodding at the road. "They'll try to sneak in." <<He>> hands you a walkie talkie. "There's a lot of ground to cover, so we'll need to split up. We'll be stronger if we team up to fight them though."
<br><br>

<<if $alexFarm.upgrades.tower gte 2 and $alexFarm.towerGuard.name>>
	<<He>> waves at the watchtower, and $alexFarm.towerGuard.name flashes the searchlight in response.
	<br><br>
<<elseif $alexFarm.upgrades.tower and $alexFarm.towerGuard.name>>
	<<He>> waves at the watchtower, and you make out $alexFarm.towerGuard.name wave in response.
	<br><br>
<<elseif $alexFarm.upgrades.tower>>
	<<He>> points at the watchtower. "We can climb it if we need a better view."
	<br><br>
<</if>>

<<if pcAreArmsBound("any")>>
	Alex slices through your bindings. You're not defending the farm like that.
	<<unbind>>
	<br><br>
<</if>>

<<link [[Next|Farm Assault]]>><<endevent>><</link>>
<br>



:: Farm Assault Wardrobe [exitCheckBypass]
<<effects>>
<div id="wardrobeExits"><<wardrobeExits>></div>

<<if $phase is 2>>
	You enter the cottage, climb the stairs, and throw open the rustic wardrobe.
<<elseif $phase is 1>>
	You climb from your bed, and throw open the rustic wardrobe.
<<elseif $phase is 3>>
	You enter your room, and throw open the rustic wardrobe.
<<else>>
	You look through the rustic wardrobe.
<</if>>
<<set $phase to 0>>
You hear shouting outside.
<br><br>
<<set $wardrobe_location to "alexFarm">>
<<wardrobeSelection>>
<div id="wardrobeMessage"><<onWardrobeOpen>></div>
<<wardrobe>>

:: Farm Assault Widgets [widget]
<<widget "farm_assault_init">>
	<<set $alexFarm.assault.fight to {}>>
	<<set $alexFarm.assault.fight.freeFieldsForTeams to []>>
	<<set _emptyFields to []>>
	<<for _fieldIndex, _field range $plots.farm>>
		<<if _field.stage gte 1>>
			<<set $alexFarm.assault.fight.freeFieldsForTeams.push(_fieldIndex)>>
		<<else>>
			<<set _emptyFields.push(_fieldIndex)>>
		<</if>>
	<</for>>
	<<set $alexFarm.assault.fight.teams to []>>
	<<if $alexFarm.stage gte 12>>
		<<set _remyTeamCount to 5>>
	<<elseif $alexFarm.stage gte 10>>
		<<set _remyTeamCount to 4>>
	<<elseif $alexFarm.stage gte 8>>
		<<set _remyTeamCount to 3>>
	<<else>>
		<<set _remyTeamCount to 2>>
	<</if>>
	<<for _teamNumber to 1; _teamNumber lte _remyTeamCount; _teamNumber++>>
		<<run $alexFarm.assault.fight.teams.push({})>>
	<</for>>
	<<if $bailey.rent.timesPcRefusedBaileyAtFarm>>
		<<run $alexFarm.assault.fight.teams.push({ type: "bailey" })>>
	<</if>>
	<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
		<<set $alexFarm.assault.fight.teams[_teamIndex].location to $alexFarm.assault.fight.freeFieldsForTeams.pluck()>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].location is undefined>>/*No planted field left for this team.*/
			<<set $alexFarm.assault.fight.teams[_teamIndex].location to _emptyFields.pluck()>>
		<</if>>
		<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress to 0>>
		<<set $alexFarm.assault.fight.teams[_teamIndex].fieldProgress to 0>>
		<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft to 3>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].type isnot "bailey" and $ivoryWraith.state is "haunt" and $alexFarm.assault.fight.wraithTeamIndex is undefined and $hallucinations gte 2 and random(1,15-Math.floor(C.npc["Ivory Wraith"].lust/5)) is 1>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].type to "wraith">>
			<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft to 1>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].fieldsTorched to 0>>
			<<set $alexFarm.assault.fight.wraithTeamIndex to _teamIndex>>
		<</if>>
		<<if !$alexFarm.assault.fight.teams[_teamIndex].type>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].type to "remy">>
		<</if>>
	<</for>>
	<<if $alexFarm.upgrades.kennel gte 1>>
		<<set $alexFarm.assault.fight.dogTeamsLeft to 2>>
	<<else>>
		<<set $alexFarm.assault.fight.dogTeamsLeft to 1>>
	<</if>>
	<<set $alexFarm.assault.fight.dogsState to "guarding">>
	<<if $alexFarm.towerGuard.name>>
		<<set $alexFarm.assault.fight.towerState to "manned">>
	<<else>>
		<<set $alexFarm.assault.fight.towerState to "empty">>
	<</if>>
	<<set $alexFarm.assault.fight.alexState to "patrol">>
	<<set $alexFarm.assault.burntFields to []>>
	<<unset $alexFarm.assault.noFieldsLeftToBurn $alexFarm.assault.happenedWhilePcAway>>
<</widget>>

<<widget "farm_assault_end">>
	<<unset $alexFarm.assault.fight>>
	<<unset $alexFarm.assault.noFieldsLeftToBurn>>
	<<set $alexFarm.assault.burntFields to []>>
<</widget>>

<!-- Moves every team on by one turn. _args[0] is the turn's result, which the Farm Assault passage hands to the widgets that describe it:
	towerThreatened: a team is at the watchtower, and its fight with the guard had no result this turn
	guardWon, guardLost: the guard took out a thug, or was beaten, this turn
	fieldSetAlight: a team finished setting a field alight this turn
	dogsResult: "victorious" or "defeated" if the dogs' fight with a team ended this turn
	alexBeatThug: Alex took out a thug this turn
	teamsStillAttacking: at least one team hasn't left -->
<<widget "farm_assault_progress">>
	<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].state is undefined>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].state to "wall">>
		<</if>>
		/*Fleeing checked before and after other actions. */
		<<farm_assault_flight _args[0]>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].location isnot "done">>
			/*Assaulting the tower. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].location is "tower">>
				<<set _args[0].towerThreatened to true>>
				<<if $alexFarm.assault.fight.teams[_teamIndex].state is "approach">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "climb">>
				<<elseif $alexFarm.assault.fight.teams[_teamIndex].state is "climb">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "fight">>
				<<elseif $alexFarm.assault.fight.teams[_teamIndex].state is "fight">>
					<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
						<<if $alexFarm.towerGuard.skill gte random(1, 2000)>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
							<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft lte 0>>
								<<set $alexFarm.assault.fight.towerState to "manned">>
							<</if>>
							<<set _args[0].guardWon to true>>
							<<set _args[0].towerThreatened to false>>
						<<else>>
							<<set $alexFarm.assault.fight.towerState to "defeated">>
							<<set $alexFarm.assault.fight.teams[_teamIndex].location to $alexFarm.assault.fight.freeFieldsForTeams.pluck()>>
							<<if $alexFarm.assault.fight.teams[_teamIndex].location is undefined>>/*No free field left.*/
								<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
							<</if>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].state to "field">>
							<<set _args[0].guardLost to true>>
							<<set _args[0].towerThreatened to false>>
						<</if>>
					<<else>>
						<<if $alexFarm.towerGuard.skill gte random(1, 1000)>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
							<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft lte 0>>
								<<set $alexFarm.assault.fight.towerState to "manned">>
							<</if>>
							<<set _args[0].guardWon to true>>
							<<set _args[0].towerThreatened to false>>
						<<else>>
							<<set $alexFarm.assault.fight.towerState to "defeated">>
							<<set $alexFarm.assault.fight.teams[_teamIndex].location to $alexFarm.assault.fight.freeFieldsForTeams.pluck()>>
							<<if $alexFarm.assault.fight.teams[_teamIndex].location is undefined>>/*No free field left.*/
								<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
							<</if>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].state to "field">>
							<<set _args[0].guardLost to true>>
							<<set _args[0].towerThreatened to false>>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
			/*Successfully burning. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "celebrate">>
				<<set $alexFarm.assault.fight.teams[_teamIndex].state to "field">>
				<<set $alexFarm.assault.fight.teams[_teamIndex].location to $alexFarm.assault.fight.freeFieldsForTeams.pluck()>>
				<<if $alexFarm.assault.fight.teams[_teamIndex].location is undefined or $alexFarm.assault.fight.teams[_teamIndex].fieldsTorched gte Math.floor(C.npc["Ivory Wraith"].lust/4)>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
				<</if>>
			<</if>>
			/*Burning a field. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "field">>
				<<if $alexFarm.assault.fight.teams[_teamIndex].fieldProgress gte 4>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].fieldProgress to 0>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "celebrate">>
					<<set _args[0].fieldSetAlight to true>>
					<<damage_farm "target" $alexFarm.assault.fight.teams[_teamIndex].location>>
					<<if $alexFarm.assault.fight.teams[_teamIndex].type is "wraith">>
						<<set $alexFarm.assault.fight.teams[_teamIndex].fieldsTorched++>>
					<</if>>
				<<else>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].fieldProgress++>>
					<<if $alexFarm.assault.fight.teams[_teamIndex].type is "wraith" and random(0,1) is 1>>
						<<set $alexFarm.assault.fight.teams[_teamIndex].fieldProgress++>>
					<</if>>
				<</if>>
			<</if>>
			/*Responding to hounds. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "dogs_recover">>
				<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
					<<set _teamFieldPlanted to $plots.farm[$alexFarm.assault.fight.teams[_teamIndex].location]?.stage gte 1>>
					<<if $alexFarm.assault.fight.towerState is "manned">>
						<<if _teamFieldPlanted>>
							<<set $alexFarm.assault.fight.freeFieldsForTeams.push($alexFarm.assault.fight.teams[_teamIndex].location)>>/*Add their location back to the pool.*/
						<</if>>
						<<set $alexFarm.assault.fight.teams[_teamIndex].location to "tower">>
						<<set $alexFarm.assault.fight.teams[_teamIndex].state to "approach">>
						<<set $alexFarm.assault.fight.towerState to "attacked">>
					<<elseif _teamFieldPlanted>>
						<<set $alexFarm.assault.fight.teams[_teamIndex].state to "field">>
					<<else>>/*Nothing to burn here.*/
						<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
					<</if>>
				<<else>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
				<</if>>
				<<set $alexFarm.assault.fight.dogTeamsLeft -= 1>>
				<<if $alexFarm.assault.fight.dogTeamsLeft gte 1>>
					<<set $alexFarm.assault.fight.dogsState to "guarding">>
					<<set _args[0].dogsResult to "victorious">>
				<<else>>
					<<set $alexFarm.assault.fight.dogsState to "defeated">>
					<<set _args[0].dogsResult to "defeated">>
				<</if>>
			<</if>>
			/*Intercepted by hounds. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "dogs">>
				<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
				<</if>>
				<<set $alexFarm.assault.fight.teams[_teamIndex].state to "dogs_recover">>
			<</if>>
			/*Entering. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "entry">>
				<<set _teamFieldPlanted to $plots.farm[$alexFarm.assault.fight.teams[_teamIndex].location]?.stage gte 1>>
				<<if $alexFarm.assault.fight.dogTeamsLeft gte 1 and $alexFarm.assault.fight.dogsState is "guarding" and $alexFarm.assault.fight.teams[_teamIndex].type isnot "wraith">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "dogs">>
					<<set $alexFarm.assault.fight.dogsState to "fighting">>
				<<elseif ($alexFarm.assault.fight.teams[_teamIndex].type is "bailey" or random(1, 2) is 2 or !_teamFieldPlanted) and $alexFarm.assault.fight.towerState is "manned" and $alexFarm.assault.fight.teams[_teamIndex].type isnot "wraith">>
					<<if _teamFieldPlanted>>
						<<set $alexFarm.assault.fight.freeFieldsForTeams.push($alexFarm.assault.fight.teams[_teamIndex].location)>>/*Add their location back to the pool.*/
					<</if>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].location to "tower">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "approach">>
					<<set $alexFarm.assault.fight.towerState to "attacked">>
				<<elseif !_teamFieldPlanted>>/*Nothing to burn here.*/
					<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
				<<else>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "field">>
				<</if>>
			<</if>>
			/*Breaking in. */
			<<if $alexFarm.assault.fight.teams[_teamIndex].state is "wall">>
				<<if $alexFarm.assault.fight.teams[_teamIndex].wallProgress gte $alexFarm.upgrades.wall>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].state to "entry">>
					<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress to 0>>
				<<else>>
					<<if $alexFarm.assault.fight.teams[_teamIndex].type is "wraith">>
						<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress to $alexFarm.upgrades.wall>>
					<<elseif $alexFarm.upgrades.wall gte 4 and $alexFarm.assault.fight.teams[_teamIndex].type isnot "bailey">>
						<<if random(1, 3) is 3>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress++>>
						<</if>>
					<<elseif $alexFarm.upgrades.wall gte 3 and $alexFarm.assault.fight.teams[_teamIndex].type isnot "bailey">>
						<<if random(1, 3) gte 2>>
							<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress++>>
						<</if>>
					<<else>>
						<<set $alexFarm.assault.fight.teams[_teamIndex].wallProgress++>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
		/*Fleeing. */
		<<farm_assault_flight _args[0]>>
		/*Alex. */
		<<if $alexFarm.assault.fight.alexState is "patrol">>
			<<if $alexFarm.assault.fight.teams[_teamIndex].location isnot "done" and $alexFarm.assault.fight.teams[_teamIndex].type isnot "wraith">>
				<<set $alexFarm.assault.fight.alexState to "fighting">>
				<<set $alexFarm.assault.fight.alexTeamIndex to _teamIndex>>
			<</if>>
		<<elseif $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
			<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
				<<if random(1, 100) gte 80>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
					<<set _args[0].alexBeatThug to true>>
				<</if>>
			<<else>>
				<<if random(1, 100) gte 60>>
					<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
					<<set _args[0].alexBeatThug to true>>
				<</if>>
			<</if>>
		<</if>>
		/*Fleeing. */
		<<farm_assault_flight _args[0]>>
	<</for>>
	<<if !_args[0].teamsStillAttacking and !$plots.farm.some(plot => plot.stage gte 1)>>
		<<set $alexFarm.assault.noFieldsLeftToBurn to true>>
	<</if>>
<</widget>>

<<widget "farm_assault_flight">>
	<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft lte 0>>/*Flee if numbers reduced to 0.*/
		<<if typeof $alexFarm.assault.fight.teams[_teamIndex].location is "number" and $alexFarm.assault.fight.teams[_teamIndex].state isnot "celebrate" and $plots.farm[$alexFarm.assault.fight.teams[_teamIndex].location].stage gte 1>>
			<<set $alexFarm.assault.fight.freeFieldsForTeams.push($alexFarm.assault.fight.teams[_teamIndex].location)>>/*Add their location back to the pool.*/
		<</if>>
		<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
	<</if>>
	<<if $alexFarm.assault.fight.teams[_teamIndex].location isnot "done">>
		<<set _args[0].teamsStillAttacking to true>>
	<<elseif $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>/*Alex patrols again. */
		<<set $alexFarm.assault.fight.alexState to "patrol">>
		<<unset $alexFarm.assault.fight.alexTeamIndex>>
	<</if>>
<</widget>>

<<widget "farm_assault_info">>
	<<if _args[1] is "guard">>
		<<set _guardSkill to $alexFarm.towerGuard.skill>>
	<<else>>
		<<set _guardSkill to 0>>
	<</if>>
	<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].location is "tower" and $alexFarm.assault.fight.teams[_teamIndex].state is "fight">>
			<<set _guardIsFighting to true>>
		<</if>>
	<</for>>

	<<if _guardIsFighting or _args[0].guardWon or _args[0].guardLost>>
		Your walkie talkie picks up another signal. <span class="red">You hear a struggle, punctuated by static.</span>
		<<if _args[0].guardWon>>
			You peer at the watchtower. A body falls from the top. <span class="green">It's not $alexFarm.towerGuard.name.</span> Seems $per_npc.farm_tower_guard.pronouns.he got the better of one of $per_npc.farm_tower_guard.pronouns.his attackers.
		<<elseif _args[0].guardLost>>
			You peer at the watchtower. A body falls from the top. <span class="red">It's $alexFarm.towerGuard.name.</span> <<print toTitleCase($per_npc.farm_tower_guard.pronouns.he)>> won't be helping for the rest of the assault.
		<</if>>
		<br><br>
	<<else>>
		<<if _args[1] is "guard">>
			Your walkie talkie picks up another signal. It's $alexFarm.towerGuard.name, keeping you informed of enemy activity:
		<<else>>
			You look across the farm, trying to spot enemy movements:
		<</if>>
		<br>
		<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
			<<if $alexFarm.assault.fight.teams[_teamIndex].type is "wraith">>
				<<if $alexFarm.assault.fight.teams[_teamIndex].location is "done">>
					<span class="green">The <<farm_assault_thugs>> is walking away, like <<print Memories.IvoryWraith.has("joinedFarmAssault") ? "it's" : "they've">> lost interest.</span>
					<<if $ivoryWraith.timesMetPc gte 5 and !$alexFarm.assault.fight.pcLostStressToWraith>>
						<<stress -6>><<lstress>><<set $alexFarm.assault.fight.pcLostStressToWraith to true>>
					<</if>>
				<<else>>
					<<if _guardSkill gte random(400, 1400) or !Memories.IvoryWraith.has("joinedFarmAssault")>>
						<<switch $alexFarm.assault.fight.teams[_teamIndex].state>>
						<<case wall>>
							The <<farm_assault_thugs>> is <span class="purple">walking through the <<print $alexFarm.upgrades.wall gte 3 ? "fence" : "wall">></span>.
						<<case entry>>
							The <<farm_assault_thugs>> is shambling toward <<farm_assault_location>>.
						<<case field>>
							<<if $alexFarm.assault.fight.teams[_teamIndex].fieldProgress lte 1>>
								<span class="blue">The <<farm_assault_thugs>> enters <<farm_assault_location>>.</span>
							<<else>>
								<span class="blue">The <<farm_assault_thugs>> wanders around <<farm_assault_location>>.</span>
							<</if>>
						<<case celebrate>>
							The <<farm_assault_thugs>> stands completely still. <span class="red"><<farm_assault_location "cap">> bursts into flames.</span>
						<</switch>>
					<<else>>
						Something seems off at <<farm_assault_location>>.
					<</if>>
				<</if>>
			<<else>>
				<<if $alexFarm.assault.fight.teams[_teamIndex].location is "done">>
					<span class="green">The <<farm_assault_no>> group of <<farm_assault_thugs>> are running for the hills.</span>
				<<elseif $alexFarm.assault.fight.teams[_teamIndex].state is "dogs">>
					You hear barking from <<farm_assault_location>>.
				<<elseif $alexFarm.assault.fight.teams[_teamIndex].state is "dogs_recover">>
					You hear barking and shouts of <<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>pain<<else>>terror<</if>> from <<farm_assault_location>>.
				<<elseif $alexFarm.assault.fight.teams[_teamIndex].location is "tower">>
					<<switch $alexFarm.assault.fight.teams[_teamIndex].state>>
					<<case "approach">>
						<span class="purple">The <<farm_assault_no>> group of <<farm_assault_thugs>> are approaching the watchtower.</span>
					<<case "climb">>
						<span class="pink">The <<farm_assault_no>> group of <<farm_assault_thugs>> are climbing the watchtower.</span>
					<</switch>>
				<<else>>
					<<if _guardSkill gte random(1, 1000)>>
						<<switch $alexFarm.assault.fight.teams[_teamIndex].state>>
						<<case wall>>
							The <<farm_assault_no>> group of <<farm_assault_thugs>> are
							<<if $alexFarm.upgrades.wall gte 3>>
								<span class="pink">cutting through the fence</span> at <<farm_assault_location>>.
							<<else>>
								climbing the wall near <<farm_assault_location>>.
							<</if>>
						<<case entry>>
							The <<farm_assault_no>> group of <<farm_assault_thugs>> are rushing into <<farm_assault_location>>.
						<<case field>>
						<<switch $alexFarm.assault.fight.teams[_teamIndex].fieldProgress>>
						<<case 1>>
								<span class="blue">The <<farm_assault_no>> group of <<farm_assault_thugs>> are entering <<farm_assault_location>>.</span>
						<<case 2>>
								<span class="purple">The <<farm_assault_no>> group of <<farm_assault_thugs>> are opening petrol canisters at <<farm_assault_location>>.</span>
						<<case 3>>
								<span class="pink">The <<farm_assault_no>> group of <<farm_assault_thugs>> are pouring petrol over <<farm_assault_location>>.</span>
						<<case 4>>
								<span class="red">The <<farm_assault_no>> group of <<farm_assault_thugs>> are lighting matches at <<farm_assault_location>>.</span>
						<</switch>>
						<<case celebrate>>
							<span class="red">The <<farm_assault_no>> group of <<farm_assault_thugs>> are revelling as the field burns.</span>
						<</switch>>
					<<else>>
						There's movement at <<farm_assault_location>>.
					<</if>>
				<</if>>
			<</if>>
			<br>
		<</for>>
		<br>
	<</if>>
<</widget>>

<<widget "farm_assault_alex">>
	<<if !_args[0].teamsStillAttacking or $alexFarm.assault.noFieldsLeftToBurn is true>>
	<<elseif $alexFarm.assault.fight.alexState is "bound">>
		<<if $alexFarm.assault.fight.alexBindings gte 1>>
			<<set $alexFarm.assault.fight.alexBindings -= 1>>
		<<else>>
			<<set $alexFarm.assault.fight.alexState to "patrol">>
		<</if>>
	<<elseif $alexFarm.assault.fight.alexState is "patrol">>
		Your walkie talkie picks up a signal. "I'm looking for intruders," Alex says. "Just checking in."
		<br><br>
	<<else>>
		<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
			<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location and $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
				<span class="teal">Alex crouches beside you.</span>
				<<if $alexFarm.assault.fight.pcBindings gte 1>>
					<span class="green">Your bindings come loose.</span>
					<<farm_assault_unbind>>
				<</if>>
				"What's the plan?"
				<br><br>
			<<elseif $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
				Your walkie talkie picks up a signal. "I'm <<print either("pursuing","stalking","following","hunting","harrying")>> <<farm_assault_thugs>> at <<farm_assault_location>>," Alex says in a hushed voice.
				<<if _args[0].alexBeatThug>>
					<<set _rng to random(1, 5)>>
					<<switch _rng>>
					<<case 1>>
						<span class="green">"Knocked one out."</span>
					<<case 2>>
						<span class="green">"They'll feel this in the morning."</span>
					<<case 3>>
						<span class="green">"Wonder when they'll realise they're missing a colleague."</span>
					<<case 4>>
						<span class="green">"One thug down."</span>
					<<default>>
						<span class="green">"Took one down."</span>
					<</switch>>
					<br><br>
				<<else>>
					<<set _rng to random(1, 5)>>
					<<switch _rng>>
					<<case 1>>
						<span class="blue">"Can't get them alone."</span>
					<<case 2>>
						<span class="blue">"They're too watchful."</span>
					<<case 3>>
						<span class="blue">"Can't get close."</span>
					<<case 4>>
						<span class="blue">"Just waiting for my moment."</span>
					<<default>>
						<span class="blue">"I won't take any risks."</span>
					<</switch>>
					<br><br>
				<</if>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "farm_assault_location">><<silently>>
	<<switch $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<case 0>>
			<<set _text_output to "the first field">>
		<<case 1>>
			<<set _text_output to "the second field">>
		<<case 2>>
			<<set _text_output to "the third field">>
		<<case 3>>
			<<set _text_output to "the fourth field">>
		<<case 4>>
			<<set _text_output to "the fifth field">>
		<<case 5>>
			<<set _text_output to "the sixth field">>
		<<case 6>>
			<<set _text_output to "the seventh field">>
		<<case 7>>
			<<set _text_output to "the eighth field">>
		<<case 8>>
			<<set _text_output to "the ninth field">>
		<<case tower>>
			<<set _text_output to "the watchtower">>
		<<default>>
			<<set _text_output to "the fields">>
	<</switch>>
	<<if _args[0] is "cap">>
		<<capitalise>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "farm_assault_thugs">><<silently>>
	<<switch $alexFarm.assault.fight.teams[_teamIndex].type>>
		<<case "bailey">>
			<<set _text_output to "<span class=\"red\">Bailey's thugs</span>">>
		<<case "wraith">>
			<<if Memories.IvoryWraith.has("joinedFarmAssault")>>
				<<set _text_output to "<span class=\"wraith\">pale figure</span>">>
			<<else>>
				<<set _text_output to "<span class=\"black\">shifty stranger</span>">>
			<</if>>
		<<default>>
			<<set _text_output to "<span class=\"pink\">Remy's thugs</span>">>
	<</switch>>
	<<if _args[0] is "cap">>
		<<capitalise>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "farm_assault_options">>
	<<if !_noOptions>>
		<<link [[Wait (0:05)|Farm Assault]]>><<pass 5>><<set $alexFarm.assault.fight.movement to "wait">><</link>>
		<br>
		<<if $bus is "tower" and !_args[0].towerThreatened and $alexFarm.assault.fight.towerState isnot "manned">>
			<<link [[Climb the watchtower (0:05)|Farm Assault]]>><<pass 5>><<set $bus to "tower_top">><<set $alexFarm.assault.fight.movement to "climb">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 0>>
			<<link [[First field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 0>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 1>>
			<<link [[Second field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 1>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 2>>
			<<link [[Third field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 2>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 3>>
			<<link [[Fourth field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 3>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 4 and $alexFarm.stage gte 8>>
			<<link [[Fifth field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 4>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 5 and $alexFarm.stage gte 9>>
			<<link [[Sixth field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 5>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 6 and $alexFarm.stage gte 10>>
			<<link [[Seventh field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 6>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 7 and $alexFarm.stage gte 11>>
			<<link [[Eighth field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 7>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot 8 and $alexFarm.stage gte 12>>
			<<link [[Ninth field (0:05)|Farm Assault]]>><<pass 5>><<set $bus to 8>><<set $alexFarm.assault.fight.movement to "field">><</link>>
			<br>
		<</if>>
		<<if $bus isnot "tower" and $bus isnot "tower_top" and $alexFarm.upgrades.tower gte 1>>
			<<link [[Watchtower (0:05)|Farm Assault]]>><<pass 5>><<set $bus to "tower">><<set $alexFarm.assault.fight.movement to "tower">><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_assault_actions">>
	<<switch $bus>>
		<<case "tower">>
			The watchtower looms above you.
		<<case 0>>
			You are near the first field.
		<<case 1>>
			You are near the second field.
		<<case 2>>
			You are near the third field.
		<<case 3>>
			You are near the fourth field.
		<<case 4>>
			You are near the fifth field.
		<<case 5>>
			You are near the sixth field.
		<<case 6>>
			You are near the seventh field.
		<<case 7>>
			You are near the eighth field.
		<<case 8>>
			You are near the ninth field.
	<</switch>>
	<<if $alexFarm.assault.burntFields.includes($bus)>>
		<span class="red">It's engulfed in flames.</span>
	<</if>>
	<br>
	<<if $alexFarm.assault.fight.pcBindings gte 1>>
		You lie in the dirt, unable to move much.
		<br><br>

		<<link [[Struggle (0:05)|Farm Assault]]>><<pass 5>><<set $alexFarm.assault.fight.pcBindings -= 1>><<set $alexFarm.assault.fight.movement to "struggle">><</link>>
		<br>
	<<else>>
		<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
			<<set $_team to $alexFarm.assault.fight.teams[_teamIndex]>>
			<<set $_isBaileyTeam to $_team.type is "bailey">>
			<<set $_isWraith to $_team.type is "wraith">>
			<<if $bus is $_team.location>>
				<<if $bus is "tower">>
					<<if $_team.state is "approach">>
						<span class="blue"><<farm_assault_thugs>> approach.</span>
						<br><br>
						<<farm_assault_attack_options>>
					<<elseif $_team.state is "climb">>
						<span class="purple">You see <<farm_assault_thugs>> entering the tower.</span>
						<br><br>

						<<link [[Defend the watchtower (0:05)|Farm Assault Tower Defend]]>><<pass 5>><</link>>
						<br>
					<<elseif $_team.state is "fight">>
						<span class="pink">You hear $alexFarm.towerGuard.name fighting <<farm_assault_thugs>> at the top of the tower!</span>
						<br><br>

						<<link [[Defend the watchtower (0:05)|Farm Assault Tower Defend]]>><<pass 5>><</link>>
						<br>
					<</if>>
				<<elseif $_team.state is "wall">>
					<<if $_isWraith>>
						You see the <<farm_assault_thugs>> <span class="pink">walking through the <<print $alexFarm.upgrades.wall gte 3 ? "fence" : "wall">></span>.
					<<else>>
						<<if $alexFarm.upgrades.wall gte 3>>
							You see <<farm_assault_thugs>> sawing through the fence.
						<<else>>
							You see <<farm_assault_thugs>> climbing over the wall.
						<</if>>
						<<if $_team.thugsLeft is 1>>
							There's only one here.
						<<else>>
							There are <<number $_team.thugsLeft>> of them.
						<</if>>
					<</if>>
					<<if $_isBaileyTeam>>
						<span class="red">They move with surety.</span>
					<</if>>
					<br>
					<<if $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
						<<link [[Throw rocks with Alex (0:05)|Farm Assault Rocks Alex]]>><<pass 5>><</link>>
						<br>
					<<else>>
						<<set $_difficultyMin to ($_isBaileyTeam ? 6000 : 1)>>
						<<set $_difficultyMax to ($_isBaileyTeam ? 20000 : 15000)>>
						<<link [[Throw rocks (0:05)|Farm Assault Rocks]]>><<pass 5>><</link>><<physiquedifficulty $_difficultyMin $_difficultyMax>>
						<br>
					<</if>>
					<<set $_difficultyMin to ($_isBaileyTeam ? 3000 : 200)>>
					<<set $_difficultyMax to ($_isBaileyTeam ? 3000 : 1000)>>
					<<link [[Threaten (0:05)|Farm Assault Threaten]]>><<pass 5>><</link>><<skill_difficulty $fame.scrap "Combat Fame" $_difficultyMin $_difficultyMax>>
					<br>
				<<elseif $_team.state is "entry">>
					<<if $_isBaileyTeam>>
						<<if $_team.thugsLeft gte 2>>
							You see <<number $_team.thugsLeft>> of <<farm_assault_thugs>> rush into the farm. They ignore you, instead heading into the fields.
							<br>
							<<farm_assault_attack_options>>
						<<else>>
							You see one of <<farm_assault_thugs>> rush into the farm.
							<br>
							<<farm_assault_attack_options>>
						<</if>>
					<<elseif $_isWraith>>
						<<set _noOptions to true>>
						You see the <<farm_assault_thugs>> approach you.
						<<if !Memories.IvoryWraith.has("firstEncounter")>>
							<<run Memories.IvoryWraith.add("firstEncounter")>>
							They're a beautiful pale figure, wearing translucent white robes. They regard you with angry red eyes, clutching at their own neck. A bizarre, slimy substance leaks wherever they walk.
						<<elseif !Memories.IvoryWraith.has("joinedFarmAssault")>>
							<span class="red">Their face is a terrible, familiar pale.</span> A bizarre, slimy substance leaks wherever it walks.
						<<else>>
							It smiles a terrible, familiar smile. A bizarre, slimy substance leaks wherever it walks.
						<</if>>
						<<run Memories.IvoryWraith.add("joinedFarmAssault")>>
						<br><br>

						"<span class="wraith">Drown in smoke. Drown in flame.</span>"
						<br><br>

						<<if $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
							"I'm doubling back," Alex whispers, <span class="red">seemingly not noticing the pale figure. <<nnpc_He "Alex">> creeps away.</span>
							<<set $alexFarm.assault.fight.alexState to "patrol">>
							<<unset $alexFarm.assault.fight.alexTeamIndex>>
							<br><br>
						<</if>>

						<<generateWraith 1 true>>
						<<initWraith "man" "arms" "abomination">><<startWraith>>
						<br><br>

						<<link [[Next|Farm Assault Wraith Fight]]>><<set $fightstart to 1>><</link>>
					<<else>>
						<<if $_team.thugsLeft gte 2>>
							You see <<number $_team.thugsLeft>> of <<farm_assault_thugs>> rush into the farm. They ignore you, instead heading into the fields.
							<br><br>

							<<farm_assault_attack_options>>
						<<else>>
							You see one of <<farm_assault_thugs>> rush into the farm.
							<br><br>

							<<farm_assault_attack_options>>
						<</if>>
					<</if>>
				<<elseif $_team.state is "dogs">>
					<span class="green">Your <<farm_text_many dog>> emerge from the dark, and set upon <<farm_assault_thugs>>!</span>
					<br><br>
				<<elseif $_team.state is "dogs_recover">>
					<<if $_isBaileyTeam>>
						<<if $_team.thugsLeft gte 2>>
							<<if $alexFarm.assault.fight.dogTeamsLeft gte 2>>
								<<farm_assault_thugs>> seem unperturbed, and meet the hounds head-on. The first <<farm_text dog>> receives a solid kick to the face, and rolls away, whimpering, but the others manage to sink teeth into arms and legs. The thugs shake them free, but are left bloodied. <span class="green">A <<generate1>><<person1>><<person>> limps from the field,</span> too hurt to continue the assault.
								<br><br>
							<<else>>
								<<farm_assault_thugs>> seem unperturbed, and meet the hounds head-on. The first <<farm_text dog>> <span class="red">receives a solid kick to the face,</span> and rolls away, whimpering, but the others manage to sink teeth into arms and legs.
								<br><br>
								The thugs punch and kick at the hounds, <span class="red">scaring them away,</span> but are left bloodied. <span class="green">A <<generate1>><<person1>><<person>> limps from the field,</span> too hurt to continue the assault.
								<br><br>

							<</if>>
						<<else>>
							<<if $alexFarm.assault.fight.dogTeamsLeft gte 2>>
								<<generate1>><<person1>>
								The thug, a <<person>>, startles the hounds by barking back. One growls before lunging, grabbing the <<persons>> forearm between <<his>> teeth. <<He>> shakes the <<farm_text dog>> off, but is in no condition to continue the assault. <span class="green"><<He>> runs from the field,</span> cradling one arm in the other.
								<br><br>
							<<else>>
								<<generate1>><<person1>>
								The thug, a <<person>>, startles the hounds by barking back. One growls before lunging, grabbing the <<persons>> forearm between <<his>> teeth. <span class="red">punches the <<farm_text dog>> in the nose,</span> freeing <<his>> arm, but is in no condition to continue the assault. <span class="green"><<He>> runs from the field,</span> cradling one arm in the other.
								<br><br>
							<</if>>
						<</if>>
					<<else>>
						<<if $_team.thugsLeft gte 2>>
							<<if $alexFarm.assault.fight.dogTeamsLeft gte 2>>
								<<farm_assault_thugs>> panic, <span class="green">and run.</span> The hounds pursue them to the <<farm_fence>>, and howl triumphant into the night.
							<<else>>
								<<farm_assault_thugs>> panic, <span class="green">and run.</span> The hounds pursue a little too eagerly, <span class="red">and chase their quarry into the night,</span> leaving the farm unguarded. They'll be too tired to help when they make it back.
							<</if>>
							<br><br>
						<<else>>
							<<generate1>><<person1>>
							<<if $alexFarm.assault.fight.dogTeamsLeft gte 2>>
								The lone <<person>> panics, <span class="green">and runs.</span> The hounds pursue <<him>> to the <<farm_fence>>, and howl triumphant into the night.
							<<else>>
								The lone <<person>> panics, <span class="green">and runs.</span> The hounds pursue a little too eagerly, <span class="red">and chase their quarry into the night,</span> leaving the farm unguarded. They'll be too tired to help when they make it back.
							<</if>>
							<br><br>
						<</if>>
					<</if>>
					<<endevent>>
					<<if $_isBaileyTeam and $_team.thugsLeft gte 2>> /* Don't show attack options if team was defeated */
						<<farm_assault_attack_options>>
					<</if>>
				<<elseif $_team.state is "field">>
					<<if $_isWraith>>
						You see the <<farm_assault_thugs>> wandering in the field.
						<<if !Memories.IvoryWraith.has("joinedFarmAssault")>>
							They don't look like they're doing anything.
						<<else>>
							<span class="purple">You suspect it's spreading flammable slime.</span>
						<</if>>
					<<else>>
						<<if $_team.fieldProgress gte 4>>
							<span class="pink">You see <<farm_assault_thugs>> lighting matches!</span>
						<<elseif $_team.fieldProgress gte 3>>
							<span class="purple">You see <<farm_assault_thugs>> covering the field in petrol.</span>
						<<elseif $_team.fieldProgress gte 2>>
							<span class="blue">You see <<farm_assault_thugs>> opening petrol canisters.</span>
						<<else>>
							<span class="lblue">You see <<farm_assault_thugs>> prowling through the field.</span>
						<</if>>
					<</if>>
					<br>
					<<farm_assault_attack_options>>
				<</if>>
			<</if>>
		<</for>>

		<br>

		<<farm_assault_options _args[0]>>
	<</if>>
<</widget>>

<<widget "farm_assault_intruders">>
	<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
		<<set _text_output to "intruders">>
	<<else>>
		<<set _text_output to "intruder">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "farm_assault_no">>
	<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
		vicious
	<<else>>
		<<switch _teamIndex>>
		<<case 0>>
			first
		<<case 1>>
			second
		<<case 2>>
			third
		<<case 3>>
			fourth
		<<case 4>>
			fifth
		<</switch>>
	<</if>>
<</widget>>

<<widget "farm_assault_unbind">>
	<<unbind>>
	<<set $alexFarm.assault.fight.pcBindings to 0>>
	<<if $worn.face.type.includes("gag")>>
		<<set $worn.face.type.push("broken")>>
		<<faceruined>>
	<</if>>
	<<clotheson>>
<</widget>>

<<widget "farm_assault_attack_options">>
	<<if $alexFarm.assault.fight.alexTeamIndex is _teamIndex>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
			<<link [[Work with Alex to pick one off (0:05)|Farm Assault Pick Alex]]>><<pass 5>><</link>>
			<br>
			<<if $pain gte 100>>
				<span class="red">You are in too much pain to fight them head on.</span>
			<<else>>
				<<link [[Charge with Alex (0:05)|Farm Assault Charge]]>><<pass 5>><</link>>
			<</if>>
		<<elseif $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 1 and $alexFarm.assault.fight.teams[_teamIndex].location isnot "done" and $alexFarm.assault.fight.teams[_teamIndex].state isnot "dogs_recover">>
			The intruder is alone.
			<br><br>
			<<link [[Overpower|Farm Assault Overpower]]>><</link>>
		<</if>>
	<<elseif $pain gte 100>>
		<span class="red">You're in too much pain to fight them head-on.</span>
	<<else>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
			<<link [[Fight them head-on (0:05)|Farm Assault Intercept Bailey]]>><<pass 5>><</link>>
			<br>
			<<set $skulduggerydifficulty to 1000>>
			<<link [[Pick one off (0:05)|Farm Assault Pick Bailey]]>><<pass 5>><</link>><<skulduggerydifficulty>>
		<<elseif $alexFarm.assault.fight.teams[_teamIndex].type is "wraith">>
			<<set $_them to Memories.IvoryWraith.has("joinedFarmAssault") ? "it" : "them">>
			<<link [["Fight " + $_them + " head on"|Farm Assault Intercept Wraith]]>><</link>>
		<<else>>
			<<link [[Fight them head-on (0:05)|Farm Assault Intercept]]>><<pass 5>><</link>>
			<br>
			<<set $skulduggerydifficulty to 600>>
			<<link [[Pick one off (0:05)|Farm Assault Pick]]>><<pass 5>><</link>><<skulduggerydifficulty>>
		<</if>>
	<</if>>
	<br>
<</widget>>

:: Farm Assault Rocks
<<effects>><<wearProp "rock">>

<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
	<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<if $physiqueSuccess>>
			<<generate1>><<person1>>
			You and Alex pelt the <<farm_assault_intruders>> from the shadows. Most miss, <span class="green">but one lands true</span>, hitting the <<person>> right on the noggin. <<He>> tumbles away from the <<farm_fence>>.
			<br><br>
			<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
		<<else>>
			<<generate1>><<person1>>
			You pelt the <<farm_assault_intruders>> from the shadows. They've chosen a sheltered spot to break in, shielded by earth from most angles, and trees by others. <span class="red">You fail to hit any.</span>
			<br><br>
		<</if>>
	<</if>>
<</for>>

<<link [[Next|Farm Assault]]>><<endevent>><</link>>
<br>

:: Farm Assault Rocks Alex
<<effects>><<wearProp "rock">>

<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
	<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey" and random(1, 2) is 2>>
			<<generate1>><<person1>>
			You and Alex pelt the <<farm_assault_intruders>> from the shadows. They've chosen a sheltered spot to break in, shielded by earth from most angles, and trees by the others. <span class="red">You fail to hit any.</span>
			<br><br>
		<<else>>
			<<generate1>><<person1>>
			You and Alex pelt the <<farm_assault_intruders>> from the shadows. Most miss, <span class="green">but one lands true</span>, hitting the <<person>> right on the noggin. <<He>> tumbles away from the <<farm_fence>>.
			<br><br>
			<<set $alexFarm.assault.fight.teams[_teamIndex].thugsLeft -= 1>>
		<</if>>
	<</if>>
<</for>>

<<link [[Next|Farm Assault]]>><<endevent>><</link>>
<br>

:: Farm Assault Threaten
<<effects>>

You march into the open.
<<if $speech_attitude is "meek">>
	"I-I won't be bullied," you say. "Stop this at once, or you'll be sorry."
<<elseif $speech_attitude is "bratty">>
	"Get the fuck off my property," you say. "Before I feed you to the pigs."
<<else>>
	"If you leave now," you say, "I won't follow."
<</if>>
<br><br>
<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
	<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].type is "bailey">>
			<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
				<<generate1>><<person1>>
				<span class="red">The intruders laugh.</span>
				<<if $fame.scrap gte 400>>
					<span class="pink">"<<underworld_nickname>>,"</span> a <<person>> says. "Very scary. But there's scarier behind us."
				<<else>>
					"Very scary," a <<person>> says. "But there's scarier behind us."
				<</if>>
				They continue forcing their way in.
			<<else>>
				<<generate1>><<person1>>
				<span class="red">The <<person>> laughs.</span>
				<<if $fame.scrap gte 400>>
					<span class="pink">"<<underworld_nickname>>,"</span> <<he>> says. "Very scary. But there's scarier behind me."
				<<else>>
					"Very scary," <<he>> says. "But there's scarier behind me."
				<</if>>
				<<He>> continues forcing their way in.
			<</if>>
		<<elseif $fame.scrap gte random(200, 1000)>>
			<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
				<<generate1>><<person1>><<generate2>>
				The intruders glance at each other.
				<br>
				"Is that the one they call <span class="pink"><<underworld_nickname>></span>?" a <<person>> asks.
				<br>
				"Aye. That's why we're paid so well," a <<person2>><<person>> responds.
				<br>
				"I'm not getting paid to get my shit kicked in. I'm out." <span class="green">They turn and run.</span>

				<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
			<<else>>
				<<generate1>><<person1>>
				The intruder, a <<person>>, stares at you. "I'm just getting paid to clear some fields," <<he>> says. "I don't want no trouble." <span class="green"><<He>> turns and leaves.</span>

				<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
			<</if>>
		<<else>>
			<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
				<<generate1>><<person1>><<generate2>>
				The intruders glance at each other, <span class="red">and laugh.</span> "This <<girl>> thinks <<pshes>> tough or something," a <<person>> says. "About to learn a hard lesson."
				<br><br>
				They continue forcing their way in.
			<<else>>
				<<generate1>><<person1>>
				<span class="red">The intruder laughs.</span> "Who do you think you are?" <<he>> says. "Some <<girl>> is all I see, about to learn a hard lesson." <<He>> continues to enter.
			<</if>>
		<</if>>
	<</if>>
<</for>>
<br><br>

<<link [[Next|Farm Assault]]>><<endevent>><</link>>
<br>


:: Farm Assault Intercept
<<effects>>

<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
	<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 3>>
			<<generate1>><<generate2>><<generate3>>
			You charge Remy's thugs, a <<fullGroup>>. They plant their feet, ready to face you.
			<br><br>
		<<elseif $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
			<<generate1>><<generate2>>
			You charge Remy's thugs, a <<fullGroup>>. They plant their feet, ready to face you.
			<br><br>
		<<else>>
			<<generate1>>
			You charge Remy's thug, a <<person1>><<person>>. <<He>> seems startled by your boldness, but plants <<his>> feet as you approach.
			<br><br>
		<</if>>
	<</if>>
<</for>>

<<link [[Next|Farm Assault Fight]]>><<set $fightstart to 1>><</link>>
<br>


:: Farm Assault Intercept Bailey
<<effects>>

<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
	<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
		<<if $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 3>>
			<<generate1>><<generate2>><<generate3>>
			You charge Bailey's thugs, a <<fullGroup>>. They turn to meet you. The <<person1>><<person>> cracks <<his>> knuckles.
			<br><br>
		<<elseif $alexFarm.assault.fight.teams[_teamIndex].thugsLeft gte 2>>
			<<generate1>><<generate2>>
			You charge Bailey's thugs, a <<fullGroup>>. They turn to meet you. The <<person1>><<person>> cracks <<his>> knuckles.
			<br><br>
		<<else>>
			<<generate1>>
			You charge Bailey's thug, a <<person1>><<person>>. <<He>> turns to meet you, and cracks <<his>> knuckles.
			<br><br>
		<</if>>
	<</if>>
<</for>>

<<link [[Next|Farm Assault Fight Bailey]]>><<set $fightstart to 1>><</link>>
<br>




:: Farm Assault Fight
<<if $fightstart is 1>>
	<<set $fightstart to 0>>
	<<neutral 1>>
	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
<</if>>

<<effects>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[Next|Farm Assault Fight Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Farm Assault Fight]]>><</link>></span><<nexttext>>
<</if>>

:: Farm Assault Fight Finish
<<effects>>
<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	<<if $enemynomax gte 2>>
		Remy's thugs are too dazed and exhausted to continue, <span class="green">and stagger from the field.</span>
	<<else>>
		The <<person1>><<person>> is too dazed and exhausted to continue, <span class="green">and staggers from the field.</span>
	<</if>>
	<br><br>
	<<tearful>> you plan your next move.
	<br><br>
	<<clotheson>>
	<<endcombat>>
	<<link [[Next|Farm Assault]]>><</link>>
	<br>
	<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
		<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
		<</if>>
	<</for>>
<<elseif $enemyhealth lte 0>>
	<<if $enemynomax gte 2>>
		<span class="green">Remy's thugs flee the field,</span> throwing worried glances over their shoulders to make sure you're not pursuing.
	<<else>>
		<span class="green">The <<person1>><<person>> flees the field,</span> throwing worried glances over <<his>> shoulder to make sure you're not pursing.
	<</if>>
	<br><br>
	<<tearful>> you plan your next move.
	<br><br>
	<<clotheson>>
	<<endcombat>>
	<<link [[Next|Farm Assault]]>><</link>>
	<br>
	<<for _teamIndex to 0; _teamIndex lt $alexFarm.assault.fight.teams.length; _teamIndex++>>
		<<if $bus is $alexFarm.assault.fight.teams[_teamIndex].location>>
			<<set $alexFarm.assault.fight.teams[_teamIndex].location to "done">>
		<</if>>
	<</for>>

<<else>>
	You fall to the earth, too hurt to continue fighting.
	<br><br>
	The <<person1>><<person>> crouches over you, <span class="purple">and gropes your <<breasts>></span>. "Shame I got a job to do," <<he>> says.
	<br><br>
	You can't stop <<him>> binding your arms and legs together, and tying a gag around your mouth. "Later, <<girl>>."
	<br><br>
	<<tearful>> you struggle against the rope. It was a rough job, and you should be able to work free.
	<br><br>
	<<endcombat>>
	<<set $alexFarm.assault.fight.pcBindings to 3>>
	<<bind>>
	<<facewear "bit gag">>
	<<link [[Next|Farm Assault]]>><</link>>
	<br>

<</if>>

:: Farm Assault Fight Bailey
<<if $fightstart is 1>>
	<<set $fightstart to 0>>
	<<neutral 1>>
	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
	<<set $enemyhealthmax *= 1.3>>
	<<set $enemyhealth *= 1.3>>
	<<set $enemyarousalmax *= 1.3>>
<</if>>

<<effects>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[Next|Farm Assault Fight Bailey Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Farm Assault Fight Bailey]]>><</link>></span><<nexttext>>
<</if>>

:: Farm Assault Fight Bailey Finish
<<effects>>
<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	"You'll go far," the <<person1>><<person>> mutters.
	<<if $enemynomax gte 2>>
		Bailey's thugs are too dazed and exhausted to continue, <span class="green">and stagger from the field.</span>
	<<else>>
		<<Hes>> too dazed and exhausted to continue, <span class="green">and staggers from the field.</span>
