<<widget "shopDefaultOptions">><<nobr>>


<br>
<<set _colorOptions to ["black", "blue", "brown", "green", "pink", "purple", "red", "tangerine", "white", "yellow"]>>
<<set _secondaryColorOptions to ["black", "blue", "brown", "green", "pink", "purple", "red", "tangerine", "white", "yellow"]>>

Primary Colour:
<br>
<<for _i to 0; _i lt _colorOptions.length; _i++>>
	<label><<print '<span class="'+ _colorOptions[_i] +'">' + _colorOptions[_i] + '</span>'>>
	<<print '<<radiobutton "$shopDefaults.color" "'+ _colorOptions[_i] +'" ' + ($shopDefaults.color is _colorOptions[_i] ? "checked" : "") + '>>'>></label>
	 |
<</for>>
<br>
Secondary Colour:
<br>
<<for _i to 0; _i lt _secondaryColorOptions.length; _i++>>
	<label><<print '<span class="'+ _colorOptions[_i] +'">' + _secondaryColorOptions[_i] + '</span>'>>
	<<print '<<radiobutton "$shopDefaults.secColor" "'+ _secondaryColorOptions[_i] +'" ' + ($shopDefaults.secColor is _secondaryColorOptions[_i] ? "checked" : "") + '>>'>></label>
	 |
<</for>>
<br><br>
<label><<print '<<checkbox "$shopDefaults.disableReturn" false true '+($shopDefaults.disableReturn is true? "checked" : "")+'>>'>> Make it easier to send multiple of the same item home.</label>

<</nobr>><</widget>>

<<widget "shopDefaultOptionsToggle">><<nobr>>
<<toggleclass #shopDefault "hidden">>
<</nobr>><</widget>>



<<widget "randomclothing">><<nobr>>/* set $rctype $rcid to point to random $clothes.type.id */
<<set _ctypes to Object.keys($clothes)>>
<<set _rtype to random(0,_ctypes.length-1)>>/* oh right, twines random gives whole numbers and can actually roll the max */
<<set $rctype to _ctypes[_rtype]>>
<<set _cids to Object.keys($clothes[$rctype])>>
<<set $rcid to random(0,_cids.length-1)>>
<<if $clothes[$rctype][$rcid].one_piece is 1>>/* find and switch to upper part of the set(as a result makes one pieces slightly more likely) */
	<<if $rctype is "lower" or $rctype is "under_lower">>/* sets can be under + nonunder type */
		<<for _upid to 0; _upid lt $clothes.upper.length; _upid++>>
			<<if $clothes.upper[_upid].set is $clothes[$rctype][$rcid].set>>
				<<set $rctype to "upper">>
				<<set $rcid to _upid>>
			<</if>>
		<</for>>
		<<for _upid to 0; _upid lt $clothes.under_upper.length; _upid++>>
			<<if $clothes.under_upper[_upid].set is $clothes[$rctype][$rcid].set>>
				<<set $rctype to "under_upper">>
				<<set $rcid to _upid>>
			<</if>>
		<</for>>
	<</if>>
<</if>>
<</nobr>><</widget>>

<<widget "postLinkText">><<nobr>>/* wants clothing type and clothing id as $args 0 and 1 */
/* info that comes after the clothing selection link in a shop */
<<set _cloth to $clothes[$args[0]][$args[1]]>>
| <span class="teal"><<price $args[0] $args[1]>>.</span>
<<if $discounts.includes($args[0]+"|"+$args[1])>>
	<span class="gold"><<showdiscount $args[0] $args[1] "-" "">></span>
<</if>>
<<if _cloth.gender is "m">>
	 | <span class="blue">♂</span>
<<elseif _cloth.gender is "f">>
	 | <span class="pink">♀</span>
<<else>>
<</if>>
<<integrity _cloth.integrity>>
<<reveal _cloth.reveal>>
<<if _cloth.type.length gte 1>>
 _cloth.type 
<</if>> |
<</nobr>><</widget>>

<<widget "price">><<nobr>>
<<set _price to 0.00>>
<<if $discounts.includes($args[0]+"|"+$args[1])>>
	<<for _c to 0;_c lt $discounts.length; _c++>>
		<<if $args[0]+"|"+$args[1] is $discounts[_c]>>
			<<set _price to $clothes[$args[0]][$args[1]].cost*(1-($discountamounts[_c]/100))>>
		<</if>>
	<</for>>
<<else>>
	<<set _price to $clothes[$args[0]][$args[1]].cost>>
<</if>>
<<set _price to _price*$pricemult / 100>>
£<<print Math.round(_price)>>
<</nobr>><</widget>>

<<widget "getdiscount">><<nobr>>
<<if $discounts.includes($args[0]+"|"+$args[1])>>
	<<for _c to 0;_c lt $discounts.length; _c++>>
		<<if $args[0]+"|"+$args[1] is $discounts[_c]>>
			<<set $discount to clone(1-($discountamounts[_c]/100))>>
		<</if>>
	<</for>>
<<else>>
<<set $dicount to 1>>
<</if>>
<</nobr>><</widget>>

<<widget "setdiscountplan">><<nobr>>
/* set discount plan for the next day(next instead of current so that there can be stuff hinting at discounts of the next day) */
/* maybe something like if a shop assistant likes you and you're about to buy something that would be discounted tomorrow they give you a reduced discount on it. */
<<set $discountplan to []>>/* lists discounted clothes in the format type|id */
<<set $discountamountsplan to []>>/* lists just discount numbers(not having them part of $discountplan made it easier to do something related to checking if clothing was discounted.) */
<<for _i to 0;_i lt $args[0]; _i++>>
	<<randomclothing>>
	<<if $clothes[$rctype][$rcid].shop.includes("clothing") and !$discountplan.includes($rctype+"|"+$rcid)>>/* being sold and not already discounted*/
		/*<<set $discountplan[_i] to [$rctype, $rcid]>>*//* .includes doesn't seem to like arrays in some situations so making this a string */
		<<set $discountplan[_i] to $rctype+"|"+$rcid>>
	<<else>>
		<<set _i-->>
	<</if>>
<</for>>

<<for _i to 0;_i lt $discountplan.length; _i++>>
	<<set _discountam to either(10,10,20,25,50)>>
	<<set $discountamountsplan[_i] to _discountam>>
<</for>>

<</nobr>><</widget>>

<<widget "showdiscount">><<nobr>>/* -99% surrounded by $args[2] and $args[3] */
<<for _d to 0;_d lt $discounts.length; _d++>>
	<<if $args[0]+"|"+$args[1] is $discounts[_d]>>
		<<print $args[2]+$discountamounts[_d]+"%"+$args[3]>>
	<</if>>
<</for>>
<</nobr>><</widget>>

<<widget "offers">><<nobr>>/* list all current discounts */
/* not used atm. could try to sort based on discount here or set discounts in orderly fashion */

	<<set $clothes_choice to -1>>
<<for _c to 0;_c lt $discounts.length; _c++>>
	<<set _var to $discounts[_c].split("|")>>
	<<set _ciArg to $clothes[_var[0]][_var[1]]>>
	<<clothingicon _ciArg>>
	/* figure out the passage name a link should link to */
	<<set _n to jsCapitalize(_var[0])+" Shop">>
	<<if $clothes[_var[0]][_var[1]].one_piece is 1>>
		<<set _n to "Outfit Shop">>
		<<if _var[0] is "under_upper">>
			<<set _n to "Under Outfit Shop">>
		<</if>>
	<<elseif _var[0] is "under_upper">>
		<<set _n to "Under Upper Shop">>
	<<elseif _var[0] is "under_lower">>
		<<set _n to "Under Lower Shop">>
	<</if>>
	/* pluralize clothing name */
	<<if $clothes[_var[0]][_var[1]].plural is 1>>
		<<set _nam to $clothes[_var[0]][_var[1]].name>>
	<<else>>
		<<set _nam to jsPlNoun($clothes[_var[0]][_var[1]].name, 2)>>
	<</if>>
	/* make a link  */
	<<set _integmax to $clothes[_var[0]][_var[1]].integrity_max>>
	<<set _rev to $clothes[_var[0]][_var[1]].reveal>>
	<<print '<<link [['+_nam+'|'+_n+']]>><<set $clothes_choice to '+_var[1]+'>><<set $clothes_choice_reveal to '+_rev+'>><<set $clothes_choice_integrity to '+_integmax+'>><</link>>'>>
	/**/
	are
	<span class="gold">
	<<print $discountamounts[_c]>>% 
	</span>
	off!
	/* postLinkText stuff looks too messy here */
	/*	
	<<if $clothes[_var[0]][_var[1]].gender is "m">>
		 | <span class="blue">♂</span>
	<<elseif $clothes[_var[0]][_var[1]].gender is "f">>
		 | <span class="pink">♀</span>
	<<else>> | <</if>>
	<<integrity _integmax>>
	<<reveal _rev>>
