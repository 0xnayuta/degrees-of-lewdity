:: Park Pumpkin Competition
<<effects>><<set _kylarLocation to getKylarLocation()>>


<<if !$halloween_pumpkin>>
	You approach the pumpkin carving tables, all set up for the annual competition.
	<br><br>
	<<set $halloween_pumpkin to 1>>
	<<set $halloween_pumpkins_bought to 0>>
	<<set $pumpkin_carving to 0>>
	<<set $pumpkin_carving_knowledge to []>>
<</if>>

<<generate1>><<person1>><<generate2>>
<<if C.npc.Kylar.state isnot "prison" and $halloween_pumpkin_kylar>>
