:: Widgets Petlife [widget]


<<widget "parktrio">><<nobr>>
<<if $trio.intro is 0>>
You see a group of 
<<if $trio.gender is "m">>boys<<elseif $trio.gender is "f">>girls<<else>>teens<</if>>
hanging around and laughing happily.
<br>
<<link [[Approach them|Park trio]]>><</link>>
<br><br>
<<elseif>>
<<else>>
  <<if $pet>>
    Your see your 
      <<if _guests>>
        <<owners>> along with some others.
      <<else>>
        <<owners>>.
      <</if>>
    <<link [[Approach|Trio pet greet]]>><</link>>
  <</if>>
<</if>>

<</nobr>><</widget>>


<<widget "trio">><<nobr>>
<<set _text_output to "trio of boys">>
<<set _text_output to "trio of girls">>
<<print _text_output>>
<</nobr>><</widget>>

<<widget "owners">><<nobr>>
<<set _text_output to "friends">>
<<set _text_output to "caretakers">>
<<set _text_output to "keepers">>
<<set _text_output to "masters">>
<<set _text_output to "mistresses">>
<<set _text_output to "owners">>
<<print _text_output>>
<</nobr>><</widget>>

<<widget "oneowner">><<nobr>><!-- Probably unnecessary, can't think of when something like "one of your <<owners>>" wouldn't be good enough -->
<<set _text_output to "boy">>
<<set _text_output to "girl">>
<<set _text_output to "friend">>
<<set _text_output to "caretaker">>
<<set _text_output to "keeper">>
<<set _text_output to "master">>
<<set _text_output to "mistress">>
<<set _text_output to "owner">>
<<print _text_output>>
<</nobr>><</widget>>

<<widget "asd">><<nobr>>
<</nobr>><</widget>>

