:: Pet Training Intro

<!-- How should I track how many times a specific training has been attempted? -->
<<set _attempt to $pettraining[_currenttraining]>>

<<if ($petobedience gte 200 and _attempt is 0) or ($petobedience lt 200 and _attempt is -1)>>
	Gentle intro
<<elseif ($petobedience lt 200 and _attempt is 0) or ($petobedience gte 200 and _attempt is -1)>>
	Strict intro
<<\if>>


<<if ($petobedience gte 200 and _attempt is 0) or ($petobedience lte -200 and _attempt is -2)>>
	Gentle intro
<<elseif ($petobedience gte 100 and _attempt is 0) or ($petobedience lte -100 and _attempt is -1)>>
	Slightly gentle intro
<<elseif ($petobedience lte -100 and _attempt is 0) or ($petobedience gte 100 and _attempt is -1)>>
	Slightly strict intro
<<elseif ($petobedience lte -200 and _attempt is 0) or ($petobedience gte 200 and _attempt is -2)>>
	Strict intro
<<\if>>









<<if _refuse>>
	<<switch $pettraining[$petevent]>>
	<<case 0>>
		<<set $peteventbag.push($petevent)>>
		<<link [[Next|Pet Training End]]>><</link>>
	<<case -1>>
		<<set $peteventbag.push($petevent)>>
		<<link [[Next|Pet Training End]]>><</link>>
	<<case -2>>
		<<if ["walk","collar","tailwag"].includes($petevent)>>
			<<set $peteventbag.push($petevent)>>
		<<else>>
			"This isn't working out, should we give up on getting <<pet_he>> to _doCurrentTraining?"
			<br>
			<<link [[Encourage/Whine|Pet Training End]]>><<set $peteventbag.push($petevent)>><</link>>
			<br>
			<<link [[Do nothing/Just leave|Pet Training End]]>><</link>>
		<</if>>
	<<case -3>>
		<<link [[Next|Pet Training End]]>><</link>>
	<<default>>
		<<link [[Next|Pet Training End]]>><</link>>
	<</switch>>
<<else>>
	<<if $pettraining[_currenttraining] lt 0>>
		<<set $pettraining[_currenttraining] to 0>>
	<</if>>
	<<set $pettraining[_currenttraining]++>>

<</if>>


