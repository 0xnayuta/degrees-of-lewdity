:: Bus Flashing Widgets [widget]
<<widget "busflasharousal">><<nobr>>

<<if ($worn.under_lower.exposed and $uncomfortable.nude is true) or (!$worn.under_lower.exposed and $uncomfortable.underwear is true)>>
	It feels extremely embarrassing letting strangers see your <<undies>> in public like this, but despite the feeling of <<print ["embarrassment", "humiliation", "vulnerability", "exposure"].pluck()>> you crave more.
<<else>>
	Letting so many strangers see your <<undies>> in public like this feels <<print ["exciting", "exhillerating", "naughty", "thrilling", "lewd"].pluck()>> and your body quivers with <<print ["excitement", "exhilleration", "thoughts of lewd things", "the thrill of exposure", "lewd sensations"].pluck()>><<if $assertiveaction is "trauma">>, <<print ["what a naughty <<girl>> you are!", "how naughty of you!", "this is super naughty!", "what a bad <<girl>> you are!", "you really should be punished for behaving like this.", "you're totally not supposed to be doing this.", "you can hardly believe you're doing this.", "you can hardly believe you're doing something so naughty in public.", "you can hardly believe how risky this is.", "the risk only makes it more fun.", "you feel daring even attempting something as brazen as this in public."].pluck()>><<trauma -2>><<ltrauma>> <<else>>. <</if>>
<</if>>

<<switch $phase>>
	<<case 0>> <<arousal 0>>
	<<case 1>> <<arousal 100>>
	<<case 2>> <<arousal 200>>
	<<case 3>> <<arousal 300>>
	<<case 4>> <<arousal 100>>
<</switch>>

<<if $phase isnot 4>>
	<<if $worn.under_lower.exposed>>
		<<exhibitionism4>>
	<<else>>
		<<exhibitionism3>>
	<</if>>
<<else>>
	<br><br>
<</if>>
<</nobr>><</widget>>