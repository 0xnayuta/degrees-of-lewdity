<<else>>
	<<set $gamerskill[$logprep] += 0.5>>
<</if>>
<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+", a "+$person+" joined in and quietly played as the second player.">>
<<log $logprep 2>>
<<endevent "ArcE1">>
<<arcadeoptions>>

