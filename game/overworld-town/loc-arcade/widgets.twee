:: Widgets Arcade [widget]
<<widget "passoutarcade">><<nobr>>
[[Everything fades to black...|Passout Arcade]]
<</nobr>><</widget>>


<<widget "arcadeoptions">><<nobr>>
	<<if $money gte 500 and $daystate isnot "night">>
		<<link [[Keep playing (£5 0:20)|Arcade Play]]>><<set $money -= 500>><<pass 20>><<stress -2>><</link>><<lstress>>
		<br>
	<</if>>
	<<link [[Stop|Arcade]]>><</link>>
	<br>
<</nobr>><</widget>>


<<widget "arcadeevent">><<nobr>>
<<switch $args[0]>>
 	<<case "shooter">>
		<<if $rng gte 10>>
			<<generatey1>><<person1>>
			A <<person>> walks beside you. <<He>> enables the second player, and starts shooting. <<He>> doesn't say anything.
			<br><br>

			<<link [[Keep playing|Arcade Keep Playing]]>><</link>>
			<br>
			<<link [[Shove and dual wield|Arcade Shove]]>><<set $submissive -= 1>><<trauma -2>><</link>><<ltrauma>>
			<br>
			<<set $skulduggerydifficulty to 400>>
			<<link [[Steal|Arcade Steal]]>><<crimeup 30>><</link>><<skulduggerydifficulty>><<gcrime>>
			<<info "theft" "arcade|gamer" $skulduggerydifficulty "chance">>
			<br>
			<<link [[Stop|Arcade]]>><<endevent "ArcE1" 0>><</link>>
			<br>
		<<elseif $rng gte 2>>
			<<arcadewatchedplay>>
		<<elseif $rng gte 0 and !$worn.lower.includes("naked")>>
			<<generatey1>><<person1>>A <<person>> sneaks behind you and pulls <<if $worn.lower.skirt>>up<<else>>down<</if>> your $worn.lower.name.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<<else>>
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "fighting">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			<<generatey1>><<person1>>A <<person>> challenges you to a match.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "beat-em-up">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			<<generatey1>><<person1>>A <<person>> sits down next to you and enables the second player.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "dancing">>
		<<if $rng gte 1>>
			<<set $eventstr to "ArcE3">>
			<<generatey1>><<person1>>A <<person>> stands behind you, and watches. <<He>> doesn't say anything and just smiles when you glance back at <<himstop>>
			<br><br>
			<<if $worn.lower.skirt is 1>>
				He crouches down and you realize <<he>> will see under your skirt if you keep playing.
				<<if $exhibitionism gte 15 and !$worn.under_lower.type.includes("naked") or $exhibitionism gte 35 and $worn.under_lower.type.includes("naked")>>
					<<link [[Keep playing|Arcade Watched Dance]]>><<set $phase to 1>><</link>><<exhibitionist1>>
					<br>
				<<elseif $exhibitionism gte 35>>
					<<link [[Show off|Arcade Watched Dance]]>><<set $phase to 2>><</link>><<exhibitionist3>>
					<br>
				<</if>>
				<<link [[Stop|Arcade Watched Stop]]>><<stress 6>><</link>><<gstress>>
				<br>
			<<else>>
				<<link [[Keep playing|Arcade Watched Dance]]>><</link>>
				<br>
				<<link [[Show off|Arcade Watched Dance]]>><<set $phase to 2>><</link>>
				<br>
				<<link [[Stop|Arcade Watched Stop]]>><<stress 6>><</link>><<gstress>>
				<br>
			<</if>>
		<<else>>
			You slip and fall clumsily on your bottom.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "rhythm">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			In your excitement you fail to notice...
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "racing">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			As soon as you sit down and put your hands on the wheel you realize someone put glue on it.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "pinball">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			Someone bumps into you from behind.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
 	<<case "shmup">>
		<<if $rng gte 1>>
			<<arcadewatchedplay>>
		<<else>>
			<<generatey1>><<person1>>A <<person>> stands beside you, and starts mocking your skills and predicts you'll lose miserably at the next boss.
			<<set $logprep to "I played a "+$logprep+" game at the arcade"+$logprep2+".">>
			<<log $logprep 1>>
			<br><br>
			<<arcadeoptions>>
		<</if>>
<</switch>>
<</nobr>><</widget>>

<<widget "arcadewatchedplay">><<nobr>>
<<set $eventstr to "ArcE2">>
<<generate1>><<person1>>A <<person>> stands beside you, and watches. <<He>> offers tips of dubious wisdom.
<br><br>
<<Hes>> standing very close.
<br><br>
<<if $promiscuity gte 15>>
	<<link [[Lean closer|Arcade Watched Lean]]>><</link>><<promiscuous2>>
	<br>
<</if>>
<<link [[Stop|Arcade Watched Stop]]>><<stress 6>><</link>><<gstress>>
<br>
<<link [[Keep playing|Arcade Watched Play]]>><</link>>
<br>
<</nobr>><</widget>>