:: Widgets Fishing Wraith [widget]
<<widget "fishingTownWraithHuntStep">>
	<<if $ivoryWraith.hunt.progress>>
		<<if $moonstate is "morning" and Time.hour gte 6 and Time.hour lte 20>>
			With the rising of the sun, you feel a sense of relief. The dread passes. <span class="blue"><i>You're safe until the next blood moon.</i></span>
			<<clearWraith>>
		<<elseif $ivoryWraith.state is "haunt">>
			<span class="red">Something terrible is hunting you.</span>
			<<set $ivoryWraith.hunt.progress += (0.5 + (C.npc["Ivory Wraith"].lust / 40))>>
		<<else>>
			<span class="red">You feel that something terrible is nearby.</span>
			<<set $ivoryWraith.hunt.progress += (0.5 + (C.npc["Ivory Wraith"].lust / 40))>>
		<</if>>
	<<else>>
		<<wTimerProgress>>
	<</if>>
<</widget>>
