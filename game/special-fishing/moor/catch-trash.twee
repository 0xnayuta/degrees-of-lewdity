:: Fishing Moor Trash Catch
<<effects>>
<<if $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorCatchTrashFox>>
<<elseif ["sit", "campfire"].includes($daily.fishing.fishingMoor.hikers.phase)>>
	<<fishingMoorCatchTrashHikers>>
<<else>>
	<<fishingMoorCatchTrash>>
<</if>>


:: Widgets Fishing Moor Trash Catch [widget]
<<widget "fishingMoorCatchTrashFox">>
	<<loadNPC 0 "moor_fishing_fox">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<switch random(1, 3)>>
		<<case 1>>
			The <<beasttype>> perks up as you pull your line up, then deflates at the sight of the junk.
		<<case 2>>
			The <<beasttype>>'s ears prick up hopefully, but <<bhe>> huffs and settles back down when no fish appears.
		<<case 3>>
			The <<beasttype>> cranes <<bhis>> neck to sniff at what you've hauled up, then gives you a flat, disappointed look.
	<</switch>>
	<br><br>

	<<link [[Next|Fishing Moor Wait]]>><<endevent>><</link>>
<</widget>>


<<widget "fishingMoorCatchTrashHikers">>
	<<fishingTrashCatchText $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<if setup.fishing.lootTables.fishingTrash[$fishingTrash].isLitter and $rng lt 50>>
		<<switch random(1, 2)>>
			<<case 1>>
				One of the hikers watches you swing it in. "More rubbish than fish out here, eh?"
			<<case 2>>
				"People'll dump anything out here," one of the hikers says, shaking their head. "No respect for the place."
		<</switch>>
		<br><br>
	<</if>>
	<<unset $fishingTrash>>

	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>

<<widget "fishingMoorCatchTrash">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>
