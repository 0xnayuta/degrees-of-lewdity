:: Fishing Moor Catch
<<effects>>
<<if ["sit", "campfire"].includes($daily.fishing.fishingMoor.hikers.phase)>>
	<<fishingMoorCaughtHikers>>
<<elseif $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorCaughtFox>>
<<else>>
	<<fishingMoorCaught>>
<</if>>


:: Widgets Fishing Moor Catch [widget]
<<widget "fishingMoorCaught">>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<run updateFishRecord($fishingHookedFish.type, $fishingHookedFish.size, $bus)>>
	<<run stopFishingProp()>>
	<<set _fishPropName to "caught-" + $fishingHookedFish.type>>
	<<wearProp _fishPropName>>

	<<fishingCatchFishText $fishingHookedFish>>
	<br><br>

	<<if _canEatFish>>
		It's such a small fish, you could probably fit the whole thing in your mouth.
		<br><br>
	<</if>>

	<<link [["Stow the " + $fishingHookedFish.type + " away"|Fishing Moor Wait]]>><<tending_give $fishingHookedFish.type 1>><<set $fishingAmbientOverride to "stowAway">><</link>>
	<br>
	<<link [[Throw it back|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "throwBack">><</link>>
	<<if _canEatFish>>
		<br>
		<<link [[Eat the fish|Fishing Moor Cat Eat]]>><</link>><<cat>>
	<</if>>
<</widget>>

<<widget "fishingMoorLineSnapped">>
	Your line goes taut, then <span class="red">snaps.</span> The <<print $fishingHookedFish.type>> is gone.
	<<run stopFishingProp()>>
	<<unset $fishingHookedFish>>
	<br><br>

	<<link [[Re-hook the line and cast back out (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<pass 3>><</link>>
	<br>
	<<link [[Leave|Moor]]>><<set $eventskip to 1>><</link>>
<</widget>>
