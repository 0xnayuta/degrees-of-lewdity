:: Fishing Moor Trash Catch
<<effects>>
<<if $daily.fishing.moor.fox.phase is "watching">>
	<<fishingMoorTrashCaughtFox>>
<<elseif ["sit", "campfire"].includes($daily.fishing.moor.hikers.phase)>>
	<<fishingMoorTrashCaughtHikers>>
<<else>>
	<<fishingMoorTrashCaught>>
<</if>>


:: Widgets Fishing Moor Trash Catch [widget]
<<widget "fishingMoorTrashCaught">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>

<<widget "fishingMoorTrashCaughtHikers">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<if $rng lt 50>>
		<<switch random(1, 2)>>
			<<case 1>>
				One of the hikers watches you swing it in. "More rubbish than fish out here, eh?"
			<<case 2>>
				"People'll dump anything out here," one of the hikers says, shaking their head. "No respect for the place."
		<</switch>>
		<br><br>
	<</if>>

	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>

<<widget "fishingMoorTrashCaughtFox">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<fishingMoorFoxTrashReaction>>
	<br><br>

	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>
