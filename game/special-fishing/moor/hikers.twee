:: Fishing Moor Hiker Exposed Molestation Finish
<<effects>>
<<set $fishing.fishingMoor.event to "none">>
<<set $fishing.fishingMoor.eventDanger to 0>>
<<set $daily.fishing.fishingMoor.hikers.phase to "finished">>

<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	The <<group>> pull back, breathing hard. They exchange a look, then gather their things and disappear into the heather without a word.
	<br><br>

	<<tearful>> you get to your feet.
	<br><br>

	<<clotheson>>
	<<endcombat>>
	<<clearNPC "moor_hiker_1">>
	<<clearNPC "moor_hiker_2">>

	<<link [[Return to fishing|Fishing Moor Wait]]>><</link>>
	<br>
	<<link [[Leave|Moor]]>><<set $eventskip to 1>><</link>>
<<elseif $alarm is 1 and $rescue is 1>>
	The <<group>> begin to curse as a <<hawkScreechDesc>> pierces the air. <<hawkRescueApproachSentence>>
	<br><br>

	The <<group>>, panicked, scatter in different directions, disappearing into the moor.
	<br><br>

	<<clotheson>>
	<<endcombat>>
	<<npc "Great Hawk">><<person1>>
	<<tearful>> you search the heavens for <<if $syndromebird is 1>>your <<if $monster is 1>><<nnpc_wife "Great Hawk">><<else>>partner<</if>><<else>>whatever your assailant saw<</if>>. You quickly find what you're looking for, seeing <<if $syndromebird is 1>>your<<else>>a<</if>> <<beasttype>> flying towards you as fast as <<bhis>> wings can carry <<bhim>>.
	<br><br>

	<<clearNPC "moor_hiker_1">>
	<<clearNPC "moor_hiker_2">>

	<<if $syndromebird is 1>>
		<<link [[Next|Bird Rescue Syndrome]]>><</link>>
	<<else>>
		<<link [[Next|Bird Rescue No Syndrome]]>><</link>>
	<</if>>
	<br>
<<elseif $enemyhealth lte 0>>
	You manage to drive them back. They scatter into the heather without another word.
	<br><br>

	<<tearful>> you catch your breath, watching the heather settle.
	<br><br>

	<<clotheson>>
	<<endcombat>>
	<<clearNPC "moor_hiker_1">>
	<<clearNPC "moor_hiker_2">>

	<<link [[Return to fishing|Fishing Moor Wait]]>><</link>>
	<br>
	<<link [[Leave|Moor]]>><<set $eventskip to 1>><</link>>
<</if>>

:: Widgets Fishing Moor Event Hikers [widget]
/* Text that can appear while waiting if hikers will approach soon */
<<widget "fishingMoorHikersAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"You hear muffled voices in the distance, carrying across the wetland.",
			"You hear footsteps crunching on the heather and wet grass."
		)>>
		<<set $fishing.fishingMoor.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>

<<widget "fishingMoorHikerSitAmbient">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>

	<<cleareventpool>>
	<<addinlineevent 10>>
		The hikers talk quietly between themselves.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> chuckles at something <<his>> companion says.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The hikers watch your <<fishingBob>> for a moment, interested, then resume talking.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> points at something across the moor to <<his>> companion, but they can't seem to agree what it is.
	<</addinlineevent>>
	<<if $daily.fishing.fishingMoor.hikers.spike and $daily.fishing.fishingMoor.hikers.drinkCount gte 1>>
		<<addinlineevent 0.5>>
			The <<person1>><<personsimple>> glances your way. <<His>> eyes settle on your can for a moment before <<he>> looks back at the water.
		<</addinlineevent>>
	<</if>>

	<<if $exposed gte 1>>
		<<set $daily.fishing.fishingMoor.hikersOgle ??= 1>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 1>>
			The <<person1>><<person>>'s gaze drifts toward your <<lewdness>> before <<he>> looks back to <<his>> companion.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 1>>
			The <<person2>><<person>> glances at your <<lewdness>> with a long, slow look before turning back to <<his>> companion.
		<</addinlineevent>>
	<</if>>
	<<if $exposed gte 2>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 2>>
			The <<person1>><<personsimple>> stares openly at your <<lewdness>>, not bothering to look away when you catch <<him>> looking.
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
	<<endevent>>
<</widget>>

<<widget "fishingMoorHikerCampfireAmbient">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>

	<<cleareventpool>>
	<<addinlineevent 10>>
		The hikers talk over the crackle of the fire.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> laughs at something, and the <<person2>><<person>> shakes <<his>> head, grinning.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<personsimple>> licks <<his>> fingers and leans back, staring up at the sky.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The hikers take long sips from their cans and watch the fire settle.
	<</addinlineevent>>

	<<if $exposed gte 1>>
		<<set $daily.fishing.fishingMoor.hikersOgle ??= 1>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 1>>
			The <<person1>><<person>>'s gaze drifts toward you across the fire before <<he>> quickly looks back to <<his>> companion.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 1>>
			The <<person2>><<personsimple>> glances over at you with a long, slow look before turning back to the fire.
		<</addinlineevent>>
	<</if>>
	<<if $exposed gte 2>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 2>>
			The <<person1>><<personsimple>> stares openly at you across the fire, not bothering to look away when you catch <<him>> looking.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.fishingMoor.hikersOgle>>
			<<set $daily.fishing.fishingMoor.hikersOgle += 2>>
			The hikers exchange a look across the fire, and the <<person1>><<personsimple>> lets out a low whistle.
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
	<<endevent>>
<</widget>>

<<widget "fishingMoorHikerDrinkSip">>
	<<set $daily.fishing.fishingMoor.hikers.drinkCount -= 1>>
	<<if $daily.fishing.fishingMoor.hikers.drinkCount is 9>>
		You take a sip from the can, you can taste the alcohol. <<alcohol 17>>
	<<elseif $daily.fishing.fishingMoor.hikers.drinkCount lte 0>>
		You tip the can back and drain the last of it. <<alcohol 17>>
	<<elseif $daily.fishing.fishingMoor.hikers.drinkCount lte 9>>
		You take a sip from the can. <<alcohol 17>>
	<</if>>
<</widget>>
