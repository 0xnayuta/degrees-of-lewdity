:: Widgets Fishing Moor Event Hikers [widget]
/* Text that can appear while waiting if hikers will approach soon */
<<widget "fishingMoorHikersAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"You hear muffled voices in the distance, carrying across the wetland.",
			"You hear footsteps crunching on the heather and wet grass."
		)>>
		<<set $fishing.moor.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>

<<widget "fishingMoorHikerSitAmbient">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>

	<<cleareventpool>>
	<<addinlineevent 10>>
		The hikers talk quietly between themselves.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> chuckles at something <<his>> companion says.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The hikers watch your float for a moment, interested, then resume talking.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> points at something across the moor to <<his>> companion, but they can't seem to agree what it is.
	<</addinlineevent>>
	<<if $daily.fishing.moor.hikers.spike and $daily.fishing.moor.hikers.drinkCount gte 1>>
		<<addinlineevent 0.5>>
			The <<person1>><<person>> glances your way. <<His>> eyes settle on your can for a moment before <<he>> looks back at the water.
		<</addinlineevent>>
	<</if>>

	<<if $exposed gte 1>>
		<<set $daily.fishing.moor.hikersOgle ??= 1>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 1>>
			The <<person1>><<person>>'s gaze drifts toward your <<lewdness>> before <<he>> looks back to <<his>> companion.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 1>>
			The <<person2>><<person>> glances at your <<lewdness>> with a long, slow look before turning back to <<his>> companion.
		<</addinlineevent>>
	<</if>>
	<<if $exposed gte 2>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 2>>
			The <<person1>><<person>> stares openly at your <<lewdness>>, not bothering to look away when you catch <<him>> looking.
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "fishingMoorHikerCampfireAmbient">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>

	<<cleareventpool>>
	<<addinlineevent 10>>
		The hikers talk over the crackle of the fire.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> laughs at something, and the <<person2>><<person>> shakes <<his>> head, grinning.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person1>><<person>> licks <<his>> fingers and leans back, staring up at the sky.
	<</addinlineevent>>
	<<addinlineevent 1>>
		The hikers take long sips from their cans and watch the fire settle.
	<</addinlineevent>>

	<<if $exposed gte 1>>
		<<set $daily.fishing.moor.hikersOgle ??= 1>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 1>>
			The <<person1>><<person>>'s gaze drifts toward you across the fire before <<he>> quickly looks back to <<his>> companion.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 1>>
			The <<person2>><<person>> glances over at you with a long, slow look before turning back to the fire.
		<</addinlineevent>>
	<</if>>
	<<if $exposed gte 2>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 2>>
			The <<person1>><<person>> stares openly at you across the fire, not bothering to look away when you catch <<him>> looking.
		<</addinlineevent>>
		<<addinlineevent $daily.fishing.moor.hikersOgle>>
			<<set $daily.fishing.moor.hikersOgle += 2>>
			The hikers exchange a look across the fire, and the <<person1>><<person>> lets out a low whistle.
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "fishingMoorHikerChat">>
/* Fishing Todo Writing: chatting text */
	You chat with the hikers<<stress -1>><<lstress>>
<</widget>>

<<widget "fishingMoorHikerDrinkSip">>
	<<set $daily.fishing.moor.hikers.drinkCount -= 1>>
	<<if $daily.fishing.moor.hikers.drinkCount is 9>>
		You take a sip from the can, you can taste the alcohol. <<alcohol 17>>
	<<elseif $daily.fishing.moor.hikers.drinkCount lte 0>>
		You tip the can back and drain the last of it. <<alcohol 17>>
	<<elseif $daily.fishing.moor.hikers.drinkCount lte 9>>
		You take a sip from the can. <<alcohol 17>>
	<</if>>
<</widget>>

