/* ========================== */
/* ===== Combat Widgets ===== */
/* ========================== */
<<widget "fishCombatMoorOrgasmHikers">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>
	<<orgasm>>
	<<print either("You stagger on the uneven boggy ground", "You drive the end of your rod into the earth to keep from falling")>>,
	struggling to keep upright as your orgasm hits.
	<<set $orgasmcurrent to 0>>
	The rod slips from your grip. By the time you find your footing again, the line is slack and the <<print $fishingHookedFish.type>> is gone.
	<<run endFishingCombat()>>
	<br><br>

	<<switch random(1, 4)>>
		<<case 1>>
			The <<person1>><<person>> lets out a slow whistle. The <<person2>><<person>> claps twice, grinning at you.
		<<case 2>>
			"Oh. Wow." A beat of silence, then The <<person1>><<person>> starts clapping, laughing as <<he>> does.
		<<case 3>>
			The <<person2>><<person>> coughs. The <<person1>><<person>> just stares for a moment before letting out a long, low whistle.
		<<case 4>>
			"Bloody hell." The <<person1>><<person>> starts clapping and The <<person2>><<person>> joins in with a whoop.
	<</switch>>
	<<fameexhibitionism 5>>
	<br>
	<<link [[Next|Fishing Moor Wait]]>><</link>>
<</widget>>

<<widget "fishCombatMoorCaughtHikers">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<set _cookOffer to true or random(1, 2) is 1 and canCookFish($fishingHookedFish.type, $fishingHookedFish.size) and $daily.fishing.moor.hikers.phase isnot "campfire">>
	<<run updateFishRecord($fishingHookedFish.type, $fishingHookedFish.size, "moor")>>
	<<run endFishingCombat()>>
	<<run holdCaughtFish($fishingHookedFish.type)>>
	
	<<fishingCatchFishText "moor">>
	<br><br>

	<<if _cookOffer>>
		The <<person1>><<person>> looks over the <<print $fishingHookedFish.type>>. "We could probably start a fire and make a meal out of that, what do you think?"
		<br><br>
	<<elseif random(1, 3) is 1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"Nice catch." The <<person1>><<person>> nods approvingly at the fish.
			<<case 2>>
				The <<person2>><<person>> leans in to get a look at your catch. "Not bad."
		<</switch>>
		<br><br>
	<</if>>

	<<if _canEatFish>>
		It's a small fish, you could probably just fit the whole thing in your mouth.
		<br><br>
	<</if>>

	<<if _cookOffer>>
		<<link [[Let them cook it|Fishing Moor Campfire Cook]]>><</link>>
		<br>
	<</if>>

	<<if _canEatFish>>
		<<link [[Eat the fish|Fishing Moor Cat Eat Hikers]]>><</link>>
		<br>
	<</if>>

	<<link [[Stow it away|Fishing Moor Keep]]>><</link>>
	<br>
	<<link [["Throw the " + $fishingHookedFish.type + " back"|Fishing Moor Throw Back]]>><</link>>
<</widget>>

<<widget "fishCombatMoorLineSnappedHikers">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>
	Your line suddenly goes slack, and the <<print $fishingHookedFish.type>> disappears into the depths.
	<<run endFishingCombat()>>
	<br><br>
	
	<<switch random(1, 3)>>
		<<case 1>>
			The <<person1>><<person>> pats you once on the shoulder. "Ah, hard luck."
		<<case 2>>
			The <<person2>><<person>> clicks <<his>> tongue sympathetically. "Nearly had it." 
		<<case 3>>
			The <<person1>><<person>> winces. "That's rough. You almost had it."
	<</switch>>

	<<if $daily.fishing.moor.hikers.drinkCount is 0 and random(1, 2) is 1 or true>>
		<<he>> reaches into the bag and holds out a can. "Here, a consolation."
		<br><br>

		/* fishing todo: move spike setting to here? its more logical */

		<<link [[Accept|Fishing Moor Wait]]>><<set $daily.fishing.moor.hikers.drinkCount to 10>><</link>>
		<br>
		<<link [[Decline|Fishing Moor Wait]]>><</link>>
	<<else>>
		<br><br>

		<<link [[Re-hook the line and cast back out (0:03)|Fishing Moor Wait]]>><<pass 3>><</link>>
		<br>
		<<link [[Leave|Moor]]>><<set $eventskip to 1>><<run stopFishingProp()>><</link>>
	<</if>>
<</widget>>
