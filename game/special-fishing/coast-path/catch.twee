:: Fishing Coast Path Catch
<<effects>>
<<if Weather.dayState is "day" and $rng gte 90 and $daily.fishing.seagullSteal is undefined>>
	<<fishingSeagullCaught $fishingHookedFish $bus>>
<<else>>
	<<fishingCoastPathCaught>>
<</if>>


:: Widgets Fishing Coast Path Catch [widget]

<<widget "fishingCoastPathCaught">>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<run updateFishRecord($fishingHookedFish.type, $fishingHookedFish.size, $bus)>>
	<<run stopFishingProp()>>
	<<set _fishPropName to "caught-" + $fishingHookedFish.type>>
	<<wearProp _fishPropName>>

	<<fishingCatchFishText $fishingHookedFish>>
	<br><br>

	<<if _canEatFish>>
		It's such a small fish, you could probably fit the whole thing in your mouth.
		<br><br>
	<</if>>

	<<link [["Stow the " + $fishingHookedFish.type + " away"|Fishing Coast Path Wait]]>><<tending_give $fishingHookedFish.type 1>><<set $fishingAmbientOverride to "stowAway">><</link>>
	<br>
	<<link [[Throw it back|Fishing Coast Path Wait]]>><<set $fishingAmbientOverride to "throwBack">><</link>>
	<<if _canEatFish>>
		<br>
		<<link [[Eat the fish|Fishing Coast Path Cat Eat]]>><</link>><<cat>>
	<</if>>
<</widget>>
