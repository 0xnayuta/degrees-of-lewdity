:: Fishing Pier Clothing Catch
<<effects>>
<<if $daily.fishing.fishingPier.whitney.phase is "bet">>
	<<fishingPierCatchClothingWhitneyBet>>
<<elseif $daily.fishing.fishingPier.fisher.phase is "fishing">>
	<<fishingPierCatchClothingFisher>>
<<else>>
	<<fishingPierCatchClothing>>
<</if>>


:: Widgets Fishing Pier Clothing Catch [widget]
<<widget "fishingPierCatchClothingWhitneyBet">>
	<<fishingClothingCatchText>>
	<br><br>

	<<fishingPierWhitneyBetNonFish>>
<</widget>>


<<widget "fishingPierCatchClothingFisher">>
	<<fishingClothingCatchText>>
	<br><br>

	<<if $rng lt 50>>
		<<loadNPC 0 "fishing_pier_npc_fisher">><<person1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"More junk than fish in there some days," the <<personsimple>> says, glancing at your catch.
			<<case 2>>
				The <<personsimple>> shakes <<his>> head. "People'll throw their rubbish anywhere. No respect for the place."
		<</switch>>
		<br><br>
	<</if>>

	<<link [[Keep|Fishing Pier Wait]]>><<endevent>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[Throw away|Fishing Pier Wait]]>><<endevent>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>


<<widget "fishingPierCatchClothing">>
	<<fishingClothingCatchText>>
	<br><br>

	<<link [[Keep|Fishing Pier Wait]]>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[Throw away|Fishing Pier Wait]]>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>
