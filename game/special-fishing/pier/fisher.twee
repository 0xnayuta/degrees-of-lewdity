	<<addinlineevent 1>>
		The <<person>> reaches for <<his>> bottle on the railing and takes a drink.
		<<set $daily.fishing.pier.fisher.drunk += 1>>
	<</addinlineevent>>
	<<addinlineevent 1>>
		The <<person>> picks up the bottle and drinks from it, then goes back to <<his>> rod.
		<<set $daily.fishing.pier.fisher.drunk += 1>>
	<</addinlineevent>>

