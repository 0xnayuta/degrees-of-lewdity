	<<set $consensual to 1>>
	<<neutral 1>>
	<<set $enemyno to 1>>
	<<maninit>>
	<<set $enemytrust += 100>>
	Whitney pushes you back against the railing, <<nnpc_his "Whitney">> hands already moving beneath your clothes.
<<elseif $molestationstart is 1>>
	<<run stopFishingProp()>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<set $enemyno to 1>>
	<<maninit>>
