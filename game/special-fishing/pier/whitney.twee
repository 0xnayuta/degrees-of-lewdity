<</if>>
<<effects>>
<<effectsman>><<man>>
<<alarmstate "<span class='red'>No one on the pier intervenes.</span>">>
<<stateman>>
<br><br>

<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[Next|Fishing Whitney Pier Won Sex Finish]]>><</link>></span>
<<else>>
	<span id="next"><<link [[Next|Fishing Whitney Pier Won Sex]]>><</link>></span>
<</if>>

/* After Whitney finishes with PC, the group packs up and leaves */
:: Fishing Whitney Pier Won Sex Finish
<<effects>>
<<set $daily.fishing.pier.whitney.betComplete to true>>
<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>

	"There," Whitney says, catching <<nnpc_his "Whitney">> breath. <<nnpc_He "Whitney">> adjusts <<nnpc_his "Whitney">> clothes, one hand staying possessively on your waist. <<npcincr Whitney lust -20>><<llust>>

	<<clotheson>>
	<<endcombat>>
