:: Dock Pier
A long pier stretches out over the sea, its salt-bleached planks worn smooth by foot traffic. Waves roll below, visible through the gaps between the boards.
<br><br>

<<if $daily?.fishing?.fishingPier?.whitney?.phase is "idle">>
	<<if ["dusk", "night"].includes(Weather.dayState)>>
		<<set $daily.fishing.fishingPier.whitney.phase to "finished">>
	<<else>>
		Whitney and <<nnpc_his "Whitney">> friends are spread along the railing further down, cans in hand, fishing rods hanging over the edge.
		<br><br>
	<</if>>
<</if>>

<<if canStartFishing()>>
	<<if !$fishing.locationsFound.includes("fishingPier")>>
		<<run V.fishing.locationsFound.pushUnique("fishingPier")>>
		<span class="gold">Looks like this could be a good spot for fishing</span>.
		<br>
	<</if>>
	<<fishingRodIcon>><<link [[Start fishing|Fishing Pier Wait]]>><</link>>
	<br>
<<elseif !$fishing.locationsFound.includes("fishingPier")>>
	<<run V.fishing.locationsFound.pushUnique("fishingPier")>>
	<span class="gold">If you had a fishing rod, you could probably catch fish from here</span>.
	<br>
<</if>>
<<mericon>><<link [[Walk back to the docks (0:10)|Docks]]>><<pass 10>><</link>>


/* The PC gets sent here any time they start fishing or after an event. From here, they get sent into the wait loop, where events can happen. */
:: Fishing Pier Wait
<<effects>>
<<run initFishingPier()>>
<<run startFishingProp()>>
<<set _fishingEditBaitEnabled to true>>

<<fishingLocationDescription $bus>>
<<fishingLocationPopulation $bus>>
<<fishingPierLocationAmbient>>
<br><br>

<<set _exhibitionismCheck to Weather.dayState is "night" or (($exposed isnot 1 or hasSexStat("exhibitionism", 3)) and ($exposed lt 2 or hasSexStat("exhibitionism", 5)))>>

<<if $stress gte $stressmax>>
	<<passoutbeach>>
<<else>>
	<<if $exposed gte 1>>
		<<exhibitionism "pierFishing">>
		<br><br>
	<</if>>
	<<if $arousal gte $arousalmax>>
		<<orgasmFishingPier>>
	<<elseif _exhibitionismCheck>>
		<<fishingPierWaitAmbient>>
	<</if>>
	<br><br>

	<<if Weather.dayState isnot "night" and !$daily.fishing.fishingPier.whitney.cantLeave and !_exhibitionismCheck>>
		<<insufficientStat "exhibitionism" "to keep standing around in such an exposed state">>
	<<else>>
		<<if fishingUsingMagnetRod()>>
			<<link [[Dredge for metal (0:05)|Fishing Pier Wait Loop]]>><<pass 5>><</link>>
		<<else>>
			<<link [[Wait for a bite (0:05)|Fishing Pier Wait Loop]]>><<pass 5>><</link>>
		<</if>>
		<<if ["bet", "idle"].includes($daily.fishing.fishingPier.whitney.phase) and $daily.fishing.fishingPier.whitney.pcCider gte 1>>
			<br>
			<<link [[Take a sip|Fishing Pier Wait]]>><<set $fishingPierWaitAmbientOverride to "sip">><</link>><<galcohol>>
		<</if>>
	<</if>>

	<<if $daily.fishing.fishingPier.whitney.phase is "bet">>
		<<if !$daily.fishing.fishingPier.whitney.cantLeave>>
			<br>
			<<link [[Return to the pier|Fishing Pier Cannot Leave]]>><<run stopFishingProp()>><<set $daily.fishing.fishingPier.whitney.cantLeave to true>><</link>>
		<</if>>
	<<else>>
		<br>
		<<link [[Return to the pier|Dock Pier]]>><<run stopFishingProp()>><</link>>
	<</if>>
<</if>>

<<if $options.images isnot 1 and _fishingEditBaitEnabled>>
	<br>
	<<link "Change bait">><<run openBaitOverlay()>><</link>>
<</if>>

<<fishingPierDebugLinks>>


/* Core fishing event loop. Sending the user here rolls for an event within the eventpool. */
:: Fishing Pier Wait Loop
<<cleareventpool>>

<<if fishingUsingMagnetRod()>>
	<<addinlineevent "magnetScrap" magnetLootWeight("fishingPier", 5)>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingPier")>>
		<<include "Fishing Pier Magnet Scrap Catch">>
	<</addinlineevent>>

	<<if fishingAntiqueAvailable("antiquecoppercompass")>>
		<<addinlineevent "copperCompass" 0.15>>
			<<include "Fishing Pier Magnet Pull Compass">>
		<</addinlineevent>>
	<</if>>

	<<if !$fishing.singleCatch.cashRegister>>
		<<addinlineevent "cashRegister" 0.15>>
			<<include "Fishing Pier Magnet Pull Cash Register">>
		<</addinlineevent>>
	<</if>>

	<<if !$fishing.singleCatch.chainLength>>
		<<addinlineevent "chainLength" 0.15>>
			<<include "Fishing Pier Magnet Pull Chain Length">>
		<</addinlineevent>>
	<</if>>

	<<if !$fishing.singleCatch.shoppingTrolley>>
		<<addinlineevent "shoppingTrolley" 0.15>>
			<<include "Fishing Pier Magnet Pull Shopping Trolley">>
		<</addinlineevent>>
	<</if>>

	<<if !$fishing.singleCatch.boatAnchor>>
		<<addinlineevent "boatAnchor" 0.15>>
			<<include "Fishing Pier Magnet Pull Boat Anchor">>
		<</addinlineevent>>
	<</if>>
<<else>>
	<<addinlineevent "bite" fishingCatchEventWeight("fishingPier", 10)>>
		<<set $fishingHookedFish to rollFish("fishingPier")>>
		<<run onBaitLoss()>>
		<<if fishingTriggersReelFight($fishingHookedFish)>>
			<<run fishingMinigameStart($fishingHookedFish.type)>>
			<<include "Fishing Pier Minigame Loop">>
		<<else>>
			You feel a tug on your line, then haul back, pulling <<a $fishingHookedFish.type>> out of the water without a fight.
			<<include "Fishing Pier Catch">>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "trash" 1>>
		<<set $fishingTrash to rollFishingTrash("fishingPier")>>
		<<include "Fishing Pier Trash Catch">>
	<</addinlineevent>>

	<<addinlineevent "clothing" 1>>
		<<set $fishingClothingName to rollFishingClothing("fishingPier")>>
		<<include "Fishing Pier Clothing Catch">>
	<</addinlineevent>>
<</if>>

/* Whitney bullies Fisher off the pier */
<<if $daily.fishing.fishingPier.fisher.phase is "fishing" and $daily.fishing.fishingPier.whitney.phase is undefined>>
	<<addinlineevent "whitneyBullyFisher" 0.3>>
		<<include "Fishing Pier Whitney Bully Fisher">>
	<</addinlineevent>>
<</if>>

/* Whitney and friends arrive */
<<if $daily.fishing.fishingPier.whitney.phase is undefined and [undefined, "finished"].includes($daily.fishing.fishingPier.fisher.phase) and Time.hour lt 20 and !["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
	<<addinlineevent "whitneyArrive" 0.3>>
		<<include "Fishing Pier Whitney Arrive">>
	<</addinlineevent>>
<</if>>

/* Whitney cider offer event */
<<if $daily.fishing.fishingPier.whitney.phase is "idle" and fishingArrivalTimePassed(30) and $whitneyromance is 1 and $daily.fishing.fishingPier.whitney.pcCider is 0 and $daily.fishing.fishingPier.whitney.pcCiderTotal lt 3 and !(playerIsPregnant() and playerAwareTheyArePregnant())>>
	<<addinlineevent "whitneyCiderOffer" 2>>
		<<include "Fishing Whitney Drink Offer">>
	<</addinlineevent>>
<</if>>

/* Whitney Pier betting event. The bet is about the size of the next fish, so it can't start while the player is magnet fishing. */
<<if $daily.fishing.fishingPier.whitney.phase is "idle" and fishingArrivalTimePassed(60) and !$daily.fishing.fishingPier.whitney.betComplete and !fishingUsingMagnetRod()>>
	<<addinlineevent "whitneyBet" fishingDangerEventWeight(1)>>
		<<include "Fishing Whitney Pier Bet">>
	<</addinlineevent>>
<</if>>

/* Whitney leaves */
<<if $daily.fishing.fishingPier.whitney.phase is "idle">>
	<<if ["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
		<<addinlineevent "whitneyIdleLeaveWeather" 10>>
			<<include "Fishing Pier Whitney Idle Leave Weather Heavy">>
		<</addinlineevent>>
	<<elseif Time.hour gte 20>>
		<<addinlineevent "whitneyIdleLeaveNight" 10>>
			<<include "Fishing Pier Whitney Leave Night">>
		<</addinlineevent>>
	<<elseif $daily.fishing.fishingPier.whitney.age gt 12>>
		<<addinlineevent "whitneyIdleLeave" 10>>
			<<include "Fishing Pier Whitney Idle Leave">>
		<</addinlineevent>>
	<</if>>
<<elseif $daily.fishing.fishingPier.whitney.phase is "bet">>
	<<if ["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
		<<addinlineevent "whitneyBetLeaveWeather" 10>>
			<<include "Fishing Pier Whitney Bet Leave Weather Heavy">>
		<</addinlineevent>>
	<<elseif Time.hour gte 20>>
		<<addinlineevent "whitneyBetLeaveNight" 10>>
			<<include "Fishing Pier Whitney Bet Leave Night">>
		<</addinlineevent>>
	<<elseif Weather.name is "lightPrecipitation" and $daily.fishing.fishingPier.whitney.rainLeave is undefined>>
		<<addinlineevent "whitneyRainStay" 10>>
			<<include "Fishing Pier Whitney Bet Weather Light">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* fisher event start */
<<if [undefined, "finished"].includes($daily.fishing.fishingPier.whitney.phase) and $daily.fishing.fishingPier.fisher.phase is undefined and Time.hour lt 20 and !["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
	<<addinlineevent "fisherArrive" 1>>
		<<include "Fishing Pier Fisher Arrive">>
	<</addinlineevent>>
<</if>>

/* Fisher tips event */
<<if $daily.fishing.fishingPier.fisher.phase is "fishing" and fishingArrivalTimePassed(30) and $daily.fishing.fishingPier.fisher.drunk lte 2 and $daily.fishing.fishingPier.fisher.tipGiven is undefined and Time.hour lt 20 and !["storm", "thunderstorm"].includes(Weather.name) and !fishingUsingMagnetRod()>>
	<<addinlineevent "fisherTipsOffer" 0.5>>
		<<include "Fishing Pier Fisher Tips Offer">>
	<</addinlineevent>>
<</if>>

/* Fisher cliff tip event */
<<if $daily.fishing.fishingPier.fisher.phase is "fishing" and numberOfFishCaught() gte 50 and !$fishing.locationsFound.includes("fishingCoastPath")>>
	<<addinlineevent "fisherCliffTipOffer" 0.5>>
		<<include "Fishing Pier Fisher Cliff Tip Offer">>
	<</addinlineevent>>
<</if>>

/* Fisher leaves */
<<if $daily.fishing.fishingPier.fisher.phase is "fishing">>
	<<if Time.hour gte 20>>
		<<addinlineevent "fisherLeaveNight" 10>>
			<<include "Fishing Pier Fisher Leave Night">>
		<</addinlineevent>>
	<<elseif ["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
		<<addinlineevent "fisherLeaveWeather" 10>>
			<<include "Fishing Pier Fisher Leave Weather">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Fisher attacks if player is exposed */
<<if $daily.fishing.fishingPier.fisher.phase is "fishing" and fishingArrivalTimePassed(60) and $exposed gte 1>>
	<<addinlineevent "fisherExposedAttack" fishingDangerEventWeight($daily.fishing.fishingPier.fisherOgle)>>
		<<include "Fishing Pier Fisher Exposed Attack">>
	<</addinlineevent>>
<</if>>

/* Tentacle pulls rod event */
<<if [undefined, "finished"].includes($daily.fishing.fishingPier.whitney.phase) and !fishingUsingMagnetRod()>>
	<<addinlineevent "tentacles" fishingDangerEventWeight(3)>>
		<<include "Fishing Pier Tentacles">>
	<</addinlineevent>>
<</if>>

/* Wind blow event: weight 4 at 0 dance skill, 0.5 at 600 */
<<if ["storm", "thunderstorm", "heavyClouds", "heavyPrecipitation"].includes(Weather.name)>>
	<<set _windChance to Math.clamp(4 - currentSkillValue('danceskill') * 3.7 / 600, 0.3, 4)>>
	<<addinlineevent "wind" _windChance>>
		<<if $daily.fishing.fishingPier.whitney.phase is "idle">>
			<<include "Fishing Pier Wind Whitney Idle">>
		<<elseif $daily.fishing.fishingPier.whitney.phase is "bet">>
			<<include "Fishing Pier Wind Whitney Bet">>
		<<elseif $daily.fishing.fishingPier.fisher.phase is "fishing">>
			<<include "Fishing Pier Wind Fisher">>
		<<else>>
			<<include "Fishing Pier Wind">>
		<</if>>
	<</addinlineevent>>
<</if>>

/* Wave sprays up through the planks */
<<addinlineevent "pierWave" 0.5>>
	<<include "Fishing Pier Wave">>
<</addinlineevent>>

/* Eel swarm drags the player into the water */
<<if $settings.swarmsEnabled>>
	<<addinlineevent "pierSwarm" fishingDangerEventWeight(1)>>
		<<include "Fishing Pier Swarm">>
	<</addinlineevent>>
<</if>>

/* Nothing happens, wait loop continues */
<<addinlineevent "wait" 25>>
	<<include "Fishing Pier Wait">>
<</addinlineevent>>
<<runeventpool>>



:: Fishing Pier Cat Eat
<<effects>>
You open wide and drop the whole <<print $fishingHookedFish.type>> in your mouth. <<fishingEatFishCatProgress>><<lstress>><<stress -6>>
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Pier Wait]]>><</link>>

:: Widgets Fishing Pier Wait Flavor [widget]
/* Text that appears above the description of the PC waiting for a bite. Used for describing what other NPCs or animals are doing if they are present next to the player. */
<<widget "fishingPierLocationAmbient">>
	<<if [undefined, "finished"].includes($daily.fishing.fishingPier.whitney.phase) and $daily.fishing.fishingPier.fisher.phase is "fishing">>
		<<fishingPierFisherAmbient>>
	<<elseif ["bet", "idle"].includes($daily.fishing.fishingPier.whitney.phase)>>
		<<if $daily.fishing.fishingPier.whitney.playerFellOff>>
			Whitney looks over at you with a smirk. "Welcome back, slut. Did you enjoy your swim?"

			<<unset $daily.fishing.fishingPier.whitney.playerFellOff>>
		<<else>>
			<<switch $daily.fishing.fishingPier.whitney.phase>>
				<<case "idle">>
					<<fishingPierWhitneyIdleAmbient>>
				<<case "bet">>
					<<fishingPierWhitneyBetAmbient>>
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

/* Text that is used to generally describe the PC waiting for a bite. Also includes the PC being alone with their thoughts, and descriptions of the PC noticing things around them, like the weather or noises around them that could signify that something dangerous about to happen. Also used to describe the player when they take an action other than waiting for a bite. */
<<widget "fishingPierWaitAmbient">>
	<<if $fishingAmbientOverride is "throwBack">>
		<<if $fishing.currentBait>>
			You toss the fish back into the sea before <<fishingRebaitMid>>
		<<else>>
			You toss the fish back into the sea and cast back out.
		<</if>>
		<<unset $fishingAmbientOverride>>
	<<elseif $fishingAmbientOverride is "stowAway">>
		<<if $fishing.currentBait>>
			You stow the fish away before <<fishingRebaitMid>>
		<<else>>
			You stow the fish away and cast back out.
		<</if>>
		<<unset $fishingAmbientOverride>>
	<<elseif $fishingAmbientOverride is "reHook">>
		<<if $fishing.currentBait>>
			<<fishingRebaitStart>>
		<<else>>
			You re-hook your line and cast back out.
		<</if>>
		<<unset $fishingAmbientOverride>>
	<<elseif $fishingAmbientOverride is "keepClothing">>
		<<set _clothingItem to fishingFindClothingItem($fishingClothingName)>>
		<<generalSend "wardrobe" _clothingItem.slot $fishingClothingName _clothingItem.colour>>
		You wring out the <<= $fishingClothingName>> and stow it away.
		<<unset $fishingClothingName>>
		<<unset $fishingAmbientOverride>>
	<<elseif $fishingAmbientOverride is "tossClothing">>
		You carry the sodden <<= $fishingClothingName>> over to a bin on the pier and throw it away.
		<<unset $fishingClothingName>>
		<<unset $fishingAmbientOverride>>
	<<elseif $fishingPierWaitAmbientOverride is "sip">>
		<<fishingPierWhitneySip>>
	<<else>>
		<<cleareventpool>>
		<<fishingWaitAmbient $bus>>

		<<runeventpool>>
	<</if>>
	<<unset $fishingPierWaitAmbientOverride>>
<</widget>>
