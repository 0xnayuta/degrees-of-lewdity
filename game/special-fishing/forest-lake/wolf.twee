/*
 * A wolf attacks you. The encounter is more dangerous at night.
 */


:: Fishing Forest Lake Wolf Attack
<<if Weather.dayState is "night">>
	<<set $fishingWolfCount to 2>>
<<else>>
	<<set $fishingWolfCount to 1>>
<</if>>
<<beastNEWinit $fishingWolfCount wolf>>
As you watch your line drift across the water, snarling erupts from the treeline behind you. You spin around just as
<<if $fishingWolfCount is 1>>
	a <<beasttype>> is leaping onto you.
<<else>>
	a <<beasttype>> leaps onto you, with another right behind.
<</if>>
<br><br>

<<link [[Fight|Fishing Forest Lake Wolf Molestation]]>><<set $molestationstart to 1>><</link>>


:: Fishing Forest Lake Wolf Interrupt Attack
<<run endFishingCombat()>>
<<if Weather.dayState is "night">>
	<<set $fishingWolfCount to 2>>
<<else>>
	<<set $fishingWolfCount to 1>>
<</if>>
<<beastNEWinit $fishingWolfCount wolf>>
<<set $fishingWolfMouthTarget to random(1, 4)>>
You're focused on your catch when snarling erupts from the treeline.
<<if $fishingWolfCount is 1>>
	A <<beasttype>> surges out of the forest,
	<<if $fishingWolfMouthTarget is 1>>
		<span class="red">clamping <<bhis>> jaws around your neck</span> before you can react.
	<<elseif $fishingWolfMouthTarget is 2>>
		<span class="red">snapping at your face</span> before you can react.
	<<else>>
		charging you before you can react.
	<</if>>
<<else>>
	Two <<beasttype>>s surge out of the forest,
	<<if $fishingWolfMouthTarget is 1>>
		<span class="red">one clamping its jaws around your neck</span> before you can react.
	<<elseif $fishingWolfMouthTarget is 2>>
		<span class="red">one jumping on top of you and snapping at your face</span> before you can react.
	<<else>>
		surrounding you at the lake's edge before you can react.
	<</if>>
<</if>>
<br><br>

<<link [[Fight|Fishing Forest Lake Wolf Molestation]]>><<set $molestationstart to 1>><</link>>


:: Fishing Forest Lake Wolf Molestation
<<if $molestationstart is 1>>
	<<run stopFishingProp()>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
	<<beastTrainGenerate>>
	<<unset $fishingWolfCount>>
	<<set $enemytrust -= 40>>
	<<set $enemyhealthmax to 600>>
	<<set $enemyhealth to 600>>
	<<set $enemyarousalmax to 500>>
	<<if $fishingWolfMouthTarget is 1>>
		<<set $NPCList[0].mouth to "neck">>
		<<set $head to "grappled">>
	<<elseif $fishingWolfMouthTarget is 2>>
		<<set $NPCList[0].mouth to "hair">>
		<<set $head to "grappled">>
	<</if>>
	<<unset $fishingWolfMouthTarget>>
	<<forestRescueSetup>>
<</if>>

<<effects>>
<<effectsman>>

<<forestRescueCheck>>
<br>
<<beast $enemyno>>
<br><br>

<<stateman>>
<br><br>

<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[Next|Fishing Forest Lake Wolf Molestation Finish]]>><</link>></span>
<<else>>
	<span id="next"><<link [[Next|Fishing Forest Lake Wolf Molestation]]>><</link>></span>
<</if>>


:: Fishing Forest Lake Wolf Molestation Finish
<<effects>>
<<set $fishing.lake.event to "none">>
<<set $fishing.lake.eventDanger to 0>>

<<if $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>
	<<if $combatTrain.length gt 0>>
		The <<beasttype>> grunts in satisfaction and is shoved off of you by the second <<beasttype>>, who takes <<bhis>> place.
		<br><br>

		<<combatTrainAdvance>>
		<<link [[Next|Fishing Forest Lake Wolf Molestation]]>><</link>>
	<<else>>
		The <<beasttype>> grunts in satisfaction and retreats away from the lakeshore.
		<br><br>

		<<tearful>> you pick up your rod and gather your things.
		<br><br>

		<<clotheson>>
		<<endcombat>>
		<<link [[Return to fishing|Fishing Forest Lake Wait]]>><</link>>
		<br>
		<<link [[Leave|Lake Fishing Rock]]>><</link>>
	<</if>>
<<elseif $enemyhealth lte 0>>
	<<if $combatTrain.length gt 0>>
		The <<beasttype>> yelps and flees into the forest. Undeterred, the second <<beasttype>> approaches you.
		<br><br>

		<<combatTrainAdvance>>
		<<link [[Next|Fishing Forest Lake Wolf Molestation]]>><</link>>
	<<else>>
		The <<beasttype>> yelps and flees into the forest, leaving you alone.
		<br><br>

		<<tearful>> you pick up your rod and gather your things.
		<br><br>

		<<clotheson>>
		<<endcombat>>

		<<link [[Return to fishing|Fishing Forest Lake Wait]]>><</link>>
		<br>
		<<link [[Leave|Lake Fishing Rock]]>><</link>>
	<</if>>
<<elseif $rescue is 1 and $alarm is 1>>
	<<forestRescue>>
<</if>>


:: Widgets Fishing Forest Lake Wolf [widget]
/* Text that can appear while waiting if a wolf will attack soon */
<<widget "fishingForestLakeWolfAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"You see movement in the trees to your side. Probably just a deer.",
			"The musty smell of wet fur drifts on the breeze.",
			"Branches snap in the forest behind you.",
			"You feel like something is watching you."
		)>>
		<<set $fishing.lake.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>
