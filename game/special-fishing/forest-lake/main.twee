:: Fishing Forest Lake Wait
<<run initFishingForestLake()>>
<<run discoverFishingLocation("forestLake")>>
<<fishingLocationDescription "forestLake">>
<br><br>

<<fishingForestLakeAmbient>>

	
<<if !$daily.fishing?.hasFishedToday or random(1, 5) is 1>>
	<<set $daily.fishing.hasFishedToday to true>>
	Your bob hasn't attracted anything yet.
<<else>>
	<<fishingForestLakeWaitAmbient>>
<</if>>
<br><br>

<<link [[Wait for a bite (0:05)|Fishing Forest Lake Wait Loop]]>><</link>>
<br>
<<link [[Leave|Lake Fishing Rock]]>><</link>>
<<fishingForestLakeDebugLinks>>


:: Fishing Forest Lake Wait Loop
<<pass 5>>
<<cleareventpool>>

<<addinlineevent "bite" 10.25>>
	<<set $fishingHookedFish to rollFish("forestLake")>>
	<<include "Fishing Forest Lake Bite">>
<</addinlineevent>>

/* Rock slip */
<<addinlineevent "rockSlip" 1>>
	As you shift your weight, the slick rocks beneath your feet give way and you begin to slip.
	<br><br>

	<<silently>><<dancedifficulty 600 1200>><</silently>>
	<<if $danceSuccess>>
		<span class="green">You manage to catch yourself, regaining your footing on the treacherous stone.</span>
		<br><br>

		<<link [[Next|Fishing Forest Lake Wait]]>><</link>>
	<<else>>
		<span class="red">You tumble into the lake.</span>
		<br><br>

		<<link [[Next|Lake Depths]]>><<set $eventskip to 1>><</link>>
	<</if>>
<</addinlineevent>>

/* Wolf Attack */
<<if $settings.bestialityEnabled>>
	<<if $fishing.lake.event is "none">>
		<<addinlineevent "wolfStart" .75>>
			<<set $fishing.lake.event to "wolf">>
			<<fishingForestLakeStartleAnimals>>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.lake.event is "wolf">>
		<<set _wolfAttackProbability to Math.max(0, $fishing.lake.eventDanger - 1)>>
		<<addinlineevent "wolfAttack" _wolfAttackProbability>>
			<<set $fishing.lake.eventDanger to 0>>
			<<set $fishing.lake.event to "none">>
			<<include "Fishing Forest Lake Wolf Attack">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Bear Attack */
<<if $settings.bestialityEnabled>>
	<<if $fishing.lake.event is "none">>
		<<addinlineevent "bearStart" 0.4>>
			<<set $fishing.lake.event to "bear">>
			<<fishingForestLakeStartleAnimals>>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.lake.event is "bear">>
		<<set _bearAttackProbability to Math.max(0, $fishing.lake.eventDanger - 1)>>
		<<addinlineevent "bearAttack" _bearAttackProbability>>
			<<set $fishing.lake.eventDanger to 0>>
			<<set $fishing.lake.event to "none">>
			<<include "Fishing Forest Lake Bear Attack">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Plant Person Kiss */
<<if $settings.plantsEnabled>>
	<<if $fishing.lake.event is "none">>
		<<addinlineevent "plantPersonStart" 1.25>>
			<<set $fishing.lake.event to "plantPerson">>
			<<fishingForestLakeStartleAnimals>>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.lake.event is "plantPerson">>
		<<set _plantKissEncounterProbability to Math.max(0, $fishing.lake.eventDanger - 1)>>
		<<addinlineevent "plantPersonEncounter" _plantKissEncounterProbability>>
			<<set $fishing.lake.eventDanger to 0>>
			<<set $fishing.lake.event to "none">>
			<<include "Fishing Forest Lake Plant Kiss Encounter">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Vine Attack Event */
<<if $settings.tentaclesEnabled>>
	<<if $fishing.lake.event is "none">>
		<<addinlineevent "plantStart" 0.25>>
			<<set $fishing.lake.event to "plant">>
			<<fishingForestLakeStartleAnimals>>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.lake.event is "plant">>
		<<set _plantAttackProbability to Math.max(0, $fishing.lake.eventDanger - 1)>>
		<<addinlineevent "plantAttack" _plantAttackProbability>>
			<<set $fishing.lake.eventDanger to 0>>
			<<set $fishing.lake.event to "none">>
			<<include "Fishing Forest Lake Plant Attack">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Boar Attack Event */
<<if $settings.bestialityEnabled>>
	<<if $fishing.lake.event is "none">>
		<<addinlineevent "boarStart" .5>>
			<<set $fishing.lake.event to "boar">>
			<<fishingForestLakeStartleAnimals>>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.lake.event is "boar">>
		<<set _boarAttackProbability to Math.max(0, $fishing.lake.eventDanger - 1)>>
		<<addinlineevent "boarAttack" _boarAttackProbability>>
			<<set $fishing.lake.eventDanger to 0>>
			<<set $fishing.lake.event to "none">>
			<<include "Fishing Forest Lake Boar Attack">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Nothing happens, wait loop continues */
<<addinlineevent "wait" 10>>
	<<include "Fishing Forest Lake Wait">>
<</addinlineevent>>
<<runeventpool>>


:: Fishing Forest Lake Bite
Your line cuts through the water as something takes the bait, a <<print $fishingHookedFish.type>>.<<if $fishingHookedFish.isHuge>> It's huge!<</if>>
<br><br>

<<link [[Next|Fishing Combat Forest Lake]]>><<run startFishingCombat("forestLake")>><</link>>


:: Fishing Forest Lake Throw Back
You toss the <<print $fishingHookedFish.type>> back into the lake.
<br><br>

<<link [[Cast back out|Fishing Forest Lake Wait]]>><</link>>
<br>
<<link [[Leave|Lake Fishing Rock]]>><</link>>


:: Fishing Forest Lake Keep
You stow the <<print $fishingHookedFish.type>> away.
<<tending_give $fishingHookedFish.type 1>>
<br><br>

<<link [[Cast back out|Fishing Forest Lake Wait]]>><</link>>
<br>
<<link [[Leave|Lake Fishing Rock]]>><</link>>


:: Fishing Forest Lake Cat Eat
You open wide and drop the whole <<print $fishingHookedFish.type>> in your mouth. <<transform cat 1>><<lstress>><<stress -6>>
<br><br>

<<link [[Cast back out|Fishing Forest Lake Wait]]>><</link>>
<br>
<<link [[Leave|Lake Fishing Rock]]>><</link>>


:: Widgets Fishing Forest Lake Wait Flavor [widget]
<<widget "fishingForestLakeAmbient">>
<</widget>>

<<widget "fishingForestLakeWaitAmbient">>
	<<cleareventpool>>
	<<fishingWaitAmbient "forestLake">>
	<<if $fishing.lake.event is "wolf">>
		<<fishingForestLakeWolfAttackWaitAmbient>>
	<<elseif $fishing.lake.event is "bear">>
		<<fishingForestLakeBearAttackWaitAmbient>>
	<<elseif $fishing.lake.event is "plantPerson">>
		<<fishingForestLakePlantPersonAttackWaitAmbient>>
	<<elseif $fishing.lake.event is "plant">>
		<<fishingForestLakePlantAttackWaitAmbient>>
	<<elseif $fishing.lake.event is "boar">>
		<<fishingForestLakeBoarAttackWaitAmbient>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "fishingForestLakeStartleAnimals">>
<</widget>>
