/* The PC gets sent here any time they start fishing or after an event. From here, they get sent into the wait loop, where events can happen. */
:: Fishing Forest Lake Wait
<<effects>>
<<run initFishingForestLake()>>
<<run startFishingProp()>>

<<fishingLocationDescription $bus>>
<<fishingLocationPopulation $bus>>
<br><br>

<<if $stress gte $stressmax>>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "lake">>
	<<else>>
		<<passoutlake>>
	<</if>>
<<else>>
	<<if $exposed gte 1>>
		<<exhibitionism "forestLakeFishing">>
		<br><br>
	<</if>>
	<<if $arousal gte $arousalmax>>
		<<orgasmFishingForestLake>>
	<<else>>
		<<fishingForestLakeWaitAmbient>>
	<</if>>
	<br><br>

	<<if fishingUsingMagnetRod()>>
		<<link [[Dredge for metal (0:05)|Fishing Forest Lake Wait Loop]]>><<pass 5>><</link>>
	<<else>>
		<<link [[Wait for a bite (0:05)|Fishing Forest Lake Wait Loop]]>><<pass 5>><</link>>
	<</if>>
	<br>
	<<link [[Leave|Lake Fishing Rock]]>><<run stopFishingProp()>><</link>>
<</if>>
<<fishingForestLakeDebugLinks>>


/* Core fishing event loop. Sending the user here rolls for an event within the eventpool. */
:: Fishing Forest Lake Wait Loop
<<cleareventpool>>

<<if fishingUsingMagnetRod()>>
	<<addinlineevent "magnetScrap" magnetLootWeight("fishingForestLake", 2.5)>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingForestLake")>>
		<<include "Fishing Forest Lake Magnet Scrap Catch">>
	<</addinlineevent>>

	<<if fishingAntiqueAvailable("antiqueforestdagger")>>
		<<addinlineevent "forestDagger" 0.15>>
			<<include "Fishing Forest Lake Magnet Pull Dagger">>
		<</addinlineevent>>
	<</if>>
<<else>>
	<<addinlineevent "bite" fishingCatchEventWeight("fishingForestLake", 10)>>
		<<set $fishingHookedFish to rollFish("fishingForestLake")>>
		<<if fishingTriggersReelFight($fishingHookedFish)>>
			<<include "Fishing Forest Lake Bite Big">>
		<<else>>
			You feel a tug on your line, then haul back on your rod, pulling <<a $fishingHookedFish.type>> out of the water without a fight.
			<<include "Fishing Forest Lake Catch">>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "trash" .5>>
		<<set $fishingTrash to rollFishingTrash("fishingForestLake")>>
		<<include "Fishing Forest Lake Trash Catch">>
	<</addinlineevent>>
<</if>>

/* Wolf Attack */
<<if $fishing.forestLake.event is "none">>
	<<addinlineevent "wolfStart" fishingDangerEventWeight(2)>>
		<<set $fishing.forestLake.event to "wolf">>
		<<include "Fishing Forest Lake Wait">>
	<</addinlineevent>>
<<elseif $fishing.forestLake.event is "wolf">>
	<<set _wolfAttackProbability to Math.max(0, $fishing.forestLake.eventDanger - 1)>>
	<<addinlineevent "wolfAttack" _wolfAttackProbability>>
		<<set $fishing.forestLake.eventDanger to 0>>
		<<set $fishing.forestLake.event to "none">>
		<<include "Fishing Forest Lake Wolf Attack">>
	<</addinlineevent>>
<</if>>

/* Bear Attack */
<<if $fishing.forestLake.event is "none">>
	<<addinlineevent "bearStart" fishingDangerEventWeight(1.5)>>
		<<set $fishing.forestLake.event to "bear">>
		<<include "Fishing Forest Lake Wait">>
	<</addinlineevent>>
<<elseif $fishing.forestLake.event is "bear">>
	<<set _bearAttackProbability to Math.max(0, $fishing.forestLake.eventDanger - 1)>>
	<<addinlineevent "bearAttack" _bearAttackProbability>>
		<<set $fishing.forestLake.eventDanger to 0>>
		<<set $fishing.forestLake.event to "none">>
		<<include "Fishing Forest Lake Bear Attack">>
	<</addinlineevent>>
<</if>>

/* Plant Person Kiss */
<<if $settings.plantsEnabled>>
	<<if $fishing.forestLake.event is "none">>
		<<addinlineevent "plantPersonStart" fishingDangerEventWeight(1.5)>>
			<<set $fishing.forestLake.event to "plantPerson">>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.forestLake.event is "plantPerson">>
		<<set _plantKissEncounterProbability to Math.max(0, $fishing.forestLake.eventDanger - 1)>>
		<<addinlineevent "plantPersonEncounter" _plantKissEncounterProbability>>
			<<set $fishing.forestLake.eventDanger to 0>>
			<<set $fishing.forestLake.event to "none">>
			<<include "Fishing Forest Lake Plant Kiss Encounter">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Vine Attack Event */
<<if $settings.tentaclesEnabled>>
	<<if $fishing.forestLake.event is "none">>
		<<addinlineevent "plantStart" fishingDangerEventWeight(0.5)>>
			<<set $fishing.forestLake.event to "plant">>
			<<include "Fishing Forest Lake Wait">>
		<</addinlineevent>>
	<<elseif $fishing.forestLake.event is "plant">>
		<<set _plantAttackProbability to Math.max(0, $fishing.forestLake.eventDanger - 1)>>
		<<addinlineevent "plantAttack" _plantAttackProbability>>
			<<set $fishing.forestLake.eventDanger to 0>>
			<<set $fishing.forestLake.event to "none">>
			<<include "Fishing Forest Lake Plant Attack">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Boar Attack Event */
<<if $fishing.forestLake.event is "none">>
	<<addinlineevent "boarStart" fishingDangerEventWeight(1)>>
		<<set $fishing.forestLake.event to "boar">>
		<<include "Fishing Forest Lake Wait">>
	<</addinlineevent>>
<<elseif $fishing.forestLake.event is "boar">>
	<<set _boarAttackProbability to Math.max(0, $fishing.forestLake.eventDanger - 1)>>
	<<addinlineevent "boarAttack" _boarAttackProbability>>
		<<set $fishing.forestLake.eventDanger to 0>>
		<<set $fishing.forestLake.event to "none">>
		<<include "Fishing Forest Lake Boar Attack">>
	<</addinlineevent>>
<</if>>

/* Fish swarm drags the player into the lake */
<<if $settings.swarmsEnabled>>
	<<addinlineevent "lakeSwarm" fishingDangerEventWeight(0.5)>>
		<<include "Fishing Forest Lake Swarm">>
	<</addinlineevent>>
<</if>>

/* Nothing happens, wait loop continues */
<<addinlineevent "wait" 25>>
	<<include "Fishing Forest Lake Wait">>
<</addinlineevent>>
<<runeventpool>>


:: Fishing Forest Lake Bite Big
<<effects>>
<<set $fishingReelAttempts to 0>>
Something takes the bait and pulls out toward the middle of the lake,<<if $fishingHookedFish.aboveAverageSize>> you can see a <span class="pink">big</span> <<print $fishingHookedFish.type>> below the surface.<<else>> looks like <<a $fishingHookedFish.type>>.<</if>>
<br><br>

<<set _reelDifficultyMax to Math.clamp($fishingHookedFish.size * 10, 600, 1400)>>
<<link [[Try to reel it in|Fishing Forest Lake Reel]]>><</link>><<athleticsdifficulty -250 _reelDifficultyMax>>
<br>
<<link [[Cut the line|Fishing Forest Lake Cut Line]]>><</link>>


:: Fishing Forest Lake Throw Back
<<effects>>
You toss the <<print $fishingHookedFish.type>> back into the lake.
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Forest Lake Wait]]>><</link>>


:: Fishing Forest Lake Keep
<<effects>>
You stow the <<print $fishingHookedFish.type>> away.
<<tending_give $fishingHookedFish.type 1>>
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Forest Lake Wait]]>><</link>>


:: Fishing Forest Lake Cat Eat
<<effects>>
You open wide and drop the whole <<print $fishingHookedFish.type>> in your mouth. <<transform cat 1>><<lstress>><<stress -6>>
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Forest Lake Wait]]>><</link>>


:: Widgets Fishing Forest Lake Wait Flavor [widget]
/* Text that is used to generally describe the PC waiting for a bite. Also includes the PC being alone with their thoughts, and descriptions of the PC noticing things around them, like the weather or noises around them that could signify that something dangerous about to happen. Also used to describe the player when they take an action other than waiting for a bite. */
<<widget "fishingForestLakeWaitAmbient">>
	<<cleareventpool>>
	<<fishingWaitAmbient $bus>>

	<<if $fishing.forestLake.event is "wolf">>
		<<fishingForestLakeWolfAttackWaitAmbient>>
	<<elseif $fishing.forestLake.event is "bear">>
		<<fishingForestLakeBearAttackWaitAmbient>>
	<<elseif $fishing.forestLake.event is "plantPerson">>
		<<fishingForestLakePlantPersonAttackWaitAmbient>>
	<<elseif $fishing.forestLake.event is "plant">>
		<<fishingForestLakePlantAttackWaitAmbient>>
	<<elseif $fishing.forestLake.event is "boar">>
		<<fishingForestLakeBoarAttackWaitAmbient>>
	<</if>>
	<<runeventpool>>
<</widget>>
