:: Fishing Beach Clothing Catch
<<effects>>
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
	<<fishingBeachCatchClothingFisher>>
<<else>>
	<<fishingBeachCatchClothing>>
<</if>>

:: Widgets Fishing Beach Clothing Catch [widget]
<<widget "fishingBeachCatchClothingFisher">>
	<<fishingClothingCatchText>>
	<br><br>

	<<if $rng lt 50>>
		<<loadNPC 0 "fishing_beach_npc_fisher">><<person1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"More junk than fish in there some days," the <<personsimple>> says, glancing at your catch.
			<<case 2>>
				The <<personsimple>> shakes <<his>> head. "People'll throw their rubbish anywhere. No respect for the place."
		<</switch>>
		<br><br>
	<</if>>

	<<link [[Keep|Fishing Beach Wait]]>><<endevent>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[Throw away|Fishing Beach Wait]]>><<endevent>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>


<<widget "fishingBeachCatchClothing">>
	<<fishingClothingCatchText>>
	<br><br>

	<<link [[Keep|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[Throw away|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>


