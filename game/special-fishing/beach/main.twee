/* The PC gets sent here any time they start fishing or after an event. From here, they get sent into the wait loop, where events can happen.  */
:: Fishing Beach Wait
<<effects>>
<<run initFishingBeach()>>
<<run startFishingProp()>>

<<fishingLocationDescription $bus>>
<<fishingLocationPopulation $bus>>
<<fishingBeachAmbient>>
<br><br>

<<set _exhibitionismCheck to Weather.dayState is "night" or (($exposed isnot 1 or hasSexStat("exhibitionism", 3)) and ($exposed lt 2 or hasSexStat("exhibitionism", 5)))>>

<<if $stress gte $stressmax>>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "beach">>
	<<else>>
		<<passoutbeach>>
	<</if>>
<<else>>
	<<if $exposed gte 1>>
		<<exhibitionism "beachFishing">>
		<br><br>
	<</if>>
	<<if $arousal gte $arousalmax>>
		<<orgasmFishingBeach>>
	<<elseif _exhibitionismCheck>>
		<<fishingBeachWaitAmbient>>
	<</if>>

	<br><br>

	<<if !_exhibitionismCheck>>
		<<insufficientStat "exhibitionism" "to keep standing around in such an exposed state">>
		<br>
		<<link [[Return to the beach|Beach]]>><<run stopFishingProp()>><<set $bus to "beach">><</link>>
	<<else>>
		<<if fishingUsingMagnetRod()>>
			<<link [[Dredge for metal (0:05)|Fishing Beach Wait Loop]]>><<pass 5>><</link>>
		<<else>>
			<<link [[Wait for a bite (0:05)|Fishing Beach Wait Loop]]>><<pass 5>><</link>>
		<</if>>
		<br>
		<<link [[Return to the beach|Beach]]>><<set $eventskip to 1>><<run stopFishingProp()>><<set $bus to "beach">><</link>>
	<</if>>
<</if>>
<<fishingBeachDebugLinks>>

/* Core fishing event loop. Sending the user here rolls for an event within the eventpool. */
:: Fishing Beach Wait Loop
<<cleareventpool>>

<<if fishingUsingMagnetRod()>>
	<<addinlineevent "magnetScrap" magnetLootWeight("fishingBeach", 5)>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingBeach")>>
		<<include "Fishing Beach Magnet Scrap Catch">>
	<</addinlineevent>>

	<<if !$fishing.singleCatch.cannonball>>
		<<addinlineevent "cannonball" 0.15>>
			<<include "Fishing Beach Magnet Pull Cannonball">>
		<</addinlineevent>>
	<</if>>
<<else>>
	<<addinlineevent "bite" fishingCatchEventWeight("fishingBeach", 10)>>
		<<set $fishingHookedFish to rollFish("fishingBeach")>>
		<<if fishingTriggersReelFight($fishingHookedFish)>>
			<<include "Fishing Beach Bite Big">>
		<<else>>
			You feel a tug on your line, then haul back on your rod, pulling <<a $fishingHookedFish.type>> out of the water without a fight.
			<<include "Fishing Beach Catch">>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "trash" 1>>
		<<set $fishingTrash to rollFishingTrash("fishingBeach")>>
		<<include "Fishing Beach Trash Catch">>
	<</addinlineevent>>

	<<addinlineevent "clothing" 1>>
		<<set $fishingClothingName to rollFishingClothing("fishingBeach")>>
		<<include "Fishing Beach Clothing Catch">>
	<</addinlineevent>>
<</if>>

/* Fisher event start */
<<if $daily.fishing.beach.fisher.phase is undefined and Time.hour lt 20 and !["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
	<<addinlineevent "fisherArrive" 0.5>>
		<<include "Fishing Beach Fisher Arrive">>
	<</addinlineevent>>
<</if>>

/* Fisher tips */
<<if $daily.fishing.beach.fisher.phase is "fishing" and $daily.fishing.beach.fisher.tipGiven is undefined and !fishingUsingMagnetRod()>>
	<<addinlineevent "fisherTipsOffer" 0.5>>
		<<include "Fishing Beach Fisher Tips Offer">>
	<</addinlineevent>>
<</if>>

/* Fisher cliff tip */
<<if $daily.fishing.beach.fisher.phase is "fishing" and numberOfFishCaught() gte 50 and !$fishing.locationsFound.includes("fishingCoastPath")>>
	<<addinlineevent "fisherCliffTipOffer" 1>>
		<<include "Fishing Beach Fisher Cliff Tip Offer">>
	<</addinlineevent>>
<</if>>

/* Fisher leaves */
<<if $daily.fishing.beach.fisher.phase is "fishing">>
	<<if Time.hour gte 20>>
		<<addinlineevent "fisherLeaveNight" 10>>
			<<include "Fishing Beach Fisher Leave Night">>
		<</addinlineevent>>
	<<elseif ["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
		<<addinlineevent "fisherLeaveWeather" 10>>
			<<include "Fishing Beach Fisher Leave Weather">>
		<</addinlineevent>>
	<</if>>
<</if>>

/* Fisher attacks if player is exposed */
<<if $daily.fishing.beach.fisher.phase is "fishing" and $exposed gte 1>>
	<<addinlineevent "fisherExposedAttack" fishingDangerEventWeight($daily.fishing.beach.fisherOgle)>>
		<<include "Fishing Beach Fisher Exposed Attack">>
	<</addinlineevent>>
<</if>>

/* Bystander notices exposed player */
<<if $exposed gte 1 and Weather.dayState is "day">>
	<<addinlineevent "exposedNoticed" fishingDangerEventWeight(1)>>
		<<run stopFishingProp()>>
		<<beachex1>>
	<</addinlineevent>>
	<<addinlineevent "exposedMolestation" fishingDangerEventWeight(1)>>
		<<run stopFishingProp()>>
		<<beachex2>>
	<</addinlineevent>>
<</if>>

/* Wind blows skirt */
<<addinlineevent "beachWind" .2>>
	<<beachday4>>
<</addinlineevent>>

/* Wave soaks the PC */
<<addinlineevent "beachWave" .2>>
	<<include "Fishing Beach Wave">>
<</addinlineevent>>

/* Dog tearing at clothing */
<<if [undefined, "finished"].includes($daily.fishing.beach.fisher.phase)>>
	<<addinlineevent "beachDog" fishingDangerEventWeight(3.5)>>
		<<beachday2>>
	<</addinlineevent>>
<</if>>

<<if Weather.dayState is "day">>
	/* Beach molestation */
	<<if [undefined, "finished"].includes($daily.fishing.beach.fisher.phase)>>
		<<addinlineevent "beachMolestation" fishingDangerEventWeight(3.5)>>
			<<include "Fishing Beach Molestation">>
		<</addinlineevent>>
	<</if>>

	/* See a parent on the beach */
	<<addinlineevent "beachParent" 1>>
		<<beachday3>>
	<</addinlineevent>>

	/* Classmates approach */
	<<addinlineevent "beachClassmates" 1>>
		<<include "Fishing Beach Classmates">>
	<</addinlineevent>>
<</if>>


<<if Weather.dayState is "night">>
	<<addinlineevent "nightDog" fishingDangerEventWeight(3.5)>>
		<<beachnight1>>
	<</addinlineevent>>
	<<addinlineevent "beachNightTentacles" fishingDangerEventWeight(1)>>
		<<include "Fishing Beach Tentacles">>
	<</addinlineevent>>
<</if>>

/* Nothing happens, wait loop continues */
<<addinlineevent "wait" 25>>
	<<include "Fishing Beach Wait">>
<</addinlineevent>>
<<runeventpool>>


:: Fishing Beach Bite Big
<<effects>>
<<set $fishingReelAttempts to 0>>
Something takes the bait and runs with it, your rod bending toward the surf.<<if $fishingHookedFish.aboveAverageSize>> You can see a <span class="pink">big</span> <<print $fishingHookedFish.type>> below the surface.<<else>> Looks like <<a $fishingHookedFish.type>>, big enough to give you some trouble.<</if>>
<br><br>

<<set _reelDifficultyMax to Math.clamp($fishingHookedFish.size * 10, 600, 1400)>>
<<link [[Try to reel it in|Fishing Beach Reel]]>><</link>><<athleticsdifficulty -250 _reelDifficultyMax>>
<br>
<<link [[Cut the line|Fishing Beach Cut Line]]>><</link>>


:: Fishing Beach Throw Back
<<effects>>
You toss the <<print $fishingHookedFish.type>> back into the sea.
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Beach Wait]]>><</link>>


:: Fishing Beach Keep
<<effects>>
You stow the <<print $fishingHookedFish.type>> away.
<<tending_give $fishingHookedFish.type 1>>

<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Beach Wait]]>><</link>>


:: Fishing Beach Cat Eat
<<effects>>
You open wide and drop the whole <<print $fishingHookedFish.type>> in your mouth. <<transform cat 1>><<lstress>><<stress -6>>
<<unset $fishingHookedFish>>
<br><br>

<<link [[Next|Fishing Beach Wait]]>><</link>>


:: Widgets Fishing Beach Wait Flavor [widget]
/* Text that appears above the description of the PC waiting for a bite. Used for describing what other NPCs or animals are doing if they are present next to the player. */
<<widget "fishingBeachAmbient">>
	<<if $daily.fishing.beach.fisher.phase is "fishing">>
		<<fishingBeachFisherAmbient>>
	<</if>>
<</widget>>

/* Text that is used to generally describe the PC waiting for a bite. Also includes the PC being alone with their thoughts, and descriptions of the PC noticing things around them, like the weather or noises around them that could signify that something dangerous about to happen. Also used to describe the player when they take an action other than waiting for a bite. */
<<widget "fishingBeachWaitAmbient">>
	<<cleareventpool>>
	<<fishingWaitAmbient $bus>>

	<<if beachCampfirePartyPresent()>>
		<<fishingWaitAmbientCampfireParty>>
	<</if>>
	<<runeventpool>>
<</widget>>
