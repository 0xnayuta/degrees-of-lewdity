:: Fishing Beach Catch
<<effects>>
<<if Weather.dayState is "day" and ($daily.fishing.fishingBeach.fisher.phase is "finished" or $daily.fishing.fishingBeach.fisher.phase is undefined) and $rng gte 92 and $daily.fishing.seagullSteal is undefined>>
	<<fishingSeagullCaught $fishingHookedFish $bus>>
<<elseif $daily.fishing.fishingBeach.fisher.phase is "fishing" and fishingArrivalTimePassed(60) and $daily.fishing.fishingBeach.fisher.drunk gte 1 and $rng gte 80>>
	<<fishingBeachCaughtFisherDrunk>>
<<elseif beachCampfirePartyPresent() and $rng gte 75 and $daily.fishing.fishingBeach.partyFeed is undefined and canCookFish($fishingHookedFish.type)>>
	<<fishingBeachCaughtCampfireCook>>
<<else>>
	<<fishingBeachCaught>>
<</if>>


:: Widgets Fishing Beach Catch [widget]
<<widget "fishingBeachCaught">>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<run updateFishRecord($fishingHookedFish.type, $fishingHookedFish.size, $bus)>>
	<<run stopFishingProp()>>
	<<set _fishPropName to "caught-" + $fishingHookedFish.type>>
	<<wearProp _fishPropName>>

	<<fishingCatchFishText $fishingHookedFish>>
	<br><br>

	<<if _canEatFish>>
		It's such a small fish, you could probably fit the whole thing in your mouth.
		<br><br>
	<</if>>

	<<link [["Stow the " + $fishingHookedFish.type + " away"|Fishing Beach Wait]]>><<tending_give $fishingHookedFish.type 1>><<set $fishingAmbientOverride to "stowAway">><</link>>
	<br>
	<<link [[Throw it back|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "throwBack">><</link>>
	<<if _canEatFish>>
		<br>
		<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
			<<link [[Eat the fish|Fishing Beach Cat Eat Fisher]]>><</link>><<cat>>
		<<else>>
			<<link [[Eat the fish|Fishing Beach Cat Eat]]>><</link>><<cat>>
		<</if>>
	<</if>>
<</widget>>
