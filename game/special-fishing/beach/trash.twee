:: Fishing Beach Trash Catch
<<effects>>
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
	<<fishingBeachTrashCaughtFisher>>
<<else>>
	<<fishingBeachTrashCaught>>
<</if>>


:: Widgets Fishing Beach Trash Catch [widget]
<<widget "fishingBeachTrashCaught">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<link [[Next|Fishing Beach Wait]]>><</link>>
<</widget>>

<<widget "fishingBeachTrashCaughtFisher">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught += 1>>
	<br><br>

	<<if $rng lt 50>>
		<<loadNPC 0 "fishing_beach_npc_fisher">><<person1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"More junk than fish in there some days," the <<personsimple>> says, glancing at your catch.
			<<case 2>>
				The <<personsimple>> shakes <<his>> head. "People'll throw their rubbish anywhere. No respect for the place."
		<</switch>>
		<br><br>
	<</if>>

	<<link [[Next|Fishing Beach Wait]]>><<endevent>><</link>>
<</widget>>
