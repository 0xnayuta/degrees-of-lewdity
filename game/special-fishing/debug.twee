<<widget "fishingMoorDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Moor Catch]]>>
		<<set $fishingHookedFish to rollFish("fishingMoor")>>
	<</link>>
	<br>
	<<link [[Bite (huge)|Fishing Moor Bite Big]]>>
		<<set $fishingHookedFish to rollFish("fishingMoor")>>
		<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, setup.fishing.reelFightMinSize)>>
		<<set $fishingHookedFish.aboveAverageSize to true>>
	<</link>>
	<br>
	<<link [[Magnet scrap|Fishing Moor Magnet Scrap Catch]]>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingMoor")>>
	<</link>>
	<br>
	<<link [[Trash catch|Fishing Moor Trash Catch]]>>
		<<set $fishingTrash to rollFishingTrash("fishingMoor")>>
	<</link>>
	<br>
	<<link [[Cat attack|Fishing Moor Cat Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Lurker attack|Fishing Moor Lurker Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Hiker attack|Fishing Moor Hiker Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
	<</link>>
	<br>
	<<link [[Hiker arrive|Fishing Moor Hiker Arrive]]>>
		<<set $fishing.moor.event to "moorHikers">>
		<<set $fishing.moor.eventDanger to 0>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Hiker drink offer|Fishing Moor Hiker Drink Offer]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.drinkOffered to undefined>>
		<<set $daily.fishing.moor.hikers.drinkCount to 0>>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave|Fishing Moor Hiker Leave]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave weather|Fishing Moor Hiker Leave Weather]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave dusk|Fishing Moor Hiker Leave Dusk]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave night|Fishing Moor Hiker Leave Night]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Fox arrive|Fishing Moor Fox Arrive]]>>
		<<set $fishing.moor.event to "none">>
		<<set $daily.fishing.moor.fox.phase to undefined>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
	<</link>>
	<br>
	<<link [[Hiker flirt|Fishing Moor Hiker Flirt]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.flirt to undefined>>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Spiked drink|Fishing Moor Spiked Drink 1]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.drinkCount to 1>>
		<<set $daily.fishing.moor.hikers.spike to true>>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Catch: hikers|Fishing Debug Moor Catch Hikers]]>><</link>> (run Hiker Arrive first)
	<br>
	<<link [[Catch: campfire cook|Fishing Debug Moor Catch Campfire Cook]]>><</link>> (run Hiker Arrive first)
	<br>
	<<link [[Catch: fox|Fishing Debug Moor Catch Fox]]>><</link>>
<</widget>>

<<widget "fishingPierDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Pier Catch]]>>
		<<set $fishingHookedFish to rollFish("fishingPier")>>
	<</link>>
	<br>
	<<link [[Bite (huge)|Fishing Pier Bite Big]]>>
		<<set $fishingHookedFish to rollFish("fishingPier")>>
		<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, setup.fishing.reelFightMinSize)>>
		<<set $fishingHookedFish.aboveAverageSize to true>>
	<</link>>
	<br>
	<<link [[Magnet scrap|Fishing Pier Magnet Scrap Catch]]>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingPier")>>
	<</link>>
	<br>
	<<link [[Trash catch|Fishing Pier Trash Catch]]>>
		<<set $fishingTrash to rollFishingTrash("fishingPier")>>
	<</link>>
	<br>
	<<link [[Fisher arrive|Fishing Pier Fisher Arrive]]>>
		<<set $daily.fishing.pier.fisher.phase to undefined>>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Whitney bully fisher|Fishing Pier Whitney Bully Fisher]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Tentacles|Fishing Pier Tentacles]]>>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
	<</link>>
	<br>
	<<link [[Wind|Fishing Pier Wind]]>>
		<<run Weather.set("storm", true)>>
	<</link>>
	<br>
	<<link [[Fisher tips offer|Fishing Pier Fisher Tips Offer]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $daily.fishing.pier.fisher.tipGiven to undefined>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher leave night|Fishing Pier Fisher Leave Night]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher leave weather|Fishing Pier Fisher Leave Weather]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher saved on pier|Fishing Pier Fisher Saved On Pier]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $phase to 0>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher saved from water|Fishing Pier Fisher Saved From Water]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $phase to 1>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Whitney cider offer|Fishing Whitney Drink Offer]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
		<<set $daily.fishing.pier.whitney.pcCider to 0>>
	<</link>>
	<br>
	<<link [[Whitney bet|Fishing Whitney Pier Bet]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney idle leave|Fishing Pier Whitney Idle Leave]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
		<<set $daily.fishing.pier.whitney.age to 13>>
	<</link>>
	<br>
	<<link [[Whitney idle leave: heavy weather|Fishing Pier Whitney Idle Leave Weather Heavy]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney idle leave: night|Fishing Pier Whitney Leave Night]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney bet leave: heavy weather|Fishing Pier Whitney Bet Leave Weather Heavy]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
	<</link>>
	<br>
	<<link [[Whitney bet leave: night|Fishing Pier Whitney Bet Leave Night]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
	<</link>>
	<br>
	<<link [[Whitney bet: light rain stay|Fishing Pier Whitney Bet Weather Light]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
		<<set $daily.fishing.pier.whitney.rainLeave to undefined>>
	<</link>>
	<br>
	<<link [[Wave|Fishing Pier Wave]]>><</link>>
	<br>
	<<link [[Swarm|Fishing Pier Swarm]]>><</link>>
	<br>
	<<link [[Catch: seagull|Fishing Debug Pier Catch Seagull]]>><</link>>
	<br>
	<<link [[Catch: Whitney kiss|Fishing Debug Pier Catch Whitney Kiss]]>><</link>>
	<br>
	<<link [[Catch: Whitney bet win|Fishing Debug Pier Catch Whitney Bet]]>><</link>>
	<br>
	<<link [[Catch: fisher drunk|Fishing Debug Pier Catch Fisher Drunk]]>><</link>> (run Fisher Arrive first)
	<br>
	<<link [[Clothing catch|Fishing Pier Clothing Catch]]>>
		<<set $fishingClothingName to rollFishingClothing("fishingPier")>>
	<</link>>
<</widget>>


:: Fishing Debug Forest Lake Catch
<<set $fishingHookedFish ??= rollFish("fishingForestLake")>>
<<fishingForestLakeCaught>>


:: Fishing Debug Beach Parent
<<beachday3>>


:: Fishing Debug Beach Night Dog
<<beachnight1>>


:: Fishing Debug Beach Night Molestation
<<beachnight2>>


:: Fishing Debug Beach Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught $fishingHookedFish "fishingBeach">>


:: Fishing Debug Beach Catch Campfire Cook
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.beach.partyFeed to undefined>>
<<fishingBeachCaughtCampfireCook>>


:: Fishing Debug Beach Catch Fisher Drunk
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.beach.fisher.phase to "fishing">>
<<set $daily.fishing.beach.fisher.drunk to 1>>
<<fishingBeachCaughtFisherDrunk>>


:: Fishing Debug Coast Path Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingCoastPath")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught $fishingHookedFish "fishingCoastPath">>


:: Fishing Debug Pier Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught $fishingHookedFish "fishingPier">>


:: Fishing Debug Pier Catch Whitney Kiss
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.pier.whitney.phase to "idle">>
<<set $daily.fishing.pier.whitney.fishKiss to undefined>>
<<fishingPierCaughtWhitneyKiss>>


:: Fishing Debug Pier Catch Whitney Bet
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.pier.whitney.phase to "bet">>
<<fishingPierCaughtWhitneyBet>>


:: Fishing Debug Pier Catch Fisher Drunk
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.pier.fisher.phase to "fishing">>
<<set $daily.fishing.pier.fisher.drunk to 4>>
<<fishingPierCaughtFisherDrunk>>


:: Fishing Debug Moor Catch Hikers
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<set $daily.fishing.moor.hikers.phase to "sit">>
<<fishingMoorCaughtHikers>>


:: Fishing Debug Moor Catch Campfire Cook
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<set $daily.fishing.moor.hikers.phase to "sit">>
<<loadNPC 0 "moor_hiker_1">><<person1>>
<<loadNPC 1 "moor_hiker_2">><<person2>>
<<include "Fishing Moor Campfire Cook">>


:: Fishing Debug Moor Catch Fox
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<beastNEWinit 1 fox>>
<<set $daily.fishing.moor.fox.phase to "watching">>
<<set $daily.fishing.moor.fox.closeness to 8>>
<<set $daily.fishing.moor.fox.anger to 0>>
<<fishingMoorCaughtFox>>
