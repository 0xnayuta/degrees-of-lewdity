:: Fishing Debug Forest Lake Catch
<<fishCombatForestLakeCaught>>


:: Fishing Debug Beach Parent
<<beachday3>>


:: Fishing Debug Beach Night Dog
<<beachnight1>>


:: Fishing Debug Beach Night Molestation
<<beachnight2>>


:: Fishing Debug Beach Catch Seagull
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught "beach">>


:: Fishing Debug Beach Catch Campfire Cook
<<set $daily.fishing.beach.partyFeed to undefined>>
<<fishCombatBeachCaughtCampfireCook>>


:: Fishing Debug Beach Catch Fisher Drunk
<<set $daily.fishing.beach.fisher.phase to "fishing">>
<<set $daily.fishing.beach.fisher.drunk to 1>>
<<fishCombatBeachCaughtFisherDrunk>>


:: Fishing Debug Coast Path Catch Seagull
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught "coastPath">>


:: Fishing Debug Pier Catch Seagull
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCaught "pier">>


:: Fishing Debug Pier Catch Whitney Kiss
<<set $daily.fishing.pier.whitney.phase to "idle">>
<<set $daily.fishing.pier.whitney.fishKiss to undefined>>
<<fishCombatPierCaughtWhitneyKiss>>


:: Fishing Debug Pier Catch Whitney Bet
<<set $daily.fishing.pier.whitney.phase to "bet">>
<<fishCombatPierCaughtWhitneyBet>>


:: Fishing Debug Pier Catch Fisher Drunk
<<set $daily.fishing.pier.fisher.phase to "fishing">>
<<set $daily.fishing.pier.fisher.drunk to 4>>
<<fishCombatPierCaughtFisherDrunk>>


:: Fishing Debug Moor Catch Hikers
<<set $daily.fishing.moor.hikers.phase to "sit">>
<<fishCombatMoorCaughtHikers>>


:: Fishing Debug Moor Catch Campfire Cook
<<run endFishingCombat()>>
<<set $daily.fishing.moor.hikers.phase to "sit">>
<<loadNPC 0 "moor_hiker_1">><<person1>>
<<loadNPC 1 "moor_hiker_2">><<person2>>
<<include "Fishing Moor Campfire Cook">>


:: Fishing Debug Moor Catch Fox
<<beastNEWinit 1 fox>>
<<set $daily.fishing.moor.fox.phase to "watching">>
<<set $daily.fishing.moor.fox.closeness to 8>>
<<set $daily.fishing.moor.fox.anger to 0>>
<<fishCombatMoorCaughtFox>>
