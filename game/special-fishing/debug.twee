:: Widgets Fishing Debug [widget]

<<widget "fishingBeachDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Beach Catch]]>>
		<<set $fishingHookedFish to rollFish("fishingBeach")>>
	<</link>>
	<br>
	<<link [[Bite (huge)|Fishing Beach Bite Big]]>>
		<<set $fishingHookedFish to rollFish("fishingBeach")>>
		<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, setup.fishing.reelFightMinSize)>>
		<<set $fishingHookedFish.aboveAverageSize to true>>
	<</link>>
	<br>
	<<link [[Magnet scrap|Fishing Beach Magnet Scrap Catch]]>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingBeach")>>
	<</link>>
	<br>
	<<link [[Trash catch|Fishing Beach Trash Catch]]>>
		<<set $fishingTrash to rollFishingTrash("fishingBeach")>>
	<</link>>
	<br>
	<<link [[Fisher arrive|Fishing Beach Fisher Arrive]]>>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Fisher tips offer|Fishing Beach Fisher Tips Offer]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
		<<set $daily.fishing.beach.fisher.tipGiven to undefined>>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Molestation|Fishing Beach Molestation]]>>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
	<</link>>
	<br>
	<<link [[Night tentacles|Fishing Beach Tentacles]]>><</link>>
	<br>
	<<link [[Beach wind|Fishing Beach Wait Loop]]>><<set $eventPoolOverride to "beachWind">><</link>>
	<br>
	<<link [[Beach dog|Fishing Beach Wait Loop]]>>
		<<set $eventPoolOverride to "beachDog">>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
	<</link>>
	<br>
	<<link [[Beach parent|Fishing Debug Beach Parent]]>><</link>>
	<br>
	<<link [[Classmates|Fishing Beach Classmates]]>><</link>>
	<br>
	<<link [[Fisher leave night|Fishing Beach Fisher Leave Night]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Fisher leave weather|Fishing Beach Fisher Leave Weather]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
		<<run Weather.set("storm", true)>>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Night dog|Fishing Debug Beach Night Dog]]>><</link>>
	<br>
	<<link [[Night molestation|Fishing Debug Beach Night Molestation]]>><</link>>
	<br>
	<<link [[Wave|Fishing Beach Wave]]>><</link>>
	<br>
	<<link [[Catch: seagull|Fishing Debug Beach Catch Seagull]]>><</link>>
	<br>
	<<link [[Catch: campfire cook|Fishing Debug Beach Catch Campfire Cook]]>><</link>>
	<br>
	<<link [[Catch: fisher drunk|Fishing Debug Beach Catch Fisher Drunk]]>><</link>> (run Fisher Arrive first)
	<br>
	<<link [[Clothing catch|Fishing Beach Clothing Catch]]>>
		<<set $fishingClothingName to rollFishingClothing("fishingBeach")>>
	<</link>>
<</widget>>

<<widget "fishingCoastPathDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Coast Path Catch]]>>
		<<set $fishingHookedFish to rollFish("fishingCoastPath")>>
	<</link>>
	<br>
	<<link [[Bite (huge)|Fishing Coast Path Bite Big]]>>
		<<set $fishingHookedFish to rollFish("fishingCoastPath")>>
		<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, setup.fishing.reelFightMinSize)>>
		<<set $fishingHookedFish.aboveAverageSize to true>>
	<</link>>
	<br>
	<<link [[Magnet scrap|Fishing Coast Path Magnet Scrap Catch]]>>
		<<set $fishingMagnetScrap to rollMagnetScrap("fishingCoastPath")>>
	<</link>>
	<br>
	<<link [[Trash catch|Fishing Coast Path Trash Catch]]>>
		<<set $fishingTrash to rollFishingTrash("fishingCoastPath")>>
	<</link>>
	<br>
	<<link [[Catch: seagull|Fishing Debug Coast Path Catch Seagull]]>><</link>>
	<br>
	<<link [[Clothing catch|Fishing Coast Path Clothing Catch]]>>
		<<set $fishingClothingName to rollFishingClothing("fishingCoastPath")>>
	<</link>>
<</widget>>

