:: Widgets Fishing Debug [widget]
<<widget "fishingMinigameDebugTeleportWidget">>
	<<if !["Fishing Pier Wait", "Fishing Beach Wait", "Fishing Coast Path Wait", "Fishing Forest Lake Wait", "Fishing Moor Wait"].includes($passage)>>
		<<set $location to "mer_pier">>
		<<set $outside to 1>>
		<<set $bus to "fishingPier">>
		<<set $worn.handheld to clone(setup.clothes.handheld.find(item => item.name is "fishing rod"))>>
		<<tending_give bait_worm 100>>
		<<run initFishingPier()>>
	<</if>>
	<<set $fishingHookedFish to { type: _args[0], size: setup.fishing.lootTables.fish[_args[0]].maxSize }>>
	<<run fishingMinigameStart(_args[0])>>
<</widget>>

<<widget "fishingBeachDebugLinks">>
	<<if V.debug is 1>>
		<br><br><br><br><br>
		Fishing Event Debug
		<br>
		<<link [[Bite|Fishing Beach Catch]]>>
			<<set $fishingHookedFish to rollFish("fishingBeach")>>
		<</link>>
		<br>
		<<link [[Minigame|Fishing Beach Minigame Loop]]>>
			<<set $fishingHookedFish to rollFish("fishingBeach")>>
			<<for _i to 0; _i lt 67 and !setup.fishing.lootTables.fish[$fishingHookedFish.type].minigame; _i++>>
				<<set $fishingHookedFish to rollFish("fishingBeach")>>
			<</for>>
			<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, 35)>>

			<<run fishingMinigameStart($fishingHookedFish.type)>>
		<</link>>
		<br>
		<<link [[Trash catch|Fishing Beach Trash Catch]]>>
			<<set $fishingTrash to rollFishingTrash("fishingBeach")>>
		<</link>>
		<br>
		<<link [[Fisher arrive|Fishing Beach Fisher Arrive]]>>
			<<set $daily.fishing.fishingBeach.fisher.phase to undefined>>
			<<run Weather.set("clear", true)>>
		<</link>>
		<br>
		<<link [[Molestation|Fishing Beach Molestation]]>>
			<<set $daily.fishing.fishingBeach.fisher.phase to undefined>>
		<</link>>
		<br>
		<<link [[Night tentacles|Fishing Beach Tentacles]]>><</link>>
		<br>
		<<link [[Beach wind|Fishing Beach Wait Loop]]>><<set $eventPoolOverride to "beachWind">><</link>>
		<br>
		<<link [[Beach dog|Fishing Beach Wait Loop]]>>
			<<set $eventPoolOverride to "beachDog">>
			<<set $daily.fishing.fishingBeach.fisher.phase to undefined>>
		<</link>>
		<br>
		<<link [[Beach parent|Fishing Debug Beach Parent]]>><</link>>
		<br>
		<<link [[Classmates|Fishing Beach Classmates]]>><</link>>
		<br>
		<<link [[Fisher leave night|Fishing Beach Fisher Leave Night]]>>
			<<set $daily.fishing.fishingBeach.fisher.phase to "fishing">>
		<</link>> (Fisher Arrive should be ran first)
		<br>
		<<link [[Fisher leave weather|Fishing Beach Fisher Leave Weather]]>>
			<<set $daily.fishing.fishingBeach.fisher.phase to "fishing">>
			<<run Weather.set("storm", true)>>
		<</link>> (Fisher Arrive should be ran first)
		<br>
		<<link [[Night dog|Fishing Debug Beach Night Dog]]>><</link>>
		<br>
		<<link [[Night molestation|Fishing Debug Beach Night Molestation]]>><</link>>
		<br>
		<<link [[Wave|Fishing Beach Wave]]>><</link>>
		<br>
		<<link [[Catch: seagull|Fishing Debug Beach Catch Seagull]]>><</link>>
		<br>
		<<link [[Catch: campfire cook|Fishing Debug Beach Catch Campfire Cook]]>><</link>>
		<br>
		<<link [[Catch: fisher drunk|Fishing Debug Beach Catch Fisher Drunk]]>><</link>> (run Fisher Arrive first)
		<br>
		<<link [[Clothing catch|Fishing Beach Clothing Catch]]>>
			<<set $clothingItem to rollFishingClothing("fishingBeach")>>
		<</link>>
	<</if>>
<</widget>>

<<widget "fishingCoastPathDebugLinks">>
	<<if V.debug is 1>>
		<br><br><br><br><br>
		Fishing Event Debug
		<br><br>
