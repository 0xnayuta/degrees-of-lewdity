:: Widgets Fishing Debug [widget]

<<widget "fishingBeachDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Beach Bite]]>>
		<<set $fishingHookedFish to rollFish("beach")>>
	<</link>>
	<br>
	<<link [[Fisher arrive|Fishing Beach Fisher Arrive]]>>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Robin lemonade|Fishing Robin Lemonade Give]]>>
		<<set $daily.fishing.beach.robinLemonadeVisited to undefined>>
	<</link>>
	<br>
	<<link [[Fisher tips offer|Fishing Beach Fisher Tips Offer]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
		<<set $daily.fishing.beach.fisher.tipGiven to undefined>>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Molestation|Fishing Beach Molestation]]>>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
	<</link>>
	<br>
	<<link [[Night tentacles|Fishing Beach Tentacle Event]]>><</link>>
	<br>
	<<link [[Beach wind|Fishing Beach Wait Loop]]>><<set $eventPoolOverride to "beachWind">><</link>>
	<br>
	<<link [[Beach dog|Fishing Beach Wait Loop]]>>
		<<set $eventPoolOverride to "beachDog">>
		<<set $daily.fishing.beach.fisher.phase to undefined>>
	<</link>>
	<br>
	<<link [[Beach parent|Fishing Debug Beach Parent]]>><</link>>
	<br>
	<<link [[Classmates|Fishing Beach Classmates]]>><</link>>
	<br>
	<<link [[Fisher leave night|Fishing Beach Fisher Leave Night]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Fisher leave weather|Fishing Beach Fisher Leave Weather]]>>
		<<set $daily.fishing.beach.fisher.phase to "fishing">>
		<<run Weather.set("storm", true)>>
	<</link>> (Fisher Arrive should be ran first)
	<br>
	<<link [[Night dog|Fishing Debug Beach Night Dog]]>><</link>>
	<br>
	<<link [[Night molestation|Fishing Debug Beach Night Molestation]]>><</link>>
	<br>
	<<link [[Wave|Fishing Beach Wave]]>><</link>>
<</widget>>

<<widget "fishingCoastPathDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Coast Path Bite]]>>
		<<set $fishingHookedFish to rollFish("coastPath")>>
	<</link>>
<</widget>>

<<widget "fishingForestLakeDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Forest Lake Bite]]>>
		<<set $fishingHookedFish to rollFish("forestLake")>>
	<</link>>
	<br>
	<<link [[Wolf attack|Fishing Forest Lake Wolf Attack]]>>
		<<set $fishing.lake.event to "none">>
		<<set $fishing.lake.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Bear attack|Fishing Forest Lake Bear Attack]]>>
		<<set $fishing.lake.event to "none">>
		<<set $fishing.lake.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Boar attack|Fishing Forest Lake Boar Attack]]>>
		<<set $fishing.lake.event to "none">>
		<<set $fishing.lake.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Plant person|Fishing Forest Lake Plant Kiss Encounter]]>>
		<<set $fishing.lake.event to "none">>
		<<set $fishing.lake.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Plant vines|Fishing Forest Lake Plant Attack]]>>
		<<set $fishing.lake.event to "none">>
		<<set $fishing.lake.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Rock slip|Fishing Forest Lake Wait Loop]]>><<set $eventPoolOverride to "rockSlip">><</link>>
<</widget>>

<<widget "fishingMoorDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Moor Bite]]>>
		<<set $fishingHookedFish to rollFish("moor")>>
	<</link>>
	<br>
	<<link [[Cat attack|Fishing Moor Cat Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Lurker attack|Fishing Moor Lurker Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
	<</link>>
	<br>
	<<link [[Hiker attack|Fishing Moor Hiker Attack]]>>
		<<set $fishing.moor.event to "none">>
		<<set $fishing.moor.eventDanger to 0>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
	<</link>>
	<br>
	<<link [[Hiker arrive|Fishing Moor Hiker Arrive]]>>
		<<set $fishing.moor.event to "moorHikers">>
		<<set $fishing.moor.eventDanger to 0>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Hiker drink offer|Fishing Moor Hiker Drink Offer]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.drinkOffered to undefined>>
		<<set $daily.fishing.moor.hikers.drinkCount to 0>>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave|Fishing Moor Hiker Leave]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave weather|Fishing Moor Hiker Leave Weather]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave dusk|Fishing Moor Hiker Leave Dusk]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Hiker leave night|Fishing Moor Hiker Leave Night]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Fox arrive|Fishing Moor Fox Arrive]]>>
		<<set $fishing.moor.event to "none">>
		<<set $daily.fishing.moor.fox.phase to undefined>>
		<<set $daily.fishing.moor.hikers.phase to undefined>>
	<</link>>
	<br>
	<<link [[Hiker flirt|Fishing Moor Hiker Flirt]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.flirt to undefined>>
	<</link>> (run Hiker Arrive first)
	<br>
	<<link [[Spiked drink|Fishing Moor Spiked Drink 1]]>>
		<<set $daily.fishing.moor.hikers.phase to "sit">>
		<<set $daily.fishing.moor.hikers.drinkCount to 1>>
		<<set $daily.fishing.moor.hikers.spike to true>>
	<</link>> (run Hiker Arrive first)
<</widget>>

<<widget "fishingPierDebugLinks">>
	<br><br><br><br><br>
	Fishing Event Debug
	<br><br>
	<<link [[Bite|Fishing Pier Bite]]>>
		<<set $fishingHookedFish to rollFish("pier")>>
	<</link>>
	<br>
	<<link [[Fisher arrive|Fishing Pier Fisher Arrive]]>>
		<<set $daily.fishing.pier.fisher.phase to undefined>>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
		<<run Weather.set("clear", true)>>
	<</link>>
	<br>
	<<link [[Whitney bully fisher|Fishing Pier Whitney Bully Fisher]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Tentacles|Fishing Pier Tentacles]]>>
		<<set $daily.fishing.pier.whitney.phase to undefined>>
	<</link>>
	<br>
	<<link [[Wind|Fishing Pier Wind]]>>
		<<run Weather.set("storm", true)>>
	<</link>>
	<br>
	<<link [[Fisher tips offer|Fishing Pier Fisher Tips Offer]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
		<<set $daily.fishing.pier.fisher.tipGiven to undefined>>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher leave night|Fishing Pier Fisher Leave Night]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Fisher leave weather|Fishing Pier Fisher Leave Weather]]>>
		<<set $daily.fishing.pier.fisher.phase to "fishing">>
	<</link>> (run Fisher Arrive first)
	<br>
	<<link [[Whitney cider offer|Fishing Whitney Drink Offer]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
		<<set $daily.fishing.pier.whitney.pcCider to 0>>
	<</link>>
	<br>
	<<link [[Whitney bet|Fishing Whitney Pier Bet]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney idle leave|Fishing Pier Whitney Idle Leave]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
		<<set $daily.fishing.pier.whitney.age to 13>>
	<</link>>
	<br>
	<<link [[Whitney idle leave: heavy weather|Fishing Pier Whitney Idle Leave Weather Heavy]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney idle leave: night|Fishing Pier Whitney Leave Night]]>>
		<<set $daily.fishing.pier.whitney.phase to "idle">>
	<</link>>
	<br>
	<<link [[Whitney bet leave: heavy weather|Fishing Pier Whitney Bet Leave Weather Heavy]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
	<</link>>
	<br>
	<<link [[Whitney bet leave: night|Fishing Pier Whitney Bet Leave Night]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
	<</link>>
	<br>
	<<link [[Whitney bet: light rain stay|Fishing Pier Whitney Bet Weather Light]]>>
		<<set $daily.fishing.pier.whitney.phase to "bet">>
		<<set $daily.fishing.pier.whitney.rainLeave to undefined>>
	<</link>>
	<br>
	<<link [[Wave|Fishing Pier Wave]]>><</link>>
	<br>
	<<link [[Gwylan hypno chain|Fishing Pier Wait]]>> Will mess with Gwylan state
		<<set $gwylan to ($gwylan ?? {})>>
		<<set $hypnosis_traits.devotion to 3>>
		<<set $eventPoolOverride to "gwylanHypnoThought1">>
	<</link>>
<</widget>>

<<widget "fishingBeachCombatDebugLinks">>
	<br><br><br><br><br>
