		<<set $privatedanceoffered to 1>>
	<</if>>
	<<if !hasSexStat("promiscuity", 3) and $uncomfortable.prostituting is false>>
		<<His>> offer repulses you, but you need the money.
	<</if>>
	<br><br>
<</widget>>

<<widget "dancelonging">>
