:: Widgets Dance Actions [widget]

<<widget "danceactions">>
	<<exposure>>
	<<danceUpdateTF>>
	<<switch $dance.event>>
		<<case 0>>
			<<set _oldDanceAction to $dance.action>>
			<<if $exposed gte 2 and !hasSexStat("exhibitionism", 5) and $forceddance isnot 1 and !$danceStudio.job?.exposed and ($corruptionDancing is undefined or $dancelocation isnot "brothel")>>
				<!--
					No dancing if:
					Under 75 exhib, fully exposed, not forced, haven't chosen to dance despite exposure, (not at brothel or not corrupt dance)
				-->
			<<elseif $exposed gte 1 and !hasSexStat("exhibitionism", 3) and $forceddance isnot 1 and !$danceStudio.job?.exposed and ($corruptionDancing is undefined or $dancelocation isnot "brothel") and !$worn.under_lower.type.includes("dance")>>
				<!--
					No dancing if:
					Under 35 exhib, half exposed, not forced, haven't chosen to dance despite exposure,
					not wearing dance clothes, (not at brothel or not corrupt Dancing)
				-->
			<<else>>
				<!-- Generate "dance near" boxes -->
				<<if $audience gte 1>>
					<<for $_audienceMemberIndex to 0; $_audienceMemberIndex lt $enemyno; $_audienceMemberIndex++>> <!-- For each audience member 1-6 -->
						<<personSelect $_audienceMemberIndex>>
						<div class="dance_box">
							<label>
								<<if $NPCList[$_audienceMemberIndex].masturbating gte 1>>
									/* To prevent adding one more variable, favorite dance are linked to traits.
									This ensures that each NPC likes exactly one of the first four dances available to the player. */
									<<set _allDances to $dance.selected.concat($dance.transformation)>>
									<<if $NPCList[$_audienceMemberIndex].traits.includes("relaxed") and _oldDanceAction is _allDances[0]>>
										<span class="pink">The <<person>> masturbates.</span>
									<<elseif $NPCList[$_audienceMemberIndex].traits.includes("sociable") and _oldDanceAction is _allDances[1]>>
										<span class="pink">The <<person>> masturbates.</span>
									<<elseif $NPCList[$_audienceMemberIndex].traits.includes("brooding") and _oldDanceAction is _allDances[2]>>
										<span class="pink">The <<person>> masturbates.</span>
									<<elseif $NPCList[$_audienceMemberIndex].traits.includes("lecher") and _oldDanceAction is _allDances[3]>>
										<span class="pink">The <<person>> masturbates.</span>
									<<else>>
										The <<person>> stares intently.
									<</if>>
									<<dance_npc_masturbation_chance $_audienceMemberIndex>>
								<<else>>
									The <<person>> watches.
								<</if>>
								<<capture $_audienceMemberIndex>>
									| Dance near <<him>>. <<radiobutton "$dance_place" $_audienceMemberIndex autocheck>>
								<</capture>>
							</label>
						</div>
						<br>
					<</for>>
					<br>
				<</if>>

				/* Normal dances */
				<<for _style range $dance.selected>>
					<<set _info to setup.dance.normal[_style]>>
					<<if _info>>
						<label>
							<<set _tooltip to _info.details>>
							<<if _info.span>>
								<<print '<span class="tooltip-anchor ' + _info.span + '" @tooltip="_tooltip">' + _info.name + '</span>'>>
							<<else>>
								<<print '<span class="tooltip-anchor" @tooltip="_tooltip">' + _info.name + '</span>'>>
							<</if>>
							(0:01)
							<<if $dance.actionDefault is _style or ($dance.actionDefault is 0 and _style is $dance.selected[0])>>
								<<radiobutton "$dance.action" _style checked>>
							<<else>>
								<<radiobutton "$dance.action" _style>>
							<</if>>
						</label> |
						<br>
					<</if>>
				<</for>>

				/* TF-specific dances */
				<<for _style range $dance.transformation>>
					<<set _info to setup.dance.special[_style]>>
					<<if _info>>
						<<set _show to false>>
						<<switch _style>>
							<<case "atone">>
								<<if $fallenangel gte 2 and $audience gte 2>>
									<<set _show to true>>
								<</if>>
							<<case "groom">>
								<<if $cat gte 6 and $liquidoutsidecount gte 1 and !pcAreArmsBound("any")>>
									<<set _show to true>>
								<</if>>
							<<case "glide">>
								<<if $harpy gte 6 and !pcAreArmsBound("any")>>
									<<set _show to true>>
								<</if>>
							<<case "growl">>
								<<if $wolfgirl gte 6 and $audience gte 1>>
									<<set _show to true>>
								<</if>>
							<<case "milk">>
								<<outfitChecks>>
								<<if $cow gte 6 and $audience gte 1 and $exposedRaw is 2 and _topless and !pcAreArmsBound("any")>>
									<<set _show to true>>
								<</if>>
							<<case "radiate">>
								<<if $angel gte 6 and $audience gte 1 and $angelBanish gte 1>>
									<<set _show to true>>
								<</if>>
							<<case "drain">>
								<<if $demon gte 6 and $audience gte 1 and $audienceexcitement gte 1>>
									<<set _show to true>>
								<</if>>
							<<case "pounce">>
								<<if $fox gte 6 and $audience gte 1>>
									<<set _show to true>>
								<</if>>
						<</switch>>

						<<if _show>>
							<label>
								<<set _tooltip to _info.details>>
								<<if _info.span>>
									<<print '<span class="tooltip-anchor ' + _info.span + '" @tooltip="_tooltip">' + _info.name + '</span>'>>
								<<else>>
									<<print '<span class="tooltip-anchor" @tooltip="_tooltip">' + _info.name + '</span>'>>
								<</if>>
								(0:01)
								<<switch _style>>
									<<case "atone">><<fallenangel>>
									<<case "groom">><<cat>>
									<<case "glide">><<harpy>>
									<<case "growl">><<wolfgirl>>
									<<case "milk">><<cow>>
									<<case "radiate">><<angel>> <<angelBanishNote>>
									<<case "drain">><<demon>>
									<<case "pounce">><<fox>>
								<</switch>>
								<<if $dance.actionDefault is _style>>
									<<radiobutton "$dance.action" _style checked>>
								<<else>>
									<<radiobutton "$dance.action" _style>>
								<</if>>
							</label> |
							<br>
						<</if>>
					<</if>>
				<</for>>

				/* Smugglers' pub */
				<<if $dance.tankard isnot undefined and $dance.tankard.semen+$dance.tankard.goo gte 5 and hasSexStat("exhibitionism", 3)>>
					<label>
						<span class="lewd">Drink</span> (0:01) <<combatExhibitionist3>> 
						<<radiobutton "$dance.action" "tankard_sip">>
					</label> |
					<br>
				<</if>>

				<!-- Generate stripping dance actions -->
				<<dancestripactions>>
				<br><br>
				<<link [[Continue|$passage]]>><</link>>
				<br>
			<</if>>
		<<case "vip">>
			<<link [[Allow|$passage]]>><<set $dance.action to "vipallow">><</link>>
			<br>
			<<link [[Push away|$passage]]>><<set $dance.action to "vippush">><</link>>
			<br>
		<<case "darryl">>
			<<link [[Reassure|$passage]]>><<set $dance.action to "darrylreassure">><<npcincr Darryl love 1>><</link>><<glove "Darryl" "simple">>
			<br>
			<<link [[Pull Darryl onto the stage|$passage]]>><<set $dance.action to "darrylpull">><</link>>
			<br>
		<<case "briar">>
			<<link [[Wink at Briar|$passage]]>><<set $dance.action to "briarwink">><<npcincr Briar love 1>><</link>><<glove "Briar" "simple">>
			<br>
			<<if hasSexStat("promiscuity", 3)>>
				<<link [[Seduce Briar|$passage]]>><<set $dance.action to "briarseduce">><</link>><<promiscuous3>>
				<br>
			<<else>>
				<span class="blue">The thought of seducing Briar strikes your mind, but you're not promiscuous enough.</span>
				<br>
			<</if>>
		<<case "strippertrouble">>
			<<link [[Intervene|$passage]]>><<set $dance.action to "stripperhelp">><</link>>
			<br>
			<<link [[Ignore|$passage]]>><<set $dance.action to "stripperignore">><</link>>
			<br>
		<<case "note">>
			<<link [[Approach|$passage]]>><<set $dance.action to "noteapproach">><</link>>
			<br>
			<<link [[Ignore|$passage]]>><<set $dance.action to "noteignore">><</link>>
			<br>
		<<case "rape">>
		<<case "molest">>
			<<link [[Let them cop a feel|$passage]]>><<set $dance.action to "cop">><</link>>
			<br>
			<<if $dancelocation is "brothel" and $corruptionDancing isnot undefined>>
				The slime in your ear prevents you from ending the show.
			<<elseif $forceddance isnot 1>>
				<<link [["It's too dangerous, time to end the show"|$passage]]>><<set $dance.action to "finish">><</link>>
				<br>
			<</if>>
		<<case "skirtstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "skirtstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "skirtsurrender">><</link>>
			<br>
		<<case "overlowerstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "overlowerstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "overlowersurrender">><</link>>
			<br>
		<<case "lowerstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "lowerstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "lowersurrender">><</link>>
			<br>
		<<case "overupperstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "overupperstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "overuppersurrender">><</link>>
			<br>
		<<case "upperstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "upperstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "uppersurrender">><</link>>
			<br>
		<<case "understrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "understruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "undersurrender">><</link>>
			<br>
		<<case "underupperstrip">>
			<<link [[Struggle for your clothes|$passage]]>><<set $dance.action to "underupperstruggle">><</link>>
			<br>
			<<link [[Surrender your clothes|$passage]]>><<set $dance.action to "underuppersurrender">><</link>>
			<br>
		<<case "private" and $dancelocation isnot "underground">>
			<<link [[Ignore|$passage]]>><<set $dance.action to "privaterefuse">><</link>>
			<br>
		<<case "leighton">>
			<<link [[Ignore|$passage]]>><<set $weekly.leighton.waitingInBrothelDressingRoom to true>><</link>>
			<br>
		<<case "robin">>
			<<link [[Ignore|$passage]]>><<set $dance.action to "robinignore">><<npcincr Robin love -5>><<npcincr Robin dom -20>><</link>>
			<br>
		<<case "drink">>
			<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
				<span class="blue">You can't bring yourself to drink while you know you're with child.</span>
				<br>
			<<else>>
				<<link [[Drink|$passage]]>><<set $dance.action to "drink">><</link>><<dancedifficulty 1 `800 + $drunk`>><<gdrunk>>
				<br>
				<<link [[Drink carefully|$passage]]>><<set $dance.action to "drink_careful">><</link>><<gdrunk>>
				<br>
			<</if>>
			<<link [[Ignore|$passage]]>><<set $dance.action to "drink_ignore">><</link>>
			<br>
		<<case "light">>
			<<if hasSexStat("exhibitionism", 5)>>
				<<link [[Flaunt|$passage]]>><<set $dance.action to "light_flaunt">><</link>><<ginterest>>
				<br>
			<</if>>
			<<if $forceddance is 1 or $danceStudio.job?.exposed>>
				<<link [[Cover yourself|$passage]]>><<set $dance.action to "light_cover">><</link>>
				<br>
			<</if>>
		<<case "corruptionDance">>
			<<if hasSexStat("promiscuity", 5) and $submissive gte 1900>>
				<<link [[Submit willingly|$passage]]>>
					<<corruption 3>><<pain -8>><<stress -12>><<trauma -24>><<sub 2>>
					<<set $corruptionResult to "submit">><<set $dance.action to "corruptionResult">>
				<</link>><<promiscuous5>><<ggcorruption>><<llpain>><<llltrauma>><<llstress>>
				<br>
			<</if>>
			<<link [[Obey|$passage]]>>
				<<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 1>>
				<<set $corruptionResult to "obey">><<set $dance.action to "corruptionResult">>
			<</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
			<br>
			<<link [[Defy|$passage]]>>
				<<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>>
				<<set $corruptionResult to "defy">><<set $dance.action to "corruptionResult">>
			<</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
			<br>
		<<case "tankard">>
			<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
				<span class="blue">You can't bring yourself to drink while you know you're with child.</span>
				<br>
			<<else>>
				<<if hasSexStat("exhibitionism", 2)>>
					<<link [[Drink it and keep the tankard|$passage]]>><<set $dance.action to "tankard_drink_keep">><</link>><<gdrunk>><<exhibitionist2>>
					<br>
				<</if>>
				<<link [[Drink it and throw the tankard back|$passage]]>><<set $dance.action to "tankard_drink_return">><</link>><<gdrunk>>
				<br>
			<</if>>
			<<if hasSexStat("exhibitionism", 2)>>
				<<link [[Throw the beer away and keep the tankard|$passage]]>><<set $dance.action to "tankard_keep">><</link>><<exhibitionist2>>
				<br>
			<</if>>
			<<link [[Ignore|$passage]]>><<set $dance.action to "tankard_ignore">><</link>>
			<br>
	<</switch>>
<</widget>>

:: Widgets Dance Audience [widget]

<<widget "danceaudience">>
	<<if $dance.event is 0>>
		<<set $_joins to 0>> /* stores how many people joined. */
		<<if $dance.action is "rousing">>
			<<set $_growthChance to Math.min(70, danceAudienceGrowthChance())>>
		<<elseif $dance.action is "steady">>
			<<set $_growthChance to Math.max(50, danceAudienceGrowthChance())>>
		<<else>>
			<<set $_growthChance to danceAudienceGrowthChance()>>
		<</if>>
		<<rng>>
		<<if $_growthChance gte $rng>>
			<<set $_joins += 1>>
		<</if>>
		<<if $dance.action is "steady" and random(1, 3) is 1>>
			<<rng>>
			<<if $_growthChance gte $rng>>
				<<set $_joins += 1>>
			<</if>>
		<</if>>
		<<if $_joins is 1>>
			<<if $audience gte 0 and $audience lte 5>>
				<<danceGenerateAudience>><<personSelect $audience>>
				A <<person>> starts watching you.
			<<else>>
				Someone else joins the audience.
			<</if>>
			<<set $audience += $_joins>>
			<<person_dance>>
		<<elseif $_joins is 2>>
			<<if $audience gte 0 and $audience lte 4>>
				<<danceGenerateAudience>><<personSelect $audience>>
				A <<person>> and 
				<<danceGenerateAudience>><<personSelect `$audience + 1`>>
				a <<person>> start watching you.
			<<elseif $audience is 5>>
				<<danceGenerateAudience>><<personSelect $audience>>
				A <<person>> starts watching you while someone else joins the audience.
			<<else>>
				Two more people join the audience.
			<</if>>
			<<set $audience += $_joins>>
			<<person_dance>>
		<</if>>
		<<if $audience is 0>>
			Nobody is paying attention to you.
		<<elseif $audience is 1>>
			The <<person>> is watching you intently.
		<<elseif $audience is 2>>
			A couple of people are watching you.
		<<elseif $audience is 3>>
			A few people are watching you.
		<<elseif $audience is 4>>
			Four people are watching you.
		<<elseif $audience is 5>>
			Five people are watching you.
		<<elseif $audience is 6>>
			Six people are watching you.
		<<elseif $audience is 7>>
			Seven people are watching you.
		<<elseif $audience is 8>>
			Eight people are watching you.
		<<elseif $audience is 9>>
			Nine people are watching you.
		<<elseif $audience is 10>>
			Ten people are watching you.
		<<elseif $audience is 11>>
			Eleven people are watching you.
		<<elseif $audience is 12>>
			A dozen people are watching you.
		<<elseif $audience lte 24>>
			There's a small crowd watching you.
		<<elseif $audience lte 36>>
			You've attracted quite a crowd.
		<<else>>
			There's a large crowd of people watching you. Those at the back struggle to get a good view.
		<</if>>
		<<dancespeech>>
		<<dance_npc_masturbation>>
		<<person_dance>>
		<br><br>
		<<if $audience gte 1>>
			Your audience look
			<<if $audienceexcitement is 0>>
				<span class="red">distracted</span>
			<<elseif $audienceexcitement lt 20>>
				<span class="pink">indifferent</span>
			<<elseif $audienceexcitement lt 40>>
				<span class="purple">attentive</span>
			<<elseif $audienceexcitement lt 60>>
				<span class="blue">interested</span>
			<<elseif $audienceexcitement lt 80>>
				<span class="lblue">impressed</span>
			<<elseif $audienceexcitement lt 100>>
				<span class="teal">engrossed</span>
			<<else>>
				<span class="green">obsessed</span>
			<</if>>
			and
			<<if $audiencearousal is 0>>
				<span class="blue">chaste.</span>
			<<elseif $audiencearousal lt 20>>
				<span class="lblue">reserved.</span>
			<<elseif $audiencearousal lt 40>>
				<span class="teal">temperate.</span>
			<<elseif $audiencearousal lt 60>>
				<span class="green">excited.</span>
			<<elseif $audiencearousal lt 84>>
				/* 1% chance to be assaulted. */
				<span class="purple">lustful.</span>
			<<elseif $audiencearousal lt 96>>
				/* 7% chance to be assaulted. */
				<span class="pink">lecherous.</span>
			<<else>>
				<span class="red">filled with carnal desire.</span>
				/* 24% to 100% chance to be assaulted. */
			<</if>>
			<<if $dance.stageCum gte 1 and $dance.stageGoo gte 1>>
				<<set $_fluids to "semen and lewd fluids">>
			<<elseif $dance.stageCum gte 1>>
				<<set $_fluids to "semen">>
			<<else>>
				<<set $_fluids to "lewd fluids">>
			<</if>>
			<<if $dance.stageCum + $dance.stageGoo gte 20>>
				<span class="red">Not an inch</span> of the stage is free of <<print $_fluids>>.
			<<elseif $dance.stageCum + $dance.stageGoo gte 15>>
				The stage is <span class="pink">drenched</span> with <<print $_fluids>>.
			<<elseif $dance.stageCum + $dance.stageGoo gte 10>>
				The stage is <span class="purple">coated</span> in <<print $_fluids>>.
			<<elseif $dance.stageCum + $dance.stageGoo gte 5>>
				The stage is <span class="blue">wet</span> with <<print $_fluids>>.
			<<elseif $dance.stageCum + $dance.stageGoo gte 3>>
				There's a <span class="lblue">large</span> pool of <<print $_fluids>> on the stage.
			<<elseif $dance.stageCum + $dance.stageGoo gte 1>>
				There's a <span class="teal">small</span> pool of <<print $_fluids>> on the stage.
			<</if>>
			<<set $audiencemod to Math.clamp($audiencemod, 1, 10)>>
			<br>
			Awe: <<statbarinverted $audiencemod 10>>
			<br>

			<<rng>>
			<<if danceTipChance() gte $rng>>
				<<rng 10>>
				<<set $_venuemod to $venuemod>>
				<<if $dance.action is "sophisticated">>
					<<set $venuemod += 1>>
				<<elseif $dance.action is "steady">>
					<<set $venuemod *= 2/3>>
				<<elseif $dance.action is "drain">>
					<<set $venuemod *= (1 + (4 * Math.pow(_audienceexcitement / 100, 2)))>>
				<</if>>
				<<set $dance.tip to ($rng * $audience * $venuemod * $audiencemod) / 5>>
				<<set $venuemod to $_venuemod>>
				<<if $worn.feet.type.includes("heels")>>
					<<set $dance.tip *= (1 + $worn.feet.reveal * 2 / 8000)>> 
					/* Up to ~20% more money from dancing with heels (800 max reveal), but introduces additional events that increase tiredness */
				<</if>>
				<<set $dance.tip *= 1 + ($mathstrait / 4)>>
				<<if $dance.tip gte 5000>>
					Thrilled with the display, your audience showers you with cash.
				<<elseif $dance.tip gte 500>>
					Someone throws a decent tip at you.
				<<else>>
					Someone throws a modest tip at you.
				<</if>>
				<<set $dance.tip = Math.trunc($dance.tip)>>
				<<if $dance.tip gte 50>>
					<<set $dance.tip to 100 * Math.round( $dance.tip / 100.0 )>>
				<<else>>
					<<set $dance.tip to 5 * Math.round( $dance.tip / 5.0 )>>
				<</if>>
				<<set $dance.tip to Math.max( $dance.tip, 5 )>>
				<<if $venuemod is 0>>
					They won't let you keep it.
				<<else>>
					<<set $dance.totalTip += $dance.tip>>
					You've gained <<printmoney $dance.tip>>. 
					<<if $dancelocation>>
						<<switch $dancelocation>>
							<<case "stage">><<set _tipSource to "danube">>
							<<case "club">><<set _tipSource to "stripClub">>
							<<default>><<set _tipSource to $dancelocation>>
						<</switch>>
						<<set _tipSource += "DanceTips">>
					<<else>>
						<<set _tipSource to "danceTips">>
					<</if>>
					<<money $dance.tip _tipSource>>
				<</if>>
			<</if>>
			<<if $dance.totalTip gt 0>>
				You danced for $dance.time <<if $dance.time gte 2>>minutes<<else>>minute<</if>> and gained <<printmoney $dance.totalTip>> this session.
				<br><br>
			<</if>>
			<<rng>><<rngWraith 2 "night">>
			<<if ($ivoryWraith.state is "haunt" or $ivoryWraith.offspring.status is "dead") and _wraithEvent and $rng lte 10>>
				<<danceWraith>>
				<<set $_blockDancingEvents to true>>
			<</if>>
			<<if $dancelocation is "club" and $audiencearousal gte 96>>
				<<dancefinish>>
				<<set $_blockDancingEvents to true>>
			<<elseif $dancelocation is "cafe" and $timer lte 0>>
				<<dancesamfinish>>
				<<set $_blockDancingEvents to true>>
			<<elseif $dancelocation is "party">>
				<<if $audiencearousal gte 90>>
					<<dancepull>>
					<<set $_blockDancingEvents to true>>
				<<elseif $drunk gte random(1, 1000) and random(1, 3)>>
					<<dancedrunktrip>>
					<<set $_blockDancingEvents to true>>
				<</if>>
			<<elseif $audiencearousal gte 100 and (["","beach","underground","smuggler_forced","stage","smuggler_pub","brothel"].includes($dancelocation) or $dancelocation is 0) and $dance.action isnot "radiate">>
				<<dancerape>>
				<<set $_blockDancingEvents to true>>
			<</if>>
			<<if $_blockDancingEvents or $dancelocation is "wren_heist">>
				/* No events */
			<<else>>
				<<cleareventpool>>

				/* Special cases */
				<<set _canHeels to ($worn.feet.type.includes("heels") and random(0, 1000) lt $worn.feet.reveal)>>
				<<set _canPrivate to ($privatedanceoffered isnot 1)>>
				<<set _canEarslimes to ($earSlime.corruption gte 1 and $corruptionDancing is undefined and !$hypnosis_traits.silence)>>
				<<set _canLeighton to (!$daily.leighton.offeredPcPrivateDance and Time.weekDay gte 6 and Memories.Leighton.has("metPcAtBrothel") and $pillory.tenant.special.name isnot "Leighton")>>
				<<set _canRobin to $robin.outings.canShowUpAtBrothel>>

				/* Fluids trip */
				<<if  random(0, 9) lt ($dance.stageCum + $dance.stageGoo) and $dance.action isnot "glide">>
					<<addevent "dancefall" 0.2>>
				<</if>>

				/* Heels trip */
				<<if _canHeels and $dance.action isnot "glide">>
					<<if $dancelocation is "club">><<addevent "dancetripfinish" 0.2>><</if>>
					<<if ["","beach","underground","smuggler_forced","stage","smuggler_pub","brothel"].includes($dancelocation)>><<addevent "dancetriprape" 0.2>><</if>>
				<</if>>

				/* Earslimes */
				<<if $dancelocation is "brothel" and _canEarslimes>>
					<<set _corrWeight to Math.clamp($earSlime.corruption / 500, 0.05, 0.3)>>
					<<addevent "danceCorruption" _corrWeight>>
				<</if>>

				/* Molest */
				<<if $audiencearousal gte 60 and ["","beach","underground","smuggler_forced","stage","smuggler_pub","brothel","pirate_cruise"].includes($dancelocation) and $dance.action isnot "growl">>
					<<addevent "dancemolest" `($audiencearousal gte 80 ? 0.15 : 0.05)`>>
				<</if>>

				/* Strip */
				<<if $audiencearousal gte 40 and ["","beach","underground","smuggler_forced","stage","smuggler_pub","brothel","pirate_cruise","cafe"].includes($dancelocation) and $dance.action isnot "growl">>
					<<addevent "dancestrip" `($audiencearousal gte 60 ? 0.3 : 0.1)`>>
				<</if>>

				/* Private */
				<<if _canPrivate and $audiencearousal gte 40 and ["club","brothel","underground"].includes($dancelocation)>>
					<<if $dance.action is "intense">>
						<<addevent "danceprivate" 0.5>>
					<<elseif $dance.action is "sophisticated">>
						<<addevent "danceprivate" 0.1>>
					<<else>>
						<<addevent "danceprivate" 0.2>>
					<</if>>
				<</if>>

				/* Smuggler rescue */
				<<if $dancelocation is "smuggler_forced" and _canPrivate and $audiencearousal gte 60>>
					<<addevent "smuggler_rescue" 0.5>>
				<</if>>

				/* Smuggler pub */
				<<if $dancelocation is "smuggler_pub" and $audienceexcitement gte 20 and $audience gte 1 and $dance.tankard is undefined>>
					<<addevent "dancetankard" 0.5>>
				<</if>>

				/* VIP */
				<<if $enemyno gte 2 and $audiencearousal gte 40 and ["club","brothel"].includes($dancelocation) and $dance.action isnot "growl">>
					<<addevent "dancevip" 0.1>>
				<</if>>

				/* Club */
				<<if $dancelocation is "club">>
					<<if $audiencearousal gte 60>>
						<<addevent "dancelonging" 0.1>>
						<<addevent "dancenote" 0.15>>
						<<addevent "dancestrippertrouble" 0.1>>
						<<addevent "dancesalivate" 0.1>>
						<<addevent "dancedarryl" 0.02>>
					<<else>>
						<<addevent "dancedarryl" 0.01>>
					<</if>>
				<</if>>

				/* Brothel */
				<<if $dancelocation is "brothel" and $audiencearousal gte 40>>
					<<addevent "dancebriar" 0.02>>
					<<if _canLeighton>><<addevent "danceleighton" 0.1>><</if>>
					<<if _canRobin>><<addevent "dancebrothelrobin" 0.1>><</if>>
				<</if>>

				/* Stage */
				<<if $dancelocation is "stage" and $audiencearousal gte 40>>
					<<addevent "dancelight" 0.1>>
				<</if>>

				/* Party */
				<<if $dancelocation is "party" and $audiencearousal gte 40>>
					<<addevent "dancedrink" 0.4>>
					<<addevent "dancelonging" 0.4>>
				<</if>>

				/* Nothing */
				<<addinlineevent "nothing" 1>><</addinlineevent>>

				<<runeventpool>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "dancelight">>
	<<exposure>>
	<<danceTime>>
	<<if $exposed gte 2>>
		The spotlight changes hue and brightens, forcing you to squint.
	<<else>>
		<<set $dance.event to "light">>
		The spotlight changes hue, piercing the fabric of your clothes and illuminating the skin beneath. <span class="lewd">It's as if you're naked!</span>
	<</if>>
	<br><br>
<</widget>>

<<widget "dancedrink">>
	<<set $dance.event to "drink">>
	The <<person>> offers you a glass of wine.
	<<if $drunk gte currentSkillValue('danceskill') - 800>>
		You feel unsteady already.
	<</if>>
	<br><br>
<</widget>>

<<widget "dancepull">>
	<<set $dance.event to "dancepull">>
	Driven mad with lust, <span class="pink">the <<person>> grasps your leg and tries to pull you off the stage.</span>
	<br><br>
<</widget>>

<<widget "dancedrunktrip">>
	You <span class="purple">drunkenly</span> trip and stumble, falling from the table.
	<<outfitChecks>>
	<<if (!_shirtless) and random(1)>>
		<<set _top.integrity -= 10>>
		You're caught, but your _top.name <<= _top.plural is 1 ? "snag" : "snags">>.
		<<if _top.integrity lte 0>>
			<span class="pink">You hear a tear,</span> and look down to find <<= _top.plural is 1 ? "their" : "its">> tattered remains vanishing in the crowd.
			<<arousal 100>><<if _top is $worn.over_upper>><<overupperruined>><<else>><<upperruined>><</if>>
			<<danceArousal 1>>
			<<danceExcitement 1>>
		<<else>>
			Someone cops a feel of your chest as you climb back up.
		<</if>>
	<<elseif !_bottomless>>
		<<set _bottom.integrity -= 10>>
		You're caught, but your _bottom.name <<= _bottom.plural is 1 ? "snag" : "snags">>.
		<<if _bottom.integrity lte 0>>
			<span class="pink">You hear a tear,</span> and look down to find <<= _bottom.plural is 1 ? "their" : "its">> tattered remains vanishing in the crowd.
			<<arousal 100>><<if _bottom is $worn.over_lower>><<overlowerruined>><<else>><<lowerruined>><</if>>
			<<danceArousal 1>>
			<<danceExcitement 1>>
		<<else>>
			Someone cops a feel of your <<bottom>> as you climb back up.
		<</if>>
	<<else>>
		The <<person>> catches you. Someone cops a feel of your <<bottom>> as you climb back up.
	<</if>>
	<br><br>
<</widget>>

<<widget "dancerape">>
	<<set $dance.event to "rape">>
	Driven wild by their lust, your audience surges toward you, their eyes filled with a primal hunger.
	<br><br>
<</widget>>

<<widget "dancefall">>
	<<if $dance.stageCum gte 1 and $dance.stageGoo gte 1>>
		<<set $_fluids to "semen and lewd fluids">>
	<<elseif $dance.stageCum gte 1>>
		<<set $_fluids to "semen">>
	<<else>>
		<<set $_fluids to "lewd fluids">>
	<</if>>
	<<if random(currentSkillValue('danceskill'), Math.max(currentSkillValue('danceskill'), 1000)) gte (20 + 2 * ($dance.stageCum + $dance.stageGoo)) * 1000 / 60>>
		/* Starts at 1/3 chance to fall at 0 skill.
		100% chance to fall with 20 cum+goo at max dancing skill. */
		Your feet slip on the stage covered in <<print $_fluids>>, <span class="green">but you're able to recover,</span> incorporating the move into the dance.<<tiredness 3>><<ggtiredness>>
		<<set $dance.event to 0>>
		<br><br>
	<<else>>
		Your feet slip on the stage covered in <<print $_fluids>>, <span class="red">and you fall on your <<bottom>>.</span>
		<<set $dance.event to "rape">>
		Driven wild by your vulnerability, your audience surges toward you, their eyes filled with a primal hunger.
		<br><br>
	<</if>>
<</widget>>

<<widget "dancemolest">>
	<<danceTime>>
	<<set $dance.event to "molest">><<molested>>
	The <<person>> reaches out and grasps your waist!<<trauma 6>><<stress 6>><<gtrauma>><<gstress>>
	<br><br>
<</widget>>

<<widget "dancestrip">>
	<<outfitChecks>>
	<<danceTime>>
	<<if $worn.under_lower.name isnot "naked" and _skirtExposed>>
		You spin, your skirt flaring up. Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.under_lower.name.
		<<set $dance.event to "skirtstrip">><<molested>>
	<<elseif $worn.over_lower.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.over_lower.name.
		<<set $dance.event to "overlowerstrip">><<molested>>
	<<elseif $worn.lower.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.lower.name.
		<<set $dance.event to "lowerstrip">><<molested>>
	<<elseif $worn.over_upper.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.over_upper.name.
		<<set $dance.event to "overupperstrip">><<molested>>
	<<elseif $worn.upper.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.upper.name.
		<<set $dance.event to "upperstrip">><<molested>>
	<<elseif $worn.under_lower.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.under_lower.name.
		<<set $dance.event to "understrip">><<molested>>
	<<elseif $worn.under_upper.name isnot "naked">>
		Lacking in decency, a member of your audience seizes the opportunity and lunges for your $worn.under_upper.name.
		<<set $dance.event to "underupperstrip">><<molested>>
	<</if>>
	<<trauma 6>><<stress 6>>
	<<if $dance.event isnot 0>>
