			<<else>>
				<<if hasSexStat("exhibitionism", 5)>>
					<label><span class="meek">Strip $worn.lower.name</span> <<combatExhibitionist5>> <<radiobutton "$dance.action" "lowerstripnude">></label> |
				<</if>>
			<</if>>
		<</if>>

		<<if _underOutfit>>
			<<if !$worn.lower.type.includes("naked") and !$worn.upper.type.includes("naked")>>
				<<if setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1>>
					<<if hasSexStat("exhibitionism", 3)>>
						<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist3>> <<radiobutton "$dance.action" "underoutfitstripskirt">></label> |
					<</if>>
				<<elseif $worn.upper.open is 1>>
					<<if hasSexStat("exhibitionism", 3)>>
						<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist3>> <<radiobutton "$dance.action" "underoutfitstripopen">></label> |
					<</if>>
				<</if>>
			<<elseif !$worn.lower.type.includes("naked")>>
				<<if $player.breastsize gte 3>>
					<<if hasSexStat("exhibitionism", 4)>>
					<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist4>> <<radiobutton "$dance.action" "underoutfitstripbreasts">></label> |
					<</if>>
				<<elseif $player.gender_appearance isnot "m" and $worn.under_lower.gender isnot "m">>
					<<if hasSexStat("exhibitionism", 4)>>
					<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist4>> <<radiobutton "$dance.action" "underoutfitstripchest">></label> |
					<</if>>
				<<else>>
					<<if hasSexStat("exhibitionism", 3)>>
					<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist3>> <<radiobutton "$dance.action" "underoutfitstripunder">></label> |
					<</if>>
				<</if>>
			<<else>>
				<<if hasSexStat("exhibitionism", 5)>>
					<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist5>> <<radiobutton "$dance.action" "underoutfitstripnude">></label> |
				<</if>>
			<</if>>
		<</if>>

		<<if !$worn.under_upper.type.includes("naked") and _underOutfit is false>>
			<<if !$worn.upper.type.includes("naked") and $worn.upper.open is 1>>
				<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist1>> <<radiobutton "$dance.action" "underupperstripopen">></label> |
			<<elseif $player.breastsize gte 3>>
				<<if hasSexStat("exhibitionism", 4)>>
				<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist4>> <<radiobutton "$dance.action" "underupperstripbreasts">></label> |
				<</if>>
			<<elseif $player.gender_appearance isnot "m" and $worn.under_lower.gender isnot "m">>
				<<if hasSexStat("exhibitionism", 4)>>
				<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist4>> <<radiobutton "$dance.action" "underupperstripfchest">></label> |
				<</if>>
			<<else>>
			<label><span class="meek">Strip $worn.under_upper.name</span> <<combatExhibitionist1>> <<radiobutton "$dance.action" "underupperstripmchest">></label> |
			<</if>>
		<</if>>

		<<if !$worn.under_lower.type.includes("naked") and _underOutfit is false>>
			<<if !$worn.lower.type.includes("naked") and setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1>>
				<<if hasSexStat("exhibitionism", 3)>>
				<label><span class="meek">Strip $worn.under_lower.name</span> <<combatExhibitionist3>> <<radiobutton "$dance.action" "understripskirt">></label> |
				<</if>>
			<<elseif $worn.lower.type.includes("naked")>>
				<<if hasSexStat("exhibitionism", 5)>>
				<label><span class="meek">Strip $worn.under_lower.name</span> <<combatExhibitionist5>> <<radiobutton "$dance.action" "understripnude">></label> |
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "danceStageCum">>
	<<if $dance.stageCum is undefined>>
		<<set $dance.stageCum to 0>>
	<</if>>
	<<if $dance.stageGoo is undefined>>
		<<set $dance.stageGoo to 0>>
	<</if>>
	<<if _args[0]>>
		<<set $dance.stageCum += _args[0]>>
	<</if>>
<</widget>>

<<widget "danceStageGoo">>
	<<if $dance.stageCum is undefined>>
		<<set $dance.stageCum to 0>>
	<</if>>
	<<if $dance.stageGoo is undefined>>
		<<set $dance.stageGoo to 0>>
	<</if>>
	<<if _args[0]>>
		<<set $dance.stageGoo += _args[0]>>
	<</if>>
<</widget>>

<<widget "dance_private_init">>
	<<if $dance_place isnot 0>>
		<<saveNPC $dance_place chosen_npc>>
		<<saveNPC 0 zero_npc>>
		<<clearsinglenpc $dance_place>>
		<<clearsinglenpc 0>>
		<<loadNPC 0 chosen_npc>>
		<<loadNPC $dance_place zero_npc>>
		<<clearNPC zero_npc>>
		<<clearNPC chosen_npc>>
	<</if>>
	<<set $enemyno to 1>>
	<<unset $corruptionDancing>>
	<<set $phase to 0>>
	<<person1>>
<</widget>>

<<widget "danceTime">>
	<<pass 1>>
	<<if $dance.action is "languorous">>
		<<if random(1, 3) gte 2>>
			<<tiredness 1>>
		<</if>>
	<<else>>
		<<tiredness 1>>
		<<if  ($dance.action is "intense" and random(1, 2) is 1)>>
			<<tiredness 1>>
		<</if>>
	<</if>>
	<<if ["","beach","smuggler_pub","brothel","club"].includes($dancelocation)>>
		<<set $dance.time += 1>>
	<</if>>
<</widget>>

<<widget "limitNPC">>
	<<if _args[0] gt 0>>
		<<for $_i to $enemyno-1; $_i gt _args[0]-1; $_i-->>
			<<clearsinglenpc $_i>>
		<</for>>
		<<set $enemyno to _args[0]>>
	<</if>>
<</widget>>

<<widget "danceUpdateTF">>
	<<if $angel gte 6>>
		<<set $dance.transformation.pushUnique("radiate")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "radiate")>>
	<</if>>
	<<if $fallenangel gte 2>>
		<<set $dance.transformation.pushUnique("atone")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "atone")>>
	<</if>>
	<<if $demon gte 6>>
		<<set $dance.transformation.pushUnique("drain")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "drain")>>
	<</if>>
	<<if $wolfgirl gte 6>>
		<<set $dance.transformation.pushUnique("growl")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "growl")>>
	<</if>>
	<<if $cat gte 6>>
		<<set $dance.transformation.pushUnique("groom")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "groom")>>
	<</if>>
	<<if $cow gte 6>>
		<<set $dance.transformation.pushUnique("milk")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "milk")>>
	<</if>>
	<<if $harpy gte 6>>
		<<set $dance.transformation.pushUnique("glide")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "glide")>>
	<</if>>
	<<if $fox gte 6>>
		<<set $dance.transformation.pushUnique("pounce")>>
	<<else>>
		<<set $dance.transformation to $dance.transformation.filter(i => i !== "pounce")>>
	<</if>>
<</widget>>

<<widget "danceTutorial">>
	<<if !$dance.tutorial and ["brothel", "club", "cafe", "beach", "smuggler_pub", "party", "stage"].includes($dancelocation)>>
		<<set $dance.tutorial to true>>
		<span class="gold">Dance to earn tips. You can increase your earnings by raising your Awe level and drawing a larger audience. 
		<br> 
		A <span class="purple">Lustful</span> audience is risky, while a <span class="pink">Lecherous</span> audience is very dangerous. Also, be cautious of slippery stages.</span>
	<</if>>
<</widget>>
