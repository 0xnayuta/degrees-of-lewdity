:: Widgets Diary [widget]
/*

How to Add new variables to be tracked by diary:
1. add it to <<widget "loginit">>'s <<set log to {...}>> part(so that $log.yourvariable will get it's position in a relevant array)
  update <<set _len to >> to have the last $log. number
  optional: if it's a string make it have "" instead of 0 in $logblank
    <<set $logblank[$log.yourvariable] to ("")>>
2. make <<widget "log">> track changes to it(if it's a number with wide range) or just it's value in some way
  ,$yourvariable - $logged[$log.yourvariable]
  <<set _d[$log.yourvariable] to ($yourvariable - $logged[$log.yourvariable])>>
3. add it to <<widget "logstatsupdate">> just as ,$yourvariable
4. add it at least to the debug section of <<widget "showdiaryentry">>
  <<if _e[$log.yourvariable] isnot 0 and _e[$log.yourvariable] isnot undefined>>yourvariable:<<print _e[$log.yourvariable]>><</if>>

*/
<<widget "loginit">><<nobr>>

/* name diaryentry array indexes to make coding easier without making the game repeatedly use the names(in save files and such) */
<<set _len to 85>>/* index of last $log.variable */
<<if $logblank is undefined or $logblank.length lte _len>>/* checking _len to trigger on version update if new ones get added */
	<<set $log to {
		time:0,text:1,importance:2,comment:3,opinion:4,
		money:5,stress:6,trauma:7,awareness:8,pain:9,
		tiredness:10,arousal:11,control:12,allure:13,antiquemoney:14,
		blackmoney:15,spray:16,spraymax:17,drunk:18,drunkgain:19,
		drugged:20,weather:21,clothupper:22,clothlower:23,clothunder:24,
		oldclothupper:25,oldclothlower:26,oldclothunder:27,collared:28,purity:29,
		submissive:30,physique:31,beauty:32,promiscuity:33,exhibitionism:34,
		deviancy:35,skulduggery:36,danceskill:37,swimmingskill:38,seductionskill:39,
		oralskill:40,vaginalskill:41,penileskill:42,analskill:43,handskill:44,
		feetskill:45,bottomskill:46,thighskill:47,chestskill:48,science:49,
		maths:50,english:51,history:52,school:53,unclad:54,
    cool:55,detention:56,fameexhibitionism:57,fameprostitution:58,famebestiality:59,
    famerape:60,famesex:61,famegood:62,famebusiness:63,famepimp:64,
    famescrap:65,dancestat:66,drinksservedstat:67,tablesservedstat:68,prostitutionstat:69,
    forcedprostitutionstat:70,orgasmstat:71,ejacstat:72,moleststat:73,rapestat:74,
    beastrapestat:75,tentaclerapestat:76,swallowedstat:77,parasitestat:78,hitstat:79,
    attackstat:80,spraystat:81,rescued:82,clothesstripstat:83,clothesruinstat:84,
    passoutstat:85
	}>>
	/*
	to add:
		Delinquency
		More specific ejaculation stats
	*/
	<<set $logblank to []>>
	<<for $logblank.length lte _len>>
		<<set $logblank.push(0)>>
	<</for>>
	<<set $logblank[$log.weather] to ("")>>
	<<set $logblank[$log.clothupper] to ("")>>
	<<set $logblank[$log.clothlower] to ("")>>
	<<set $logblank[$log.clothunder] to ("")>>
	<<set $logblank[$log.oldclothupper] to ("")>>
	<<set $logblank[$log.oldclothlower] to ("")>>
	<<set $logblank[$log.oldclothunder] to ("")>>

<</if>>

<<if $logged is undefined>><<set $logged to clone($logblank)>><</if>>

<<if $diary.length-1 lt $days>> /* fill diary with blank days to catch up to current date */
	<<for _i to 0; _i lt $days; _i++>>
		<<if $diary[_i] is undefined>>
			<<set $diary.push([])>>
			<<set $diary[_i][0] to clone($logblank)>>
			<<set $diary[_i][0][$log.text] to "Day " + _i>>
			<<set $diary[_i][0][$log.importance] to -5>>
		<</if>>
	<</for>>
	<<set $diary.push([])>>
	<<set _a to clone($logblank)>>
	<<set _a[$log.text] to $month+" "+$monthday+" "+$logprep>>
	<<set _a[$log.time] to 0>>
	<<set _a[$log.comment] to "(Day "+$days+")">>
	<<set _a[$log.importance] to 7>>
	<<set _a[$log.money] to "="+$money>>
	<<set $diary[$days][0] to _a>>
	/*<<set $diary[$days][0] to
	{text:$month + " " + $monthday, timestamp:0,comment:"",opinion:"",importance:7,effect:{money:0,stress:0,trauma:0,awareness:0,pain:0,tired:0,arousal:0,control:0,allure:0,antiquemoney:0,blackmoney:0,weather:"",clothupper:"",clothlower:"",clothunder:"",oldclothupper:(""),oldclothlower:(""),oldclothunder:("")}}>>
	*/
<</if>>

<</nobr>><</widget>>

<<widget "log">><<nobr>>
	<<if $logdebug is 1>>log<<print $args[1]>>(<<print $args[0]>>)<</if>>

	<<if $args[0] == undefined>><<set $args[0] to "Did something.">><</if>>
	<<if $args[1] == undefined>><<set $args[1] to 1>><</if>>
	<<set $logprep to "">> /* if this didn't exist logadd wouldn't be necessary but I think it needs to since there might be some situations where logprep+"" needs to be the 1st thing */
	<<set $diarypage to $days>>
	<<set $diaryline to $diary[$days].length>>
	<<set _d to $diary[$days][$diaryline]>>
	<<if $args[1] gte $logchangetreshold or $debug is 1>>
		<<set $diary[$days].push(clone($logblank))>>
		<<set _d to $diary[$days][$diaryline]>>
		<<set _d[$log.time] to $time>>
		<<set _d[$log.text] to $args[0]>>
		<<set _d[$log.importance] to $args[1]>>
		<<set _d[$log.comment] to "">>
		<<set _d[$log.opinion] to "">>
		<<set _d[$log.money] to ($money - $logged[$log.money])>>
		<<set _d[$log.stress] to ($stress - $logged[$log.stress])>>
		<<set _d[$log.trauma] to ($trauma - $logged[$log.trauma])>>
		<<set _d[$log.awareness] to ($awareness - $logged[$log.awareness])>>
		<<set _d[$log.pain] to ($pain - $logged[$log.pain])>>
		<<set _d[$log.tiredness] to ($tiredness - $logged[$log.tiredness])>>
		<<set _d[$log.arousal] to ($arousal - $logged[$log.arousal])>>
		<<set _d[$log.control] to ($control - $logged[$log.cotrol])>>
		<<set _d[$log.allure] to ($allure - $logged[$log.allure])>>
		<<set _d[$log.antiquemoney] to ($antiquemoney - $logged[$log.antiquemoney])>>
		<<set _d[$log.blackmoney] to ($blackmoney - $logged[$log.blackmoney])>>
		<<set _d[$log.spray] to ($spray - $logged[$log.spray])>>
		<<set _d[$log.spraymax] to ($spraymax - $logged[$log.spraymax])>>
		<<set _d[$log.drunk] to ($drunk)>>
		<<set _d[$log.drunkgain] to ($drunk - $logged[$log.drunk])>>
		<<set _d[$log.drugged] to ($drugged - $logged[$log.drugged])>>
		<<set _d[$log.weather] to ("")>>
		<<set _d[$log.clothupper] to ("")>>
		<<set _d[$log.clothlower] to ("")>>
		<<set _d[$log.clothunder] to ("")>>
		<<set _d[$log.oldclothupper] to ("")>>
		<<set _d[$log.oldclothlower] to ("")>>
		<<set _d[$log.oldclothunder] to ("")>>
		<<set _d[$log.collar] to ($collared)>>
		<<set _d[$log.purity] to ($purity - $logged[$log.purity])>>
		<<set _d[$log.submissive] to ($submissive - $logged[$log.submissive])>>
		<<set _d[$log.physique] to ($physique - $logged[$log.physique])>>
		<<set _d[$log.beauty] to ($beauty - $logged[$log.beauty])>>
		<<set _d[$log.promiscuity] to ($promiscuity - $logged[$log.promiscuity])>>
		<<set _d[$log.exhibitionism] to ($exhibitionism - $logged[$log.exhibitionism])>>
		<<set _d[$log.deviancy] to ($deviancy - $logged[$log.deviancy])>>
		<<set _d[$log.skulduggery] to ($skulduggery - $logged[$log.skulduggery])>>
		<<set _d[$log.danceskill] to ($danceskill - $logged[$log.danceskill])>>
		<<set _d[$log.swimmingskill] to ($swimmingskill - $logged[$log.swimmingskill])>>
		<<set _d[$log.seductionskill] to ($seductionskill - $logged[$log.seductionskill])>>
		<<set _d[$log.oralskill] to ($oralskill - $logged[$log.oralskill])>>
		<<set _d[$log.vaginalskill] to ($vaginalskill - $logged[$log.vaginalskill])>>
		<<set _d[$log.penileskill] to ($penileskill - $logged[$log.penileskill])>>
		<<set _d[$log.analskill] to ($analskill - $logged[$log.analskill])>>
		<<set _d[$log.handskill] to ($handskill - $logged[$log.handskill])>>
		<<set _d[$log.feetskill] to ($feetskill - $logged[$log.feetskill])>>
		<<set _d[$log.bottomskill] to ($bottomskill - $logged[$log.bottomskill])>>
		<<set _d[$log.thighskill] to ($thighskill - $logged[$log.thighskill])>>
		<<set _d[$log.chestskill] to ($chestskill - $logged[$log.chestskill])>>
		<<set _d[$log.science] to ($science - $logged[$log.science])>>
		<<set _d[$log.maths] to ($maths - $logged[$log.maths])>>
		<<set _d[$log.english] to ($english - $logged[$log.english])>>
		<<set _d[$log.history] to ($history - $logged[$log.history])>>
		<<set _d[$log.school] to ($school - $logged[$log.school])>>
		<<set _d[$log.unclad] to ($unclad - $logged[$log.unclad])>>
    <<set _d[$log.cool] to ($cool - $logged[$log.cool])>>
    <<set _d[$log.detention] to ($detention - $logged[$log.detention])>>
    <<set _d[$log.fameexhibitionism] to ($fameexhibitionism - $logged[$log.fameexhibitionism])>>
    <<set _d[$log.fameprostitution] to ($fameprostitution - $logged[$log.fameprostitution])>>
    <<set _d[$log.famebestiality] to ($famebestiality - $logged[$log.famebestiality])>>
    <<set _d[$log.famerape] to ($famerape - $logged[$log.famerape])>>
    <<set _d[$log.famesex] to ($famesex - $logged[$log.famesex])>>
    <<set _d[$log.famegood] to ($famegood - $logged[$log.famegood])>>
    <<set _d[$log.famebusiness] to ($famebusiness - $logged[$log.famebusiness])>>
    <<set _d[$log.famepimp] to ($famepimp - $logged[$log.famepimp])>>
    <<set _d[$log.famescrap] to ($famescrap - $logged[$log.famescrap])>>
    <<set _d[$log.dancestat] to ($dancestat - $logged[$log.dancestat])>>
    <<set _d[$log.drinksservedstat] to ($drinksservedstat - $logged[$log.drinksservedstat])>>
    <<set _d[$log.tablesservedstat] to ($tablesservedstat - $logged[$log.tablesservedstat])>>
    <<set _d[$log.prostitutionstat] to ($prostitutionstat - $logged[$log.prostitutionstat])>>
    <<set _d[$log.forcedprostitutionstat] to ($forcedprostitutionstat - $logged[$log.forcedprostitutionstat])>>
    <<set _d[$log.orgasmstat] to ($orgasmstat - $logged[$log.orgasmstat])>>
    <<set _d[$log.ejacstat] to ($ejacstat - $logged[$log.ejacstat])>>
    <<set _d[$log.moleststat] to ($moleststat - $logged[$log.moleststat])>>
    <<set _d[$log.rapestat] to ($rapestat - $logged[$log.rapestat])>>
    <<set _d[$log.beastrapestat] to ($beastrapestat - $logged[$log.beastrapestat])>>
    <<set _d[$log.tentaclerapestat] to ($tentaclerapestat - $logged[$log.tentaclerapestat])>>
    <<set _d[$log.swallowedstat] to ($swallowedstat - $logged[$log.swallowedstat])>>
    <<set _d[$log.parasitestat] to ($parasitestat - $logged[$log.parasitestat])>>
    <<set _d[$log.hitstat] to ($hitstat - $logged[$log.hitstat])>>
    <<set _d[$log.attackstat] to ($attackstat - $logged[$log.attackstat])>>
    <<set _d[$log.spraystat] to ($spraystat - $logged[$log.spraystat])>>
    <<set _d[$log.rescued] to ($rescued - $logged[$log.rescued])>>
    <<set _d[$log.clothesstripstat] to ($clothesstripstat - $logged[$log.clothesstripstat])>>
    <<set _d[$log.clothesruinstat] to ($clothesruinstat - $logged[$log.clothesruinstat])>>
    <<set _d[$log.passoutstat] to ($passoutstat - $logged[$log.passoutstat])>>

  	/* add strings only when they have changed, so if entry says weather is clear then it wasn't before that*/
  	<<if $logged[$log.weather] isnot $weather>><<set $diary[$days][$diaryline][$log.weather] to $weather>><</if>>
  	/* need to list all clothing when something changes so that we don't need to search through previous entries to figure out if a part that didn't change is naked or not */
  	<<if $logged[$log.clothupper] isnot $upperclothes or $logged[$log.clothlower] isnot $lowerclothes or $logged[$log.clothunder] isnot $underclothes>>
  		<<set $diary[$days][$diaryline][$log.oldclothupper] to clone($logged[$log.clothupper])>>
  		<<set $diary[$days][$diaryline][$log.oldclothlower] to clone($logged[$log.clothlower])>>
  		<<set $diary[$days][$diaryline][$log.oldclothunder] to clone($logged[$log.clothunder])>>
  		<<set $diary[$days][$diaryline][$log.clothupper] to $upperclothes>>
  		<<set $diary[$days][$diaryline][$log.clothlower] to $lowerclothes>>
  		<<set $diary[$days][$diaryline][$log.clothunder] to $underclothes>>
  	<</if>>

  	<<logstatsupdate>>
	<<else>> /* wait for more noteworthy event to add changes to, kind of unnecessary unless the diary actually shows changes to stats that are constantly changing */
		<<run $diary[$days].push($logblank)>>
	<</if>>
	<<if $logextra isnot "" and $logextra isnot undefined>> /* virginity loss entries should come after the event (or as some special comment like thing) */
		<<logextra $logextra $logextraimportance>>
	<</if>>
<</nobr>><</widget>>

<<widget "logstatsupdate">><<nobr>> /* update logstats to current stats */
/* must have same length as $log has and have things in the same order(could use <<set $logged[$log.x] >> to more reliably match) */
<<set $logged to [$time,"",0,"","",
	$money,$stress,$trauma,$awareness,$pain,
	$tiredness,$arousal,$control,$allure,$antiquemoney,
	$blackmoney,$spray,$spraymax,$drunk,$drunk,
	$drugged,$weather,$upperclothes,$lowerclothes,$underclothes,
	clone($logged[$log.clothupper]),$logged[$log.clothlower],$logged[$log.clothunder],$collared,$purity,
	$submissive,$physique,$beauty,$promiscuity,$exhibitionism,
	$deviancy,$skulduggery,$danceskill,$swimmingskill,$seductionskill,
	$oralskill,$vaginalskill,$penileskill,$analskill,$handskill,
	$feetskill,$bottomskill,$thighskill,$chestskill,$science,
	$maths,$english,$history,$school,$unclad,
  $cool,$detention,$fameexhibitionism,$fameprostitution,$famebestiality,
  $famerape,$famesex,$famegood,$famebusiness,$famepimp,
  $famescrap,$dancestat,$drinksservedstat,$tablesservedstat,$prostitutionstat,
  $forcedprostitutionstat,$orgasmstat,$ejacstat,$moleststat,$rapestat,
  $beastrapestat,$tentaclerapestat,$swallowedstat,$parasitestat,$hitstat,
  $attackstat,$spraystat,$rescued,$clothesstripstat,$clothesruinstat,
  $passoutstat
]>>
<</nobr>><</widget>>

<<widget "logextra">><<nobr>>
<<if $args[1] == undefined>><<set $args[1] to 8>><</if>>
<<set $logextra to "">>
<<set _ex to clone($logblank)>>
<<set _ex[$log.time] to $time>>
<<set _ex[$log.text] to $args[0]>>
<<set _ex[$log.importance] to $args[1]>>

<<set $diarypage to $days>>
<<set $diaryline to $diary[$days].length-1>>/* since <<log>> will get the correct diaryline it should be safe to set diaryline to -1 of what it really should be */
<<run $diary[$days].push(_ex)>>
<</nobr>><</widget>>

<<widget "logedit">><<nobr>> /* edit the last entry text*/
	<<set $diary[$days][$diaryline][$log.text] to $args[0]>>
<</nobr>><</widget>>

<<widget "logadd">><<nobr>> /* add to the last entry text*/
	<<set $diary[$days][$diaryline][$log.text] to $diary[$days][$diaryline][$log.text]+$args[0]>>
<</nobr>><</widget>>

<<widget "logupdateeffect">><<nobr>> /*  update the last effect(strings require $logdebug since clothing report will be buggy)	*/
<<set _l to clone($logged)>>
<<logstatsupdate>>
<<for _e to $log.money; _e lt $logblank.length; _e++>>/* assuming money is the 1st value we care about */
	/* set newvaluechange to oldvaluechange + currentvalue - oldvalue */
	<<if typeof($diary[$days][$diaryline][_e]) is "number">>
		<<set _newvalue to $diary[$days][$diaryline][_e] + $logged[_e] - _l[_e]>>
		<<set $diary[$days][$diaryline][_e] to _newvalue>>
	<<elseif typeof($diary[$days][$diaryline][_e]) is "string">>
		<<if $logdebug is 1>>
			<<if $diary[$days][$diaryline][_e] isnot _l[_e]>>/* this should break clothing report so that it'll only say the new clothing */
				<<set _newvalue to clone($logged[_e])+"¤removethis:"+clone(_l[_e])+" isnot "+$diary[$days][$diaryline][_e]+"¤">>
				<<set $diary[$days][$diaryline][_e] to _newvalue>>
			<</if>>
		<</if>>
	<<elseif typeof($diary[$days][$diaryline][_e]) is "boolean">>
		/* do something? */
	<<elseif typeof($diary[$days][$diaryline][_e]) is "undefined">>
	<</if>>
<</for>>
<</nobr>><</widget>>

<<widget "logtimeupdate">><<nobr>> /*  change entry time in case log was called early for some reason */
	$money $logmoney $awareness $awarelevel $awareselect
	<<set $diary[$days][$diaryline][$log.time] to $time>>
<</nobr>><</widget>>

<<widget "logday">><<nobr>>
	<<set $dayendreport to "">>
	/* $moneytext might be useful in other situtations so could move this to some place that gets run more often */
	<<set $moneytext to "£"+ Math.trunc($money / 100)+".">>
	<<if $money % 100 lte 9>><<set $moneytext to $moneytext+"0">><</if>>
	<<set $moneytext to $moneytext+$money % 100>>
	<<set $dayendreport to "It's the start of a new day! I have " + $moneytext + " and I feel ">>

	<<if $tiredness gte 2000>><<set $dayendreport to $dayendreport + "<span class='red'>exhausted</span>, ">>
	<<elseif $tiredness gte 1600>><<set $dayendreport to $dayendreport + "<span class='pink'>fatigued</span>, ">>
	<<elseif $tiredness gte 1200>><<set $dayendreport to $dayendreport + "<span class='purple'>tired</span>, ">>
	<<elseif $tiredness gte 800>><<set $dayendreport to $dayendreport + "<span class='blue'>wearied</span>, ">>
	<<elseif $tiredness gte 400>><<set $dayendreport to $dayendreport + "<span class='lblue'>alert</span>, ">>
	<<elseif $tiredness gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>wide awake</span>, ">>
	<<else>><<set $dayendreport to $dayendreport + "<span class='green'>refreshed</span>, ">>
	<</if>>
	<<if $stress gte 10000>><<set $dayendreport to $dayendreport + "<span class='red'>extremely stressed out</span>">>
	<<elseif $stress gte 8000>><<set $dayendreport to $dayendreport + "<span class='pink'>very stressed</span>">>
	<<elseif $stress gte 6000>><<set $dayendreport to $dayendreport + "<span class='purple'>kind of stressed</span>">>
	<<elseif $stress gte 4000>><<set $dayendreport to $dayendreport + "<span class='blue'>a bit tense</span>">>
	<<elseif $stress gte 2000>>><<set $dayendreport to $dayendreport + "<span class='lblue'>somewhat relaxed</span>">>
	<<elseif $stress gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>rather relaxed</span>">>
	<<else>><<set $dayendreport to $dayendreport + "<span class='green'>serene</span>">>
	<</if>>
	<<set $dayendreport to $dayendreport + " and ">>
	<<if $innocencestate isnot 1>>	/* would $awarelevel gte 0 work too? */
		<<if $trauma gte $traumamax>><<set $dayendreport to $dayendreport + "<span class='red'>numb</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 4>><<set $dayendreport to $dayendreport + "<span class='pink'>tormented</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 3>><<set $dayendreport to $dayendreport + "<span class='purple'>disturbed</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 2>><<set $dayendreport to $dayendreport + "<span class='blue'>troubled</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 1>><<set $dayendreport to $dayendreport + "<span class='lblue'>nervous</span>">>
		<<elseif $trauma gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>uneasy</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>healthy</span>">>
		<</if>>
	<<else>>
		<<if $awareness gte 0>><<set $dayendreport to $dayendreport + "<span class='red'>aware</span>">>
		<<elseif $awareness gt -40>><<set $dayendreport to $dayendreport + "<span class='pink'>uncertain</span>">>
		<<elseif $awareness gt -80>><<set $dayendreport to $dayendreport + "<span class='purple'>perplexed</span>">>
		<<elseif $awareness gt -120>><<set $dayendreport to $dayendreport + "<span class='blue'>curious</span>">>
		<<elseif $awareness gt -160>><<set $dayendreport to $dayendreport + "<span class='lblue'>trusting</span>">>
		<<elseif $awareness gt -200>><<set $dayendreport to $dayendreport + "<span class='teal'>naive</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>oblivious</span>">><</if>>
	<</if>>
	<<set $dayendreport to $dayendreport + " and the state of my body ">> /* this part could probably be worded better */

		<<if $pain gte 100>><<set $dayendreport to $dayendreport + "makes me <span class='red'>sob uncontrollably</span>">>
		<<elseif $pain gte 80>><<set $dayendreport to $dayendreport + "makes me <span class='pink'>cry and whimper</span>">>
		<<elseif $pain gte 60>><<set $dayendreport to $dayendreport + "makes me <span class='purple'>cry</span>">>
		<<elseif $pain gte 40>><<set $dayendreport to $dayendreport + "makes <span class='blue'>tears run down my face</span>">>
		<<elseif $pain gte 20>><<set $dayendreport to $dayendreport + "makes <span class='lblue'>tears well in my eyes</span>">>
		<<elseif $pain gte 1>><<set $dayendreport to $dayendreport + "makes me <span class='teal'>upset</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>feels okay</span>">>
	<</if>>

	<<set $dayendreport to $dayendreport + " I'm also ">> /* this also could probably be worded better */

		<<if $arousal gte 10000>><<set $dayendreport to $dayendreport + "<span class='red'>shaking with arousal</span>">>
		<<elseif $arousal gte 8000>><<set $dayendreport to $dayendreport + "feeling like there is <span class='pink'>a heat rising within me</span>">>
		<<elseif $arousal gte 6000>><<set $dayendreport to $dayendreport + "feeling <span class='purple'>horny</span>">>
		<<elseif $arousal gte 4000>><<set $dayendreport to $dayendreport + "feeling <span class='blue'>lustful</span>">>
		<<elseif $arousal gte 2000>><<set $dayendreport to $dayendreport + "feeling <span class='lblue'>aroused</span>">>
		<<elseif $arousal gte 1>><<set $dayendreport to $dayendreport + "feeling <span class='teal'>sensual</span>">>
		<<else>><<set $dayendreport to $dayendreport + "feeling <span class='green'>cold</span>">>
	<</if>>

	<<set $dayendreport to "Bazang! "+ $dayendreport>>


	<<set $dayendreport to $dayendreport + ".">>
	<<set $diaryline to $diary[$days].length>> /* */
	<<set $diary[$days].push(clone($logblank))>>
	<<set $diary[$days][$diaryline][$log.time] to $time>>
	<<set $diary[$days][$diaryline][$log.text] to $dayendreport>>
	<<set $diary[$days][$diaryline][$log.importance] to 7>>
	/*
	<<set $diary[$days].push(
		{
	    timestamp:$time,
	    text:$dayendreport,
			importance:7, comment:"",	comment:"",	opinion:"", effect:{money:0,stress:0,trauma:0,awareness:0,pain:0,tired:0,arousal:0,control:0,allure:0,antiquemoney:0,blackmoney:0,weather:"",clothupper:"",clothlower:"",clothunder:"",oldclothupper:(""),oldclothlower:(""),oldclothunder:("")}
	  }
		)>>*/
<</nobr>><</widget>>

<<widget "logcomment">><<nobr>>
	<<set $diary[$args[0]][$args[1]][$log.comment] to "("+$args[2]+")">>
<</nobr>><</widget>>

<<widget "logimportance">><<nobr>>
	<<set $diary[$args[0]][$args[1]][$log.importance] to $args[2]>>
<</nobr>><</widget>>

<<widget "logopinion">><<nobr>>
<span id="textbox1">
<<set _c to "">>
<<set $plropinion to "">>
<<if $diaryprompts is 2 or $diaryprompts is 3>>
	<span class="lblue">Select how you feel about this event:</span><br><span class="grey">
		<<for _i to 0;_i lt $args.length; _i++>>
			<label><<radiobutton "$plropinion" $args[_i]>> $args[_i]</label><br>
		<</for>></span>
<<else>>
	<<if $args[0]>><<set _c to $args.random()>><</if>>
	/* <<set $diary[$days][$diaryline][$log.opinion] to "["+_c+"]">> /* sets opinion to whatever if you don't have opinion prompts */
<</if>>
<<if $diaryprompts is 1>>
	<<textbox "$plrcomment" _c >>
	<<link "Add a comment to your diary">><<logcomment $days $diaryline $plrcomment>><<remove "#textbox1">><</link>><br>
<<elseif $diaryprompts is 2>>
	<span class="lblue">Comment:</span><<textbox "$plrcomment" "" >><br>
	<<link "Add your opinion and comment to the diary">><<set $diary[$days][$diaryline][$log.opinion] to "["+$plropinion+"]">><<logcomment $days $diaryline $plrcomment>><<remove "#textbox1">><</link>><br>
<<elseif $diaryprompts is 3>>
	<<link "Add your opinion to the diary">><<set $diary[$days][$diaryline][$log.opinion] to "["+$plropinion+"]">><</link>><br>
<</if>></span>
<</nobr>><</widget>>


<<widget "showdiaryentry">><<nobr>>
<<set _text to $diary[$args[0]][$args[1]][$log.text]>>
<<set _e to $diary[$args[0]][$args[1]]>>
<<if _e[$log.importance] lte 0 >>/* after this stuff is same as above though it used to be more different, should make a widget or something  */
	<span class="black">_text </span>
<<elseif _e[$log.importance] is 1 >>
	<span class="grey">_text </span>
<<elseif _e[$log.importance] is 2 >>
	<span class="blue">_text </span>
<<elseif _e[$log.importance] is 3 >>/* combat and other events of similar importance */
	<span class="lblue">_text </span>
<<elseif _e[$log.importance] is 4 >>
	<span class="teal">_text </span>
<<elseif _e[$log.importance] is 5 >>
	<span class="green">_text </span>
<<elseif _e[$log.importance] is 6 >>
	<span class="orange">_text </span>
<<elseif _e[$log.importance] is 7 >>/* for date and end/start of day report that colors stuff on it's own */
	_text
<<elseif _e[$log.importance] is 8 >> /* virginity loss */
	<span class="red">_text </span>
<<elseif _e[$log.importance] is 9 >> /* not sure, transformations? */
	<span class="gold">_text </span>
<<else>>
	_text
<</if>>
/* clothing change report */
/*
"Changed x to y" would be weird for situations where clothes break and such
"Now wearing x" might be best since it doesn't really mention how or why the clothing situation changed
	actually is the "now" really necessary?
this probably won't handle sets very well
*/
<<set _eqsign to "=">>/* you get an error with just <<if x is "=">> */
<<if _e[$log.clothunder] isnot undefined and _e[$log.clothunder].first() isnot _eqsign>>/* 1st entry of day lists current stats with = in front including clothes which we don't want*/
<<if _e[$log.clothupper] isnot "" or _e[$log.clothlower] isnot "" or _e[$log.clothunder] isnot "">>/*could just check 1 now that all should be set if 1 is*/
	Wearing
	<<if _e[$log.clothupper] is "naked" and _e[$log.clothlower] is "naked" and _e[$log.clothunder] is "naked">>nothing <</if>>
	<<set $listed to []>>
	<<if _e[$log.clothupper] isnot "naked">><<set $listed.push(_e[$log.clothupper])>><</if>>
	<<if _e[$log.clothlower] isnot "naked">><<set $listed.push(_e[$log.clothlower])>><</if>>
	<<if _e[$log.clothunder] isnot "naked">>
		<<if _e[$log.clothupper] is "naked" and _e[$log.clothlower] is "naked">>
			<<set $listed.push("only "+_e[$log.clothunder])>>
		<<else>>
			<<set $listed.push(_e[$log.clothunder])>>
		<</if>>
	<<elseif _e[$log.clothupper] isnot "naked" or _e[$log.clothlower] isnot "naked">>
		<<set $listed.push("no underwear")>>
	<</if>>
	<<listify $listed>>.
<</if>>
<</if>>

<<if _e[$log.drunk] gt 0>><span class="purple">Feeling</span>
	<<if _e[$log.drunk] lte 120>>
		<span class="blue"> woozy</span>.
	<<elseif _e[$log.drunk] lte 240>>
		<span class="purple"> tipsy</span>.
	<<elseif _e[$log.drunk] lte 360>>
		<span class="purple"> drunk</span>.
	<<elseif _e[$log.drunk] lte 480>>
		<span class="pink"> smashed</span>.
	<<else>>
		<span class="pink"> wasted</span>.
	<</if>>
<</if>>

<<if _e[$log.drugged] isnot 0>>
	<<if _e[$log.drugged] lt 0>><span class="blue">-lewd warmth </span><</if>>
	<<if _e[$log.drugged] gt 0>><span class="pink">+lewd warmth </span><</if>>
<</if>>

<<if _e[$log.science] isnot 0>><<if _e[$log.science] gt 0>><span class="green">+Science </span><</if>><</if>>
<<if _e[$log.maths] isnot 0>><<if _e[$log.maths] gt 0>><span class="green">+Maths </span><</if>><</if>>
<<if _e[$log.english] isnot 0>><<if _e[$log.english] gt 0>><span class="green">+English </span><</if>><</if>>
<<if _e[$log.history] isnot 0>><<if _e[$log.history] gt 0>><span class="green">+History </span><</if>><</if>>

<<if _e[$log.cool] isnot 0>>
	<<if _e[$log.cool] lt 0>><span class="red">-Status </span><</if>>
	<<if _e[$log.cool] gt 0>><span class="green">+Status </span><</if>>
<</if>>

<<if _e[$log.detention] isnot 0>>
	<<if _e[$log.detention] gt 0>><span class="red">+Detention </span><</if>>
	<<if _e[$log.detention] lt 0>><span class="lblue">-Detention </span><</if>>
<</if>>

<<if _e[$log.spray] isnot 0>>
	<<if _e[$log.spray] lt 0>><span class="red">-pepper spray </span><</if>>
	<<if _e[$log.spray] gt 0>><span class="green">+pepper spray </span><</if>>
<</if>>

<<if _e[$log.money] isnot 0>>
	<<if _e[$log.money] lt 0>><span class="red">-£<<print Math.abs(Math.trunc(_e[$log.money] / 100))>>.<<if _e[$log.money] % 100 lte 9>>0<</if>><<print _e[$log.money] % 100>></span><</if>>
	<<if _e[$log.money] gt 0>><span class="gold">£<<print Math.trunc(_e[$log.money] / 100)>>.<<if _e[$log.money] % 100 lte 9>>0<</if>><<print _e[$log.money] % 100>></span><</if>>
<</if>>
<<if _e[$log.antiquemoney] gt 0>><span class="brown"> £<<print _e[$log.antiquemoney]>></span><</if>>
<<if _e[$log.blackmoney] gt 0>><span class="black"> £<<print _e[$log.blackmoney]>></span><</if>>

<<if $logshowcomments is 1>><span class="meek"><<print _e[$log.comment]>></span><</if>>
<<if $logshowopinions is 1>><span class="meek"><<print _e[$log.opinion]>></span><</if>>

<<if $logdebug is 1>><span class="greyred">/* Do I need the undefined checks? */
	<<if _e[$log.weather] isnot "" and _e[$log.weather] isnot undefined>>weather changed to <<print _e[$log.weather]>><</if>>
	<<if _e[$log.pain] isnot 0 and _e[$log.pain] isnot undefined>>pain:<<print _e[$log.pain]>><</if>>
	<<if _e[$log.arousal] isnot 0 and _e[$log.arousal] isnot undefined>>arousal:<<print _e[$log.arousal]>><</if>>
	<<if _e[$log.tiredness] isnot 0 and _e[$log.tiredness] isnot undefined>>tiredness:<<print _e[$log.tiredness]>><</if>>
