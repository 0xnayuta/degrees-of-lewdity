:: Widgets Diary [widget]
/*

You can add new variables to be tracked by diary by 
1. adding , yourvariable:$yourvariable to $logged in <<logstats>>.
2. if necessary add stuff to <<showlogentry>> otherwise it'll only show up with $logdebug 
3. add it to <<setstatsto>> in widgets.twee

*/
<<widget "loginit">><<nobr>>
<<if $debug>>
	<<run console.log("Ran loginit in "+$passage+".")>>
<</if>>

<<if $logday is undefined>>
	<<set $logday to 0>>
<</if>>

<<if $log is undefined>>
	<<set $log to []>>
	<<set $diarypage to 0>>
	<<set $diaryline to 0>>
	<<set $todoentries to 0>>
	<<set $logextra to "">>
	<<set $logprep to "">>
<</if>>
<<if $logpars is undefined>>
	<!-- This just lets log be an array while using it mostly like an object, so instead of $log.text we use $log[$logpars.text] -->
	<!-- I could probably get rid of the opinion, for now moving it to be last -->
	<<set $logpars to {time:0,text:1,importance:2,comment:3,day:4,written:5,stats:6,opinion:7}>>
	<<set $logpars to {time:0,text:1,importance:2,comment:3,opinion:4,written:5,stats:6,day:7}>><!--remove before making new save-->
<</if>>	
<<if $logblank is undefined>>
	<<set $logblank to [,,,,,,,]>>
<</if>>
/*
alternative between having logged stats as an object with nice names and having it as an array and a separate object for names much like this one, the main advantage this has is that the order of stuff doesn't matter while still not adding that much to save file size.
1234567890qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM
ëËêÊÿŸüÜûÛïÏîÎöÖôÔäÄâÂ
õÕãÃñÑ
éÉýÝúÚíÍóÓáÁèÈùÙìÌòÒàÀ
åÅæÆœŒçÇðÐøØ
ΑαΒβΓγΔδΕεΖζΗηΘθΙιΚκΛλΜμΝνΞξΟοΠπΡρΣσΤτΥυΦφΧχΨψΩω
*/
/*
<<set $vars to {}>>
<<set _v to [
	"money","stress","trauma","awareness","pain",
  "tiredness","arousal","control","allure","antiquemoney",
	"blackmoney","spray","spraymax","drunk","drunk",
	"drugged","weather",
	"upperclothes","lowerclothes","underclothes",
	"upperintegrity","lowerintegrity","underintegrity",
	"upperintegritymax","lowerintegritymax","underintegritymax",
	"collared","purity",
	"submissive","physique","beauty","promiscuity","exhibitionism",
	"deviancy","skulduggery","danceskill","swimmingskill","seductionskill",
	"oralskill","vaginalskill","penileskill","analskill","handskill",
	"feetskill","bottomskill","thighskill","chestskill","science",
	"maths","english","history","school","unclad",
  "cool","detention","fameexhibitionism","fameprostitution","famebestiality",
  "famerape","famesex","famegood","famebusiness","famepimp",
  "famescrap","dancestat","drinksservedstat","tablesservedstat","prostitutionstat",
  "forcedprostitutionstat","orgasmstat","ejacstat","moleststat","rapestat",
  "beastrapestat","tentaclerapestat","swallowedstat","parasitestat","hitstat",
  "attackstat","spraystat","rescued","clothesstripstat","clothesruinstat",
  "passoutstat", "bus"
	]>>
<<set _i2 to 0>>
<<set _chars to "1234567890qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNMëËêÊÿŸüÜûÛïÏîÎöÖôÔäÄâÂõÕãÃñÑéÉýÝúÚíÍóÓáÁèÈùÙìÌòÒàÀåÅæÆœŒçÇðÐøØΑαΒβΓγΔδΕεΖζΗηΘθΙιΚκΛλΜμΝνΞξΟοΠπΡρΣσΤτΥυΦφΧχΨψΩω">>
<<for _i to 0 ; _i lt _v.length ; _i++>>
	<<if _i gt _chars.length>>
	<<set $vars[_v[_i]] to _chars.charAt(_i2)+_chars.charAt(_i)>>
	<<elseif _i gt _chars.length*2>>
	<<set $vars[_v[_i]] to _chars.charAt(_i2+1)+_chars.charAt(_i)>>
	<<else>>
	<<set $vars[_v[_i]] to _chars.charAt(_i)>>
	<</if>>
<</for>>

/* settings */
<<if $logdebug is undefined>><<set $logdebug to 0>><</if>>
<<if $diarymode is undefined>><<set $diarymode to 0>><</if>>
<<if $loglocations is undefined>><<set $loglocations to 1>><</if>>
<<if $diaryprompts is undefined>><<set $diaryprompts to 0>><</if>>
<<if $diaryfilterA is undefined>><<set $diaryfilterA to 0>><</if>>
<<if $diaryfilterB is undefined>><<set $diaryfilterB to 1>><</if>>
<<if $diaryinsertfilterinfo is undefined>><<set $diaryinsertfilterinfo to 0>><</if>>
<<if $logshowcomments is undefined>><<set $logshowcomments to 1>><</if>>
<<if $logshowopinions is undefined>><<set $logshowopinions to 0>><</if>>
<<if $logchangetreshold is undefined>><<set $logchangetreshold to 0>><</if>>
<<if $diaryshowunwritten is undefined>><<set $diaryshowunwritten to false>><</if>>
/* importances */
<<if $busimportance is undefined>><<set $busimportance to 2>><</if>>
<<if $workimportance is undefined>><<set $workimportance to 2>><</if>>
<<if $passoutimportance is undefined>><<set $passoutimportance to 2>><</if>>
<<if $exposureimportance is undefined>><<set $exposureimportance to 2>><</if>>
<<if $logextraimportance is undefined>><<set $logextraimportance to 8>><</if>>
<<if $locationimportance is undefined>><<set $locationimportance to 0>><</if>>
<<if $lockpickimportance is undefined>><<set $lockpickimportance to 0>><</if>>

/* How do I make it so that the log doesn't have to have entries for each day?
with $logday, it's like $days but can be set to smaller number when archiving old entries.
 */
<<if $log.length-1 lt $logday>> /* fill log with blank days to catch up to current date */
	<<if $debug>>
		<<run console.log("filling log with blank days to catch up to current date.")>>
	<</if>>
	<<for _i to 0; _i lt $logday; _i++>>
		<<if $log[_i] is undefined>>
			<<set $log.push([])>>
			<<set $log[_i][0] to clone($logblank)>>
			<<set $log[_i][0][$logpars.text] to "Day " + $days - $logday + _i>>
			<<set $log[_i][0][$logpars.importance] to -5>>
		<</if>>
	<</for>>
	<<set $log.push([[]])>>
	<<set _a to $log[$logday][0]>>
	<<set _a[$logpars.text] to $month+" "+$monthday>>
	<<set _a[$logpars.time] to 0>>
	<<set _a[$logpars.comment] to "(Day "+$days+")">>
	<<set _a[$logpars.importance] to 7>>
	<<set _a[$logpars.written] to 2>>
	<<set _a[$logpars.stats] to {}>>
	<<set _a[$logpars.day] to $days>>
<</if>>

<<if $statlist is undefined or $objectVersion.statlog is undefined or $objectVersion.statlog lt 1>>
	<<logstats>>
	<<set $objectVersion.statlog to 1>>
<</if>>

<</nobr>><</widget>>


<<widget "diaryinit">><<nobr>>
<!--<<run console.log("Ran diaryinit.")>>-->
<<if $diarydisable is undefined>><!-- $diarydisable makes only log stuff happen making it just a uninteractive record of events -->
	<<if $diary is undefined>>
		<!--
		<<set $diary to [[[]]]>>
		<<set $diary to {year2021:{month9:{day0:[]}}}>>
		-->
		<<set _dayX to "day"+$days>>
		<<set $diary to {}>>
		<<set $diary[_dayX] to { day: $days , entries: [] , stats: {} }>>
	<</if>>

	<<if $dpars is undefined>><!-- diary parameters -->
		<!-- This just lets diary entries be an arrays while using them mostly like objects, so instead of 
		$diary[_day].entries[_entry].text 
		we use 
		$diary[_day].entries[_entry].[$dpars.text] 
		-->
		<<set $dpars to {time:0,text:1,importance:2,comment:3,stats:4}>>
<</if>>	



<</if>>	

<</nobr>><</widget>>

<<widget "logstats">><<nobr>> /* update logged to current stats */ 
<<clamp>>/* prevent stat changes that go beyond the limits from being logged. */
/* does mean the $beauty from <<preclamp>> often gets added at the end of an event instead of in next passage by caption.twee but I don't think it will cause any issues. */
<<set $logged to {
	hunger:$hunger,money:$money,stress:$stress,trauma:$trauma,awareness:$awareness,pain:$pain,
	tiredness:$tiredness,arousal:$arousal,control:$control,allure:$allure,antiquemoney:$antiquemoney,
	blackmoney:$blackmoney,spray:$spray,spraymax:$spraymax,drunk:$drunk,drunk:$drunk,
	drugged:$drugged,weather:$weather,
	worn:$worn,
	purity:$purity,
	submissive:$submissive,physique:$physique,beauty:$beauty,promiscuity:$promiscuity,exhibitionism:$exhibitionism,
	deviancy:$deviancy,skulduggery:$skulduggery,danceskill:$danceskill,swimmingskill:$swimmingskill,seductionskill:$seductionskill,
	oralskill:$oralskill,vaginalskill:$vaginalskill,penileskill:$penileskill,analskill:$analskill,handskill:$handskill,
	feetskill:$feetskill,bottomskill:$bottomskill,thighskill:$thighskill,chestskill:$chestskill,science:$science,
	maths:$maths,english:$english,history:$history,school:$school,unclad:$unclad,
	athletics:$athletics,tending:$tending,grace:$grace,
  cool:$cool,detention:$detention,fameexhibitionism:$fameexhibitionism,fameprostitution:$fameprostitution,famebestiality:$famebestiality,
  famerape:$famerape,famesex:$famesex,famegood:$famegood,famebusiness:$famebusiness,famepimp:$famepimp,
	famesocial:$famesocial,famepark:$famepark,schoolrep:$schoolrep,
  famescrap:$famescrap,dancestat:$dancestat,drinksservedstat:$drinksservedstat,tablesservedstat:$tablesservedstat,prostitutionstat:$prostitutionstat,
  forcedprostitutionstat:$forcedprostitutionstat,orgasmstat:$orgasmstat,ejacstat:$ejacstat,moleststat:$moleststat,rapestat:$rapestat,
  beastrapestat:$beastrapestat,tentaclerapestat:$tentaclerapestat,swallowedstat:$swallowedstat,parasitestat:$parasitestat,hitstat:$hitstat,
  attackstat:$attackstat,spraystat:$spraystat,rescued:$rescued,clothesstripstat:$clothesstripstat,clothesruinstat:$clothesruinstat,
  passoutstat:$passoutstat,bus:$bus,
	packtrust:$wolfpacktrust,packfear:$wolfpackfear,
	insecurity_penis_tiny:$insecurity_penis_tiny,insecurity_penis_small:$insecurity_penis_small,insecurity_penis_big:$insecurity_penis_big,insecurity_breasts_tiny:$insecurity_breasts_tiny,insecurity_breasts_small:$insecurity_breasts_small,insecurity_breasts_big:$insecurity_breasts_big,
	acceptance_penis_tiny:$acceptance_penis_tiny,acceptance_penis_small:$acceptance_penis_small,acceptance_penis_big:$acceptance_penis_big,acceptance_breasts_tiny:$acceptance_breasts_tiny,acceptance_breasts_small:$acceptance_breasts_small,acceptance_breasts_big:$acceptance_breasts_big,
	breastsize:$breastsize,bottomsize:$bottomsize,penissize:$penissize,ballssize:$ballssize
}>>
<<if $statlist isnot Object.keys($logged)>>
	<<set $statlist to Object.keys($logged)>>/* array with all of the statnames */
<</if>>
/*
<<if 0 is 0>>
<<else>>
	<<set _values to [$money,$stress,$trauma,$awareness,$pain,
	$tiredness,$arousal,$control,$allure,$antiquemoney,
	$blackmoney,$spray,$spraymax,$drunk,$drunk,
	$drugged,$weather,
	$worn,
	$collared,$purity,
	$submissive,$physique,$beauty,$promiscuity,$exhibitionism,
	$deviancy,$skulduggery,$danceskill,$swimmingskill,$seductionskill,
	$oralskill,$vaginalskill,$penileskill,$analskill,$handskill,
	$feetskill,$bottomskill,$thighskill,$chestskill,$science,
	$maths,$english,$history,$school,$unclad,
	$athletics,$tending,
	$cool,$detention,$fameexhibitionism,$fameprostitution,$famebestiality,
	$famerape,$famesex,$famegood,$famebusiness,$famepimp,
	$famesocial,$famepark,
	$famescrap,$dancestat,$drinksservedstat,$tablesservedstat,$prostitutionstat,
	$forcedprostitutionstat,$orgasmstat,$ejacstat,$moleststat,$rapestat,
	$beastrapestat,$tentaclerapestat,$swallowedstat,$parasitestat,$hitstat,
	$attackstat,$spraystat,$rescued,$clothesstripstat,$clothesruinstat,
	$passoutstat, $bus,
	$wolfpacktrust,$wolfpackfear,
	$insecurity_penis_tiny,$insecurity_penis_small,$insecurity_penis_big,$insecurity_breasts_tiny,$insecurity_breasts_small,$insecurity_breasts_big,
	$acceptance_penis_tiny,$acceptance_penis_small,$acceptance_penis_big,$acceptance_breasts_tiny,$acceptance_breasts_small,$acceptance_breasts_big,
	$breastsize,$bottomsize,$penissize,$ballssize
	]>>
	<<for _i to 0 ; _i lt _v.length ; _i++>>
		<<set $logged[$vars[_i]] to _values[_u]>>
	<</for>>
<</if>>
/
to add:
Delinquency
More specific ejaculation stats
goo/semen
virginities?
transformation stats 
lactation and hair stats?
*/
<</nobr>><</widget>>

<<widget "log">><<nobr>>
<<if $reality is true>>
	<<if $diaryshowunwritten is 90>>
		How do I do this?
		At first I was thinking I'd move entries from $diary to $writtendiary
		But actually what if it was just a per entry bool for having written it that gets checked whenever 
		Also does $diaryshowunwritten need to be a number instead of boolean? I mean there could be more than just on/off as option but nah bool is fine
		Since knowing the actual value is useful for say $drunk and probably for others should I somehow make it so that it doesn't need an exception to work,
			what if 123 to 120 resulted in "123+-3" instead of "-3" or just use the same method as for strings so "123->120"?
				gain stuff took care of this I think?
	<</if>>
	<<if $logdebug is 1>>
		<br>log<<print $args[1]>>(<<print $args[0]>>)<br>
		<<run console.log("::"+$passage+" <<log \""+$args[0]+"\" "+$args[1]+">>")>>
	<</if>>

	<<if $args[0] == undefined>><<set $args[0] to "Did something.">><</if>>
	<<if $args[1] == undefined>><<set $args[1] to 1>><</if>>
	<<set $logprep to "">>
	<<set $logprep2 to "">>
	<<unset $logprep3>>
	<<unset $logprepvars>>
	<<set $diarypage to $logday>>
	<<set $diaryline to $log[$logday].length>>
	<<set $log[$logday].push([])>>
	<<set $log[$logday][$diaryline][$logpars.day] to $days>>
	<<set $log[$logday][$diaryline][$logpars.time] to $time>>
	<<set $log[$logday][$diaryline][$logpars.text] to $args[0]>>
	<<set $log[$logday][$diaryline][$logpars.importance] to $args[1]>>
	<<if $logdebug is 1>>
		<<set $log[$logday][$diaryline][$logpars.comment] to " :: "+$passage>>
		<<set $log[$logday][$diaryline][$logpars.opinion] to " :: "+$passage>>
	<<else>>
		<<set $log[$logday][$diaryline][$logpars.comment] to "">>
		<<set $log[$logday][$diaryline][$logpars.opinion] to "">>
	<</if>>
	<<set $log[$logday][$diaryline][$logpars.written] to 0>>
	<<if $args[1] gte $logwritetreshold>>
		<<set $todoentries++>>
	<</if>>
	<<set $log[$logday][$diaryline][$logpars.stats] to {}>>
	<<if $args[1] gte $logchangetreshold or $logdebug is 1 or $oldlogged is undefined>>
		/* is there way I could not have anything at all when stat hasn't changed? yes */
		<<set $oldlogged to clone($logged)>>/* should this be clone($logged)>>? */
		<<if $trauma gt $logged[$statlist.trauma]+1 and $diarydisable is undefined>><!-- Add some trauma to traumatic entries so that writing them down can later remove that amount without affecting overall trauma balance. -->
			<<trauma 2>>
		<</if>>
		<!---->
		<<logstats>>
		<<for _i to $statlist.length-1; _i gt 0; _i-->>
			<<set _d to $log[$logday][$diaryline][$logpars.stats]>>
			<<if $logged[$statlist[_i]] isnot $oldlogged[$statlist[_i]]>>
				<<if typeof($logged[$statlist[_i]]) is "number">>
					<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]] to ($logged[$statlist[_i]])>>/* note that this shows up only when it has changed */
					<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]+"gain"] to ($logged[$statlist[_i]] - $oldlogged[$statlist[_i]])>> /* this makes it so that say .moneygain is how much money changed */
					<<if $diarydisable is undefined>>
						<<set _dayX to "day"+$days>>
						<<if $diary[_dayX].stats[$statlist[_i]] is undefined>>
							<<set $diary[_dayX].stats[$statlist[_i]] to 0>> 
						<</if>>
						<<set $diary[_dayX].stats[$statlist[_i]] += ($logged[$statlist[_i]] - $oldlogged[$statlist[_i]])>> 
						<!-- 
						I'm tired, what this should translate to is for example $diary.day2.stats.stress = stress gain of the whole day
						-->
					<</if>>
				<<elseif typeof($logged[$statlist[_i]]) is "string">>
					/*<<set _d[$statlist[_i]] to $oldlogged[$statlist[_i]]+"->"+$logged[$statlist[_i]]>>/* _d.weather.split("->")[1] to get the new value and .split("->")[0] for the old*/
					/* having less properties per entry probably isn't that important now that only changes get defined(and each of them doesn't need their own shit(meaning that we now have both "oldstring" and "string" instead of "oldstring->string")) */
					<<set _d[$statlist[_i]] to $logged[$statlist[_i]]>>
					<<set _d["old"+$statlist[_i]] to $oldlogged[$statlist[_i]]>>
					<<if $diarydisable is undefined>>
						/* for the daily statchange summary we do want all the changes in one value which for strings can look a bit weird */
						<<if $diary["day"+$days].stats[$statlist[_i]] is undefined>>
							<<set $diary["day"+$days].stats[$statlist[_i]] to $logged[$statlist[_i]]>> 
						<<else>>
							<<set $diary["day"+$days].stats[$statlist[_i]] += "->"+$logged[$statlist[_i]]+"">>
						<</if>>
					<</if>>
				<<elseif typeof($logged[$statlist[_i]]) is "boolean">>
					<<set _d[$statlist[_i]] to ($logged[$statlist[_i]])>>
					<<if $diarydisable is undefined>>
						<<set $diary["day"+$days].stats[$statlist[_i]] to ($logged[$statlist[_i]])>>
					<</if>>
				<<elseif typeof($logged[$statlist[_i]]) is "object">>
					<!-- No idea how or if objects should be handled, clothing and npc stuff could be handled as objects but including only the changed bits would be tricky as would displaying the changes -->
				<<elseif typeof($logged[$statlist[_i]]) is "undefined">>
				<</if>>
			<</if>>
		<</for>>
		
		/* need to list all clothing when something changes so that we don't need to search through previous entries to figure out if a part that didn't change is naked or not */
		/* this makes it so that to see if you already were wearing a clothing you check if .old___erclothes is undefined, I'd like it to be somehow simpler but I'm not sure if it'll really be even used so this is good enough */
		<<set _d to $log[$logday][$diaryline][$logpars.stats]>>
		<<if _d.upperclothes isnot undefined or _d.lowerclothes isnot undefined or _d.underclothes isnot undefined>>
			<<set $log[$logday][$diaryline][$logpars.stats].upperclothes to $upperclothes>>
			<<set $log[$logday][$diaryline][$logpars.stats].upperintegrity to $upperintegrity>>
			<<set $log[$logday][$diaryline][$logpars.stats].upperintegritymax to $upperintegritymax>>
			<<set $log[$logday][$diaryline][$logpars.stats].lowerclothes to $lowerclothes>>
			<<set $log[$logday][$diaryline][$logpars.stats].lowerintegrity to $lowerintegrity>>
			<<set $log[$logday][$diaryline][$logpars.stats].lowerintegritymax to $lowerintegritymax>>
			<<set $log[$logday][$diaryline][$logpars.stats].underclothes to $underclothes>>
			<<set $log[$logday][$diaryline][$logpars.stats].underintegrity to $underintegrity>>
			<<set $log[$logday][$diaryline][$logpars.stats].underintegritymax to $underintegritymax>>
		<</if>>
		/* 
		Actually what would looking through the old entries instead look like?
			<<if upperclothes is undefined or lower or under>>
				<<set _lookupday to $logday>>
				<<for _lookupline to $diaryline-1;upp/low/und-erclothes is undefined;_lookupline-->>
					<<if $log[_lookupday][_lookupline][$logpars.stats].upperclothes isnot undefined>>
						return $log[_lookupday][_lookupline][$logpars.stats].upperclothes
					<</if>>
					same for other clothes
					<<if _lookupline is 0>>
						<<set _lookupday-->>
						<<set _lookupline to $log[_lookupday].length>> it'll -- now so that'll do -1 that length usually needs
					<</if>>
				<</for>>
			<</if>>
		so while it's certainly doable it might have to go through tons of stuff when say wearing a chastitybelt or if it should include accessories so at least for this purpose it seems like a bad idea, might be worth it if there was enough stuff that repeatedly storing the same values would somehow become a problem.
		*/
	<</if>>
	<<if $logextra isnot "" and $logextra isnot undefined>> /* virginity loss entries should come after the event (or as some special comment like thing) */
		<<logextra $logextra $logextraimportance>>
	<</if>>
	<<if $args[0].includes("TBD")>>/* Prompt for a better wording. */
		<<logtbd $args[0]>>
	<</if>>
<</if>>
<</nobr>><</widget>>

<<widget "logextra">><<nobr>>
<<if $reality is true>>
	<<if $args[1] == undefined>><<set $args[1] to 8>><</if>>
	<<set $logextra to "">>
	<<set _ex to clone($logblank)>>
	<<set _ex[$logpars.day] to $days>>
	<<set _ex[$logpars.time] to $time>>
	<<set _ex[$logpars.text] to $args[0]>>
	<<set _ex[$logpars.importance] to $args[1]>>
	<<set _ex[$logpars.written] to 0>>
	<<set _ex[$logpars.stats] to {}>>

	<<set $diarypage to $logday>>
	<<set $diaryline to $log[$logday].length-1>>/* since <<log>> will get the correct diaryline it should be safe to set diaryline to -1 of what it really should be */
	<<run $log[$logday].push(_ex)>>
<</if>>
<</nobr>><</widget>>


<<widget "dumblog">><<nobr>>/* add entries without clearing logprep or affecting stat tracking, for entries that get added mid event or such, similar to logextra but doesn't assume it's called by <<log>> */
/* Could be useful for breaking super long events into multiple entries... But only last one wanting rationalisation(as the only one with recorded trauma gain) has some questionable aspects(ie. trauma gain happens early and you end up needing to rationalise walking home with some npc or such) that might be annoying to make nice so I'll try stick to one entry per event. */
<<if $reality is true>>
	<<if $logdebug is 1>><br>log<<print $args[1]>>(<<print $args[0]>>)<br><</if>>
	<<if $args[1] == undefined>><<set $args[1] to 1>><</if>>
	<<set $diarypage to $logday>>
	<<set $diaryline to $log[$logday].length>>
	<<set $log[$logday].push([])>>
	<<set $log[$logday][$diaryline][$logpars.day] to $days>>
	<<set $log[$logday][$diaryline][$logpars.time] to $time>>
	<<set $log[$logday][$diaryline][$logpars.text] to $args[0]>>
	<<set $log[$logday][$diaryline][$logpars.importance] to $args[1]>>
	<<set $log[$logday][$diaryline][$logpars.comment] to "">>
	<<set $log[$logday][$diaryline][$logpars.opinion] to "">>
	<<set $log[$logday][$diaryline][$logpars.written] to 0>>
	<<set $log[$logday][$diaryline][$logpars.stats] to {}>>
<</if>>
<</nobr>><</widget>>


<<widget "logedit">><<nobr>> /* edit/replace the last entry text*/
<<if $reality is true>>
	<<set $log[$logday][$diaryline][$logpars.text] to $args[0]>>
<</if>>
<</nobr>><</widget>>

<<widget "logadd">><<nobr>> /* add to the last entry text*/
<<if $reality is true>>
	<<set $log[$logday][$diaryline][$logpars.text] to $log[$logday][$diaryline][$logpars.text]+$args[0]>>
<</if>>
<</nobr>><</widget>>

<<widget "logupdateeffect">><<nobr>> /*  update the last effect(strings require $logdebug since clothing report will be buggy)	*/
/* I'd really like to remove this but Robin Money Demand and Kylar Shake passages seem hellish to handle without this(adding a thing to every single link in "robinoptions" and "kylaroptions" just to handle such a minor thing seems insane)
One semi reasonable option would be to just do two log entries(done, leaving this in just in case I change my mind or something).
 */
<<if $reality is true>>
	<<set _old to clone($logged)>>
	<<logstats>>
	<<for _i to $statlist.length-1; _i gt 0; _i-->>
		<<set _d to $log[$logday][$diaryline][$logpars.stats]>>
		<<if $logged[$statlist[_i]] isnot _old[$statlist[_i]]>>
			<<if typeof($logged[$statlist[_i]]) is "number">>
				<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]] to ($logged[$statlist[_i]])>>
				<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]+"gain"] to $logged[$statlist[_i]+"gain"] + _old[$statlist[_i]+"gain"]>>
			<<elseif typeof($logged[$statlist[_i]]) is "string">>
				<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]] to $logged[$statlist[_i]]>>
				<<set $log[$logday][$diaryline][$logpars.stats]["old"+$statlist[_i]] to _old[$statlist[_i]]>>
			<<elseif typeof($logged[$statlist[_i]]) is "boolean">>
				<<set $log[$logday][$diaryline][$logpars.stats][$statlist[_i]] to ($logged[$statlist[_i]])>>
			<<elseif typeof($logged[$statlist[_i]]) is "undefined">>
			<</if>>
		<</if>>
	<</for>>
<</if>>
<</nobr>><</widget>>

<<widget "logtimeupdate">><<nobr>> /*  change entry time in case log was called early for some reason */
<<if $reality is true>>
	<<set $log[$logday][$diaryline].time to $time>>
<</if>>
<</nobr>><</widget>>

<<widget "logday">><<nobr>>/* the widget making end of day reports, not to be confused with $logday the variable */
<<if $reality is true>>
	<<set $dayendreport to "">>
	/* $moneytext might be useful in other situtations so could move this to some place that gets run more often */
	<<set $moneytext to "£"+ Math.trunc($money / 100)+".">>
	<<if $money % 100 lte 9>><<set $moneytext to $moneytext+"0">><</if>>
	<<set $moneytext to $moneytext+$money % 100>>
	<<set $dayendreport to "It's the start of a new day! I have " + $moneytext + " and I feel ">>

	<<if $tiredness gte 2000>><<set $dayendreport to $dayendreport + "<span class='red'>exhausted</span>, ">>
	<<elseif $tiredness gte 1600>><<set $dayendreport to $dayendreport + "<span class='pink'>fatigued</span>, ">>
	<<elseif $tiredness gte 1200>><<set $dayendreport to $dayendreport + "<span class='purple'>tired</span>, ">>
	<<elseif $tiredness gte 800>><<set $dayendreport to $dayendreport + "<span class='blue'>wearied</span>, ">>
	<<elseif $tiredness gte 400>><<set $dayendreport to $dayendreport + "<span class='lblue'>alert</span>, ">>
	<<elseif $tiredness gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>wide awake</span>, ">>
	<<else>><<set $dayendreport to $dayendreport + "<span class='green'>refreshed</span>, ">>
	<</if>>
	<<if $stress gte 10000>><<set $dayendreport to $dayendreport + "<span class='red'>extremely stressed out</span>">>
	<<elseif $stress gte 8000>><<set $dayendreport to $dayendreport + "<span class='pink'>very stressed</span>">>
	<<elseif $stress gte 6000>><<set $dayendreport to $dayendreport + "<span class='purple'>kind of stressed</span>">>
	<<elseif $stress gte 4000>><<set $dayendreport to $dayendreport + "<span class='blue'>a bit tense</span>">>
	<<elseif $stress gte 2000>><<set $dayendreport to $dayendreport + "<span class='lblue'>somewhat relaxed</span>">>
	<<elseif $stress gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>rather relaxed</span>">>
	<<else>><<set $dayendreport to $dayendreport + "<span class='green'>serene</span>">>
	<</if>>
	<<set $dayendreport to $dayendreport + " and ">>
	<<if $innocencestate isnot 1>>	/* would $awarelevel gte 0 work too? */
		<<if $trauma gte $traumamax>><<set $dayendreport to $dayendreport + "<span class='red'>numb</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 4>><<set $dayendreport to $dayendreport + "<span class='pink'>tormented</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 3>><<set $dayendreport to $dayendreport + "<span class='purple'>disturbed</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 2>><<set $dayendreport to $dayendreport + "<span class='blue'>troubled</span>">>
		<<elseif $trauma gte ($traumamax / 5) * 1>><<set $dayendreport to $dayendreport + "<span class='lblue'>nervous</span>">>
		<<elseif $trauma gte 1>><<set $dayendreport to $dayendreport + "<span class='teal'>uneasy</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>healthy</span>">>
		<</if>>
	<<else>>
		<<if $awareness gte 0>><<set $dayendreport to $dayendreport + "<span class='red'>aware</span>">>
		<<elseif $awareness gt -40>><<set $dayendreport to $dayendreport + "<span class='pink'>uncertain</span>">>
		<<elseif $awareness gt -80>><<set $dayendreport to $dayendreport + "<span class='purple'>perplexed</span>">>
		<<elseif $awareness gt -120>><<set $dayendreport to $dayendreport + "<span class='blue'>curious</span>">>
		<<elseif $awareness gt -160>><<set $dayendreport to $dayendreport + "<span class='lblue'>trusting</span>">>
		<<elseif $awareness gt -200>><<set $dayendreport to $dayendreport + "<span class='teal'>naive</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>oblivious</span>">><</if>>
	<</if>>
	<<set $dayendreport to $dayendreport + " and the state of my body ">> /* this part could probably be worded better */

		<<if $pain gte 100>><<set $dayendreport to $dayendreport + "makes me <span class='red'>sob uncontrollably</span>">>
		<<elseif $pain gte 80>><<set $dayendreport to $dayendreport + "makes me <span class='pink'>cry and whimper</span>">>
		<<elseif $pain gte 60>><<set $dayendreport to $dayendreport + "makes me <span class='purple'>cry</span>">>
		<<elseif $pain gte 40>><<set $dayendreport to $dayendreport + "makes <span class='blue'>tears run down my face</span>">>
		<<elseif $pain gte 20>><<set $dayendreport to $dayendreport + "makes <span class='lblue'>tears well in my eyes</span>">>
		<<elseif $pain gte 1>><<set $dayendreport to $dayendreport + "makes me <span class='teal'>upset</span>">>
		<<else>><<set $dayendreport to $dayendreport + "<span class='green'>feels okay</span>">>
	<</if>>

	<<set $dayendreport to $dayendreport + " I'm also ">> /* this also could probably be worded better */

		<<if $arousal gte 10000>><<set $dayendreport to $dayendreport + "<span class='red'>shaking with arousal</span>">>
		<<elseif $arousal gte 8000>><<set $dayendreport to $dayendreport + "feeling like there is <span class='pink'>a heat rising within me</span>">>
		<<elseif $arousal gte 6000>><<set $dayendreport to $dayendreport + "feeling <span class='purple'>horny</span>">>
		<<elseif $arousal gte 4000>><<set $dayendreport to $dayendreport + "feeling <span class='blue'>lustful</span>">>
		<<elseif $arousal gte 2000>><<set $dayendreport to $dayendreport + "feeling <span class='lblue'>aroused</span>">>
		<<elseif $arousal gte 1>><<set $dayendreport to $dayendreport + "feeling <span class='teal'>sensual</span>">>
		<<else>><<set $dayendreport to $dayendreport + "feeling <span class='green'>cold</span>">>
	<</if>>

	<<set $dayendreport to "Bazang! "+ $dayendreport>>


	<<set $dayendreport to $dayendreport + ".">>
	<<set $diaryline to $log[$logday].length>> /* */
	<<set $log[$logday].push(clone($logblank))>>
	<<set $log[$logday][$diaryline].time to $time>>
	<<set $log[$logday][$diaryline][$logpars.text] to $dayendreport>>
	<<set $log[$logday][$diaryline][$logpars.importance] to 7>>
	<<set $log[$logday][$diaryline].written to 0>>
	<<set $log[$logday][$diaryline][$logpars.stats] to clone($logged)>>
	/*
	<<set $log[$logday].push(
		{
	    timestamp:$time,
	    text:$dayendreport,
			importance:7, comment:"",	comment:"",	opinion:"", effect:{money:0,stress:0,trauma:0,awareness:0,pain:0,tired:0,arousal:0,control:0,allure:0,antiquemoney:0,blackmoney:0,weather:"",upperclothes:"",lowerclothes:"",underclothes:"",oldupperclothes:(""),oldlowerclothes:(""),oldunderclothes:("")}
	  }
		)>>*/
<</if>>
<</nobr>><</widget>>

<<widget "logcomment">><<nobr>>
	<<set $log[$args[0]][$args[1]][$logpars.comment] to "("+$args[2]+")">>
<</nobr>><</widget>>

<<widget "logimportance">><<nobr>>
	<<set $log[$args[0]][$args[1]][$logpars.importance] to $args[2]>>
<</nobr>><</widget>>

<<widget "logopinion">><<nobr>>
<<if $reality is true>>
<span id="textbox1">
<<set _c to "">>
<<set $plropinion to "">>
<<if $diaryprompts is 2 or $diaryprompts is 3>>
	<span class="lblue">Select how you feel about this event:</span><br><span class="grey">
		<<for _i to 0;_i lt $args.length; _i++>>
			<label><<radiobutton "$plropinion" $args[_i]>> $args[_i]</label><br>
		<</for>></span>
<<else>>
	<<if $args[0]>><<set _c to $args.random()>><</if>>
	/* <<set $log[$logday][$diaryline][$logpars.opinion] to "["+_c+"]">> /* sets opinion to whatever if you don't have opinion prompts */
<</if>>
<<if $diaryprompts is 1>>
	<<textbox "$plrcomment" _c >>
	<<link "Add a comment to your diary">><<logcomment $logday $diaryline $plrcomment>><<remove "#textbox1">><</link>><br>
<<elseif $diaryprompts is 2>>
	<span class="lblue">Comment:</span><<textbox "$plrcomment" "" >><br>
	<<link "Add your opinion and comment to the diary">><<set $log[$logday][$diaryline][$logpars.opinion] to "["+$plropinion+"]">><<logcomment $logday $diaryline $plrcomment>><<remove "#textbox1">><</link>><br>
<<elseif $diaryprompts is 3>>
	<<link "Add your opinion to the diary">><<set $log[$days][$diaryline][$logpars.opinion] to "["+$plropinion+"]">><</link>><br>
<</if>></span>
<</if>>
<</nobr>><</widget>>

<<widget "logtbd">><<nobr>>
<span id="textbox1">
<<set $tbdline to $args[0]>>
Log entry marked as to be decided, you can write a better one:<br>
<<textbox "$tbdline" $args[0] >>
<<link "Use this">>
	<<logedit $tbdline>>
	<<if $tbdline isnot $args[0]>><!-- check that the line was actually changed -->
		<<logcomment $logday $diaryline `"Was originally:"+$args[0]`>>
	<</if>>
	<<remove "#textbox1">>
<</link>> |
<<link "Leave it as it was">><<remove "#textbox1">><</link>><br>
</span>
<</nobr>><</widget>>



<<widget "showlogentry4">><<nobr>>
<!-- 
1560, 1453, 1447, 1483, 1391, 1393, 1530, 1384, 1392, 1488, 1447, 1409, 1457, 1461, 1436, 
avg = 1448.73
-->
<</nobr>><</widget>>


<<widget "showlogentryJS">><<nobr>>
<<set _text to $log[$args[0]][$args[1]][$logpars.text]>>
<<set _e to $log[$args[0]][$args[1]]>>
<<script>>
<!-- var t = state.variables.log[]. -->
state.temporary.text
<</script>>
<</nobr>><</widget>>


<!--
Performance testing

times:
v1(showlogentry): 
1657, 1530, 1570, 1730, 1658, 1574, 1557, 1522, 1614, 1476, 1494, 1487, 1545, 1517, 1558, 1519, 1486, 1482, 1519, 1514, 1481, 1551, 1509, 1471, 1474, 1506, 1478, 1475, 1516, 1483, 1467, 1532, 
avg = 1529.75

v2(with presetlogentry):
1616, 1391, 1400, 1393, 1366, 1428, 1429, 1523, 1390, 1286, 1297, 1276, 1262, 1330, 1475, 
avg = 1390.80
	At least on subsequent runs the time is more than 100ms better, which is relevant for changing written status

v2 with links removed:
1392, 1450, 1500, 1359, 1291, 1270, 1288, 1260, 1285, 1267, 1312, 1214, 1225, 1262, 1264, 1214, 
avg = 1303.31

v2(again since I might have closed things between v2 and link removal):
1367, 1447, 1352, 1321, 1324, 1323, 1351, 1272, 1293, 1262, 1254, 1228, 1439, 1411, 1275, 1420, 1386, 1317, 1505, 1421, 1432, 1434, 1320, 1334, 1273,
avg = 1350.44
	So links do have an impact but it's small
	
v2 with links, autowrite and !!!s on traumatic entries removed:
1416, 1260, 1234, 1245, 1245, 1232, 1264, 1268, 1250, 1224, 1200, 1209, 1198, 1185, 1189, 1248, 1196, 1201, 1202,
avg = 1235.05

v2 with no hidden entries:
334, 334, 335, 335, 335, 336, 340, 346, 347, 358, 361, 373, 376, 381, 383, 391, 409, 450
avg = 362.44
	Wow.
	
v2 with hidden entries but no <<dontshowlogentry>>:
220, 221, 223, 227, 228, 228, 230, 232, 232, 240, 241, 245, 246, 248, 250, 252, 257, 258, 265, 265, 268, 277, 285, 317, 338
avg = 251.72
	Yeah, seems like the <<dontshowlogentry>> that I didn't even think about being there is super slow.
	I should check how v1 would be affected by the same thing but don't feel like doing that atm.

:

avg = 
-->
<<widget "presetlogentry">><<nobr>>
<!-- Figure out formatting for a log entry ahead of time -->


<<set _text to $log[$args[0]][$args[1]][$logpars.text]>>
<<set _e to $log[$args[0]][$args[1]]>>
<<set _entry to "">>
<<set _entry to Math.floor(_e[$logpars.time] / 60).toString().padStart(2, "0")+":"+(_e[$logpars.time] % 60).toString().padStart(2, "0")>>/* time as 21:00 , should add ampm setting */

<<switch $log[$args[0]][$args[1]][$logpars.importance]>>
	<<case 0>>
		<<set _entrycolour to "black">>
	<<case 1 >>
		<<set _entrycolour to "grey">>
	<<case 2 >>
		<<set _entrycolour to "blue">>
	<<case 3 >>/* combat and other events of similar importance */
		<<set _entrycolour to "lblue">>
	<<case 4 >>
		<<set _entrycolour to "teal">>
	<<case 5 >>
		<<set _entrycolour to "green">>
	<<case 6 >>
		<<set _entrycolour to "orange">>
	<<case 7 >>/* for date and end/start of day report that colours stuff on it's own */
		/* results in <span class=''> */
	<<case 8 >> /* virginity loss */
		<<set _entrycolour to "red">>
	<<case 9 >> /* not sure, transformations? */
		<<set _entrycolour to "gold">>
	<<default>>
<</switch>>

<<set _entry += " <span class='"+_entrycolour+"'>"+_text+"</span>">>


<<set _stats to $log[$args[0]][$args[1]][$logpars.stats]>>

<!--
TODO: clothing and npc relations
<<set _clothlist to ["upperclothes","lowerclothes","underclothes"]>>/*  */
<<set _clothlist to ["upper","lower","under"]>>
<<if _stats.underclothes isnot undefined>>/* assuming that <<log>> has defined all clothes if it did one */
	Wearing
	<<if _stats.upperclothes is "naked" and _stats.lowerclothes is "naked" and _stats.underclothes is "naked">>
		<span class='lewd'>''nothing''</span>.
	<<else>>
	<<set $listed to []>>
	<<for _i to 0;_i lt _clothlist.length;_i++>>
		<<if _stats[_clothlist[_i]+"clothes"] isnot "naked">>
			<<set _wearing to _stats[_clothlist[_i]+"clothes"]>>
		<<elseif _clothlist[_i] is "under">>
			<<set _wearing to "no underwear">>
		<</if>>
		<<if _wearing isnot undefined>>
			<<if _stats["old"+_clothlist[_i]+"clothes"] isnot undefined>>
				<<set _wearing to "''"+_wearing+"''">>/* indicate new clothes by bolding them(could colour them instead or something) */
			<</if>>
			/* colour based on integrity? */
			<<set _hp to _stats[_clothlist[_i]+"integrity"]/_stats[_clothlist[_i]+"integritymax"]>>
			<<if _stats[_clothlist[_i]+"clothes"] is "naked" and _clothlist[_i] is "under">>
				<<set _wearing to "<span class='lewd'>"+_wearing+"</span>">>
			<<else>>
				<<if _hp lte 0.2>>
					<<set _wearing to "<span class='blue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.5>>
					<<set _wearing to "<span class='lblue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.9>>
					<<set _wearing to "<span class='teal'>"+_wearing+"</span>">>
				<<else>>
					<<set _wearing to "<span class='green'>"+_wearing+"</span>">>
				<</if>>
			<</if>>
			<<set $listed.push(_wearing)>>
		<</if>>
		<<set _wearing to undefined>>
		<</for>>
		<<if $listed.length is 1>>
			<<set $listed[0] to "only "+$listed[0]>>/* if upper or skirt add a/an? jsArticle($listed[0]) */
		<</if>>
		<<listify $listed>>.
	<</if>>
<</if>>

-->

<<if _stats.drunk gt 0 and _stats.drunk isnot undefined>>
	<<set _entry += " <span class='purple'>Feeling</span>">>
	<<if _stats.drunk lte 120>>
		<<set _entry += "<span class='blue'> woozy</span>.">>
	<<elseif _stats.drunk lte 240>>
		<<set _entry += "<span class='purple'> tipsy</span>.">>
	<<elseif _stats.drunk lte 360>>
		<<set _entry += "<span class='purple'> drunk</span>.">>
	<<elseif _stats.drunk lte 480>>
		<<set _entry += "<span class='pink'> smashed</span>.">>
	<<else>>
		<<set _entry += "<span class='pink'> wasted</span>.">>
	<</if>>
<</if>>

<<if _stats.druggedgain isnot undefined>>
	<<if _stats.druggedgain lt 0>><<set _entry += " <span class='blue'>-lewd warmth </span>">><</if>>
	<<if _stats.druggedgain gt 0>><<set _entry += " <span class='pink'>+lewd warmth </span>">><</if>>
<</if>>

<<if _stats.sciencegain isnot undefined>>
	<<if _stats.sciencegain gt 0>>
		<<set _entry += " <span class='green'>+Science</span>">>
	<</if>>
<</if>>
<<if _stats.mathsgain isnot undefined>><<if _stats.mathsgain gt 0>><<set _entry += " <span class='green'>+Maths</span>">><</if>><</if>>
<<if _stats.englishgain isnot undefined>><<if _stats.englishgain gt 0>><<set _entry += " <span class='green'>+English</span>">><</if>><</if>>
<<if _stats.historygain isnot undefined>><<if _stats.historygain gt 0>><<set _entry += " <span class='green'>+History</span>">><</if>><</if>>

<<if _stats.coolgain isnot undefined>>
	<<if _stats.coolgain lt 0>><<set _entry += " <span class='red'>-Status </span>">><</if>>
	<<if _stats.coolgain gt 0>><<set _entry += " <span class='green'>+Status </span>">><</if>>
<</if>>

<<if _stats.detentiongain isnot undefined>>
	<<if _stats.detentiongain gt 0>><<set _entry += " <span class='red'>+Detention </span>">><</if>>
	<<if _stats.detentiongain lt 0>><<set _entry += " <span class='lblue'>-Detention </span>">><</if>>
<</if>>

<<if _stats.spraygain isnot undefined>>
	<<if _stats.spraygain lt 0>><<set _entry += " <span class='red'>-pepper spray</span>">><</if>>
	<<if _stats.spraygain gt 0>><<set _entry += " <span class='green'>+pepper spray</span>">><</if>>
<</if>>
<<if _stats.moneygain isnot undefined>>
	<<if _stats.moneygain lt 0>>
		<<set _entry += " <span class='red'>-£" + Math.abs(Math.trunc(_stats.moneygain / 100)) + "." + ((_stats.moneygain % 100).toString().padStart(2, '0')) + "</span>">>
	<</if>>
	<<if _stats.moneygain gt 0>>
		<<set _entry += " <span class='gold'>£" + Math.trunc(_stats.moneygain / 100) + "." + ((_stats.moneygain % 100).toString().padStart(2, '0')) + "</span>">>
	<</if>>
<</if>>
<<if _stats.antiquemoneygain gt 0>><<set _entry += " <span class='brown'> £"+_stats.antiquemoneygain+"</span>">><</if>>
<<if _stats.blackmoneygain gt 0>><<set _entry += " <span class='black'> £"+_stats.blackmoneygain+"</span>">><</if>>


<<if $logshowcomments is 1>>
	<<set _entry to _entry+" <span class='meek'>"+_e[$logpars.comment]+"</span>">>
<</if>>
<<if $logshowopinions is 1>>
	<<set _entry to _entry+" <span class='meek'>"+_e[$logpars.opinion]+"</span>">>
<</if>>

<<if $presetlogdisplaystrings is undefined>>
	<<set $presetlogdisplaystrings to []>>
<</if>>
<<if $presetlogdisplaystrings[$args[0]] is undefined>>
	<<run $presetlogdisplaystrings.push()>>
<</if>>
<<if $presetlogdisplaystrings[$args[0]][$args[1]] is undefined>>
	<<run $presetlogdisplaystrings[$args[0]].push(_entry)>>
<<else>>
	<<set $presetlogdisplaystrings[$args[0]][$args[1]] to _entry>>
<</if>>

<</nobr>><</widget>>


<<widget "showlogentry">><<nobr>>
<<set _text to $log[$args[0]][$args[1]][$logpars.text]>>
<<set _e to $log[$args[0]][$args[1]]>>
<<switch $log[$args[0]][$args[1]][$logpars.importance]>>
	<<case 0>>/* after this stuff is same as above though it used to be more different, should make a widget or something  */
		<span class="black">_text </span>
	<<case 1 >>
		<span class="grey">_text </span>
	<<case 2 >>
		<span class="blue">_text </span>
	<<case 3 >>/* combat and other events of similar importance */
		<span class="lblue">_text </span>
	<<case 4 >>
		<span class="teal">_text </span>
	<<case 5 >>
		<span class="green">_text </span>
	<<case 6 >>
		<span class="orange">_text </span>
	<<case 7 >>/* for date and end/start of day report that colours stuff on it's own */
		_text
	<<case 8 >> /* virginity loss */
		<span class="red">_text </span>
	<<case 9 >> /* not sure, transformations? */
		<span class="gold">_text </span>
	<<default>>
		_text
<</switch>>
/*
todo: make a thing for (at least temporarily) saving the rest of this it might make opening diary faster(and I suspect logdebug stuff of causing too much recursion errors when this used in some situations).
*/

/* clothing change report */
/*
"Changed x to y" would be weird for situations where clothes break and such
"Now wearing x" might be best since it doesn't really mention how or why the clothing situation changed
	actually is the "now" really necessary?
this probably won't handle sets very well
<<print JSON.stringify($log[0][$args[1]])>>
*/
<<set _e to $log[$args[0]][$args[1]][$logpars.stats]>>
<<set _clothlist to ["upperclothes","lowerclothes","underclothes"]>>/*  */
<<set _clothlist to ["upper","lower","under"]>>
<<if _e.underclothes isnot undefined>>/* assuming that <<log>> has defined all clothes if it did one */
	Wearing
	<<if _e.upperclothes is "naked" and _e.lowerclothes is "naked" and _e.underclothes is "naked">>
		<span class='lewd'>''nothing''</span>.
	<<else>>
	<<set $listed to []>>
	<<for _i to 0;_i lt _clothlist.length;_i++>>
		<<if _e[_clothlist[_i]+"clothes"] isnot "naked">>
			<<set _wearing to _e[_clothlist[_i]+"clothes"]>>
		<<elseif _clothlist[_i] is "under">>
			<<set _wearing to "no underwear">>
		<</if>>
		<<if _wearing isnot undefined>>
			<<if _e["old"+_clothlist[_i]+"clothes"] isnot undefined>>
				<<set _wearing to "''"+_wearing+"''">>/* indicate new clothes by bolding them(could colour them instead or something) */
			<</if>>
			/* colour based on integrity? */
			<<set _hp to _e[_clothlist[_i]+"integrity"]/_e[_clothlist[_i]+"integritymax"]>>
			<<if _e[_clothlist[_i]+"clothes"] is "naked" and _clothlist[_i] is "under">>
				<<set _wearing to "<span class='lewd'>"+_wearing+"</span>">>
			<<else>>
				<<if _hp lte 0.2>>
					<<set _wearing to "<span class='blue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.5>>
					<<set _wearing to "<span class='lblue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.9>>
					<<set _wearing to "<span class='teal'>"+_wearing+"</span>">>
				<<else>>
					<<set _wearing to "<span class='green'>"+_wearing+"</span>">>
				<</if>>
			<</if>>
			<<set $listed.push(_wearing)>>
		<</if>>
		<<set _wearing to undefined>>
		<</for>>
		<<if $listed.length is 1>>
			<<set $listed[0] to "only "+$listed[0]>>/* if upper or skirt add a/an? jsArticle($listed[0]) */
		<</if>>
		<<listify $listed>>.
	<</if>>
<</if>>

<<if _e.drunk gt 0 and _e.drunk isnot undefined>><span class="purple">Feeling</span>
	<<if _e.drunk lte 120>>
		<span class="blue"> woozy</span>.
	<<elseif _e.drunk lte 240>>
		<span class="purple"> tipsy</span>.
	<<elseif _e.drunk lte 360>>
		<span class="purple"> drunk</span>.
	<<elseif _e.drunk lte 480>>
		<span class="pink"> smashed</span>.
	<<else>>
		<span class="pink"> wasted</span>.
	<</if>>
<</if>>

<<if _e.druggedgain isnot undefined>>
	<<if _e.druggedgain lt 0>><span class="blue">-lewd warmth </span><</if>>
	<<if _e.druggedgain gt 0>><span class="pink">+lewd warmth </span><</if>>
<</if>>

<<if _e.sciencegain isnot undefined>><<if _e.sciencegain gt 0>><span class="green">+Science </span><</if>><</if>>
<<if _e.mathsgain isnot undefined>><<if _e.mathsgain gt 0>><span class="green">+Maths </span><</if>><</if>>
<<if _e.englishgain isnot undefined>><<if _e.englishgain gt 0>><span class="green">+English </span><</if>><</if>>
<<if _e.historygain isnot undefined>><<if _e.historygain gt 0>><span class="green">+History </span><</if>><</if>>

<<if _e.coolgain isnot undefined>>
	<<if _e.coolgain lt 0>><span class="red">-Status </span><</if>>
	<<if _e.coolgain gt 0>><span class="green">+Status </span><</if>>
<</if>>

<<if _e.detentiongain isnot undefined>>
	<<if _e.detentiongain gt 0>><span class="red">+Detention </span><</if>>
	<<if _e.detentiongain lt 0>><span class="lblue">-Detention </span><</if>>
<</if>>

<<if _e.spraygain isnot undefined>>
	<<if _e.spraygain lt 0>><span class="red">-pepper spray </span><</if>>
	<<if _e.spraygain gt 0>><span class="green">+pepper spray </span><</if>>
<</if>>
<<if _e.moneygain isnot undefined>>
	<<if _e.moneygain lt 0>><span class="red">-£<<print Math.abs(Math.trunc(_e.moneygain / 100))>>.<<if _e.moneygain % 100 lte 9>>0<</if>><<print _e.moneygain % 100>></span><</if>>
	<<if _e.moneygain gt 0>><span class="gold">£<<print Math.trunc(_e.moneygain / 100)>>.<<if _e.moneygain % 100 lte 9>>0<</if>><<print _e.moneygain % 100>></span><</if>>
<</if>>
<<if _e.antiquemoneygain gt 0>><span class="brown"> £<<print _e.antiquemoneygain>></span><</if>>
<<if _e.blackmoneygain gt 0>><span class="black"> £<<print _e.blackmoneygain>></span><</if>>

<<if $logshowcomments is 1>><span class="meek"><<print $log[$args[0]][$args[1]][$logpars.comment]>></span><</if>>
<<if $logshowopinions is 1>><span class="meek"><<print $log[$args[0]][$args[1]][$logpars.opinion]>></span><</if>>

<<if $logdebug isnot 0>><span class="greyred">/* Do I need the undefined checks? */
	<<for _i to 0; _i lt $statlist.length; _i++>>
		<<if _e[$statlist[_i]] isnot undefined>>
			<<if typeof(_e[$statlist[_i]]) is "number">>/* "statname:+statgain=statvalue" */
				<<if _e[$statlist[_i]+"gain"] isnot undefined and Number.isNaN(parseFloat(_e[$statlist[_i]+"gain"])) is false>>/* needed to prevent errors from clothing integrity and anything else that might get forced to give value without it changing */
					<<print "|"+$statlist[_i]+":">>
					<<if _e[$statlist[_i]+"gain"] gte 0>>+<<else>>-<</if>>
					<<print Math.abs(parseFloat(_e[$statlist[_i]+"gain"].toFixed(2)))+" = ''"+parseFloat(_e[$statlist[_i]].toFixed(2))+"''">>/* tofixed(2) returns a string with 2 decimal places while parseFloat returns a number with decimals but more importantly in this case it changes 1.00 to 1 while keeping 1.01 as is. Point being that some stats would otherwise get super long floats.  */
				<<else>>
					<<print "|"+$statlist[_i]+": = ''"+parseFloat(_e[$statlist[_i]].toFixed(2))+"''">>/*Without gain being defined we just report that the value still is whatever it was */
				<</if>>
			<<elseif typeof(_e[$statlist[_i]]) is "string">>/* "statname:oldstring->newstring" */
				<<print "|"+$statlist[_i]+":"+_e["old"+$statlist[_i]]+" -> ''"+_e[$statlist[_i]]+"''">>/* this should be fine with oldstat being undefined(in case we stop defining it) */
			<<elseif typeof(_e[$statlist[_i]]) is "boolean">>
				<<print "|"+$statlist[_i]+":''"+_e[$statlist[_i]]+"''">>
			<</if>>
		<</if>>
	<</for>>
	/*
	*/
	</span>
<</if>>


<</nobr>><</widget>>

<<widget "filteredentriesinfo">><<nobr>>/* Say if entries got filtered */
/*
$diaryinsertfilterinfo=?
0=Only filtered entry count total at the bottom
1=On same line without a stat change summary
2=On same line with a stat change summary
3=On a new line with a stat change summary
4=On a new line without a stat change summary
*/
<<if _hiddenentries gte 1>>
	<<if $diaryinsertfilterinfo gte 1>>/* Do we want filtered entry messages mid diary? */
		<<if $diaryinsertfilterinfo gte 3>>/* Should they be on new lines */
			<br>
		<</if>>
		<span class="black">(_hiddenentries <<if _hiddenentries is 1>>entry<<else>>entries<</if>> filtered out)
		<<if $diaryinsertfilterinfo is 2 or $diaryinsertfilterinfo is 3>>/* Should they include a summary of noteworthy stat changes */
			<<filteredstatchanges>>
		<</if>>
		</span> 
		<<set _hiddenentries to 0>>
		<<set $diaryfiltersum to {}>>
	<</if>>
<</if>>
<</nobr>><</widget>>

<<widget "dontshowlogentry">><<nobr>>/* but add the stat changes so that a summary of all stat changes from not shown(filtered) entries can be displayed */
/* doing this being made much later than previous stuff was a good chance to add comments for "obvious" stuff I probably wouldn't have bothered with when I still had all of this in my head. */
<<set _e to $log[$args[0]][$args[1]][$logpars.stats]>>/* e for diary entry. Args are day and line*/
<<for _i to 0; _i lt $statlist.length; _i++>>/*go through each stat*/
	<<if _e[$statlist[_i]] isnot undefined>>/*only things that changed are defined*/
		<<if typeof(_e[$statlist[_i]]) is "number">>/* "statname:+statgain=statvalue" */
			<<if _e[$statlist[_i]+"gain"] isnot undefined and Number.isNaN(parseFloat(_e[$statlist[_i]+"gain"])) is false>>/* Check that the stat actually changed and is a number and wasn't defined for some other reason. statnamegain is the change while $log[day][line][6].statname is just the value after the change has happened. */
				<<if $diaryfiltersum[$statlist[_i]+"gainsum"] is undefined>>/* $diaryfiltersum should be a blank object at the start of filtering. Also using different property names(not just statname and statnamegain) to make it clear these are a different thing */
					<<set $diaryfiltersum[$statlist[_i]+"gainsum"] to 0>>
					<<set $diaryfiltersum[$statlist[_i]+"original"] to _e[$statlist[_i]]-_e[$statlist[_i]+"gain"]>>/* subtracting the change gives us the value the stat was in the last entry before filtering started */
				<</if>>
				<<set $diaryfiltersum[$statlist[_i]+"gainsum"] to $diaryfiltersum[$statlist[_i]+"gainsum"]+_e[$statlist[_i]+"gain"]>>/* add up the change to last one(if there is one) */
			<<else>>
				<<set $diaryfiltersum[$statlist[_i]] to _e[$statlist[_i]]>>
			<</if>>
		<<elseif typeof(_e[$statlist[_i]]) is "string">>/* "statname:oldstring->newstring" */
			<<if $diaryfiltersum[$statlist[_i]] is undefined>>
				<<set $diaryfiltersum[$statlist[_i]+"original"] to _e["old"+$statlist[_i]]>>
			<</if>>
			<<set $diaryfiltersum[$statlist[_i]] to _e[$statlist[_i]]>>
		<<elseif typeof(_e[$statlist[_i]]) is "boolean">>
			<<set $diaryfiltersum[$statlist[_i]] to _e[$statlist[_i]]>>
		<</if>>
	<</if>>
<</for>>
/* Now $diaryfiltersum should have a sum of changes to each stat(ie. $$diaryfiltersum.sciencegainsum) since the last time it was cleared */
<</nobr>><</widget>>


<<widget "filteredstatchanges">><<nobr>> /* Show stat changes of multiple hidden entries. Copy paste from showlogentry but might want to adjust things a bit*/
/*<<print JSON.stringify($diaryfiltersum)>>*/
<<set _clothlist to ["upperclothes","lowerclothes","underclothes"]>>/*  */
<<set _clothlist to ["upper","lower","under"]>>
<<if $diaryfiltersum.underclothes isnot undefined>>/* assuming that <<log>> has defined all clothes if it did one */
	Wearing
	<<if $diaryfiltersum.upperclothes is "naked" and $diaryfiltersum.lowerclothes is "naked" and $diaryfiltersum.underclothes is "naked">>
		<span class='lewd'>''nothing''</span>.
	<<else>>
	<<set $listed to []>>
	<<for _i to 0;_i lt _clothlist.length;_i++>>
		<<if $diaryfiltersum[_clothlist[_i]+"clothes"] isnot "naked">>
			<<set _wearing to $diaryfiltersum[_clothlist[_i]+"clothes"]>>
		<<elseif _clothlist[_i] is "under">>
			<<set _wearing to "no underwear">>
		<</if>>
		<<if _wearing isnot undefined>>
			<<if $diaryfiltersum[_clothlist[_i]+"clothesoriginal"] isnot undefined>>
				<<set _wearing to "''"+_wearing+"''">>/* indicate new clothes by bolding them(could colour them instead or something) */
			<</if>>
			/* colour based on integrity? */
			<<set _hp to $diaryfiltersum[_clothlist[_i]+"integrity"]/$diaryfiltersum[_clothlist[_i]+"integritymax"]>>
			<<if $diaryfiltersum[_clothlist[_i]+"clothes"] is "naked" and _clothlist[_i] is "under">>
				<<set _wearing to "<span class='lewd'>"+_wearing+"</span>">>
			<<else>>
				<<if _hp lte 0.2>>
					<<set _wearing to "<span class='blue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.5>>
					<<set _wearing to "<span class='lblue'>"+_wearing+"</span>">>
				<<elseif _hp lte 0.9>>
					<<set _wearing to "<span class='teal'>"+_wearing+"</span>">>
				<<else>>
					<<set _wearing to "<span class='green'>"+_wearing+"</span>">>
				<</if>>
			<</if>>
			<<set $listed.push(_wearing)>>
		<</if>>
		<<set _wearing to undefined>>
		<</for>>
		<<if $listed.length is 1>>
			<<set $listed[0] to "only "+$listed[0]>>/* if upper or skirt add a/an? jsArticle($listed[0]) */
		<</if>>
		<<listify $listed>>.
	<</if>>
<</if>>

<<if $diaryfiltersum.drunk gt 0 and $diaryfiltersum.drunk isnot undefined>><span class="purple">Felt</span>
	<<if $diaryfiltersum.drunk lte 120>>
		<span class="blue"> woozy</span>.
	<<elseif $diaryfiltersum.drunk lte 240>>
		<span class="purple"> tipsy</span>.
	<<elseif $diaryfiltersum.drunk lte 360>>
		<span class="purple"> drunk</span>.
	<<elseif $diaryfiltersum.drunk lte 480>>
		<span class="pink"> smashed</span>.
	<<else>>
		<span class="pink"> wasted</span>.
	<</if>>
<</if>>

<<if $diaryfiltersum.druggedgainsum isnot undefined>>
	<<if $diaryfiltersum.druggedgainsum lt 0>><span class="blue">-lewd warmth </span><</if>>
	<<if $diaryfiltersum.druggedgainsum gt 0>><span class="pink">+lewd warmth </span><</if>>
<</if>>

<<if $diaryfiltersum.sciencegainsum isnot undefined>><<if $diaryfiltersum.sciencegainsum gt 0>><span class="green">+Science </span><</if>><</if>>
<<if $diaryfiltersum.mathsgainsum isnot undefined>><<if $diaryfiltersum.mathsgainsum gt 0>><span class="green">+Maths </span><</if>><</if>>
<<if $diaryfiltersum.englishgainsum isnot undefined>><<if $diaryfiltersum.englishgainsum gt 0>><span class="green">+English </span><</if>><</if>>
<<if $diaryfiltersum.historygainsum isnot undefined>><<if $diaryfiltersum.historygainsum gt 0>><span class="green">+History </span><</if>><</if>>

<<if $diaryfiltersum.coolgainsum isnot undefined>>
	<<if $diaryfiltersum.coolgainsum lt 0>><span class="red">-Status </span><</if>>
	<<if $diaryfiltersum.coolgainsum gt 0>><span class="green">+Status </span><</if>>
<</if>>

<<if $diaryfiltersum.detentiongainsum isnot undefined>>
	<<if $diaryfiltersum.detentiongainsum gt 0>><span class="red">+Detention </span><</if>>
	<<if $diaryfiltersum.detentiongainsum lt 0>><span class="lblue">-Detention </span><</if>>
<</if>>

<<if $diaryfiltersum.spraygainsum isnot undefined>>
	<<if $diaryfiltersum.spraygainsum lt 0>><span class="red">-pepper spray </span><</if>>
	<<if $diaryfiltersum.spraygainsum gt 0>><span class="green">+pepper spray </span><</if>>
<</if>>
<<if $diaryfiltersum.moneygainsum isnot undefined>>
	<<if $diaryfiltersum.moneygainsum lt 0>><span class="red">-£<<print Math.abs(Math.trunc($diaryfiltersum.moneygainsum / 100))>>.<<if $diaryfiltersum.moneygainsum % 100 lte 9>>0<</if>><<print $diaryfiltersum.moneygainsum % 100>></span><</if>>
	<<if $diaryfiltersum.moneygainsum gt 0>><span class="gold">£<<print Math.trunc($diaryfiltersum.moneygainsum / 100)>>.<<if $diaryfiltersum.moneygainsum % 100 lte 9>>0<</if>><<print $diaryfiltersum.moneygainsum % 100>></span><</if>>
<</if>>
<<if $diaryfiltersum.antiquemoneygainsum gt 0>><span class="brown"> £<<print $diaryfiltersum.antiquemoneygainsum>></span><</if>>
<<if $diaryfiltersum.blackmoneygainsum gt 0>><span class="black"> £<<print $diaryfiltersum.blackmoneygainsum>></span><</if>>

<<if $logdebug isnot 0>><span class="darkblack">/* Do I need the undefined checks? */
	<<for _dstat to 0; _dstat lt $statlist.length; _dstat++>>
		<<if $diaryfiltersum[$statlist[_dstat]+"gainsum"] isnot undefined>>
			/*<<print $statlist[_dstat]+":"+Math.abs(parseFloat($diaryfiltersum[$statlist[_dstat]+"original"].toFixed(2)))+" -> ">>*/
			<<print $statlist[_dstat]+":">><<if $diaryfiltersum[$statlist[_dstat]+"gainsum"] gte 0>>+<<else>>-<</if>><<print "''"+parseFloat($diaryfiltersum[$statlist[_dstat]+"gainsum"].toFixed(2))+"''">>
		<<elseif typeof($diaryfiltersum[$statlist[_dstat]]) is "string">>/* "statname:oldstring->newstring" */
			<<print $statlist[_dstat]+":"+$diaryfiltersum[$statlist[_dstat]+"original"]+" -> ''"+$diaryfiltersum[$statlist[_dstat]]+"''">>/* this should be fine with oldstat being undefined(in case we stop defining it) */
		<<elseif typeof($diaryfiltersum[$statlist[_dstat]]) is "boolean">>
			<<print $statlist[_dstat]+":''"+$diaryfiltersum[$statlist[_dstat]]+"''">>
		<</if>>
	<</for>>
	/*
	*/
	</span>
<</if>>
<</nobr>><</widget>>


<<widget "cleandiary">><<nobr>>
<<if $args[0] is "debugonlystats">><!-- Remove everything that shows up only with logdebug from entries older than $args[1] days. -->
<!-- Need to make a list of stats that are like that, actually what if it was a customizable list so player could decide what if any stats are shown? -->
<<if $args[0] is "nonmomeystats">><!-- Remove all stat info except for money from entries older than $args[1] days. -->
<<if $args[0] is "allstats">><!-- Remove all stat info from entries older than $args[1] days. -->
/*
*/
<!-- Check for most duplicated entry texts and change them to use some var? -->
<<set $logdupes[0] to "">>

<</nobr>><</widget>>


<<widget "logcount">><<nobr>>
<!-- Count amount of trauma and other stats gained from all uwritten entries -->
<!-- removed making of $traumaticevents from this to make it only happen after all of the .written have been set -->
<<if $log is undefined>>
	<<run console.log("ERROR.")>>
<</if>>
<<set _unresolved to {}>>
<<set _unresolved.traumagain to 0>>
<<set _unresolved.traumaloss to 0>>
<<set _unresolved.stessgain to 0>>
<<set _unresolved.stressloss to 0>>
	
<<for _i, _day range $log>>
  <<for _j, _entry range $log[_i]>>
    <<if _entry[$logpars.written] lt 2>>
		<<if _entry[$logpars.stats].traumagain gt 0>>
			<<set _unresolved.traumagain += _entry[$logpars.stats].traumagain>>
		<<elseif _entry[$logpars.stats].traumagain lt 0>>
			<<set _unresolved.traumaloss += _entry[$logpars.stats].traumagain>>/* could abs() this or something to make it positive*/
		<</if>>
	<</if>>
  <</for>>
<</for>>
<br>
You've gained _unresolved.traumagain trauma.
<br>
You've reduced your trauma by <<print Math.abs(_unresolved.traumaloss)>>.
<br>

<</nobr>><</widget>>

<<widget "settraumaticevents">><<nobr>>
<!-- Make traumatic events easy to find making an array with just (log)day, line and writestatus of trauma increasing events -->
<<set $traumaticevents to []>>
<<for _i, _day range $log>>
  <<for _j, _entry range $log[_i]>>
    <<if _entry[$logpars.written] lt 2>>
		<<if _entry[$logpars.stats].traumagain gt 0>>
			<<run $traumaticevents.push({ d: _i , l: _j , w: _entry[$logpars.written] })>>
			<<run console.log("entry("+_i+","+_j+") was traumatic.")>>
		<</if>>
	<</if>>
  <</for>>
<</for>>
<</nobr>><</widget>>

<<widget "showdiaryentry">><<nobr>>
showdiaryentry does nothing atm.
<</nobr>><</widget>>



