:: Widgets Clothing Caption [widget]
<<widget "clothingcaption">><<nobr>>

<<if $compactsidebar gte 2>>
	<<set _clothlist to [$worn.upper.integrity+"|"+$worn.upper.integrity_max+"|"+$worn.upper.name, $worn.lower.integrity+"|"+$worn.lower.integrity_max+"|"+$worn.lower.name, $worn.under_upper.integrity+"|"+$worn.under_upper.integrity_max+"|"+$worn.under_upper.name, $worn.under_lower.integrity+"|"+$worn.under_lower.integrity_max+"|"+$worn.under_lower.name]>>
	<<if _clothlist.count("0|0|naked") gte 4>>
		<span class="red">Naked!</span>
	<<else>>
		<<if $worn.lower.name is "naked" and $worn.under_lower.name is "naked">>
			<span class="red">Bottomless!</span>
		<<elseif $worn.upper.name is "naked" and $worn.under_upper.name is "naked">>
			<span class="pink">Topless!</span>
		<<elseif $worn.lower.name is "naked" and $worn.upper.name is "naked" and _clothlist.count("0|0|naked") gte 2>>
			<span class="pink">Only underclothes!</span>
		<<elseif $worn.lower.name is "naked">>
			<span class="pink">Exposed underwear!</span>
		<<elseif $worn.upper.name is "naked">>
			<span class="pink">Exposed bra!</span>
		<<elseif $worn.under_lower.name is "naked">>
			<span class="pink">No underwear!</span>
		<</if>>
		<<run _clothlist.delete("0|0|naked")>>
		Wearing:<<clothlistify _clothlist>>
	<</if>>
<<else>>
	<<if $worn.upper.name is "naked">>
		<<if $worn.lower.name is "naked">>
			<<if $worn.under_lower.name is "naked">>
				<<if $worn.under_upper.name is "naked">>
				<span class="red">You are completely naked!</span>
				<<else>>
				<span class="red">Your bottom half is completely exposed!</span> <span class="pink">Your <<underupperintegrity>>
				<<if $compactsidebar lt 1>><<underupperclothescolour>> <</if>>
				$worn.under_upper.name <<if $worn.under_upper.plural is 1>>give<<else>>gives<</if>> little comfort.</span>
				<</if>>
			<</if>>
			<<if $worn.under_lower.name isnot "naked">>
				<<if $worn.under_upper.name is "naked">>
				<span class="pink">You are wearing nothing but a <<if !$worn.under_lower.type.includes("chastity")>>pair of <</if>><<underlowerintegrity>>
				<<if $compactsidebar lt 1>><<underlowerclothescolour>> <</if>>
				$worn.under_lower.name.</span>
				<<else>>
					<<if $worn.under_lower.set is $worn.under_upper.set>>
					<span class="pink">You are wearing nothing but <<underupperword>> <<underupperintegrity>> 
					<<if $compactsidebar lt 1>><<underupperclothescolour>> <</if>>
					$worn.under_upper.name.</span>
					<<else>>
					<span class="pink">You are wearing a <<if !$worn.under_lower.type.includes("chastity")>>pair of <</if>><<underlowerintegrity>> 
					<<if $compactsidebar lt 1>><<underlowerclothescolour>> <</if>>
