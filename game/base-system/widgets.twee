		<<elseif $location is "temple">>
		<img id="location" src="img/misc/templedusk.png">
		<</if>>
	<</if>>

<<else>>

<<if $daystate is "day">>
	<<if $weather is "clear">>
		It's a bright and sunny day.
		<br>
	<<elseif $weather is "rain">>
		It's a rainy day.
		<br>
	<<elseif $weather is "overcast">>
