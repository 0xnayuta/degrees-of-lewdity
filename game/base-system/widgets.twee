<<widget "combat_partner">><<nobr>>/* somehow set to "I" when masturbating? */
<<set $combat_partner = "">>/* hopefulyy this will fix the "An an a slight boy", it does but instead causes just "A"s to appear */
/* $args[0] is the id/slot of the relevant npc */
/* not sure if anything aside from beasts that no longer set $beasttype need it. Hopefully adding the arg to everywhere where it needs to be is worth it(all uses of <<-stat>> widgets). */
/* Considered if someting like $combat_partner with $NPCList[$args[0]].description + $NPCList[$args[0]].type could replace this widget but this is still needed to at least get a man/woman/boy/girl out of "m" or "f" and for handling how beast, swarm and tentacle descriptions differ from human ones */
/* $pronoun gets set to "n" in some situations  */

/*<<if $args[0] isnot 0 and $args[0] isnot 1 and $args[0] isnot 2 and $args[0] isnot 3 and $args[0] isnot 4 and $args[0] isnot 5>><</if>>*/
<<if $args[0] is undefined>>
	<<set $args[0] to 0>>
	/* made everything set this manually just so I can easily search for "stat>>" to see ones where I haven't looked into if they need it or not. */
<</if>>
<!-- Make sure that we actually have someone we could call a partner -->
<<if typeof($args[0]) is "number" and ($NPCList[$args[0]].description isnot 0 or $swallowed is 1 or $enemytype is "tentacles" or $enemytype is "beast" or $swarm.type isnot 0)>>
	<<if $enemytype is "beast">> 
		<<set $combat_partner = $NPCList[$args[0]].description+" "+$NPCList[$args[0]].type>>
	<<elseif $enemytype is "tentacles">>?
		<<set _id to Math.abs($args[0].replace("tentacle", ""))>>
		<<set $combat_partner to $tentacles[_id].desc+" tentacle">>
	<<elseif $swallowed is 1>>
		<<set $combat_partner to $vorecreature>>
		
	<<elseif $swarm.type isnot 0>>/* is a swarm */
		<<set $combat_partner to $swarm.type>>
	<<elseif $npc isnot 0>>/* is a named npc */
		<<set $combat_partner = $npcdescription + " " + $npc>>
	<<elseif $npcadult is 1>>/* is a named npc */
		<<if $NPCList[$args[0]].gender is "m">><<set $combat_partner = $NPCList[$args[0]].description + " man">>
		<<elseif $NPCList[$args[0]].gender is "f">><<set $combat_partner = $NPCList[$args[0]].description + " woman">>
		<<elseif $NPCList[$args[0]].gender is "i">><<set $combat_partner = $NPCList[$args[0]].description + " thing">>
		<<elseif $NPCList[$args[0]].gender is "t">><<set $combat_partner = $NPCList[$args[0]].description + " person">>/* just people? or somehow figure out all of the people this is about? */
		<<elseif $NPCList[$args[0]].gender is "n">><<set $combat_partner = $NPCList[$args[0]].description + " one">>
		<<else>><<set $combat_partner = $description + " person("+$pronoun+","+$NPCList[$args[0]].gender+")">>
		<</if>>
	<<else>>
		<<if $NPCList[$args[0]].gender is "m">><<set $combat_partner = $NPCList[$args[0]].description + " boy">>
		<<elseif $NPCList[$args[0]].gender is "f">><<set $combat_partner = $NPCList[$args[0]].description + " girl">>
		<<elseif $NPCList[$args[0]].gender is "i">><<set $combat_partner = $NPCList[$args[0]].description + " thing">>
		<<elseif $NPCList[$args[0]].gender is "t">><<set $combat_partner = $NPCList[$args[0]].description + " kid">>
		<<elseif $NPCList[$args[0]].gender is "n">><<set $combat_partner = $NPCList[$args[0]].description + " one">>
		<<else>><<set $combat_partner = $description + " kid("+$pronoun+","+$NPCList[$args[0]].gender+")">>/* this should appear if all else fails, hopefully preventing no description at all */
		<</if>>
	<</if>>
<<else>>
	<!-- Some lines probably sound weird with this(should either make them replace "myself" with "I" or be adjusted to work with "myself") -->
	<<set $combat_partner to "myself">>
	<<set $combat_partner to "No one?(this is either a solo action or a bug)">>
	<!-- allow "manually" setting the partner by giving a string instead of number ie. "snapper" -->
	<!-- Don't remember if there was any situation where a non number was used before adding this. I think I defaulted to using 0 whenever -->
	<<if typeof($args[0]) is "string">>
		<<set $combat_partner to $args[0]>>
	<</if>>
<</if>>

<<if $swarm.type isnot 0>>/* no a/an for swarms since they have plural names */
	<<set $combat_partner to jsArticle($combat_partner)>>
<</if>>
<<set $Combat_partner to jsCapitalize($combat_partner)>>
/*
<<set $logextra "I lost my "+$args[0]+"virginity to "+jsArticle($combat_partner)+$combat_partner+".">>
<<set $logextra "I lost my "+$args[0]+"virginity to "+$combat_partner+".">>
*/
<<run console.log("Identified combat partner" + $args[0] + " as " + $combat_partner)>>
<</nobr>><</widget>>


<<widget "remembersettings">><<nobr>>/* save setting in a way that persists even after restarting the game. */
<<remember $debug>>
<<remember $tipdisable>>
<<remember $cheatdisable>>
<<remember $sidebar>>

/* diary settings */
<<remember $logdebug>>
<<remember $diarymode>>
<<remember $loglocations>>
<<remember $diaryprompts>>
<<remember $diaryfilterA>>
<<remember $diaryfilterB>>
<<remember $logshowcomments>>
<<remember $logshowopinions>>
<<remember $logchangetreshold>>
<<remember $diaryshowunwritten>>
<<remember $busimportance>>
<<remember $workimportance>>
<<remember $passoutimportance>>
<<remember $exposureimportance>>
<<remember $logextraimportance>>
<<remember $locationimportance>>
/* sliders */
<<remember $malechance>>
<<remember $beastmalechance>>
<<remember $monsterchance>>
<<remember $dgchance>>
<<remember $cbchance>>
<<remember $straponchance>>
<<remember $whitechance>>
<<remember $blackchance>>
<<remember $alluremod>>
<<remember $homochance>>
<<remember $malevictimchance>>
/*content toggles*/
<<remember $monsterhallucinations>>
<<remember $bestialitydisable>>
<<remember $swarmdisable>>
<<remember $spiderdisable>>
<<remember $parasitedisable>>
<<remember $slimedisable>>
<<remember $voredisable>>
<<remember $tentacledisable>>
<<remember $analdisable>>
<<remember $transformdisable>>
<<remember $hirsutedisable>>
<<remember $breastfeedingdisable>>
<<remember $bodywritingdisable>>
/* not sure if these are really necessary */
<<remember $debugdisable>>
<<remember $breastsizemax>>
<<remember $gamemode>>
<<remember $numberify_enabled>>
<<remember $silhouettedisable>>
<<remember $dev>>
<<remember $images>>
<<remember $timestyle>>
<<remember $zoom>>
<<remember $checkstyle>>

<</nobr>>
<</widget>>

<<widget "forgetsettings">><<nobr>>/* not sure where would be a good place to actually use this if at all */
<<remember $facreset to true>>
<<run UI.restart()>>/* will ask to restart, Engine.restart() won't ask, anyway probably not a good idea to not do a restart after undefining all of these */

/*
<<forget $debug, $tipdisable, $cheatdisable, $sidebar, $malechance, $beastmalechance, $dgchance, $cbchance, $whitechance, $blackchance, $alluremod>>
<<forget $logdebug, $sidebar.log, $diarymode, $loglocations, $diaryprompts, $diaryfilterA, $diaryfilterB, $logshowcomments, $logshowopinions, $logchangetreshold, $diaryshowunwritten>>
<<forget $busimportance, $workimportance, $passoutimportance, $exposureimportance, $logextraimportance>>
<<forget $bestialitydisable, $swarmdisable, $parasitedisable, $slimedisable, $voredisable, $tentacledisable, $analdisable, $transformdisable, $hirsutedisable, $breastfeedingdisable>>
<<forget $breastsizemax, $gamemode, $numberify_enabled, $silhouettedisable, $dev, $images>>
<<run Engine.restart()>>
*/
<</nobr>><</widget>>




<<widget "listify">><<nobr>>/* put commas and ands correctly in a list(wants an array) */
<<set $listified to "">>
<<for _i, _item range $args[0]>>
	<<set $listified to $listified+_item>>
	<<if $args[0].length gte _i+3>>
		<<set $listified to $listified+", ">>
	<<elseif $args[0].length is _i+2>>
		<<set $listified to $listified+" and ">>
	<</if>>
<</for>>
<<if $args[1]>><<else>>$listified<</if>>/*print only if $args[1] is undefined */
<</nobr>><</widget>>

<<widget "clothlistify">><<nobr>>/* make a list of clothes with damage level indicated, wants array of "integrity|integritymax|colour|name" */
<<set $listified to "">>
<<for _i, _item range $args[0]>>
	<<set _item to _item.split("|")>>
	<<if _item[3] isnot "naked">>
		<<if _item[0]/_item[1] lte 0.2>>
			<<set _text2 to "<span class='red'>tattered "+_item[3]+"</span>">>
			<<set _text to "<span class='red'>"+_item[3]+"</span>">>
		<<elseif _item[0]/_item[1] lte 0.5>>
			<<set _text2 to "<span class='blue'>torn "+_item[3]+"</span>">>
			<<set _text to "<span class='blue'>"+_item[3]+"</span>">>
		<<elseif _item[0]/_item[1] lte 0.9>>
			<<set _text2 to "<span class='teal'>frayed "+_item[3]+"</span>">>
			<<set _text to "<span class='teal'>"+_item[3]+"</span>">>
		<<else>>
			<<set _text to "<span class='green'>"+_item[3]+"</span>">>
		<</if>>
		<<if _item[2].length gte 2>>/* colour */
			<<set _text to _item[2]+" "+_text>>
		<</if>>
		<<set $listified to $listified+_text>>
		<<if $args[0].length gte _i+3>>
			<<set $listified to $listified+", ">>
		<<elseif $args[0].length is _i+2>>
			<<set $listified to $listified+" and ">>
		<</if>>
	<</if>>
<</for>>
$listified
<</nobr>><</widget>>



<<widget "pickfrom">><<nobr>>/* based on $rng pick from given options using made because either() doesn't depend on $rng */
	<<set _mod to $rng % ($args.length-1)>>/* %	= Modulo (remainder of a division) also array.length isn't zero-based so need to -1 it */
	$args[_mod]
	<<set $picked to $args[_mod]>>
<</nobr>><</widget>> /* not sure if not setting $rng in this is really necessary, are there situations where $rng is checked again after the 1st check? ie. <<if $rng lt 10>>blah<<if $rng is 1>>... I think I made one with lockers or something so yeah */

<<widget "pickrandom">><<nobr>>/* reroll $rng(in case the range $rng can be when called is less than the options) and pick from given options */
	<<set $rng to random(1, 100)>>
	<<set _mod to $rng % ($args.length-1)>>
	$args[_mod]
	<<set $picked to $args[_mod]>>
	<</nobr>><</widget>> /*  */

<<widget "pickfromsilently">><<nobr>>/* based on $rng pick from given options without printing the picked thing */
	<<set _mod to $rng % ($args.length-1)>>
	<<set $picked to $args[_mod]>>
<</nobr>><</widget>> /* having the options be an array at $args[0] would make combining these possible by using $args 1 and 2 but I like how simple these are to use without that */

