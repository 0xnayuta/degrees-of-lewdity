<<widget "pilloptions">><<nobr>>
<<if $pillstaken is 1>><<set $pillstaken to 0>>
You take the pills Doctor Harper prescribed. You feel dizzy.<<gcontrol>><<lawareness>><<awareness -1>><<control 10>><br><br>
<</if>>
<<if $pills gte 1 and $medicated is 0>>
<<link "Take pills">><<set $medicated += 1>><<set $pillstaken to 1>><<script>>state.display(state.active.title, null)<</script>><</link>><br>
<</if>>
<<if $asylumpillstaken is 1>><<set $asylumpillstaken to 0>>
You take the pills prescribed in the asylum. You feel hazy.<<ggcontrol>><<llawareness>><<awareness -5>><<control 25>><br><br>
<</if>>
<<if $asylumpills gte 1 and $asylummedicated lt 1>>
<<link "Take strong pills">><<set $asylummedicated += 1>><<set $asylumpillstaken to 1>><<script>>state.display(state.active.title, null)<</script>><</link>><br>
<</if>>


<</nobr>><</widget>>

<<widget "encountersteal">><<nobr>>
<<set $rng to random(1, 100)>>
<<if $rng gte 96 and $spray lt $spraymax>><<spray 1>>
<span class="green">You steal a charge for your pepper spray.</span><<crimeup 50>><<combatskulduggeryskilluse>><<combatcontrol 10>><<gcombatcontrol>>
<<elseif $rng gte 90 and $compoundstate is undefined and $compoundcard is undefined>><<set $compoundcard to 1>>
You steal a strange card. There's an address on it, for a location on <span class="gold">Elk Street.</span>
<<else>><<set $rng to random(5, 100)>>
You steal £$rng.<<set $money += $rng * 100>><<crimeup $rng>><<combatskulduggeryskilluse>><<combatcontrol 10>><<gcombatcontrol>>
<</if>>
<</nobr>><</widget>>



<<widget "combat_partner">><<nobr>>/* somehow set to "I" when masturbating? */
<<set $combat_partner = "">>/* hopefulyy this will fix the "An an a slight boy", it does but instead causes just "A"s to appear */
<<if $enemytype is "beast">>
	<<set $combat_partner = $beasttype>>
<<elseif $npc isnot 0>>/* is a named npc */
	<<set $combat_partner = $npcdescription + " " + $npc>>
<<elseif $npcadult is 1>>/* is a named npc */
	<<if $pronoun is "m">><<set $combat_partner = $description + " man">>
	<<elseif $pronoun is "f">><<set $combat_partner = $description + " woman">>
	<<elseif $pronoun is "i">><<set $combat_partner = $description + " thing">>
	<<else>><<set $combat_partner = $description + " person">>
	<</if>>
<<else>>
	<<if $pronoun is "m">><<set $combat_partner = $description + " boy">>
	<<elseif $pronoun is "f">><<set $combat_partner = $description + " girl">>
	<<elseif $pronoun is "i">><<set $combat_partner = $description + " thing">>
	<<else>><<set $combat_partner = $description + "kid">>/* this should appear if all else fails, hopefully preventing no description at all */
	<</if>>
<</if>>
<<set $combat_partner to jsArticle($combat_partner)>>
<<set $Combat_partner to jsCapitalize($combat_partner)>>
/*
<<set $logextra "I lost my "+$args[0]+"virginity to "+jsArticle($combat_partner)+$combat_partner+".">>
<<set $logextra "I lost my "+$args[0]+"virginity to "+$combat_partner+".">>
*/
<</nobr>><</widget>>


<<widget "remembersettings">><<nobr>>/*  */
<<remember $debug>>
<<remember $tipdisable>>
<<remember $cheatdisable>>
<<remember $compactsidebar>>

/* diary settings */
<<remember $logdebug>>
<<remember $diarymode>>
<<remember $loglocations>>
<<remember $diaryprompts>>
<<remember $diarysidebar>>
<<remember $diaryfilterA>>
<<remember $diaryfilterB>>
<<remember $compactsidebar>>
<<remember $logshowcomments>>
<<remember $logshowopinions>>
<<remember $logchangetreshold>>
<<remember $diaryshowunwritten>>
<<remember $busimportance>>
<<remember $workimportance>>
<<remember $passoutimportance>>
<<remember $exposureimportance>>
<<remember $logextraimportance>>
<<remember $locationimportance>>
/* sliders */
<<remember $malechance>>
<<remember $beastmalechance>>
<<remember $dgchance>>
<<remember $cbchance>>
<<remember $whitechance>>
<<remember $blackchance>>
<<remember $alluremod>>
/*content toggles*/
<<remember $bestialitydisable>>
<<remember $swarmdisable>>
<<remember $parasitedisable>>
<<remember $slimedisable>>
<<remember $voredisable>>
<<remember $tentacledisable>>
<<remember $analdisable>>
<<remember $transformdisable>>
<<remember $hirsutedisable>>
<<remember $breastfeedingdisable>>
/* not sure if these are really necessary */
<<remember $breastsizemax>>
<<remember $gamemode>>
<<remember $numberify_enabled>>
<<remember $silhouettedisable>>
<<remember $dev>>
<<remember $images>>
<<remember $textonly>>

<</nobr>><</widget>>

<<widget "forgetsettings">><<nobr>>/* not sure where would be a good place to actually use this if at all */
<<remember $facreset to true>>
<<run UI.restart()>>/* will ask to restart, Engine.restart() won't ask, anyway probably not a good idea to not do a restart after undefining all of these */

/*
<<forget $debug, $tipdisable, $cheatdisable, $compactsidebar, $malechance, $beastmalechance, $dgchance, $cbchance, $whitechance, $blackchance, $alluremod>>
<<forget $logdebug, $diarysidebar, $diarymode, $loglocations, $diaryprompts, $diaryfilterA, $diaryfilterB, $logshowcomments, $logshowopinions, $logchangetreshold, $diaryshowunwritten>>
<<forget $busimportance, $workimportance, $passoutimportance, $exposureimportance, $logextraimportance>>
<<forget $bestialitydisable, $swarmdisable, $parasitedisable, $slimedisable, $voredisable, $tentacledisable, $analdisable, $transformdisable, $hirsutedisable, $breastfeedingdisable>>
<<forget $breastsizemax, $gamemode, $numberify_enabled, $silhouettedisable, $dev, $images, $textonly>>
<<run Engine.restart()>>
*/
<</nobr>><</widget>>


/*
diary stuff


*/
<<widget "loginit">><<nobr>>

/* name diaryentry array indexes to make coding easier without making the game repeatedly use the names(in save files and such) */
<<set _len to 53>>/* index of last $log.variable */
<<if $logblank is undefined or $logblank.length lte _len>>/* checking _len to trigger on version update if new ones get added */
	<<set $log to {
		time:0,text:1,importance:2,comment:3,opinion:4,
		money:5,stress:6,trauma:7,awareness:8,pain:9,
		tiredness:10,arousal:11,control:12,allure:13,antiquemoney:14,
		blackmoney:15,spray:16,spraymax:17,drunk:18,drunkgain:19,
		drugged:20,weather:21,clothupper:22,clothlower:23,clothunder:24,
		oldclothupper:25,oldclothlower:26,oldclothunder:27,collared:28,purity:29,
		submissive:30,physique:31,beauty:32,promiscuity:33,exhibitionism:34,
		deviancy:35,skulduggery:36,danceskill:37,swimmingskill:38,seductionskill:39,
		oralskill:40,vaginalskill:41,penileskill:42,analskill:43,handskill:44,
		feetskill:45,bottomskill:46,thighskill:47,chestskill:48,science:49,
		maths:50,english:51,history:52,unclad:53
	}>>
	/*
	to add: detentions, stats like number of molestations and dancings(mainly so you can talk about them in appointments )
	*/
	<<set $logblank to []>>
	<<for $logblank.length lte _len>>
		<<set $logblank.push(0)>>
	<</for>>
	<<set $logblank[$log.weather] to ("")>>
	<<set $logblank[$log.clothupper] to ("")>>
	<<set $logblank[$log.clothlower] to ("")>>
	<<set $logblank[$log.clothunder] to ("")>>
	<<set $logblank[$log.oldclothupper] to ("")>>
	<<set $logblank[$log.oldclothlower] to ("")>>
	<<set $logblank[$log.oldclothunder] to ("")>>

<</if>>

<<if $logged is undefined>><<set $logged to clone($logblank)>><</if>>

<<if $diary.length-1 lt $days>> /* fill diary with blank days to catch up to current date */
	<<for _i to 0; _i lt $days; _i++>>
		<<if $diary[_i] is undefined>>
			<<set $diary.push([])>>
			<<set $diary[_i][0] to clone($logblank)>>
			<<set $diary[_i][0][$log.text] to "Day " + _i>>
			<<set $diary[_i][0][$log.importance] to -5>>
		<</if>>
	<</for>>
	<<set $diary.push([])>>
	<<set _a to clone($logblank)>>
	<<set _a[$log.text] to $month+" "+$monthday+" "+$logprep>>
	<<set _a[$log.time] to 0>>
	<<set _a[$log.comment] to "(Day "+$days+")">>
	<<set _a[$log.importance] to 7>>
	<<set _a[$log.money] to "="+$money>>
	<<set $diary[$days][0] to _a>>
	/*<<set $diary[$days][0] to
	{text:$month + " " + $monthday, timestamp:0,comment:"",opinion:"",importance:7,effect:{money:0,stress:0,trauma:0,awareness:0,pain:0,tired:0,arousal:0,control:0,allure:0,antiquemoney:0,blackmoney:0,weather:"",clothupper:"",clothlower:"",clothunder:"",oldclothupper:(""),oldclothlower:(""),oldclothunder:("")}}>>
	*/
<</if>>

<</nobr>><</widget>>

<<widget "log">><<nobr>>
	<<if $logdebug is 1>>log<<print $args[1]>>(<<print $args[0]>>)<</if>>

	<<if $args[0] == undefined>><<set $args[0] to "Did something.">><</if>>
	<<if $args[1] == undefined>><<set $args[1] to 1>><</if>>
	<<set $logprep to "">> /* if this didn't exist logadd wouldn't be necessary but I think it needs to since there might be some situations where logprep+"" needs to be the 1st thing */
	<<set $diarypage to $days>>
	<<set $diaryline to $diary[$days].length>>
	<<set _d to $diary[$days][$diaryline]>>
	<<if $args[1] gte $logchangetreshold or $debug is 1>>
	<<if $rng gt 110>>/* dunno which one I should keep so using random one to make sure both work */
		/* order and number of these matters so it's more error prone if things change */
		<<set $diary[$days].push([
			$time,$args[0],$args[1],"","",
			$money - $logged[$log.money],
			$stress - $logged[$log.stress],
			$trauma - $logged[$log.trauma],
			$awareness - $logged[$log.awareness],
			$pain - $logged[$log.pain],
			$tiredness - $logged[$log.tiredness],
			$arousal - $logged[$log.arousal],
			$control - $logged[$log.control],
			$allure - $logged[$log.allure],
			$antiquemoney - $logged[$log.antiquemoney],
			$blackmoney - $logged[$log.blackmoney],
			$spray - $logged[$log.spray],
			$spraymax - $logged[$log.spraymax],
			$drunk,
			$drunk - $logged[$log.drunk],
			$drugged - $logged[$log.drugged],
			"","","","","","",""
			,$collared - $logged[$log.collared]
			,$purity - $logged[$log.purity]
			,$submissive - $logged[$log.submissive]
			,$physique - $logged[$log.physique]
			,$beauty - $logged[$log.beauty]
			,$promiscuity - $logged[$log.promiscuity]
			,$exhibitionism - $logged[$log.exhibitionism]
			,$deviancy - $logged[$log.deviancy]
			,$skulduggery - $logged[$log.skulduggery]
			,$danceskill - $logged[$log.danceskill]
			,$swimmingskill - $logged[$log.swimmingskill]
			,$seductionskill - $logged[$log.seductionskill]
			,$oralskill - $logged[$log.oralskill]
			,$vaginalskill - $logged[$log.vaginalskill]
			,$penileskill - $logged[$log.penileskill]
			,$analskill - $logged[$log.analskill]
			,$handskill - $logged[$log.handskill]
			,$feetskill - $logged[$log.feetskill]
			,$bottomskill - $logged[$log.bottomskill]
			,$thighskill - $logged[$log.thighskill]
			,$chestskill - $logged[$log.chestskill]
			,$science - $logged[$log.science]
			,$maths - $logged[$log.maths]
			,$english - $logged[$log.english]
			,$history - $logged[$log.history]
			,$unclad + $logged[$log.unclad]
		])>>
	<<else>>/* order of these doesn't matter */
		<<set $diary[$days].push(clone($logblank))>>
		<<set _d to $diary[$days][$diaryline]>>
		<<set _d[$log.time] to $time>>
		<<set _d[$log.text] to $args[0]>>
		<<set _d[$log.importance] to $args[1]>>
		<<set _d[$log.comment] to "">>
		<<set _d[$log.opinion] to "">>
		<<set _d[$log.money] to ($money - $logged[$log.money])>>
		<<set _d[$log.stress] to ($stress - $logged[$log.stress])>>
		<<set _d[$log.trauma] to ($trauma - $logged[$log.trauma])>>
		<<set _d[$log.awareness] to ($awareness - $logged[$log.awareness])>>
		<<set _d[$log.pain] to ($pain - $logged[$log.pain])>>
		<<set _d[$log.tiredness] to ($tiredness - $logged[$log.tiredness])>>
		<<set _d[$log.arousal] to ($arousal - $logged[$log.arousal])>>
		<<set _d[$log.control] to ($control - $logged[$log.cotrol])>>
		<<set _d[$log.allure] to ($allure - $logged[$log.allure])>>
		<<set _d[$log.antiquemoney] to ($antiquemoney - $logged[$log.antiquemoney])>>
		<<set _d[$log.blackmoney] to ($blackmoney - $logged[$log.blackmoney])>>
		<<set _d[$log.spray] to ($spray - $logged[$log.spray])>>
		<<set _d[$log.spraymax] to ($spraymax - $logged[$log.spraymax])>>
		<<set _d[$log.drunk] to ($drunk)>>
		<<set _d[$log.drunkgain] to ($drunk - $logged[$log.drunk])>>
		<<set _d[$log.drugged] to ($drugged - $logged[$log.drugged])>>
		<<set _d[$log.weather] to ("")>>
		<<set _d[$log.clothupper] to ("")>>
		<<set _d[$log.clothlower] to ("")>>
		<<set _d[$log.clothunder] to ("")>>
		<<set _d[$log.oldclothupper] to ("")>>
		<<set _d[$log.oldclothlower] to ("")>>
		<<set _d[$log.oldclothunder] to ("")>>
		<<set _d[$log.collar] to ($collared)>>
		<<set _d[$log.purity] to ($purity - $logged[$log.purity])>>
		<<set _d[$log.submissive] to ($submissive - $logged[$log.submissive])>>
		<<set _d[$log.physique] to ($physique - $logged[$log.physique])>>
		<<set _d[$log.beauty] to ($beauty - $logged[$log.beauty])>>
		<<set _d[$log.promiscuity] to ($promiscuity - $logged[$log.promiscuity])>>
		<<set _d[$log.exhibitionism] to ($exhibitionism - $logged[$log.exhibitionism])>>
		<<set _d[$log.deviancy] to ($deviancy - $logged[$log.deviancy])>>
		<<set _d[$log.skulduggery] to ($skulduggery - $logged[$log.skulduggery])>>
		<<set _d[$log.danceskill] to ($danceskill - $logged[$log.danceskill])>>
		<<set _d[$log.swimmingskill] to ($swimmingskill - $logged[$log.swimmingskill])>>
		<<set _d[$log.seductionskill] to ($seductionskill - $logged[$log.seductionskill])>>
		<<set _d[$log.oralskill] to ($oralskill - $logged[$log.oralskill])>>
		<<set _d[$log.vaginalskill] to ($vaginalskill - $logged[$log.vaginalskill])>>
		<<set _d[$log.penileskill] to ($penileskill - $logged[$log.penileskill])>>
		<<set _d[$log.analskill] to ($analskill - $logged[$log.analskill])>>
		<<set _d[$log.handskill] to ($handskill - $logged[$log.handskill])>>
		<<set _d[$log.feetskill] to ($feetskill - $logged[$log.feetskill])>>
		<<set _d[$log.bottomskill] to ($bottomskill - $logged[$log.bottomskill])>>
		<<set _d[$log.thighskill] to ($thighskill - $logged[$log.thighskill])>>
		<<set _d[$log.chestskill] to ($chestskill - $logged[$log.chestskill])>>
		<<set _d[$log.science] to ($science - $logged[$log.science])>>
		<<set _d[$log.maths] to ($maths - $logged[$log.maths])>>
		<<set _d[$log.english] to ($english - $logged[$log.english])>>
		<<set _d[$log.history] to ($history - $logged[$log.history])>>
		<<set _d[$log.unclad] to ($unclad - $logged[$log.unclad])>>
	<</if>>
	/* add strings only when they have changed, so if entry says weather is clear then it wasn't before that*/
	<<if $logged[$log.weather] isnot $weather>><<set $diary[$days][$diaryline][$log.weather] to $weather>><</if>>
	/* need to list all clothing when something changes so that we don't need to search through previous entries to figure out if a part that didn't change is naked or not */
	<<if $logged[$log.clothupper] isnot $upperclothes or $logged[$log.clothlower] isnot $lowerclothes or $logged[$log.clothunder] isnot $underclothes>>
		<<set $diary[$days][$diaryline][$log.oldclothupper] to clone($logged[$log.clothupper])>>
		<<set $diary[$days][$diaryline][$log.oldclothlower] to clone($logged[$log.clothlower])>>
		<<set $diary[$days][$diaryline][$log.oldclothunder] to clone($logged[$log.clothunder])>>
		<<set $diary[$days][$diaryline][$log.clothupper] to $upperclothes>>
		<<set $diary[$days][$diaryline][$log.clothlower] to $lowerclothes>>
		<<set $diary[$days][$diaryline][$log.clothunder] to $underclothes>>
	<</if>>

	<<logstatsupdate>>
	<<else>> /* wait for more noteworthy event to add changes to, kind of unnecessary unless the diary actually shows changes to stats that are constantly changing */
		<<run $diary[$days].push($logblank)>>
	<</if>>
	<<if $logextra isnot "" and $logextra isnot undefined>> /* virginity loss entries should come after the event (or as some special comment like thing) */
		<<logextra $logextra $logextraimportance>>
	<</if>>
<</nobr>><</widget>>
/*<<widget "oldlog">><<nobr>>
