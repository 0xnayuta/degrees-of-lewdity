		$pillory_tenant.special.name's
	<</if>>
<</nobr>><</widget>>

<<widget "the_pillory_type">><<nobr>>
	<<get_pillory_npc>>the
	<<if $pillory_tenant.special.name is "">>
		<<person>>
	<<else>>
