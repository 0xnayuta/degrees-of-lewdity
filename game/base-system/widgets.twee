<<widget "physique">><<nobr>>
<<if $args[0]>><<set _temp to $args[0]>><<else>><<set _temp to 1>><</if>>
<<if $exposed gte 2>>
<<set _temp *= 1.2>>
<<elseif $exposed is 1>>
<<set _temp *= 1.1>>
<</if>>
<<set $physique += 10 * _temp>><<set $physiqueuse += _temp>><span class="gold"> You get a good workout.</span>
<</nobr>><</widget>>

<<widget "bruise">><<nobr>>
<<if $args[0]>>
	<<switch $args[0]>>
	<<case "face">>
