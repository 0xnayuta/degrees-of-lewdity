<<widget "skulduggeryskilluse">><<nobr>>
	<<set $skulduggery += 3>>
	<<if $skulduggery lt 1000>>
		<span class="gold"> You learned a thing or two about skulduggery.</span>
		<br><br>
	<</if>>
<</nobr>><</widget>>

<<widget "combatskulduggeryskilluse">><<nobr>>
	<<set $skulduggery += 3>>
	<<if $skulduggery lt 1000>>
		<span class="gold"> You learned a thing or two about skulduggery.</span>
	<</if>>
<</nobr>><</widget>>

<<widget "swimmingskilluse">><<nobr>>
