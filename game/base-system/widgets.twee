<</nobr>><</widget>>

<<widget "historyskill">><<nobr>>
<<if $args[0]>>
	<<set $history += ($args[0] * 2)>><<set $school += ($args[0] * 2)>>
	<<if $worn.face.type.includes("glasses")>>
