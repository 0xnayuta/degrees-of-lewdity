<<elseif $args[0]+$args[1] lte 2>>
	some
<<elseif $args[0]+$args[1] lte 3>>
	some
<<elseif $args[0]+$args[1] lte 4>>
	bunch of
<<elseif $args[0]+$args[1] lte 6>>
	lots of
<<elseif $args[0]+$args[1] lte 8>>
	a ton of
<<else>>
	a ton of
<</if>>
<</nobr>><</widget>>

