		<<set $mouthuse to "lefthand">><<set $NPCList[$args[0]].lefthand to "mouth">>
	<<else>>
		<<set $mouthuse to "righthand">><<set $NPCList[$args[0]].righthand to "mouth">>
	<</if>>
<</if>>
<</nobr>><</widget>>

