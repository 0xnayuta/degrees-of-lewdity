	<<set $rightarmgoo += _i>>
	<<set $leftarmgoo += _i>>
	<<set $thighgoo += _i>>
	<<set $bottomgoo += _i>>
	<<set $tummygoo += _i>>
	<<set $chestgoo += _i>>
	<<set $facegoo += _i>>
	<<set $hairgoo += _i>>
	<<set $feetgoo += _i>>
	<<if $player.gender is "f">>
		<<if $args[2] isnot "outside">>
			<<set $vaginagoo += _i>>
		<</if>>
		<<set $vaginaoutsidegoo += _i>>
	<<elseif $player.gender is "m">>
		<<set $penisgoo += _i>>
	<</if>>
	<<if $args[2] isnot "outside">>
		<<set $anusgoo += _i>>
		<<set $mouthgoo += _i>>
	<</if>>
<</if>>

<<if $args[0] isnot "goo">>
	<<set $necksemen += _i>>
	<<set $rightarmsemen += _i>>
	<<set $leftarmsemen += _i>>
	<<set $thighsemen += _i>>
	<<set $bottomsemen += _i>>
	<<set $tummysemen += _i>>
	<<set $chestsemen += _i>>
	<<set $facesemen += _i>>
	<<set $hairsemen += _i>>
	<<set $feetsemen += _i>>
	<<if $player.gender is "f">>
		<<if $args[2] isnot "outside">>
			<<set $vaginasemen += _i>>
		<</if>>
		<<set $vaginaoutsidesemen += _i>>
	<<elseif $player.gender is "f">>
		<<set $penissemen += _i>>
	<</if>>
	<<if $args[2] isnot "outside">>
		<<set $anussemen += _i>>
		<<set $mouthsemen += _i>>
	<</if>>
<</if>>

<</nobr>><</widget>>

