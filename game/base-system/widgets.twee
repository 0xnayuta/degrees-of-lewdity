<<widget "toiletuse">><<nobr>>/* not sure if there's a better file for this to be in */
You 
<<if $watersportsdisable is "f">>
	use the toilet to 
	<<if $canpee gte 4320>>/* more than 3 days since last use */
		empty your almost bursting bladder of piss.
		<<smell "piss" 1>>
	<<elseif $canpee gte 1440>>/* more than 24h since last use */
		empty your bladder of piss.
	<<else>>
		pee.
	<</if>>
	<<smell "piss" 1>>
<<else>>
	use the toilet.
<</if>>
<<set _issues to 0>>
<<set $canpee to -(120+$rng*2)>>
/* + toiletuse stat? */
<<if $exposure gte 2 and $exhibitionism lte 75 and $args[0] isnot "clean">>
	<br>
	Being so nude in such a dirty place makes you uncomfortable.
	<<set _issues++>>
<<if $worn.lower.type.includes("naked") and $worn.under_lower.type.includes("naked") or $worn.lower.skirt is 1 and $worn.under_lower.type.includes("naked")>>/* nothing too in the way, makes bound arms not matter */
	<br>
	Easy access of the relevant area makes doing you business easier and more comfortable.
	<<arousal 1>><<stress -1>>
<<elseif $leftarm is "bound" and $rightarm is "bound" and $worn.under_lower.type.includes("chastity")>>
	<br>
	Your $worn.under_lower.name and arms being bound make the process a bit uncomfortable and time consuming.
	<<pass 2>>
	<<set _issues++>>
<<elseif $worn.under_lower.type.includes("chastity")>>
	<br>
	Your $worn.under_lower.name makes the process a bit uncomfortable.
	<<set _issues++>>
<<elseif $leftarm is "bound" and $rightarm is "bound">>
	<br>
	Your arms being bound makes the process more difficult and time consuming.
	<<pass 2>>
	<<set _issues++>>
<<elseif $leftarm is "bound" or $rightarm is "bound">>
	<br>
	With just one hand available /* shifting your clothes out of the way and */doing your business takes a bit longer.
	<<pass 1>>
	<<set _issues++>>
<</if>>
<<if $vaginasemen gte 2 or $vaginagoo gte 2 or $anussemen gte 2 or $anusgoo gte 2>>
	<br>
	Your privates drip some
	/* should this actually reduce the goo/semen count? */
	<<if $vaginasemen gte 2 or $anussemen gte 2 and $vaginagoo gte 2 or $anusgoo gte 2>>
		semen and slime
	<<elseif $vaginasemen gte 2 or $anussemen gte 2>>
		semen
	<<elseif $vaginagoo gte 2 or $anusgoo gte 2>>
		slime
	<</if>>
	into the toilet.
	<<set _issues++>>
<</if>>

<<if $parasite.penis.name>>
	<br>
	<span class="pink">The $parasite.penis.name parasite clinging to your penis reminds you of it's presence.</span>
	<<set _issues++>>
<</if>>
<<if $parasite.clit.name>>
	<br>
	<span class="pink">The $parasite.clit.name parasite clinging to your clit reminds you of it's presence.</span>
	<<set _issues++>>
<</if>>
<<if $parasite.bottom.name>>
	<br>
	<span class="pink">The $parasite.bottom.name parasite clinging to your bottom reminds you of it's presence.</span>
	<<set _issues++>>
<</if>>
<<if $arousal gte 8000>>
	<br>
	<<if $parasite.bottom.name or $parasite.bottom.penis or $parasite.clit.name>>
		And with how aroused you already are that presence is all the more distracting
		<<set _issues += 2>>
	<<else>>
		Your level of arousal is rather distracing.
		<<set _issues++>>
	<</if>>
<</if>>
<<if $phase is "m" and $player.gender is "f" or $phase is "f" and $player.gender is "m">>
	<br>
	Using a toilet meant for the opposite sex is thrilling.
	<<arousal 1>><<garousal>>
	<<set _issues++>>
<</if>>
<<if _issues lte 0>>
	<br>
	It feels nice and relaxing. <<stress -1>><<lstress>>
<<else>>
	/*  */
	<<arousal _issues>><<garousal>>
<</if>>
<br>
<<set $logprep to "Used a toilet.">>
<<log $logprep 1>>
<</nobr>><</widget>>