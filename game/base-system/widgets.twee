<<if !$worn.under_lower.type.includes("naked")>>
<<gtrauma>><<gstress>><<trauma 1>><<stress 1>>
<<else>>
<<gtrauma>><<gstress>><<trauma 3>><<stress 3>>
<</if>>
<</nobr>><</widget>>

<<widget "goo">><<nobr>>
<<goooutsidecount>>
<<if $sidebar.fluids gte 3>>
	<<if $goocount gte 1 or $semencount gte 1>>
		<span class="pink">Semen</span>|<span class="purple">Goo</span>:<br>
		<<if $semenoutsidecount gte 1 or $goooutsidecount gte 1>>
		<<if $sidebar.fluids is 3>>body<</if>>
		<<if $sidebar.fluids is 4>>B<</if>>
			<<if $semenoutsidecount gte 55>>
			<span style="color:#e6005c">$semenoutsidecount</span>
			<<elseif $semenoutsidecount gte 25>>
			<span style="color:#ff1a75">$semenoutsidecount</span>
