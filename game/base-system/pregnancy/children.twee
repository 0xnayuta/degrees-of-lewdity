:: Widgets children [widget]
/*args[0] - filter in the form of an object ({location, excludeUnhatched: true to also exclude unhatched eggs}), args[1] - "both" to include unrelated children or "only" to exclude the player children*/
<<widget "getChildrenIds">>
	<<set _childrenIds to []>>
	<<if _args[0]>>
		/* Only "location" and "excludeUnhatched" are supported filter keys. Anything else would be silently
		ignored below and match every child instead of the subset the caller meant, so fail loud. */
		<<run Object.keys(_args[0]).forEach(key => {
			if (key !== "location" and key !== "excludeUnhatched") {
				throw new Error(`getChildrenIds: unsupported filter key "${key}", only "location" and "excludeUnhatched" are supported`);
			}
		})>>
	<</if>>
	<<run getBornChildren().forEach(child => {
		const pregnancy = getPregnancyOf(child);
		if ((pregnancy.carrier === "pc" || pregnancy.donor === "pc") && _args[1] === "only") {
			return;
		} else if ((pregnancy.carrier !== "pc" && pregnancy.donor !== "pc") and !_args[1]) {
			return;
		}
		if (T.args[0] && T.args[0].location !== undefined && child.development.location !== T.args[0].location) {
			return;
		}
		if (T.args[0] && T.args[0].excludeUnhatched && childIsUnhatchedEgg(child)) {
			return;
		}
		if (child.childId !== undefined) T.childrenIds.push(child.childId);
	})>>
<</widget>>

/*args[0] - location, args[1] - min length requirement, args[2] - max length requirement,
args[3] - "both" to include unrelated children or "only" to exclude the player children
Groups littermates by pregnancyId.*/
<<widget "getSameBirthChildrenIds">>
	<<set _birthChildrenIds to {}>>
	<<run getBornChildren().forEach(child => {
		const pregnancy = getPregnancyOf(child);
		if (pregnancy.carrier !== "pc" && pregnancy.donor !== "pc") {
			if (T.args[3] !== "both" && T.args[3] !== "only") return;
		} else if (T.args[3] === "only") {
			return;
		}
		if (childIsUnhatchedEgg(child)) return;
		if (T.args[0] !== undefined && child.development.location !== T.args[0]) return;
		if (T.birthChildrenIds[child.pregnancyId] === undefined) T.birthChildrenIds[child.pregnancyId] = [];
		T.birthChildrenIds[child.pregnancyId].push(child.childId);
	})>>
	<<if _args[1]>>
		<<for $_label, $_value range _birthChildrenIds>>
			<<if $_value.length lt _args[1] or $_value.length gt _args[2]>>
				<<run delete _birthChildrenIds[$_label]>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

/*args[0] - childId, args[1] - new name*/
<<widget "childRename">>
	<<if _args[0] isnot undefined>>
		<<set $childRecords[_args[0]].name to generateBabyName(_args[1], $childRecords[_args[0]].gender, _args[0])>>
	<</if>>
<</widget>>

/*args[0] - childId, args[1] - set to display specific text output*/
<<widget "childAge">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set _childTotalDaysRaw to childAgeOf($childRecords[_args[0]])>>
		<<switch $childRecords[_args[0]].species>>
			<<case "human" "wolf" "hawk">><<set _childTotalDaysCap to 200>>
			<<default>><<set _childTotalDaysCap to 0>>
		<</switch>>
		<<set _childTotalDays to Math.clamp(_childTotalDaysRaw, 0, _childTotalDaysCap)>>
		<<set _childYears to Math.floor(_childTotalDays / 360)>>
		<<set _childDays to Math.floor(_childTotalDays % 360)>>
		<<switch _args[1]>>
			<<case "full">>
				<<set $_text_output to _childYears + " year" + (_childYears isnot 1 ? "s, " : ", ") + _childDays + " day" + (_childDays isnot 1 ? "s " : " ") + "old">>
			<<case "year">>
				<<set $_text_output to _childYears + " year" + (_childYears isnot 1 ? "s" : "")>>
			<<case "day">>
				<<set $_text_output to _childDays + " day" + (_childDays isnot 1 ? "s" : " ")>>
			<<case "totalDays">>
				<<set $_text_output to _childTotalDays>>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><<if _childTotalDaysCap is _childTotalDays>> <mouse class="tooltip linkBlue">(Capped)<span>Reached end of current child activity content.</span></mouse><</if>><</if>><</widget>>

/*:: Widgets children2 [widget]*/

/*args[0] - childId*/
<<widget "childSelect">>
	<<if _args[0] isnot undefined>>
		<<set $childSelected to $childRecords[_args[0]]>>
		<<if $childRecords[_args[0]].species isnot "human" and $childRecords[_args[0]].features.monster is "monster">>
			<<set $cmonster to 1>>
		<<else>>
			<<set $cmonster to 0>>
		<</if>>
	<</if>>
<</widget>>

/*args[0] - childId*/
<<widget "childname">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set $_id to _args[0]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
	<</if>>
	<<if $_id isnot undefined>>
		<<set $_text_output to $childRecords[$_id].name>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - childId in an array*/
<<widget "childrenNames">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set $_text_output to "">>
		<<for $_i to 0; $_i lt _args[0].length; $_i++>>
			<<set $_text_output += $childRecords[_args[0][$_i]].name>>
			<<if $_i is _args[0].length - 1>>
			<<elseif $_i is _args[0].length - 2>>
				<<set $_text_output += " and ">>
			<<else>>
				<<set $_text_output += ", ">>
			<</if>>
		<</for>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - childId in an array*/
<<widget "childInteratedWith">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set $_id to _args[0]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
	<</if>>
	<<if $_id isnot undefined>>
		<<set $_development to $childRecords[$_id].development>>
		<<if $_development.interactionsTotal is undefined>>
			<<set $_development.interactionsTotal to 0>>
			<<set $_development.interactions to 0>>
		<</if>>
		<<set $_development.interactionsTotal++>>
		<<if $daily.childInteractions is undefined>><<set $daily.childInteractions to []>><</if>>
		<<if !$daily.childInteractions.includes($_id)>>
			<<set $_development.interactions++>>
			<<run $daily.childInteractions.push($_id)>>
		<</if>>
		<<set $pregnancyStats.childInteractions++>>
		<<if $location is "home">><<set $pregnancyStats.orphanageInteractions++>><</if>>
	<</if>>
<</silently>><</widget>>

