<<widget "exhibitionism">><<nobr>>
/*just the stat effects first*/
<<if $attitude.nude is "excited" or $uncomfortable.nude is false>>
	<<if $exposed is 1 and $daystate is "night">>
		<<arousal 20>>
	<<elseif $exposed is 1 and $daystate is "day">>
		<<arousal 40>>
	<<elseif $exposed is 2 and $daystate is "night">>
		<<arousal 40>>
	<<elseif $exposed is 2 and $daystate is "day">>
		<<arousal 80>>
	<</if>>
<<elseif $attitude.nude is "embarrassed" or $uncomfortable.nude is true>>
	<<if $exposed is 1 and $daystate is "night">>
		<<arousal 20>>
		<<stress 1>>
	<<elseif $exposed is 1 and $daystate is "day">>
		<<arousal 10>>
		<<stress 2>>
	<<elseif $exposed is 2 and $daystate is "night">>
		<<arousal 10>>
		<<stress 2>>
	<<elseif $exposed is 2 and $daystate is "day">>
		<<arousal 5>>
		<<stress 3>>
	<</if>>
<<elseif $attitude.nude is "uncomfortable">>
	<<if $exposed is 1 and $daystate is "night">>
		<<stress 1>>
	<<elseif $exposed is 1 and $daystate is "day">>
		<<stress 2>>
	<<elseif $exposed is 2 and $daystate is "night">>
		<<stress 2>>
	<<elseif $exposed is 2 and $daystate is "day">>
		<<stress 4>>
	<</if>>
<<elseif $attitude.nude is "uncaring">>
<<elseif $attitude.nude is "relaxed">>
	<<if $exposed is 1 and $daystate is "night">>
		<<stress -0.1>>
	<<elseif $exposed is 1 and $daystate is "day">>
		<<stress -0.2>>
	<<elseif $exposed is 2 and $daystate is "night">>
		<<stress -0.2>>
	<<elseif $exposed is 2 and $daystate is "day">>
		<<stress -0.3>>
	<</if>>
<<elseif $attitude.nude is "horrible">>
	<<if $exposed is 1 and $daystate is "night">>
		<<trauma 1>>
	<<elseif $exposed is 1 and $daystate is "day">>
		<<trauma 2>>
	<<elseif $exposed is 2 and $daystate is "night">>
		<<trauma 2>>
	<<elseif $exposed is 2 and $daystate is "day">>
		<<trauma 4>>
	<</if>>
<</if>>
<<switch $args[0]>>
	<<case "street">>
		You are standing on a public street
		<<if $exposed is 1>>
			in a state of undress!
		<<else>>
			completely exposed!
		<</if>>
		<<exhibitionismskinfeel>>
		There appears to be no one else around, but you don't know how long that will last.
		<<set $logprep to "I was on a public street "+$naked+",">>
	<<case "alley">>
		You are standing in a public alley
		<<if $exposed is 1>>
			in a state of undress!
		<<else>>
			with your vulnerables exposed!
		<</if>>
		<<exhibitionismskinfeel>>
		<<if $daystate is "night">>
			<<set $logprep to "I was in an alley "+$naked+", luckily no one else was around at such a late hour!">>
		<<else>>
			<<set $logprep to "I was in an alley "+$naked+", luckily no one else was around!">>
			There appears to be no one else around, but you don't know how long that will last.
		<</if>>
	<<case "park">>
		You are hiding behind a bush.
		<<if $daystate is "day">>
			If you're careful you might be able to remain concealed by hiding behind vegetation.
			<<set $logprep to "I was "+$naked+" at the park, I hid behind a bush to avoid being seen!">>
		<<else>>
			<<set $logprep to "I was "+$naked+" at the park, I hid behind a bush in case anyone was around!">>
		<</if>>
		<<exhibitionismskinfeel>>
	<<case "garden">>
		You are hiding behind the garden shed.
		<<exhibitionismskinfeel>>
		You hope you can make it to your bedroom without anyone seeing you.
		<<set $logprep to "I was "+$naked+" in the orphanage garden, I hid behind the garden shed hoping no one would see me!">>
	<<case "beach">>
		<<if $daystate is "night">>
			You are alone, but being in such a lewd state of dress is as terrifying as it is thrilling.
			<<exhibitionismskinfeel>>
			<<set $logprep to "I was at the beach "+$naked+"! Thanks to the late hour I seemed to be alone.">>
		<<else>>
			<<if $exposed is 1>>
				Even for the beach, your state of undress is too much. You hide behind a windbreaker.
			<<else>>
				You're completely exposed in broad daylight! Thankfully, there's enough windbreakers to hide your body.
			<</if>>
			<<exhibitionismskinfeel>>
			<<set $logprep to "I was at the beach "+$naked+"! There were people around so I tried to use the numerous windbreakers scattered around to shield myself.">>
		<</if>>
	<<case "roof">>
			<<exhibitionismskinfeel "roof">>
			The open air makes you feel more exposed than ever despite no one being around.
			<<if $bus is "commercial" or $bus is "industrial">>
				<<set $logprep to "I was "+$naked+" on the rooftop of a "+$bus+" building, the open air made me feel more exposed than ever despite no one being around!">>
			<<else>>
				<<set $logprep to "I was "+$naked+" on a rooftop, the open air made me feel more exposed than ever despite no one being around!">>
			<</if>>
	<<case "building">>
		<<if $daystate is "night">>
			You are alone, but being in such a lewd state of dress is as terrifying as it is thrilling.
			<<set $logprep to "I was in a building "+$naked+", luckily no one seemed to be around!">>
		<<else>>
			<<if $exposed is 1>>
				You are dressed lewdly in a public space! You feel excitement and terror in equal measure.
			<<else>>
				You are in public with your unmentionables uncovered! You feel excitement and terror in equal measure.
			<</if>>
			<<set $logprep to "I was "+$naked+" in a public space!">>
		<</if>>
	<<case "mall">>
	<<case "shop">>
	<<case "classroom">>
		You're alone in the room, but being exposed in this often-crowded space makes you feel vulnerable and conscious of your <<nuditystop>>
		<<set $logprep to "I was in a classroom while "+$naked+"!">>
	<<default>>
		BUG - Missing/typo'd location in "exhibitionism" widget<br><br> 
<</switch>>
<<if $leftarm is "bound" and $rightarm is "bound">>
	<<set _coveryourself to "but with your arms bound you can do nothing to hide your $nakedness.">>
<<else>>
	<<set _coveryourself to "and cover yourself as best you can.">>
<</if>>
<<if $attitude.nude is "excited" or $uncomfortable.nude is false>>
	You feel a sense of exitement that's even stronger if you don't cover your<<if $exposed is 1>>undressed<<else>>naked<</if>> body.
	<<set $logprep to $logprep+" It was exciting!">>
<<elseif $attitude.nude is "embarrassed" or $uncomfortable.nude is true>>
	You feel intense embarrassment at your exposure _coveryourself
	<<set $logprep to $logprep+" It was embarrassing.">>
<<elseif $attitude.nude is "uncomfortable">>
	You feel uncomfortable at your exposure _coveryourself
<<elseif $attitude.nude is "uncaring">>
<<elseif $attitude.nude is "relaxed">>
	Not caring about your exposure feels freeing.
<<elseif $attitude.nude is "horrible">>
	You feel horrified at your exposure _coveryourself
<</if>>
/*<<if $leftarm is "bound" and $rightarm is "bound">> but with your arms bound you can do nothing to hide your <<if $exposed is 1>>state of undress.<<else>>nakedness.<</if>><<else>> and cover yourself as best you can.<</if>>*/
<<log $logprep $exposureimportance>>
<</nobr>><</widget>>

