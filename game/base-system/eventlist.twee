:: EventList [nobr]
<<initevents>>
<<if $reality is false>>
The memory ends.
  <<setstatsto $realstats>>
<</if>>
<<set $reality to true>>
<<set $endevent to false>>
$reality
<<link [[Back|Bedroom]]>><</link>>
<br><br>
<<print JSON.stringify($seenevents)>>
<br><br>
<<for _i to 0; _i lt $events.length; _i++>>
<<if $seenevents.includes($events[_i]) is true>>
  You have been <<loadevent $events[_i] 1>>
<<else>>
  <<if _spoilme is true>>
    You haven't been <<loadevent $events[_i]>> ($events[_i])
  <</if>>
<</if>>
<br>
The replaying event will end 
<</for>>

:: Eventlist widgets [widget]
/*
There should be some way to keep track of what events you've seen and what not.

Just adding an unique number and a ending number to <<endevent>> for each event seems simple enough but figuring out when should events split and how different should an ending be to get it's own number slow it down more than I like so for now probably not going to bother with adding them.

$events[id].
  id:(same as position in array but having it here should allow sorting)
  endings:[endingnum]=count
  passage:"passagename"(ideally the one linked by a widget that start the event)


*/
<<widget "eventseen">>/* $args[0] is event id and $args[1] is event ending */
  <<set $events[$args[0]].endings[$args[1]].seen += 1>>
  <<switch $args[0]>>
    <<case 122>>

    <<case 123>>
    <<case 124>>
  <</switch>>

<</widget>>

<<widget "addevent">><<nobr>>
/* would loading data from a JSON or YAML file be doable?
  probably but that'd probably be more trouble than I feel like dealing with
  so the question becomes should I just make eventends have some fictional event id and ending number that could then in theory be used by some stuff or should I just not bother or maybe do some shitty version of eventlist that just has the number and the ending?


  So ideally what would a event database have?
  Event id obviously
  Name and/or description would be nice so that you can actually say that you've not seen the so and so events
  Some sort of tags or grouping by location/character or such
  Hint that gets shown only when you haven't seen the event
  Some way to track the paths you've taken through the event or just whether you've seen the result of each choice
    either c1c1c3c2:0, c1c2c3c1:0... or c11:0 c12:0 c13:0 c21:0 c22:0... could work
    having a flag per choice instead of recording the whole path might be better since going "while you have done aadc, abdc and bbdc you haven't actually done badc" wouldn't usually be very useful while going "you've never selected option a as the 3rd option" would be useful.
    so counter for each choice, you've selecte choice 1a 3 times, 2a once 2b once 2c once...
      but really tracking just the ending should be good enough while being a ton easier to do.
  Something else?
  <<run $events.push({endings:[]})>>
*/
<<run $events.push($args[0])>>

<</nobr>><</widget>>

<<widget "loadevent">><<nobr>>
<<switch $args[0]>>
  <<case "DanW1">>
    <<set $eventdescription to "asked to help at a party.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 42>><<startdream>><</link>><</if>>
  <<case "DanW2">>
    <<set $eventdescription to "asked to retrieve something from an attic.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 32>><<startdream>><</link>><</if>>
  <<case "DanW3">>
    <<set $eventdescription to "asked to join someone for a tea.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 22>><<startdream>><</link>><</if>>
  <<case "DanW4">>
    <<set $eventdescription to "asked to weed a garden.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 12>><<startdream>><</link>><</if>>
  <<case "DanW5">>
    <<set $eventdescription to "asked to fill in for a missing tea party guest.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 0>><<startdream>><</link>><</if>>
  <<case "DanW6">>
    <<set $eventdescription to "asked to be a tutor.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 52>><<startdream>><</link>><</if>>
  <<case "DanW7">>
    <<set $eventdescription to "asked to suckle on a breast.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|Danube House Knock]]>><<set $rng to 92>><<startdream>><</link>><</if>>
  <<case "DomW1">>
    <<set $eventdescription to "asd.">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<set $rng to 0>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<set $rng to 0>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<set $rng to 0>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<set $rng to 0>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<startdream>><</link>><</if>>
  <<case "">>
    <<set $eventdescription to ".">>$eventdescription
    <<if $args[1] is 1>><<link [[Recall|]]>><<startdream>><</link>><</if>>
<</switch>>
<</nobr>><</widget>>

<<widget "startdream">><<nobr>>
<<logstats>>
<<set $realstats to $logged>>
<<set $reality to false>>
/*
<<setstatsto $tempstats>>
*/
<</nobr>><</widget>>

<<widget "randomEventHint">><<nobr>>
<<set _randomevent to "">>
<<set _randomevent to either($events)>>
<<for $seenevents.includes(_randomevent) is true>>
  <<set _randomevent to either($events)>>
<</while>>
<<showevent _randomevent>>
You haven't been $eventdescription
<</nobr>><</widget>>


<<widget "initevents">><<nobr>>
  <<addevent "DanW1">>
  <<addevent "DanW2">>
  <<addevent "DanW3">>
