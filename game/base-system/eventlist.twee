  <<case "">>
    <<set $eventdescription to ".">>
    <<if $args[1] is 1>><<link [[Recall|]]>><<startdream>><</link>><</if>>
<</switch>>
<</nobr>><</widget>>

<<widget "startdream">><<nobr>>
<<logstats>>
<<set $realstats to $logged>>
<<set $reality to false>>
