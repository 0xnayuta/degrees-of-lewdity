:: Widgets Stats [widget]

<<widget "trauma">><<nobr>>
	<<if $args[0] or $args[1]>>
		<<if $args[0] gte 0>>
			<<set $trauma += ($args[0] * 3) - (($args[0] * 1.5) * ($control / $controlmax))>>
			<<if $dev is 1>><<set $control -= $args[0]>><</if>>
		<<else>>
			<<set $trauma += ($args[0] * 3) + (($args[0] * 1.5) * ($control / $controlmax))>>
		<</if>>
	<</if>>
	<<if $trauma gte 1>>
		<<set $sleeptrouble to 1>>
	<<else>>
		<<set $sleeptrouble to 0>>
	<</if>>

	<<if $trauma gte ($traumamax / 10) * 1>>
		<<set $nightmares to 1>>
	<<else>>
		<<set $nightmares to 0>>
	<</if>>

	<<if $trauma gte ($traumamax / 10) * 7>>
		<<set $anxiety to 2>>
	<<elseif $trauma gte ($traumamax / 10) * 2>>
		<<set $anxiety to 1>>
	<<else>>
		<<set $anxiety to 0>>
	<</if>>

	<<if $trauma gte ($traumamax / 10) * 8>>
		<<set $flashbacks to 1>>
	<<else>>
		<<set $flashbacks to 0>>
	<</if>>

	<<if $trauma gte ($traumamax / 10) * 6>>
		<<set $panicattacks to 2>>
	<<elseif $trauma gte ($traumamax / 10) * 4>>
		<<set $panicattacks to 1>>
	<<else>>
		<<set $panicattacks to 0>>
	<</if>>

	<<updateHallucinations>>

	<<if $trauma gte $traumamax>>
		<<set $dissociation to 2>>
	<<elseif $trauma gte ($traumamax / 10) * 9>>
		<<set $dissociation to 1>>
	<<else>>
		<<set $dissociation to 0>>
	<</if>>
<</nobr>><</widget>>

<<widget "combattrauma">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gte 0>>
			<<set $trauma += ($args[0] * 1) - (($args[0] * 0.5) * ($control / $controlmax))>>
			<<if $dev is 1>><<set $control -= $args[0]>><</if>>
		<<else>>
			<<set $trauma += ($args[0] * 1) + (($args[0] * 0.5) * ($control / $controlmax))>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "straighttrauma">><<nobr>>
	<<if $args[0]>>
		<<set $trauma += ($args[0] * 1)>>
	<</if>>
<</nobr>><</widget>>

<<widget "updateHallucinations">><<nobr>>
	<<if $trauma gte ($traumamax / 10) * 5 or $awareness gte 400 or $hallucinogen gt 0 or ($moonstate isnot 0 and $daystate is "night")>>
		<<set $hallucinations to 2>>
	<<elseif $trauma gte ($traumamax / 10) * 3 or $awareness gte 300>>
		<<set $hallucinations to 1>>
	<<else>>
		<<set $hallucinations to 0>>
	<</if>>
<</nobr>><</widget>>

<<widget "control">><<nobr>>
	<<if $args[0]>>
		<<set $control += ($args[0] * 10)>>
		<<if $args[0] gte 1>>
			<<set $controlstart += ($args[0] * 10)>>
		<</if>>
		<<if $control gte ($controlmax / 5) * 2>>
			<<set $controlled to 1>>
		<<else>>
			<<set $controlled to 0>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "combatcontrol">><<nobr>>
	<<if $args[0]>>
		<<set $control += ($args[0] * 10)>>
		<<if $control gte $controlstart>>
			<<set $control to $controlstart>>
		<</if>>
		<<if $control gte ($controlmax / 5) * 2>>
			<<set $controlled to 1>>
		<<else>>
			<<set $controlled to 0>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "corruption">><<nobr>>
<<if $args[0]>>
	<<set $corruption_slime += $args[0]>>
<</if>>
<</nobr>><</widget>>

<<widget "semenvolume">><<nobr>>
	<<if $args[0] and $penisexist is 1>>
		<<set $semen_volume += ($args[0] * 3)>>
		<<if $cow gte 6>>
			<<set $semen_volume += ($args[0] * 3)>>
		<</if>>
		<<set $semen_volume = Math.clamp($semen_volume, 0, $semen_max)>>
	<</if>>
<</nobr>><</widget>>

<<widget "milkvolume">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gt 0>>
			<<set $lactation_pressure += 1>>
			<<if $cow gte 6>>
				<<set $lactation_pressure += 1>>
			<</if>>
		<</if>>
		<<if $lactating is 1>>
			<<set $milk_volume += ($args[0] * 2)>>
			<<if $cow gte 6>>
				<<set $milk_volume += ($args[0] * 2)>>
			<</if>>
			<<set $milk_volume = Math.clamp($milk_volume, 24, $milk_max)>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "stress">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gt 0>>
			<<if $drunk gte 480>>
				<<set $stress += ($args[0] * 10)>>
			<<elseif $drunk gte 360>>
				<<set $stress += ($args[0] * 15)>>
			<<elseif $drunk gte 240>>
				<<set $stress += ($args[0] * 20)>>
			<<elseif $drunk gte 120>>
				<<set $stress += ($args[0] * 25)>>
			<<elseif $drunk gte 1>>
				<<set $stress += ($args[0] * 30)>>
			<<else>>
				<<set $stress += ($args[0] * 40)>>
			<</if>>
		<<else>>
			<<set $stress += ($args[0] * 80)>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "arousal">><<nobr>>
	<<if $args[0] gte 0 or $args[0] lt 0>>
		<<set $arousal to Math.clamp($arousal + $args[0], 0, $arousalmax)>>
		<<if $args[0] gte 0>>
			<<if $args[1] is true>>
				<<if $trackedArousal.length gt 4>>
					<<run $trackedArousal.deleteAt(0)>>
				<</if>>
				<<run $trackedArousal.push(0)>>
			<</if>>
			<<set $trackedArousal[$trackedArousal.length - 1] += $args[0]>>
		<</if>>
	<<else>>
		<<if $arousalError is undefined>>
			<<set $arousalError to [$args[0]]>>
		<<elseif $arousalError.length gte 50>>
			<<set $arousalError to [$args[0]]>>
		<<else>>
			<<set $arousalError.push($args[0])>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "breastarousal">><<nobr>>
	<<if $args[0] gte 0 or $args[0] lt 0>>
		<<set $arousal += ($args[0] * $breastsensitivity)>>
		<<if $args[0] gte 0>>
			<<set $trackedArousal[$trackedArousal.length - 1] += $args[0] * $breastsensitivity>>
		<</if>>
	<<else>>
		<<if $arousalError is undefined>>
			<<set $arousalError to [$args[0]]>>
		<<elseif $arousalError.length gte 50>>
			<<set $arousalError to [$args[0]]>>
		<<else>>
			<<set $arousalError.push($args[0])>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "genitalarousal">><<nobr>>
	<<if $args[0] gte 0 or $args[0] lt 0>>
		<<set $arousal += ($args[0] * $genitalsensitivity)>>
		<<if $args[0] gte 0>>
			<<set $trackedArousal[$trackedArousal.length - 1] += $args[0] * $genitalsensitivity>>
		<</if>>
	<<else>>
		<<if $arousalError is undefined>>
			<<set $arousalError to [$args[0]]>>
		<<elseif $arousalError.length gte 50>>
			<<set $arousalError to [$args[0]]>>
		<<else>>
			<<set $arousalError.push($args[0])>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "tiredness">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gt 0>>
			<<set $tiredness += ($args[0] * 15)>>
		<<else>>
			<<set $tiredness += ($args[0] * 20)>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "pain">><<nobr>>
<!-- Including masochism effect for all pain NG v2.7 -->
	<<if $args[0] gte 0 or $args[0] lt 0>>
		<<if $masochism gte 100>>
			<<set $pain += (($args[0] * (1 - ($masochism / 1200))) * 4)>>
			<<set _arousal to (($args[0] * (0 + ($masochism / 24))) * 4)>>
			<<arousal _arousal>>
			<<set $arousalmasochism += ($args[0] * (0 + ($masochism / 14)))>>
		<<else>>
		<<set $pain += ($args[0] * 4)>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "masopain">><<nobr>>
	<<if $args[0]>>
		<<set $pain += (($args[0] * (1 - ($masochism / 1200))) * 4)>>
		<<set _arousal to (($args[0] * (0 + ($masochism / 18))) * 4)>>
		<<arousal _arousal>>
	<</if>>
<</nobr>><</widget>>

<<widget "detention">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gt 0>>
			<<set $detention += ($args[0] * 10)>>
		<</if>>
		<<set $delinquency += ($args[0] * 4)>>
		/*
		Keep track of offense types waiting to be "served" at detention. Could make punishment match the "crimes" by checking if $detentions.x is above 0
		Also set the line to write in detention(some might be impossible to get atm due to getting a worse punishment)
		*/
		<<if $args[1]>>
			<<set _s to $args[1].replace(/ /g,'')>>/*removes spaces*/
			<<set $detentions[_s] += 1>>/* could be $detentions._s if it wouldn't use _s itself instead of it's value */
			<<set _oldline to clone($detentionline)>>/* dunno if clone is necessary */
			<<switch $args[1]>>
				<<case "Wrong changing room">>
					<<if $player.gender is "f">>
						<<set $detentionline to either("I won't enter the boy's changing room,","I won't peep into boy's changing room,","I will use the correct changing room,")>>
					<<elseif $player.gender is "m">>
						<<set $detentionline to either("I won't enter the girl's changing room,","I won't peep into girl's changing room,","I will use the correct changing room,")>>
					<<else>>
						<<set $detentionline to either("I will use the correct changing room,")>>
					<</if>>
				<<case "Bus indecency">>
					<<set $detentionline to either("I will not ride the bus without proper clothing,","I will be properly clothed when riding the bus,")>>
				<<case "Indecency">>
					<<set $detentionline to either("I will wear proper clothing during school,","I will be properly clothed in school,","I won't dress indecently in school,")>>
				<<case "Tardiness">>
					<<set $detentionline to either("I will arrive to classes in time from now on,","I will be in time for my classes,","I won't be late to class.")>>
				<<case "Interrupt">>
					<<set $detentionline to either("I won't interrupt other classes,","I won't disturb other classes,","I will go only to the classes I have.")>>
				<<case "Mock">>
					<<set $detentionline to either("I won't mock teachers,","I won't make fun of my teachers,","I will be polite to my teachers,","I will show only utmost respect and politeness to all of my teachers,")>>
				<<case "Fighting">>
					<<set $detentionline to either("I won't assault other students,","I won't fight with other students,","I won't attack other students,","I will avoid being violent from now on,")>>
				<<case "Lewdity">>
					<<set $detentionline to either("I won't perform indecent acts at school,","I won't do sexual acts at school,")>>
				<<case "Vandalism">>
					<<set $detentionline to either("I won't damage or dirty school property,","I won't willfully destroy school property or cause a mess,","I will avoid damaging or dirtying school property,","I won't vandalise things at school,")>>
				<<case "Disobedience">>
					<<set $detentionline to either("I won't disobey instructions,","I will listen to my teachers,")>>
				<<case "Harass">>
					<<set $detentionline to either("I won't harass other students,","I won't bully other students,")>>
				<<case "Truancy">>
					<<set $detentionline to either("I won't skip classes without a reason,","I will attend all of my classes,")>>
				<<case "Detention avoidance">>
					<<set $detentionline to either("I won't try to avoid my punishments,","I will willingly attend my detentions,")>>
				<<case "Theft">>
					<<set $detentionline to either("I won't try to steal,","I will respect other people's property,")>>
				<<case "Bothering">>
					<<set $detentionline to either("I won't bother teachers pointlessly,","I will respect other people's time and won't bother them unnecessarily,","I won't waste teacher's time with inane things,")>>
				<<case "Assault">>
					<<set $detentionline to either("I won't attack teachers,","I won't act violently towards teachers,","I won't try to injure teachers")>>
				<<case "Disturbance">>
					<<set $detentionline to either("I won't disturb the class,","I will behave during class,")>>
				<<case "Lying">>
					<<set $detentionline to either("I won't tell lies,","I will tell the truth when asked,","I will answer honestly,")>>
				<<case "Laziness">>
					<<set $detentionline to either("I won't lollygag,","I won't be lazy,","I will do my best in any tasks that I receive,")>>
				<<case "Dress">>
					<<set $detentionline to either("I won't wear clothes or accessories not meant for school,","I will dress properly,","I won't dress strangely,")>>
			<</switch>>
			<<if _oldline isnot "">>
				<<set $detentionline to either($detentionline,_oldline)>>/*  */
			<</if>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "detentiondone">><<nobr>>
<<set $detention to 0>>
/* Move stuff from detentions{} to detentionstotal{} */
<<for _i to 0;$detentiontypes.length gt _i;_i++>>
	<<set $detentionstotal[$detentiontypes[_i]] += $detentions[$detentiontypes[_i]]>>
	<<set $detentions[$detentiontypes[_i]] to 0>>
<</for>>

<<set $detentionline to "">>

<</nobr>><</widget>>


<<widget "status">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gt 0>>
			<<set $cool += ($args[0] * 1)>>
			<<if $worn.face.type.includes("cool")>>
				<<set $cool += ($args[0] * 1)>>
			<</if>>
			<<if $worn.head.type.includes("cool")>>
				<<set $cool += ($args[0] * 1)>>
			<</if>>
			<<if $worn.upper.type.includes("cool")>>
				<<set $cool += ($args[0] * 1)>>
			<</if>>
		<<elseif $args[0] lt 0>>
			<<set $cool *= (1 - ($args[0] / -100))>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "spray">><<nobr>>
	<<if $args[0]>>
		<<if $args[0] gte 0>>
			<<set $spray += $args[0]>>
			<<set $spray to Math.clamp($spray, 0, $spraymax)>>
		<<else>>
			<<if $infinitespray is 1>>
			<<else>>
				<<set $spray += $args[0]>>
				<<set $spray to Math.clamp($spray, 0, $spraymax)>>
			<</if>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "awareness">><<nobr>>
	<<if $args[0]>>
		<<set $awareness += ($args[0])>>
		<<for _e to 0; _e lt $clothing_number; _e++>>
		<<activeclothes>>
			<<if $worn[_active_clothes].type.includes("dark")>>
				<<set $awareness += ($args[0])>>
			<</if>>
		<</for>>
	<</if>>
<</nobr>><</widget>>

<<widget "purity">><<nobr>>
	<<if $args[0]>>
		<<set $purity += ($args[0])>>
		<<for _e to 0; _e lt $clothing_number; _e++>>
		<<activeclothes>>
			<<if $worn[_active_clothes].type.includes("holy")>>
				<<set $purity += ($args[0])>>
			<</if>>
		<</for>>
	<</if>>
<</nobr>><</widget>>

<<widget "suspicion">><<nobr>>
	<<if $args[0]>>
		<<set $suspicion += ($args[0])>>
	<</if>>
<</nobr>><</widget>>

<<widget "asylumstatus">><<nobr>>
	<<if $args[0]>>
		<<set $asylumstatus += ($args[0] * 1)>>
	<</if>>
<</nobr>><</widget>>

<<widget "humiliation10">><<nobr>>
	<<set $stress += 40>>
	<<trauma 1>>
<</nobr>><</widget>>

<<widget "wolfpacktrust">><<nobr>>
	<<set $wolfpacktrust += 1>>
	<span class="green">The pack trusts you a little more.</span>
<</nobr>><</widget>>

<<widget "wolfpackfear">><<nobr>>
	<<set $wolfpackfear += 1>>
	<span class="green">The pack fears you a little more.</span>
<</nobr>><</widget>>

<<widget "gferocity">><<nobr>>
	<<set $wolfpackferocity += 1>>
	| <span class="blue">+ Ferocity</span>
<</nobr>><</widget>>

<<widget "gharmony">><<nobr>>
	<<set $wolfpackharmony += 1>>
	| <span class="lblue">+ Harmony</span>
<</nobr>><</widget>>

<<widget "lferocity">><<nobr>>
	<<set $wolfpackferocity -= 1>>
	| <span class="purple">- Ferocity</span>
<</nobr>><</widget>>

<<widget "lharmony">><<nobr>>
	<<set $wolfpackharmony -= 1>>
	| <span class="pink">- Harmony</span>
<</nobr>><</widget>>

<<widget "sub">><<nobr>>
	<<if $args[0]>>
		<<set $submissive += ($args[0] * 5)>>
	<</if>>
<</nobr>><</widget>>

<<widget "def">><<nobr>>
	<<if $args[0]>>
		<<set $submissive -= ($args[0] * 5)>>
	<</if>>
<</nobr>><</widget>>

<<widget "incgpenisinsecurity">><<nobr>>
	<<set _n to 10>>
	<<if $args[0] and typeof($args[0]) is "number">> <<set _n to $args[0]>> <</if>>
	<<switch $penissize>>
		<<case 4>>
			<<insecurity "penis_big" _n>><<ginsecurity "penis_big">>
		<<case 1>>
			<<insecurity "penis_small" _n>><<ginsecurity "penis_small">>
		<<case 0>>
			<<insecurity "penis_tiny" _n>><<ginsecurity "penis_tiny">>
		<<case -1>>
			<<insecurity "penis_tiny" _n>><<ginsecurity "penis_tiny">>
	<</switch>>
<</nobr>><</widget>>

<<widget "incggpenisinsecurity">><<nobr>>
	<<incgpenisinsecurity 20>>
<</nobr>><</widget>>

<<widget "insecurity">><<nobr>>
	<<if $args[0] is "penis_tiny" and $acceptance_penis_tiny lte 999>>
		<<if $args[1] and $penisexist is 1>>
			<<set $insecurity_penis_tiny += ($args[1] * 10)>>
			<<set $insecurity_penis_tiny = Math.clamp($insecurity_penis_tiny, 0, 1000)>>
			<<if $insecurity_penis_tiny gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_penis_tiny gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_penis_tiny gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_penis_tiny gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_penis_tiny gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<<elseif $args[0] is "penis_small" and $acceptance_penis_small lte 999>>
		<<if $args[1] and $penisexist is 1>>
			<<set $insecurity_penis_small += ($args[1] * 10)>>
			<<set $insecurity_penis_small = Math.clamp($insecurity_penis_small, 0, 1000)>>
			<<if $insecurity_penis_small gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_penis_small gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_penis_small gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_penis_small gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_penis_small gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<<elseif $args[0] is "penis_big" and $acceptance_penis_big lte 999>>
		<<if $args[1] and $penisexist is 1>>
			<<set $insecurity_penis_big += ($args[1] * 10)>>
			<<set $insecurity_penis_big = Math.clamp($insecurity_penis_big, 0, 1000)>>
			<<if $insecurity_penis_big gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_penis_big gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_penis_big gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_penis_big gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_penis_big gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<<elseif $args[0] is "breasts_tiny" and $player.gender is "f" and $acceptance_breasts_tiny lte 999>>
		<<if $args[1]>>
			<<set $insecurity_breasts_tiny += ($args[1] * 10)>>
			<<set $insecurity_breasts_tiny = Math.clamp($insecurity_breasts_tiny, 0, 1000)>>
			<<if $insecurity_breasts_tiny gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_breasts_tiny gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_breasts_tiny gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_breasts_tiny gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_breasts_tiny gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<<elseif $args[0] is "breasts_small" and $acceptance_breasts_small lte 999>>
		<<if $args[1]>>
			<<set $insecurity_breasts_small += ($args[1] * 10)>>
			<<set $insecurity_breasts_small = Math.clamp($insecurity_breasts_small, 0, 1000)>>
			<<if $insecurity_breasts_small gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_breasts_small gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_breasts_small gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_breasts_small gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_breasts_small gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<<elseif $args[0] is "breasts_big" and $acceptance_breasts_big lte 999>>
		<<if $args[1]>>
			<<set $insecurity_breasts_big += ($args[1] * 10)>>
			<<set $insecurity_breasts_big = Math.clamp($insecurity_breasts_big, 0, 1000)>>
			<<if $insecurity_breasts_big gte 1000>>
				<<stress 3>><<control -3>>
			<<elseif $insecurity_breasts_big gte 800>>
				<<stress 3>><<control -2>>
			<<elseif $insecurity_breasts_big gte 600>>
				<<stress 2>><<control -2>>
			<<elseif $insecurity_breasts_big gte 400>>
				<<stress 2>><<control -1>>
			<<elseif $insecurity_breasts_big gte 200>>
				<<stress 1>><<control -1>>
			<<else>>
				<<stress 1>>
			<</if>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "acceptance">><<nobr>>
	<<if $args[0] is "penis_tiny">>
		<<if $args[1]>>
			<<set $acceptance_penis_tiny += ($args[1] * 6)>>
			<<set $acceptance_penis_tiny = Math.clamp($acceptance_penis_tiny, 0, 1000)>>
		<</if>>
	<<elseif $args[0] is "penis_small">>
		<<if $args[1]>>
			<<set $acceptance_penis_small += ($args[1] * 6)>>
			<<set $acceptance_penis_small = Math.clamp($acceptance_penis_small, 0, 1000)>>
		<</if>>
	<<elseif $args[0] is "penis_big">>
		<<if $args[1]>>
			<<set $acceptance_penis_big += ($args[1] * 6)>>
			<<set $acceptance_penis_big = Math.clamp($acceptance_penis_big, 0, 1000)>>
		<</if>>
	<<elseif $args[0] is "breasts_tiny">>
		<<if $args[1]>>
			<<set $acceptance_breasts_tiny += ($args[1] * 6)>>
			<<set $acceptance_breasts_tiny = Math.clamp($acceptance_breasts_tiny, 0, 1000)>>
		<</if>>
	<<elseif $args[0] is "breasts_small">>
		<<if $args[1]>>
			<<set $acceptance_breasts_small += ($args[1] * 6)>>
			<<set $acceptance_breasts_small = Math.clamp($acceptance_breasts_small, 0, 1000)>>
		<</if>>
	<<elseif $args[0] is "breasts_big">>
		<<if $args[1]>>
			<<set $acceptance_breasts_big += ($args[1] * 6)>>
			<<set $acceptance_breasts_big = Math.clamp($acceptance_breasts_big, 0, 1000)>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "willpower">><<nobr>>
	<<if $args[0]>>
		<<set $willpower += $args[0]>>
	<</if>>
	<<set $willpower = Math.clamp($willpower, 0, $willpowermax)>>
<</nobr>><</widget>>

<<widget "hope">><<nobr>>
<<if $args[0]>>
<<set $orphan_hope += ($args[0] * 2)>>
<</if>>
<</nobr>><</widget>>

<<widget "reb">><<nobr>>
<<if $args[0]>>
<<set $orphan_reb += ($args[0] * 2)>>
<</if>>
<</nobr>><</widget>>

<<widget "grace">><<nobr>>/*Optional second variable is the rank of the NPC giving the order. Grace changes won't apply if the player's rank equals or exceeds the NPC's.*/
<<if $args[0]>>
	<<if $args[1] is "monk">>
		<<if $temple_rank is "initiate">>
			<<set $grace += $args[0]>>
			<<set $grace = Math.clamp($grace, -100, 100)>>
		<<else>>
		<</if>>
	<<elseif $args[1] is "priest">>
		<<if $temple_rank is "initiate" or $temple_rank is "monk">>
			<<set $grace += $args[0]>>
			<<set $grace = Math.clamp($grace, -100, 100)>>
		<<else>>
		<</if>>
	<<elseif $args[1] is "bishop">>
		<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
			<<set $grace += $args[0]>>
			<<set $grace = Math.clamp($grace, -100, 100)>>
		<<else>>
		<</if>>
	<<else>>
		<<set $grace += $args[0]>>
		<<set $grace = Math.clamp($grace, -100, 100)>>
	<</if>>
<</if>>
<</nobr>><</widget>>

<<widget "livestock_obey">><<nobr>>
	<<if $args[0]>>
		<<set $livestock_obey += $args[0]>>
		<<set $livestock_obey = Math.clamp($livestock_obey, 0, 100)>>
	<</if>>
<</nobr>><</widget>>

<<widget "shame">><<nobr>>
<<if $args[0]>>
	<<set $shame += $args[0]>>
	<<set $shame = Math.clamp($shame, 0, 100)>>
<</if>>
<</nobr>><</widget>>

/**/

<<widget "smell">><<nobr>>/* add(or set with $args[2]="set") 1 or $args[1] to smell($args[0]) and sort smells */
/* $smells probably shouldn't usually be changed without using this */
<<if $args[1] isnot undefined>><<set _amount to $args[1]>><<else>><<set _amount to 1>><</if>>
<<for _i to 0; _i lt $smells.length; _i++ >>
	<<if $smells[_i].includes($args[0])>>
		<<if $args[2] isnot "set">>
			<<set $smells[_i][1] += _amount>>
			<<if $dev is 1 and $worn[Object.keys($worn)[_type]] isnot undefined>>/* add smells to clothes? */
				/* not when setting since goo and semen or anything else that for now just sets the smell level probably wouldn't work nicely with clothing */
				<<for _clothingtype to 0 ; _clothingtype lt Object.keys($worn).length ; _clothingtype++>>/*  */
					<<if !$worn[Object.keys($worn)[_type]].type.includes("naked")>>
						<<set $worn[Object.keys($worn)[_type]]["smell"][$args[0]][1] += _amount>>
					<</if>>
				<</for>>
			<</if>>
		<<else>>
			<<set $smells[_i][1] to _amount>>
		<</if>>
		<<set _found to true>>
	<</if>>
<</for>>
<<if _found isnot true>>
	<<print "<br>Error, "+$args[0]+" isn't a valid smell name(new smell types can be added by adjusting widget \"cleansmells\").<br>">>
	/* this could instead of an error add a new smell to $smells but that would mean typos and such wouldn't get caught as easily */
<</if>>
/* add smell to clothes? */
<<if $args[2] isnot "set" and $dev is 1 and $worn[Object.keys($worn)[_type]] isnot undefined>>
	/* not when setting since goo and semen or anything else that for now just sets the smell level probably wouldn't work nicely with clothes */
	<<for _clothingtype to 0 ; _clothingtype lt Object.keys($worn).length ; _clothingtype++>>/*  */
		<<if !$worn[Object.keys($worn)[_type]].type.includes("naked")>>
			/* should clothing smell variable be just an object or should it also be an array that gets sorted based on smell strength? */
			<<set $worn[Object.keys($worn)[_type]]["smell"][$args[0]] += _amount>>
			<<set $worn[Object.keys($worn)[_type]]["smell"][_clothsmellid][1] += _amount>>
		<</if>>
	<</for>>
<</if>>
<<run $smells.sort(function(a,b){return b[1] - a[1];}) >>/* sort smells so that strongest come first, see https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/sort */

<</nobr>><</widget>><<widget "reducesmells">><<nobr>>/* reduce all smells equally(called by at least "hour" widget ) */

<<if $args[1]>><<set _amount to $args[1]>><<else>><<set _amount to 0.1>><</if>>
<<for _i to 0; _i lt $smells.length; _i++ >>
	<<if $smells[_i][1] gt 0>>
		<<set $smells[_i][1] -= _amount>>
	<</if>>
<</for>>

<</nobr>><</widget>><<widget "cleansmells">><<nobr>>/* also used for init */

<<set $smells to [["soap", 0], ["semen", 0], ["slime", 0], ["trash", 0], ["sweat", 0], ["forest", 0], ["piss", 0], ["alcohol", 0], ["perfume", 0], ["blood", 0], ["salt", 0], ["chlorine", 0]]>>
/*
for now unused smells: perfume, blood, salt, chlorine
potential smells: animals/fur/wolves, incense, smoke/fire/burnt, sweets/sugar
*/

/*
<<set $smells to {soap:0, semen:0, slime:0, trash:0, sweat:0, plants:0, piss:0, alcohol:0, perfume:0, blood:0, salt:0, chlorine:0}>>
<<set $smells to {}>>
soap
semen
slime
trash
sweat
forest
piss
alcohol
perfume
blood
salt
chlorine
*/


<</nobr>><</widget>>

<<widget "exposureeffect">><<nobr>>
based on $attitude figure out appropriate stat changes

<!-- Stat effects that being seen nude or very exposed should have based on attitude to such things. -->
<!-- $args[0] is the event type, nude or underwear  -->
<!-- $args[1] is the event intensity, should roughly be equal to expected stat gain  -->
<!-- $args[2] might be for "good", "bad" or "ok" making the effect lean one way or another -->
<<if $args[0] is "nude" or $args[0] is "underwear">>
	<<set _attitude to $attitude[$args[0]]>>
<<else>>
	<<run console.log("ERROR" + $args[0] + " is not a valid event type for widget \"exposureeffect\"! Should be \"nude\" or \"underwear\".")>>
<</if>>
<<if $args[1]>>
	
	<<switch _attitude>>
	<<case "excited">>
		<<arousal _effect1*100>>
	<<case "embarrassed">>
		<<arousal _effect2*100>>
		<<stress _effect2>>
	<<case "uncaring">>
	<<case "relaxed">>
		<<stress -_effect1>>
	<<case "horrible">>
		<<stress _effect2>>
		<<trauma _effect1>>
	<<case "uncaring">>
	<</switch>>
<</if>>

/**/<</nobr>><</widget>>
