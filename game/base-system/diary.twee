    <<link [[2|Diary Edit]]>><<logimportance $diarypage $diaryline 2>><</link>>
    <<link [[3|Diary Edit]]>><<logimportance $diarypage $diaryline 3>><</link>>
    <<link [[4|Diary Edit]]>><<logimportance $diarypage $diaryline 4>><</link>>
    <<link [[5|Diary Edit]]>><<logimportance $diarypage $diaryline 5>><</link>>)
    

$reality

