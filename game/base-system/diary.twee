    <<if $diarymode is 1>>
      Day:
      <<for _i to 0 ; _i lte $logday ; _i++>>
      <<capture _i>>/* prevents all of the links setting $diarypage to the last value _i was*/
      <<link [[_i|Diary Edit]]>><<set $diarypage to _i>> <</link>>
      <</capture>>
