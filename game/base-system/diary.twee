/*
$diary has a "page" for each day and each page has a number of entries with time, text, opinion/comment, importance and effects
so you access entry text with $diary[daynumber][entrynumber].text
.timestamp is simply $time
.text is the diary entry that describes what exactly happened in 1st person
.importance allows filtering out simply moving around and such and is used to decide how to color the text
.comment is a string the player can input, set $diaryprompts to 1 or 2 to be asked for comment whenever an event is done
.opinion (could be about) how you feel about an event and how you've chosen to rationalize it or just the default comment
.effects list some stat changes like money since the last time log widget was used.

to make this work time.twee has a thing that pushes a new day/page into existence at the start of each day, it also reports the date and stat changes of the day
other than that and this there are some widgets at the bottom of widgets.twee and initStory and Start2() from init.twee are used to initialize everything.
And finally nearly all events would ideally have the following bit near the end:

<<log "" 3>>
<<logopinion "">>

1st "" being filled with diary entry and 3 beig the importance of event
logopinion could have various opinions about the event split into different $args[] with $diaryprompts 2 or 3 events ask you to pick between them whenever they end

for more complex events usage of $logprep to change entry text based on choices made earlier is useful:

<<set $logprep to "">>

<<set $logprep to ""+$logprep>>
<<log $logprep 3>>
<<logopinion "">>

Also if it's really necessary <<logedit>> and <<logediteffect>> can also be used to change the last entry
for example if you want to have logopinion but there's still a choice with all options ending the event and putting you on street or something.

*/

:: Simple Diary[nobr]
<<back>>
<<for _i, _day range $diary>>
  <br>
  <<for _j, _entry range $diary[_i]>>
    _entry.text
    _entry.comment
    <br>
  <</for>>
<</for>>

:: Diary [nobr]
<<if $canwrite is 1>><<return>><<else>><<back>><</if>>
<<if $canwrite is 1>>
 | <<link [[Show all days|Diary]]>><<set $diarymode to 0>><</link>> filter: <<link [["<"|Diary]]>><<set $diaryfilterB-->><</link>> $diaryfilterB <<link [[">"|Diary]]>><<set $diaryfilterB++>><</link>> 
 | <<set $menu to 1>> <<link [[Show 1 day|Diary]]>><<set $diarymode to 1>><</link>> filter: <<link [["<"|Diary]]>><<set $diaryfilterA-->><</link>> $diaryfilterA <<link [[">"|Diary]]>><<set $diaryfilterA++>><</link>>
 | <<if $logshowcomments is 1>><<link [[Hide|Diary]]>><<set $logshowcomments to 0>><</link>><<else>><<link [[Show|Diary]]>><<set $logshowcomments to 1>><</link>><</if>> comments
<<if $debug is 1>> | <<if $logshowops is 1>><<link [[Hide|Diary]]>><<set $logshowops to 0>><</link>><<else>><<link [[Show|Diary]]>><<set $logshowops to 1>><</link>><</if>> opinions<</if>>
<br>
/*
lists and makes selectable all days
capture _i prevents all of the links setting $diarypage to the last value _i was
could make a year selector since this will probably get annoyingly long after a year or two.
yearlog would probably be an array and use .push($diary) at the end of year before emptying $diary.
compressing or exporting old entries could be a thing
*/
<<if $diarymode is 0>>
  Day:
  <<for _i to 0; _i lte $days; _i++>>
  <<capture _i>>
  <<link [[_i|Diary]]>><<set $diarypage to _i>> <</link>>
  <</capture>>
  <</for>>
<</if>>

<</if>><br>

<<if $canwrite is 1>>
/* originally I was thinking players could add entries on their own but that didn't seem as useful as just adding comments to existing ones */
Change entry $diaryline of day $diarypage's <<link [[comment|Diary]]>><<logcomment $diarypage $diaryline $entry>><</link>><<textbox "$entry" "" >>
or importance(from <<print $diary[$diarypage][$diaryline].importance>> to /* Should I somehow protect entries with above 5 importance? Someone might change them and regret not being able to restore them */
<<link [[0|Diary]]>><<logimportance $diarypage $diaryline 0>><</link>>
<<link [[1|Diary]]>><<logimportance $diarypage $diaryline 1>><</link>>
<<link [[2|Diary]]>><<logimportance $diarypage $diaryline 2>><</link>>
<<link [[3|Diary]]>><<logimportance $diarypage $diaryline 3>><</link>>
<<link [[4|Diary]]>><<logimportance $diarypage $diaryline 4>><</link>>
<<link [[5|Diary]]>><<logimportance $diarypage $diaryline 5>><</link>>)
<<else>>
You aren't in a good spot(such as your bedroom) to edit your diary.
<</if>>


<<if $diarymode is 1>> /* single day mode */
  <<for _i, _entry range $diary[$diarypage]>>
  <<capture _i>>
  <<if _entry.importance gte $diaryfilterA >><br>
    <<if $canwrite is 1>><<link [[■|Diary]]>><<set $diaryline to _i>><</link>><</if>>
    <<if _i gt 1>><<print Math.floor($diary[$diarypage][_i].timestamp / 60).toString().padStart(2, "0")>>:<<print ($diary[$diarypage][_i].timestamp % 60).toString().padStart(2, "0")>><</if>>
    <<if _entry.importance lte 0 >>
      <span class="black">_entry.text </span>
    <<elseif _entry.importance is 1 >>
      <span class="grey">_entry.text </span>
    <<elseif _entry.importance is 2 >>
      <span class="blue">_entry.text </span>
    <<elseif _entry.importance is 3 >>
      <span class="lblue">_entry.text </span>
    <<elseif _entry.importance is 4 >>
      <span class="teal">_entry.text </span>
    <<elseif _entry.importance is 5 >>
      <span class="green">_entry.text </span>
    <<elseif _entry.importance is 8 >> /* virginity loss */
      <span class="red">_entry.text </span>
    <<else>>
      _entry.text
    <</if>>
    <<if _entry.effect.money isnot 0>>
      <<if _entry.effect.money lt 0>><span class="red">-£<<print Math.abs(Math.trunc(_entry.effect.money / 100))>>.<<if _entry.effect.money % 100 lte 9>>0<</if>><<print _entry.effect.money % 100>></span><</if>>
      <<if _entry.effect.money gt 0>><span class="gold">£<<print Math.trunc(_entry.effect.money / 100)>>.<<if _entry.effect.money % 100 lte 9>>0<</if>><<print _entry.effect.money % 100>></span><</if>>
    <</if>>
    <<if $logdebug is 1>>
      <<if _entry.effect.pain isnot 0>>p:_entry.effect.pain<</if>>
      <<if _entry.effect.arousal isnot 0>>a:_entry.effect.arousal<</if>>
      <<if _entry.effect.tired isnot 0>>f:_entry.effect.tired<</if>>
      <<if _entry.effect.stress isnot 0>>s:_entry.effect.stress<</if>>
      <<if _entry.effect.trauma isnot 0>>t:_entry.effect.trauma<</if>>
      <<if _entry.effect.inno isnot 0>>i:_entry.effect.inno<</if>>
      <<if _entry.effect.control isnot 0>>c:_entry.effect.control<</if>>
      <<if _entry.effect.allure isnot 0>>b:_entry.effect.allure<</if>>
    <</if>>
    <<if $logshowcomments is 1>><span class="purple">_entry.comment</span><</if>>
    <<if $logshowops is 1>><span class="meek">_entry.opinion</span><</if>>
  <</if>>
  <</capture>>
  <</for>>
<<else>> /* all days mode */
  <<run $diary.reverse()>>
  <<for _i, _day range $diary>>
    <br> /*  */
    <<for _j, _entry range $diary[_i]>>
    <<capture _i, _j>>
    <<if _entry.importance gte $diaryfilterB >><br>
      <<if $canwrite is 1>><<link [[■|Diary]]>><<set $diarypage to $days-_i>><<set $diaryline to _j>><</link>><</if>> /* $days-_i prevents reversed day order from messing things up */
      <<if _j gt 1>><<print Math.floor($diary[_i][_j].timestamp / 60).toString().padStart(2, "0")>>:<<print ($diary[_i][_j].timestamp % 60).toString().padStart(2, "0")>><</if>>
      <<if _entry.importance lte 0 >>
        <span class="black">_entry.text </span>
      <<elseif _entry.importance is 1 >>
        <span class="grey">_entry.text </span>
      <<elseif _entry.importance is 2 >>
        <span class="blue">_entry.text </span>
      <<elseif _entry.importance is 3 >>
        <span class="lblue">_entry.text </span>
      <<elseif _entry.importance is 4 >>
        <span class="teal">_entry.text </span>
      <<elseif _entry.importance is 5 >>
        <span class="green">_entry.text </span>
      <<elseif _entry.importance is 6 >>
        <span class="orange">_entry.text </span>
      <<elseif _entry.importance is 7 >>/* for date and end/start of day report that colors stuff on it's own */
        _entry.text
      <<elseif _entry.importance is 8 >> /* virginity loss */
        <span class="red">_entry.text </span>
      <<elseif _entry.importance is 9 >> /* not sure, transformations? */
        <span class="gold">_entry.text </span>
      <<else>>
        _entry.text
      <</if>>
      <<if _entry.effect.money isnot 0>>
        <<if _entry.effect.money lt 0>><span class="red">-£<<print Math.abs(Math.trunc(_entry.effect.money / 100))>>.<<if _entry.effect.money % 100 lte 9>>0<</if>><<print _entry.effect.money % 100>></span><</if>>
        <<if _entry.effect.money gt 0>><span class="gold">£<<print Math.trunc(_entry.effect.money / 100)>>.<<if _entry.effect.money % 100 lte 9>>0<</if>><<print _entry.effect.money % 100>></span><</if>>
      <</if>>
      <<if $logdebug is 1>>
        <<if _entry.effect.pain isnot 0>>p:_entry.effect.pain<</if>>
        <<if _entry.effect.arousal isnot 0>>a:_entry.effect.arousal<</if>>
        <<if _entry.effect.tired isnot 0>>f:_entry.effect.tired<</if>>
        <<if _entry.effect.stress isnot 0>>s:_entry.effect.stress<</if>>
        <<if _entry.effect.trauma isnot 0>>t:_entry.effect.trauma<</if>>
        <<if _entry.effect.inno isnot 0>>i:_entry.effect.inno<</if>>
        <<if _entry.effect.control isnot 0>>c:_entry.effect.control<</if>>
        <<if _entry.effect.allure isnot 0>>b:_entry.effect.allure<</if>>
      <</if>>
      <<if $logshowcomments is 1>><span class="purple">_entry.comment</span><</if>>
      <<if $logshowops is 1>><span class="meek">_entry.opinion</span><</if>>
      /* the display might be a bit too busy with too many things demanding your attention so tried making it simpler with ■'s revealing extra details but that's just annoying, either hide all extra details or show them without needing to do crap
      <<if _entry.effect.money isnot 0>>
        <<if $diary[_i][_j].effect.money lt 0>><<linkappend "■ ">><<set $diarypage to _i>><<set $diaryline to _j>><span class="red">-£<<print Math.abs(Math.trunc($diary[_i][_j].effect.money / 100))>>.<<if $diary[_i][_j].effect.money % 100 lte 9>>0<</if>><<print $diary[_i][_j].effect.money % 100>></span> </span><span class="purple">_entry.comment</span><</linkappend>><</if>>
        <<if $diary[_i][_j].effect.money gt 0>><<linkappend "■ ">><<set $diarypage to _i>><<set $diaryline to _j>><span class="gold">£<<print Math.trunc($diary[_i][_j].effect.money / 100)>>.<<if $diary[_i][_j].effect.money % 100 lte 9>>0<</if>><<print $diary[_i][_j].effect.money % 100>></span> <span class="purple">_entry.comment</span><</linkappend>><</if>>
      <</if>>
      */
    <</if>>
    <</capture>>
    <</for>>
  <</for>>
  <<run $diary.reverse()>>
<</if>>
<br><br>
$innocencestate
<br>

<<set $rngvalues to []>>
<<set $rngpregen to 1>>
<<initrng>>
$rngvalues
