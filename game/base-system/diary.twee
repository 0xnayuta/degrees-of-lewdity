  <<capture _i>>
  <<if _entry[$logpars.importance] gte $diaryfilterA >>
    <<filteredentriesinfo>>
    <br>
    <<link [[■|Diary Edit]]>><<set $diaryline to _i>><</link>>
    <<if _i gt 1>><<print Math.floor($diary[$diarypage][_i][$logpars.time] / 60).toString().padStart(2, "0")>>:<<print ($diary[$diarypage][_i][$logpars.time] % 60).toString().padStart(2, "0")>><</if>>
    <<showdiaryentry $diarypage _i>>
  <<else>>
    <<set _hiddenentries += 1>>
    <<set _hiddenentriestotal += 1>>
    <<dontshowdiaryentry $diarypage _i>>
  <</if>>
  <</capture>>
  <</for>>
<<else>> /* all days mode */
  <<run $diary.reverse()>>/* show current day first */
  <<for _i, _day range $diary>>
    <br> /*  */
    <<for _j, _entry range $diary[_i]>>
    <<capture _i, _j>>
    <<if _entry[$logpars.importance] gte $diaryfilterB >>
      <<filteredentriesinfo>>
      <br>
      <<link [[■|Diary Edit]]>><<set $diarypage to $logday-_i>><<set $diaryline to _j>><</link>> /* $logday-_i prevents reversed day order from messing things up */
      <<if _j gt 1>><<print Math.floor($diary[_i][_j][$logpars.time] / 60).toString().padStart(2, "0")>>:<<print ($diary[_i][_j][$logpars.time] % 60).toString().padStart(2, "0")>><</if>>
      <<showdiaryentry _i _j>>
    <<else>>
      <<set _hiddenentries += 1>>
      <<set _hiddenentriestotal += 1>>
      <<dontshowdiaryentry _i _j>>
    <</if>>
    <</capture>>
    <</for>>
  <</for>>
  <<run $diary.reverse()>>
<</if>>
<<filteredentriesinfo>>
<br><br>
<<if _hiddenentriestotal gte 1>>
  <span class="black">(_hiddenentriestotal entries filtered out in total)
  <<if $diaryinsertfilterinfo is 0 and $diaryfiltersum isnot {}>>
