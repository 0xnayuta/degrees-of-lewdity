	style="fill:none;stroke:white;stroke-width:3" />
</svg> 

<br><br>


<<for _tday, _day range $log>>
	Day _tday
	<br>
	<<for _tline, _entry range $log[_tday]>>
		<<if _entry[$logpars.written] is true>> 
			<<set _entry[$logpars.written] to 2>>
		<<elseif _entry[$logpars.written] is false>> 
			<<set _entry[$logpars.written] to 0>>
		<</if>>
	<</for>>
<</for>>
<br>

Testing:
<<print JSON.stringify($logged)>>

<<set $ploo to "panties->chastity belt">>
<<print $ploo.split("->")[1]>>

<<set _blarg to Object.keys($logged)>>
_blarg

<<set _testi to {}>>
<<set _testi[$logpars.stats] to {}>>

<<set _i to 1>>
<<set $logged[_i] to 123>>
<<set $oldlogged[_i] to 126>>
<<set _testi[$logpars.stats][$statlist[_i]+"value"] to ($logged[_i])>>
<<set _testi[$logpars.stats][$statlist[_i]] to ($logged[_i] - $oldlogged[_i])>>
<<print _testi[$logpars.stats]["stress"] >>
<<print _testi[$logpars.stats]["stressvalue"]>>

<br>


/*


*/
<</if>>


:: Diary [widget]
<<widget "diary">><<nobr>>
