<<widget "someones">><<nobr>>
<<if $enemyno gte 2 and $enemytype is "man">>
	<<set $rng to random(1, $enemyno)>>
	<<if $rng is 1>>
	<<his1>>
	<<elseif $rng is 2>>
	<<his2>>
	<<elseif $rng is 3>>
	<<his3>>
	<<elseif $rng is 4>>
	<<his4>>
	<<elseif $rng is 5>>
	<<his5>>
	<<elseif $rng is 6>>
	<<his6>>
	<</if>>
<<else>>
<<his>>
<</if>>
<</nobr>><</widget>>

