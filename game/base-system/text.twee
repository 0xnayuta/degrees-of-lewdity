<<widget "hisselect">><<nobr>>
<!-- Note calls range from 0-5 corresponding to NPCs 1-6. This was done to simplify FOR loops -->
<<set _n to $args[0]>>
<<if $enemytype is "man" and $enemyno gte 2>>
	<<personselect _n>>
	<<if $npc isnot 0>>
	$npc's
	<<elseif $NPCList[_n].intro is 1>><<set $NPCList[_n].intro to 0>>
	the <<persons>>
	<<else>>
	<<his>>
	<</if>>
<<elseif $enemytype is "beast">>
<<bhis>>
<<else>>
<<his>>
<</if>>
<</nobr>><</widget>>

