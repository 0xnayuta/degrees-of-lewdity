	<<set $aw_molestsx to "gropes "+$aw_target>>
	<<set _s to "shag:shagged:was shagged:shagging:shags".split(":")>>
	<<set $aw_sexx to "shag "+$aw_target>>
	<<set $aw_sexedx to "shagged "+$aw_target>>
	<<set $aw_sexingx to "shagging "+$aw_target>>
	<<set $aw_sexsx to "shags "+$aw_target>>
	<<set _r to "violate:violated:was violated:violating:violates".split(":")>>
	<<set $aw_rapex to "violate "+$aw_target>>
	<<set $aw_rapedx to "violated "+$aw_target>>
	<<set $aw_rapingx to "violating "+$aw_target>>
	<<set $aw_rapesx to "violates "+$aw_target>>
	/*
	*/
	<<elseif $awareness+_awrng gt 100>>	<<set _s to "molested:to molest me:molested me:I had sex:I had sex with:having sex:assault:assaulted:assaulted".split(":")>>
	<<set _m to "molest:molested:was molested:molesting:molests:molester".split(":")>>
	<<set $aw_molestx to "molest "+$aw_target>>
	<<set $aw_molestedx to "molested "+$aw_target>>
	<<set $aw_molestingx to "molesting "+$aw_target>>
	<<set $aw_molestsx to "molests "+$aw_target>>
	<<set _s to "fuck:fucked:was fucked:fucking:fucks".split(":")>>
	<<set $aw_sexx to "fuck "+$aw_target>>
	<<set $aw_sexedx to "fucked "+$aw_target>>
	<<set $aw_sexingx to "fucking "+$aw_target>>
	<<set $aw_sexsx to "fucks "+$aw_target>>
	<<set _r to "rape:raped:was raped:raping:rapes".split(":")>>
	<<set $aw_rapex to "rape "+$aw_target>>
	<<set $aw_rapedx to "raped "+$aw_target>>
	<<set $aw_rapingx to "raping "+$aw_target>>
	<<set $aw_rapesx to "rapes "+$aw_target>>
	<<elseif $awareness+_uawrng gt 0>>
	<<set _m to "molest:molested:was molested:molesting:molests:molester".split(":")>>
	<<set $aw_molestx to "molest "+$aw_target>>
	<<set $aw_molestedx to "molested "+$aw_target>>
	<<set $aw_molestingx to "molesting "+$aw_target>>
	<<set $aw_molestsx to "molests "+$aw_target>>
	<<set _s to "have sex:had sex:was fucked:having sex:has sex".split(":")>>
	<<set $aw_sexx to "have sex with "+$aw_target>>
	<<set $aw_sexedx to "had sex with "+$aw_target>>
	<<set $aw_sexingx to "having sex with "+$aw_target>>
	<<set $aw_sexsx to "has sex with "+$aw_target>>
	<<set _r to "assault:assaulted:was assaulted:assaulting:assaults".split(":")>>
	<<set $aw_rapex to "assault "+$aw_target>>
	<<set $aw_rapedx to "assaulted "+$aw_target>>
	<<set $aw_rapingx to "assaulting "+$aw_target>>
	<<set $aw_rapesx to "assaults "+$aw_target>>
	/*
	<<elseif $awareness+_uawrng gt -40>>
	*/
	<<elseif $awareness+_uawrng gt -80>>
	<<set _m to "fondle:fondled:was fondled:fondling:fondles:creep".split(":")>>
	<<set $aw_molestx to "fondle "+$aw_target>>
	<<set $aw_molestedx to "fondled "+$aw_target>>
	<<set $aw_molestingx to "fondling "+$aw_target>>
	<<set $aw_molestsx to "fondles "+$aw_target>>
	/*
	<<set _s to "sleep:slept:slept:sleeping:sleeps:sleep with $aw_target:slept with $aw_target:sleeping with $aw_target:sleeps with $aw_target:".split(":")>>
	*/
	<<set _s to "do lewd things:did lewd things:was done lewd things to:doing lewd things:does lewd things".split(":")>>
	<<set $aw_sexx to "do lewd things with "+$aw_target>>
	<<set $aw_sexedx to "did lewd things with "+$aw_target>>
	<<set $aw_sexingx to "doing lewd things with "+$aw_target>>
	<<set $aw_sexsx to "does lewd things with "+$aw_target>>
	<<set _r to "do unpleasant things:did unpleasant things:was done unpleasant things to:doing unpleasant things:does unpleasant things".split(":")>>
