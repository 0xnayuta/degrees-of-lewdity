	<<set $aw_rapedx to "did unpleasant things to "+$aw_target>>
	<<set $aw_rapingx to "doing unpleasant things to "+$aw_target>>
	<<set $aw_rapesx to "does unpleasant things to "+$aw_target>>
	<<elseif $awareness+_uawrng gt -120>>
	<<set _m to "touch strangely:touched strangely:was touched strangely:touching strangely:touches strangely:weirdo".split(":")>>
	<<set $aw_molestx to "touch "+$aw_target+" strangely">>
	<<set $aw_molestedx to "touched "+$aw_target+" strangely">>
	<<set $aw_molestingx to "touching "+$aw_target+" strangely">>
	<<set $aw_molestsx to "touches "+$aw_target+" strangely">>
	<<set _s to "do funny things:did funny things:was done funny thing to:doing funny things:does funny things".split(":")>>
	<<set $aw_sexx to "do funny things with "+$aw_target>>
	<<set $aw_sexedx to "did funny things with "+$aw_target>>
	<<set $aw_sexingx to "doing funny things with "+$aw_target>>
	<<set $aw_sexsx to "does funny things with "+$aw_target>>
	<<set _r to "do weird things:did weird things:was done weird things to:doing weird things:does weird things".split(":")>>
	<<set $aw_rapex to "do weird things to "+$aw_target>>
	<<set $aw_rapedx to "did weird things to "+$aw_target>>
	<<set $aw_rapingx to "doing weird things to "+$aw_target>>
	<<set $aw_rapesx to "does weird things to "+$aw_target>>
	/*
	<<elseif $awareness+_uawrng gt -160>>
	*/
	<<else>>
	<<set _m to "massage:massaged:was massaged:massaging:massages:weirdo".split(":")>>
	<<set $aw_molestx to "massage "+$aw_target>>
	<<set $aw_molestedx to "massaged "+$aw_target>>
	<<set $aw_molestingx to "massaging "+$aw_target>>
	<<set $aw_molestsx to "massages "+$aw_target>>
	<<set _s to "hug:hugged:was hugged:hugging:hugs".split(":")>>
	<<set $aw_sexx to "hug "+$aw_target>>
	<<set $aw_sexedx to "hugged "+$aw_target>>
	<<set $aw_sexingx to "hugging "+$aw_target>>
	<<set $aw_sexsx to "hugs "+$aw_target>>
	<<set _r to "hug hard:hugged hard:was hugged hard:hugging hard:hugs hard".split(":")>>
	<<set $aw_rapex to "hug "+$aw_target+" hard">>
	<<set $aw_rapedx to "hugged "+$aw_target+" hard">>
	<<set $aw_rapingx to "hugging "+$aw_target+" hard">>
	<<set $aw_rapesx to "hugs "+$aw_target+" hard">>

	/*
	<<set _m to "gently massage:gently massaged:was gently massaged:gently massaging:gently massages:weirdo".split(":")>>
	<<set $aw_molestx to "gently massage "+$aw_target>>
	<<set $aw_molestedx to "gently massaged "+$aw_target>>
	<<set $aw_molestingx to "gently massaging "+$aw_target>>
	<<set $aw_molestsx to "gently massages "+$aw_target>>
	<<set _s to "gently hug:gently hugged:was gently hugged:gently hugging:gently hugs".split(":")>>
	<<set $aw_sexx to "gently hug "+$aw_target>>
