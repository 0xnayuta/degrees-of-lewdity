		<</if>>
	<</if>>
	<<if _lowercover isnot "" and _uppercover isnot "">>
		<<set _covertarget to _uppercover + " and " + _lowercover>>
	<<elseif _uppercover isnot "">>
		<<set _covertarget to _uppercover>>
	<<else>>
