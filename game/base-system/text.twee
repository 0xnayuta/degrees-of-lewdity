<<widget "he">><<nobr>>
<<if $pronoun is "m">>he
<<elseif $pronoun is "f">>she
<<elseif $pronoun is "i">>it
<<elseif $pronoun is "n">>one
<<elseif $pronoun is "t">>they
<<else>>he
<</if>>
<</nobr>><</widget>>

<<widget "bHe">><<nobr>>
<<if $enemyno gte 0>><<set _na to $enemyno-1>><<else>><<set _na to 0>><</if>>
<<if $NPCList[_na].monster is "monster">>
	<<if $NPCList[_na].pronoun is "m">>
	He
	<<else>>
	She
	<</if>>
<<else>>
It
<</if>>
<</nobr>><</widget>>

<<widget "bhe">><<nobr>>
<<if $enemyno gte 0>><<set _na to $enemyno-1>><<else>><<set _na to 0>><</if>>
<<if $NPCList[_na].monster is "monster">>
	<<if $NPCList[_na].pronoun is "m">>
	he
	<<else>>
	she
	<</if>>
<<else>>
it
<</if>>
<</nobr>><</widget>>

