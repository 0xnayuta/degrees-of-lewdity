	<<set $aw_sexsx to "gently hugs "+$aw_target>>
	<<set _r to "hug tightly:hugged tightly:was hugged tightly:hugging tightly:hugs tighly".split(":")>>
	<<set $aw_rapex to "hug "+$aw_target+" tightly">>
	<<set $aw_rapedx to "hugged "+$aw_target+" tightly">>
	<<set $aw_rapingx to "hugging "+$aw_target+" tightly">>
	<<set $aw_rapesx to "hugs "+$aw_target+" tighly">>
	/*   */
	<</if>>
	<<set _i to 0>>
	<<set $aw_molest to _m[_i]>>	<<set $aw_rape to _r[_i]>>	<<set $aw_sex to _s[_i]>> <<set $aw_fight to _f[_i]>> <<set _i++>>
	<<set $aw_molested to _m[_i]>>	<<set $aw_raped to _r[_i]>>	<<set $aw_sexed to _s[_i]>> <<set $aw_fighted to _f[_i]>> <<set _i++>>
	<<set $aw_wasmolested to _m[_i]>>	<<set $aw_wasraped to _r[_i]>>	<<set $aw_wassexed to _s[_i]>> <<set $aw_wasfighted to _f[_i]>> <<set _i++>>
	<<set $aw_molesting to _m[_i]>>	<<set $aw_raping to _r[_i]>>	<<set $aw_sexing to _s[_i]>> <<set $aw_fighting to _f[_i]>> <<set _i++>>
	<<set $aw_molests to _m[_i]>>	<<set $aw_rapes to _r[_i]>>	<<set $aw_sexs to _s[_i]>> <<set $aw_fights to _f[_i]>> <<set _i++>>

	/*<<set $aw_molester to _m[_i]>>	<<set $aw_rapist to _r[_i]>>	<<set $aw_sexer to _s[_i]>> <<set $aw_fighter to _f[_i]>> <<set _i++>>*/
	<<set $aw_molester to "molester">>	<<set $aw_rapist to "rapist">>	<<set $aw_sexer to "pervert">> <<set $aw_fighter to "thug">>
	<<set $aw_molester to _m[_i]>>

	/* decide what the last combat should be called(needs to happen before <<endcombat>>) */
	/*thought about  moving just this bit to start of <<endcombat>> but there are bits where combat is almost done and this needs to also happen when using <<awarenesswords>>. This happening outside of combat shouldn't be a problem*/
	<<if $rapeavoid is 0>>
		<<set $aw_x to $aw_rape>><<set $aw_xed to $aw_raped>><<set $aw_wasxed to $aw_wasraped>><<set $aw_xing to $aw_raping>><<set $aw_xs to $aw_rapes>>
		<<set $aw_xx to $aw_rapex>><<set $aw_xedx to $aw_rapedx>><<set $aw_xingx to $aw_rapingx>><<set $aw_xsx to $aw_rapesx>>
	<<elseif $sexavoid is 0>>>
		<<set $aw_x to $aw_sex>><<set $aw_xed to $aw_sexed>><<set $aw_wasxed to $aw_wassexed>><<set $aw_xing to $aw_sexing>><<set $aw_xs to $aw_sexs>>
		<<set $aw_xx to $aw_sexx>><<set $aw_xedx to $aw_sexedx>><<set $aw_xingx to $aw_sexingx>><<set $aw_xsx to $aw_sexsx>>
	<<else>>
		<<set $aw_x to $aw_molest>><<set $aw_xed to $aw_molested>><<set $aw_wasxed to $aw_wasmolested>><<set $aw_xing to $aw_molesting>><<set $aw_xs to $aw_molests>>
		<<set $aw_xx to $aw_molestx>><<set $aw_xedx to $aw_molestedx>><<set $aw_xingx to $aw_molestingx>><<set $aw_xsx to $aw_molestsx>>
	<</if>>
	/* if things really need to be called a fight it's probably better to do it case by case than to try to decide if combat was more of a fight(where the opponent wasn't trying to do something else) than sex scene based on what you did
	<<else>>
		<<set $aw_x to $aw_fight>><<set $aw_xed to $aw_fighted>><<set $aw_xing to $aw_fighting>><<set $aw_xs to $aw_fights>>
		<<set $aw_xx to $aw_fightx>><<set $aw_xedx to $aw_fightedx>><<set $aw_xingx to $aw_fightingx>><<set $aw_xsx to $aw_fightsx>>
	<</if>>
	*/
<</nobr>><</widget>>

<<widget "laughs">><<nobr>>
<<set $rng to random(1, 100)>>
<<if $npcadult isnot 1>>
	<<if $rng gte 51>>
	giggles
	<<else>>
	laughs
	<</if>>
<<elseif $pronoun is "f">>
	<<if $rng gte 67>>
	giggles
	<<elseif $rng gte 33>>
	chuckles
	<<else>>
	laughs
	<</if>>
<<else>>
	<<if $rng gte 51>>
	chuckles
	<<else>>
	laughs
	<</if>>
<</if>>

<</nobr>><</widget>>

<<widget "cursedtext">><<nobr>>
<<if ($args[0] or $args[1]) is "collar">>
<span class="blue">Perhaps the police can help.</span>
<<elseif ($args[0] or $args[1]) is "chastity belt">>
<span class="blue">Perhaps the temple can help.</span>
<</if>>
<</nobr>><</widget>>

<<widget "randomteacher">><<nobr>>
<<if $rng gte 81 and $initsirris is 1>>
Sirris
<<elseif $rng gte 61 and $initriver is 1>>
River
<<elseif $rng gte 41 and $initdoren is 1>>
Doren
<<elseif $rng gte 21 and $initwinter is 1>>
Winter
<<elseif $initmason is 1>>
Mason
<<else>>
a teacher
<</if>>
<</nobr>><</widget>>

<<widget "skincolourtext">><<nobr>>
	<<if $tanned gte 480>>dark tan.
	<<elseif $tanned gte 240>>medium tan.
	<<elseif $tanned gte 180>>tan.
	<<elseif $tanned gte 60>>light tan.
	<<else>>
	<<switch $haircolour>>
		<<case "black" "blue" "deepblue" "purple">>
		ivory glow.
		<<default>>
		pink glow.
	<</switch>>
<</if>>
<</nobr>><</widget>>

<<widget "gtanned">><<nobr>> |
<span class="green">+ Tan </span>
<</nobr>><</widget>>
