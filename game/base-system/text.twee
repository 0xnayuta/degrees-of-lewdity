light brown
<<elseif $haircolour is "strawberryblond">>
strawberry blond
<<elseif $haircolour is "hotpink">>
hot pink
<<elseif $haircolour is "softpink">>
soft pink
<<elseif $haircolour is "snowwhite">>
snow white
<<elseif $haircolour is "deepblue">>
deep blue
<<else>>
$haircolour
<</if>>

