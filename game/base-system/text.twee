<<elseif $args[1] is "priest">>
	<<if $temple_rank is "initiate" or $temple_rank is "monk">>
		|
		<span class="red">- - Grace</span>
	<<else>>
	<</if>>
<<elseif $args[1] is "bishop">>
	<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
		|
		<span class="red">- - Grace</span>
