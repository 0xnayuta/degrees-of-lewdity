<<widget "pronouns">><<nobr>>/*  sets _he, _hes, _his, _him, _hers, _man and _person  */
/* used for something like <<set _var to "blah "+_he+" blah">> */
<!-- Not sure if switching to using _he instead of $he would be worth it, situations where it wouldn't be defined would be kind of rare(thought about making "effects" widget call this if any person is selected instead of having to do a personselect again when passage changes. The "benefit" of having less story variables defined seems minor compared to how annoying dealing with issues might be) -->

<<if $pronoun is "m">>
	<<set _he to "he">><<set _hes to "he's">><<set _his to "his">><<set _him to "him">><<set _hers to "his">>
	<<set _He to "He">><<set _Hes to "he's">><<set _His to "His">><<set _Him to "Him">><<set _Hers to "His">>
<<elseif $pronoun is "f">>
	<<set _he to "she">><<set _hes to "she's">><<set _his to "her">><<set _him to "her">><<set _hers to "hers">>
	<<set _He to "She">><<set _Hes to "She's">><<set _His to "Her">><<set _Him to "Her">><<set _Hers to "Hers">>
<<elseif $pronoun is "i">>
	<<set _he to "it">><<set _hes to "it's">><<set _his to "its">><<set _him to "it">><<set _hers to "its">>
	<<set _He to "It">><<set _Hes to "It's">><<set _His to "Its">><<set _Him to "It">><<set _Hers to "Its">>
<<elseif $pronoun is "n">>
	<<set _he to "one">><<set _hes to "one is">><<set _his to "the">><<set _him to "them">><<set _hers to "the">>
	<<set _He to "It">><<set _Hes to "It is">><<set _His to "The">><<set _Him to "Them">><<set _Hers to "The">>
<<elseif $pronoun is "t">>
	<<set _he to "they">><<set _hes to "they are">><<set _his to "their">><<set _him to "them">><<set _hers to "theirs">>
	<<set _He to "They">><<set _Hes to "They are">><<set _His to "Their">><<set _Him to "Them">><<set _Hers to "Theirs">>
<</if>>

<<if $npcadult is 1>>
	<<if $pronoun is "m">><<set _man to "man">>
	<<elseif $pronoun is "f">><<set _man to "woman">>
	<</if>>
<<else>>
	<<if $pronoun is "m">><<set _man to "boy">>
	<<elseif $pronoun is "f">><<set _man to "girl">>
	<</if>>
<</if>>
<<set _person to $description+" "+_man>>

<!-- Old vars that I might make unnecessary at some point -->
<<if $pronoun is "m">>
	<<set $he to "he">><<set $hes to "he's">><<set $his to "his">><<set $him to "him">><<set $hers to "his">>
	<<set $He to "He">><<set $Hes to "he's">><<set $His to "His">><<set $Him to "Him">><<set $Hers to "His">>
<<elseif $pronoun is "f">>
	<<set $he to "she">><<set $hes to "she's">><<set $his to "her">><<set $him to "her">><<set $hers to "hers">>
	<<set $He to "She">><<set $Hes to "She's">><<set $His to "Her">><<set $Him to "Her">><<set $Hers to "Hers">>
<<elseif $pronoun is "i">>
	<<set $he to "it">><<set $hes to "it's">><<set $his to "its">><<set $him to "it">><<set $hers to "its">>
	<<set $He to "It">><<set $Hes to "It's">><<set $His to "Its">><<set $Him to "It">><<set $Hers to "Its">>
<<elseif $pronoun is "n">>
	<<set $he to "one">><<set $hes to "one is">><<set $his to "the">><<set $him to "them">><<set $hers to "the">>
	<<set $He to "It">><<set $Hes to "It is">><<set $His to "The">><<set $Him to "Them">><<set $Hers to "The">>
<<elseif $pronoun is "t">>
	<<set $he to "they">><<set $hes to "they are">><<set $his to "their">><<set $him to "them">><<set $hers to "theirs">>
	<<set $He to "They">><<set $Hes to "They are">><<set $His to "Their">><<set $Him to "Them">><<set $Hers to "Theirs">>
<<elseif $npcadult is 1>>
	<<if $pronoun is "m">><<set $man to "man">>
	<<elseif $pronoun is "f">><<set $man to "woman">>
	<</if>>
<<else>>
	<<if $pronoun is "m">><<set $man to "boy">>
	<<elseif $pronoun is "f">><<set $man to "girl">>
	<</if>>
<</if>>
<<set $person to $description+" "+$man>>

<</nobr>><</widget>>


<<widget "gsmell">><<nobr>> |
/* not sure if these should be shown that much, most of them are implied enough and uniportant enough that it doesn't seem necessary to announce it whenever smell changes happen aside from some specific actions where the main point is to change smell. */
<<switch $args[0]>>
	/* Not sure if different smells need to have different colours. */
	<<case "trash">><span class="brown">+ Smell of trash</span>
	<<case "forest">><span class="green">+ Smell of plants</span>
	<<case "semen">><span class="lewd">+ Smell of semen</span>
	<<case "sweat">><span class="blue">+ Smell of sweat</span>
	<<case "slime">><span class="pink">+ Smell of slime</span>
	<<case "soap">><span class="blue">+ Smell of soap</span>
	<<case "piss">><span class="gold">+ Smell of urine</span>
	<<case "alcohol">><span class="purple">+ Smell of alcohol</span>
	<<case "perfume">><span class="purple">+ Smell of perfume</span>
	<<case "blood">><span class="red">+ Smell of blood</span>
	<<case "none">><span class="teal">- Smell</span>
	<<default>><span class="brown">+ Smell of $args[0]</span>
<</switch>>

<</nobr>><</widget>>

<<widget "smelltext">><<nobr>>
/* $smells should look something like [["forest", 6], ["piss", 4], ["soap", 1]] and be sorted with $smells[0][1] being highest number */
<<if typeof($args[0]) is "object">>/* know exactly what we want ie. ["soap", 1] */
	<<set _smelltype to $args[0][0]>>
	<<set _smelllevel to $args[0][1]>>
<<elseif typeof($args[0]) is "string">>/* pick a specific smell type ie. "saap" and figure out it's level */
	<<set _smelltype to $args[0]>>
	<<for _i; _i lt $smells.length; _i++ >>
		<<if $smells[_i].includes($args[0])>>
			<<set _smelllevel to $smells[_i][1]>>
		<</if>>
	<</for>>
<<elseif typeof($args[0]) is "number">>/* pick nth strongest smell(means if $args[0] is $smells[0] it can be replaced with just 0) */
	<<set _smelltype to $smells[$args[0]][0]>>
	<<set _smelllevel to $smells[$args[0]][1]>>
<</if>>
<<switch _smelltype>>
	<<case "trash">><<set _colour to "<span class='brown'>">>
	<<case "sweat">><<set _colour to "<span class='blue'>">>
	<<case "forest">><<set _colour to "<span class='green'>">>
	<<case "semen">><<set _colour to "<span class='lewd'>">>
	<<case "slime">><<set _colour to "<span class='pink'>">>
	<<case "soap">><<set _colour to "<span class='blue'>">>
	<<case "piss">><<set _colour to "<span class='gold'>">>
	<<case "alcohol">><<set _colour to "<span class='purple'>">>
	<<case "perfume">><<set _colour to "<span class='purple'>">>
	<<case "blood">><<set _colour to "<span class='blood'>">>
	<<case "salt">><<set _colour to "<span class='lblue'>">>
	<<case "chlorine">><<set _colour to "<span class='lblue'>">>
	<<default>><<print "<br>Error, "+_smelltype+" is an unknown smelltype for widget \"smelltext\"<br>">><<set _colour to "<span class='red'>">>
<</switch>>
<<set _smelllevel to Math.round(_smelllevel)>>
<<if $args[1] is "smell1of3" or $args[1] is "smell2of3" or $args[1] is "smell3of3" or $args[1] is 1>>
	<<switch _smelllevel>>
		<<case 0>><<set _stenchlevel to "barely">>
		<<case 1>><<set _stenchlevel to "slightly">>
		<<case 2>><<set _stenchlevel to "somewhat">>
		<<case 3>><<set _stenchlevel to "">>
		<<case 4>><<set _stenchlevel to "clearly">>
		<<case 5>><<set _stenchlevel to "strongly">>
		<<case 6>><<set _stenchlevel to "overwhelmingly">>
		<<default>><<set _stenchlevel to "extremely strongly">>
	<</switch>>
	<<if $args[1] is 1>>
		<<set _text to "You smell "+_stenchlevel+" of "+_colour+_smelltype+"</span>.">>
	/* there's probably a better way to do the next bit */
	<<elseif $args[1] is "smell1of3">>
		<<set _text to "You smell "+_stenchlevel+" of "+_colour+_smelltype+"</span>,">>
	<<elseif $args[1] is "smell2of3">>
		<<set _text to ""+_stenchlevel+" of "+_colour+_smelltype+"</span>">>
	<<elseif $args[1] is "smell3of3">>
		<<set _text to "and "+_stenchlevel+" of "+_colour+_smelltype+"</span>.">>
	<</if>>
<<elseif $args[1] is "stench" or $args[1] is "short" or $args[1] is 2>>
	<<switch _smelllevel>>
		<<case 0>><<set _stenchlevel to "minute">>
		<<case 1>><<set _stenchlevel to "slight">>
		<<case 2>><<set _stenchlevel to "minor">>
		<<case 3>><<set _stenchlevel to "notable">>
		<<case 4>><<set _stenchlevel to "clear">>
		<<case 5>><<set _stenchlevel to "strong">>
		<<case 6>><<set _stenchlevel to "overwhelming">>
		<<default>><<set _stenchlevel to "extreme">>
	<</switch>>
	<<if $args[1] is "stench" or $args[1] is 2>>
		<<set _text to "You have a "+_stenchlevel+" stench of "+_colour+_smelltype+"</span> on you.">>
	<<elseif $args[1] is "short">>
		<<set _text to ""+_colour+_smelltype+"</span>("+_stenchlevel+")">>
	<</if>>
<<elseif $args[1] is undefined or $args[1] is 0>>/* just colour the smell name */
	<<set _text to ""+_colour+_smelltype+"</span>">>
<<else>>
	<<print "<br>Error args:"+$args[0]+" and "+$args[1]+" aren't valid for widget \"smelltext\"<br>">>
<</if>>
<<if _smelllevel gte 1 or $args[1] is undefined>>
	<<print _text>>
<</if>>

<</nobr>><</widget>>

/*
stench
filth
foul
trash
putrid
fetid
reek
*/



/*
Awareness based words
IMPORTANT the ones without target(no(2nd) x at the end) are about doing the thing in general without a specified target!
For most it might not be noticeable even if you write "$aw_x you" but for "having sex" and some others it certainly is!

example sentences:
He wants to $aw_xx and so he $aw_xsx and only stopped $aw_xingx when he felt like he had $aw_xedx enough but only to go off to<<set $aw_target to "others">> $aw_xx who after being <<set $aw_target to "">>$aw_xedx gave up on life so unhindered he <<set $aw_target to "everyone">>$aw_xsx until his $aw_xing spree was ended by Kylar.
To $aw_x is very natural and if you don't engage in $aw_xing it can be bad for you so if you haven't already $aw_xed you should find someone who $aw_xs often and ask them nicely.

Hnng... there's still stuff that this doesn't cover.
"I got fucked" becomes "I got had sex (with me)"
I could just not do sentences where I'd need that while using this... would something like "I $aw_wasxedby someone" and "I was $aw_wasgotxed" be good?

if I feel like it later I should add something that covers "I had/was xed" and "(started) to x me"
alse maybe replace sleep with do lewd things

Not really sure about what order the words should be(they should be easy to move around(ctrl+up/down(in Atom) is nice))
Rape= screw, violate, rape, assault, do unpleasant things, do weird things, hug hard, hug tightly
Sex= bang, shag, fuck, have sex, sleep, do funny things, hug, hug gently
Molest= feel up, grope, molest, molest, fondle, touch strangely, massage, massage gently


molest is nice since it doesn't use do/did

*/
<<widget "awarenesswords">><<nobr>> /* awareness based alternatives to words molest, fuck, rape and possibly fight/attack use the 1st arg to decide what to call the target of the action(me, you, her, Robin)*/
	<<set _awrng to random(0,100)>>	<<set _uawrng to random(0,40)>> /* for using "higher" level word randomly based on awareness progress(so a 50% chance at 50% progress) */
	<<if $args[0] isnot undefined>> /*without arg we'll keep the current target*/
		<<set $aw_target to $args[0]>> /* $aw_target is needed so that stuff like "feel up me" or "touching strangely you" won't happen */
	<</if>>
	/* .split(":") turns a string into an array with items separated by : */
	/*<<set _f to "fight:fought:fighting:fights:fight $aw_target:fought $aw_target:fighting $aw_target:fights $aw_target+".split(":")>>*/
	<<set _f to "attack:attacked:attacking:attacks:".split(":")>>
	<<set $aw_fight to "attack "+$aw_target>>
	<<set $aw_fighted to "attacked "+$aw_target>>
	<<set $aw_fighting to "attacking "+$aw_target>>
	<<set $aw_fights to "attacks "+$aw_target>>
	/*<<set _f to "bully:bullied:was bullied:bullying:bullies:bully $aw_target:bullied $aw_target:bullying $aw_target:bullies $aw_target".split(":")>>*/
	/*<<set _f to "wrestle:wrestled:was wrestled with:wrestling:wrestles:wrestle with $aw_target:wrestled with $aw_target:wrestling with $aw_target:wrestles with $aw_target".split(":")>>*/
	/*<<set _f to "tease:teased:was teased:teasing:teases:teas $aw_target:teased $aw_target:teasing $aw_target:teases $aw_target".split(":")>>*/
	/*<<set _f to "play:played:was played with:playing:plays:play with $aw_target:played with $aw_target:playing with $aw_target:plays with $aw_target".split(":")>>*/

	<<if $awareness is undefined>>
	<<set _m to "molest:molested:was molested:molesting:molests:molester".split(":")>>
	<<set $aw_molestx to "molest "+$aw_target>>
	<<set $aw_molestedx to "molested "+$aw_target>>
	<<set $aw_molestingx to "molesting "+$aw_target>>
	<<set $aw_molestsx to "molests "+$aw_target>>
	<<set _s to "fuck:fucked:was fucked:fucking:fucks".split(":")>>
	<<set $aw_sexx to "fuck "+$aw_target>>
	<<set $aw_sexedx to "fucked "+$aw_target>>
	<<set $aw_sexingx to "fucking "+$aw_target>>
	<<set $aw_sexsx to "fucks "+$aw_target>>
	<<set _r to "rape:raped:was raped:raping:rapes".split(":")>>
	<<set $aw_rapex to "rape "+$aw_target>>
	<<set $aw_rapedx to "raped "+$aw_target>>
	<<set $aw_rapingx to "raping "+$aw_target>>
	<<set $aw_rapesx to "rapes "+$aw_target>>
	/*
	*/
	<<elseif $awareness+_awrng gte 500>>
	<<set _m to "feel up:felt up:was felt up:feeling up:feels up:pervert".split(":")>>
	<<set $aw_molestx to "feel "+$aw_target+" up">>
	<<set $aw_molestedx to "felt "+$aw_target+" up">>
	<<set $aw_molestingx to "feeling "+$aw_target+" up">>
	<<set $aw_molestsx to "feels "+$aw_target+" up">>
	<<set _s to "bang:banged:was banged:banging:bangs".split(":")>>
	<<set $aw_sexx to "bang "+$aw_target>>
	<<set $aw_sexedx to "banged "+$aw_target>>
	<<set $aw_sexingx to "banging "+$aw_target>>
	<<set $aw_sexsx to "bangs "+$aw_target>>
	<<set _r to "screw:screwed:was screwed:screwing:screws".split(":")>>
