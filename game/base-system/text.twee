<<widget "his">><<nobr>>
<<if $pronoun is "m">>his
<<elseif $pronoun is "f">>her
<<elseif $pronoun is "i">>its
<<elseif $pronoun is "n">>the
<<elseif $pronoun is "t">>their
<<else>>his
<</if>>
