<<set $ruinrooms[1][$pots.boxSR] to 19>>
<<set $ruinrooms[1][$pots.snap] to 8>>
<<set $ruinrooms[1][$pots.ceram] to 8>>
<<set $ruinrooms[1][$pots.mud] to 8>>
<<set $ruinrooms[1][$pots.pebb] to 8>>
<<set $ruinrooms[1][$pots.empty] to 8>>
