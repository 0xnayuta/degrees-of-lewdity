/* 
I should do something about this, remove it? make it use a less "wasteful" system? 
Making it so that it tracks just the number of specific encounters and maybe the next 20 or so events could be ok
*/
<<widget "potinit">><<nobr>> /* i=item s=searched t=type */
<<set $ruinpots to []>>
<<set _mult to 10>>/* make 100 pots multiplied by this */
<<for _i to 0; _i lt 28*_mult; _i++>><<run $ruinpots.push({i:"dust",s:false,t:"purple"})>><</for>>
<<for _i to 0; _i lt 19*_mult; _i++>><<run $ruinpots.push({i:"box",s:false,t:"silver"})>><</for>>
<<for _i to 0; _i lt 10*_mult; _i++>><<run $ruinpots.push({i:"key",s:false,t:"bronze"})>><</for>>
<<for _i to 0; _i lt 8*_mult; _i++>><<run $ruinpots.push({i:"snapper",s:false,t:"slow"})>><</for>>
<<for _i to 0; _i lt 8*_mult; _i++>><<run $ruinpots.push({i:"ceramics",s:false,t:""})>><</for>>
<<for _i to 0; _i lt 8*_mult; _i++>><<run $ruinpots.push({i:"mud",s:false,t:""})>><</for>>
<<for _i to 0; _i lt 8*_mult; _i++>><<run $ruinpots.push({i:"pebbles",s:false,t:""})>><</for>>
<<for _i to 0; _i lt 8*_mult; _i++>><<run $ruinpots.push({i:"empty",s:false,t:""})>><</for>>
<<for _i to 0; _i lt 2*_mult; _i++>><<run $ruinpots.push({i:"swarm",s:false,t:""})>><</for>>
<<for _i to 0; _i lt 1*_mult; _i++>><<run $ruinpots.push({i:"box",s:false,t:"gold"})>><</for>>

<<run $ruinpots.shuffle()>>
/*extras at the end*/
