<<widget "ruinoptions">><<nobr>>
<<if $args[0] isnot undefined>>
	<<set $logprep to $logprep+$args[0]>>
	$args[1]
	<br>
	<<link [[Search pots|Lake Pots]]>><<wateraction>><<set $logprep to $logprep+" and continued searching pots.">><<log $logprep 1>><<set $phase to 0>><</link>><<loxygen>>
	<br>
	<<if $lakeruinkey is 1>>
		<<link [[Open door with bronze key|Lake Ruin Door]]>><<wateraction>><<set $logprep to $logprep+" and went to use bronze key on the door.">><<log $logprep 1>><<set $phase to 0>><</link>><<loxygen>>
		<br>
	<</if>>
	<<if $lakeruinkey is 2>>
		<<link [[Swim inside plinth room|Lake Ruin Plinth]]>><<wateraction>><<set $logprep to $logprep+" and swum to the plinth room.">><<log $logprep 1>><<set $phase to 0>><</link>><<loxygen>>
		<br>
	<</if>>
	/* option to take a discarded pot here would require checking that the current one isn't the last and be annoying to do in general*/
	<br>
	<<link [[Swim towards exit|Lake Ruin]]>><<wateraction>><<set $logprep to $logprep+" and swum towards the exit.">><<log $logprep 1>><<set $phase to 0>><</link>><<loxygen>>
	<br>


<<else>>
	<<link [[Search pots|Lake Pots]]>><<wateraction>><<set $phase to 0>><</link>><<loxygen>>
	<br>
	<<if $lakeruinkey is 1>>
		<<link [[Open door with bronze key|Lake Ruin Door]]>><<wateraction>><<set $phase to 0>><</link>><<loxygen>>
		<br>
	<</if>>
	<<if $lakeruinkey is 2>>
		<<link [[Swim inside plinth room|Lake Ruin Plinth]]>><<wateraction>><<set $phase to 0>><</link>><<loxygen>>
		<br>
	<</if>>
	<<if $historytrait gte 4 and $boxdumps.length gte 1>>
		<<link [[Take a discarded box|Lake Ruin Dumped Box]]>><<wateraction>><<set $phase to 0>><</link>><<loxygen>>
		<br>
	<</if>>
	<br>
	<<link [[Swim towards exit|Lake Ruin]]>><<wateraction>><<set $phase to 0>><</link>><<loxygen>>
	<br>
<</if>>

