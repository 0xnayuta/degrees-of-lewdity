<br>debug stuff
<br>@
$boxdumps[0]
$boxdumps[1]
$boxdumps[2]
$boxdumps[3]

<br><br>
<<if $ruinpots isnot undefined>>
<br><<for _ip to 0; _ip lt 20; _ip++>>
| <<if $searchpot is _ip>><span class='meek'>!!</span><</if>>
_ip $ruinpots[_ip].i $ruinpots[_ip].s $ruinpots[_ip].t /% somehow this breaks if I try to put it inside an if %/
