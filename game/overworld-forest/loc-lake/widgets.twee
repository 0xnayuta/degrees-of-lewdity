<<set $ruinrooms[2][$pots.snap] to 2>>
<<set $ruinrooms[2][$pots.ceram] to 1>>
<<set $ruinrooms[2][$pots.mud] to 30>>
<<set $ruinrooms[2][$pots.pebb] to 20>>
<<set $ruinrooms[2][$pots.empty] to 20>>
<<set $ruinrooms[2][$pots.swarm] to 8>>
<<set $ruinrooms[2][$pots.boxGN] to 0>>
<<set $ruinrooms[2][$pots.boxGCB] to 1>>
/*

