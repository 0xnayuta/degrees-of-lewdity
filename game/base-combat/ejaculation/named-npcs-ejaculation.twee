:: Widgets Ejaculation Named NPCs [widget]

/* Sets _noNamedNpcEjaculation when the NNPC has no ejaculation widget, so generic text plays instead.
   <<namedNpcEjaculation $NPCList[_npcSlot].fullDescription _args[0]>> */
<<widget "namedNpcEjaculation">>
	<<unset _noNamedNpcEjaculation>>
	<<switch _args[0]>>
		<<case "Alex">><<ejaculation-alex _args[1]>>
		<<case "Eden">><<ejaculation-eden _args[1]>>
		<<case "Gwylan">><<ejaculation-gwylan _args[1]>>
		<<case "Kylar">><<ejaculation-kylar _args[1]>>
		<<case "Leighton">><<ejaculation-leighton _args[1]>>
		<<case "Robin">><<ejaculation-robin _args[1]>>
		<<case "Sydney">><<ejaculation-sydney _args[1]>>
		<<default>><<set _noNamedNpcEjaculation to true>>
	<</switch>>
<</widget>>
