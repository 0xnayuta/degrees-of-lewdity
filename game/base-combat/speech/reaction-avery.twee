:: Widgets reaction-Avery [widget]

<<widget "reaction-avery-kissImminent">>
	<<His>> eyes flick between your lips and your eyes with naked hunger. <<if C.npc.Avery.rage lt 20>>"Come here, <<pcpetname "Avery">>..."<</if>>
<</widget>>

<<widget "reaction-avery-kissSkin">>
	<<set _bodyPart to _args[0]>>

	<<if _bodyPart is "forehead">>
		<<if C.npc.Avery.love gte 60 and C.npc.Avery.rage lt 20 and $enemytrust gt 60>>
			"That's a good <<pcpetname "Avery" "my">>," <<he>> murmurs against your skin.
		<</if>>
	<<else>>
		As <<he>> lavishes attention on your <<if _bodyPart is "chest">><<chest>><<elseif _bodyPart is "bottom">><<bottom>><<else>>thighs<</if>>, it's interspersed with <<= C.npc.Avery.rage gte 60 ? "harsh nips and bites" : C.npc.Avery.rage gte 20 ? "biting and sucking" : "nips and the odd bite">>. <<= $awareness gte 100 ? "<<He>> must be" : "It's almost like <<hes>>">> trying to leave a mark.
	<</if>>
<</widget>>

<<widget "reaction-avery-fondle">>
	<<if !_avery_fondle_speech>>
		<<set _bodyPart to _args[0]>>

		<<if $consensual or (!$consensual and $enemyanger lte 20)>>
			<<set _avery_fondle_speech to 1>>
			<<switch _bodyPart>>
				<<case "chest" "breasts">>
					"Your <<chestsimple>> <<= $player.breastsize gte 5 ? "are so soft, and" : $player.breastsize gte 1 ? "are such a pleasant handful, and so" : "is so sleek, and your nipples such">> fun to play with..."
				<<case "bottom">>
					"You have such <<= $player.bottomsize gte 6 ? "a soft" : $player.bottomsize gte 3 ? "a nice" : "an adorable">> <<bottomsimple>>."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "reaction-avery-initiative">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> <<= either("scoffs","huffs","rolls <<his>> eyes")>>. "Taking initiative, are we? At least you understand what purpose you serve."
	<<else>>
		<<He>> <<= $averyragerevealed is 1 ? "smirks" : "smiles">>. "Taking initiative, are we?" <<He>> seems <<= $averyragerevealed is 1 ? "amused" : "pleased">>.
	<</if>>
<</widget>>

<<widget "reaction-avery-undress">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> narrows <<his>> eyes at you. "You'll leave that to me unless told otherwise."
	<<else>>
		<<print either(
			`<<He>> lets out a laugh. "Trying to save us both time, hm?"`,
			`<<He>> raises both brows. "My, how bold of you, <<pcpetname "Avery">>."`
		)>>
	<</if>>
<</widget>>

<<widget "reaction-avery-choke">>
	<<if _daddy>>
		<<rng>>
		<<if $rng lte 20>>
			<<He>> <<laughs>>. "Let's see if you can still beg for <<nnpc_mummy "Avery">> with <<his>> hand around your throat."
		<<elseif C.npc.Avery.rage gte 60>>
			"I'll give you what you want," <<he>> murmurs darkly, "but not because you begged me to." <<His>> hand squeezes around your throat a little harder.
		<<elseif C.npc.Avery.rage gte 20>>
			"That's right, <<pcpetname "Avery">>." <<He>> <<laughs>> as <<his>> hand squeezes down a little harder. "Finally, you know how to speak to me."
		<<else>>
			"As you wish, <<pcpetname "Avery">>," <<he>> purrs. "Leave it to <<nnpc_mummy "Avery">>."
		<</if>>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pc-line-avery-plead">>
	<<if !$avery_mansion>>
		<<addPairedSpeechLine "Avery" "plead">>
			<<pcLine>>"Was this all the date was for...?"
		<<npcLine>>
			<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
				<<He>> scoffs. "You think you deserve better? You deserve exactly what I give you."
			<<else>>
				<<He>> laughs. "What did you expect, <<pcpetname "Avery">>? <<= either("A fairy tale","My patience to be endless")>>?"
			<</if>>
		<</addPairedSpeechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"I'm sorry! I didn't mean to!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"Don't insult my intelligence," <<he>> snarls. "You knew exactly what you were doing!"
				<<else>>
					"Quiet now. Take your discipline like a good <<girl>>."
				<</if>>
			<</addPairedSpeechLine>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"Please, I promise I'll do better! I promise...!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"You'll 'do better' when I've pulled you into line!"
				<<else>>
					"You will do better. I'll personally ensure it." <<He>> smiles coldly.
				<</if>>
			<</addPairedSpeechLine>>
		<<elseif $averyromance is 1>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"I love you, Avery. Please don't do this to me!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"Don't you dare use that word to manipulate me," <<he>> spits.
				<<else>>
					<<He>> sneers. "If you truly loved me, you wouldn't have defied me."
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"I'm sorry, Avery, please forgive me...!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"I don't want your fucking apologies, I want obedience!"
				<<else>>
					"Look at you, shrinking under me like a good pet. Too bad I'm feeling ruthless," <<he>> purrs.
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-demand">>
	<<if !$avery_mansion>>
		<<addPairedSpeechLine "Avery" "demand">>
			<<pcLine>>"You don't pay me enough to treat me like this!"
		<<npcLine>>
			<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
				"Don't you dare speak to me about money, you greedy little whore!"
			<<else>>
				<<His>> eyes narrow. "You have a lot of nerve demanding more when you act like this."
			<</if>>
		<</addPairedSpeechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"Get the hell away from me! You're taking this too far, Avery!"
			<<npcLine>>
				"It's never too far with you!" <<he>> <<= either("spits","hisses angrily","snarls")>>. "You never appreciate anything I do!<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>> Nothing's ever enough!<</if>>"
			<</addPairedSpeechLine>>
		<<elseif $averyromance is 1>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"I told you I loved you, but I won't hesitate to leave if you don't stop this right now!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<His>> expression twists with anger. "After everything I've done for you, you'd still dare think that <<= either("cesspit","hellhole")>> is preferable to staying with me?"
				<<else>>
					<<His>> expression hardens. "I gave you a chance to escape that miserable life, and you'd throw it back in my face?"
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"Stop it, Avery! I'm<<if $averySeen.includes("walkParkSOYes") or $averyromance>> your <<girlfriend>>,<</if>> not your punching bag!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<He>> laughs derisively. "You want to play the partner? Then learn to submit!"
				<<else>>
					"A title doesn't save you from discipline when you misbehave."
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-forgive">>
	<<if $avery_fate is undefined>>
		<<addSpeechLine "forgive">>
			"You're just angry," you say. "Everyone gets angry sometimes. I forgive you."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "forgive">>
			"Now I understand why you get so angry, Avery," you say. "And I forgive you."
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-moan">>
	<<set _daddy to $submissive gte 1150 and random(1, 4) is 1>>
	<<if $avery_fate is "ascended">>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"I'm all yours, Hound."
		<<npcLine>>
			<<if $consensual>>
				<<if C.npc.Avery.rage gte 60 >>
					<<His>> eyes widen for a moment, then grow dark with desire. "Yes, you are." <<He>> <<= either("scoffs","huffs")>> pridefully. "It's good that you know your place, my little fox."
				<<elseif C.npc.Avery.rage gte 20>>
					<<His>> eyes widen for a moment, then grow dark with desire. "You are, aren't you?" <<He>> smirks with satisfaction. "It's good that you know your place, my little fox..."
				<<else>>
					<<His>> eyes widen for a moment, then grow dark with desire. "Yes... So you are." <<He>> <<laughs>> with satisfaction. "I'm glad you know your place, my little fox."
				<</if>>
			<<elseif C.npc.Avery.rage gte 60 >>
				<<His>> eyes widen for a moment, then grow dark with desire. "Yes, you are." <<He>> <<= either("scoffs","huffs")>> pridefully. "So act like it!"
			<<elseif C.npc.Avery.rage gte 20>>
				<<His>> eyes widen for a moment, then grow dark with desire. "You are, aren't you?" <<He>> smirks with satisfaction. "So you had best act like it, <<girl>>."
			<<else>>
				<<His>> eyes widen for a moment, then grow dark with desire. "Yes... So you are." <<He>> <<laughs>> with satisfaction. "So you had best act like it, <<pcpetname "Avery">>."
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif $averyromance>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"I love you, Avery."
		<<npcLine>>
			<<if C.npc.Avery.rage gte 60 >>
				<<He>> scoffs. "Do you? You've been so bad lately, you had me fooled."
			<<elseif C.npc.Avery.rage gte 20>>
				<<He>> smirks. "I know. But feel free to say it again."
			<<else>>
				<<He>> <<= either("smiles","<<laughs>>")>>. "I know. It's adorable."
			<</if>>
			<<if !$averyUniqueComments.includes("moan_romance")>>
				<<set $averyUniqueComments.pushUnique("moan_romance")>>
				<<npcincr Avery rage -1>><<larage>>
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif _daddy>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"Put me in my place, <<nnpc_mummy "Avery">>."
		<<npcLine>>
			<<set $averyUniqueComments.pushUnique("called_daddy")>>
			<<His>> eyes widen for a moment, but then <<he>> smirks. You think <<he>> liked the sound of you calling <<him>> "<<nnpc_mummy "Avery">>".
			<<if $consensual>>
				<<if C.npc.Avery.rage gte 60 >>
					"Oh, I'll put you in your place alright. <<nnpc_Mummy "Avery">>'s been waiting to punish you properly."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>> smiles knowingly. "You want <<nnpc_mummy "Avery">> to put you in your place? Maybe you've been acting up for attention."
				<<else>>
					<<He>> chuckles. "Mm. I love when you call me that. Don't worry, <<nnpc_mummy "Avery">> will take care of you."
				<</if>>
			<<elseif C.npc.Avery.rage gte 60 >>
				<<He>> sneers. "Oh, I intend to. <<nnpc_mummy "Avery">> is going to remind you exactly where you belong."
			<<elseif C.npc.Avery.rage gte 20>>
				"Acting up just to get <<nnpc_mummy "Avery">>'s hands on you? I'll gladly show you where you belong."
			<<else>>
				"You want <<nnpc_mummy "Avery">> to put you in your place? You could have just asked politely instead of forcing my hand."
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif isLoveInterest("Avery")>>
		<<if !$avery_mansion>>
			<<addPairedSpeechLine "Avery" "moan">>
				<<pcLine>>"Take me away from that place, take me with you."
			<<npcLine>>
				<<if C.npc.Avery.rage gte 60 >>
					"How unfortunate. I seem to recall you wanting nothing to do with me."
				<<elseif C.npc.Avery.rage gte 20>>
					"I should make you ask again. You sound much sweeter when you're desperate."
				<<else>>
					<<He>> smiles impishly. "Mm. You'd look rather lovely waiting for me at home."
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "moan">>
				<<pcLine>>"Let me show you how grateful I am, use me as much as you want."
			<<npcLine>>
				<<if C.npc.Avery.rage gte 60 >>
					"Let's hope this sudden bout of gratitude lasts. Your recent behaviour has been entirely unacceptable."
				<<elseif C.npc.Avery.rage gte 20>>
					"Keep this up and I'll have very little to complain about. You'd like that, wouldn't you?"
				<<else>>
					<<He>> smirks. "Perfectly spoken. Now, let's put that pretty little offer to use."
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<<else>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"You're worth more than any payout."
		<<npcLine>>
			<<if C.npc.Avery.rage gte 60 >>
				<<He>> scoffs. "Is that so? Going by your behaviour of late, I find it difficult to believe."
			<<elseif C.npc.Avery.rage gte 20>>
				<<He>> smirks. "I know. But even so, as long as you behave, the money will keep coming, <<pcpetname "Avery">>."
			<<else>>
				<<He>> <<= either("smiles","<<laughs>>")>>. "Is that how you feel? How adorable."
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>
