:: Widgets reaction-Robin [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-robin-plead">>
	<<addSpeechLine "plead">>
		"Robin, please stop!"
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-robin-demand">>
	<<addSpeechLine "demand">>
		"Robin, stop! I don't want this!"
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-robin-moan">>
	<<if !$robinmist and !$robinMetal>>
		<<if C.npc.Robin.dom gte 70>>
			<<addPairedSpeechLine "Robin" "moan">>
				<<pcLine>>"You know just how to turn me on."
			<<npcLine>>
				<<if C.npc.Robin.trauma gte 20>>
					<<He>> heaves. "Because you're the only one that matters to me."
					<<set _moanHeal to true>>
				<<else>>
					<<print either(
						`<<He>> giggles. "Anything for you."`,
						`<<He>> smiles, beaming with pride and joy.`
					)>>
				<</if>>
				<<if !$robinUniqueComments.includes("moanDom")>>
					<<set $robinUniqueComments.pushUnique("moanDom")>>
					<<npcincr Robin dom 1>><<gdom>>
				<</if>>
				<<if _moanHeal and !$robinUniqueComments.includes("moanHeal")>>
					<<set $robinUniqueComments.pushUnique("moanHeal")>>
					<<npcincr Robin trauma -1>><<lrtrauma>>
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Robin" "moan">>
				<<pcLine>>"I'm gonna melt, you're making me so happy."
			<<npcLine>>
				<<if C.npc.Robin.trauma gte 60>>
					<<His>> eyes become glassy. "I'm very happy too you're here with me."
					<<set _moanHeal to true>>
				<<elseif C.npc.Robin.trauma gte 20>>
					<<He>> lets out a dry chuckle. "I-is that so? You're making me very happy too."
					<<set _moanHeal to true>>
				<<elseif C.npc.Robin.dom lte 30>>
					"Y-you're making me happy too," <<he>> says, cheeks flushing red.
				<<else>>
					"Aww. I'll make sure you don't wash away when you become a puddle," <<he>> chuckles.
				<</if>>
				<<if !$robinUniqueComments.includes("moanDom")>>
					<<set $robinUniqueComments.pushUnique("moanDom")>>
					<<npcincr Robin dom 1>><<gdom>>
				<</if>>
				<<if _moanHeal and !$robinUniqueComments.includes("moanHeal")>>
					<<set $robinUniqueComments.pushUnique("moanHeal")>>
					<<npcincr Robin trauma -1>><<lrtrauma>>
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<</if>>
<</widget>>
