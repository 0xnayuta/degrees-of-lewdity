:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
    <<set $_stringsPre to ($enemyanger lte 60 ? "<<He>> snickers. ":"<<He>> snarls. ")>>
    <<if ($speechpenisvirgin is 1 and $player.virginity.penile is _args[0]) or ($speechvaginavirgin is 1 and $player.virginity.vaginal is _args[0])>>
        <<print $_stringsPre + `"Fuck. Your value just depreciated a little."`>>
    <<elseif $speechanusvirgin is 1 and $player.virginity.anal is _args[0]>>
        <<print $_stringsPre + `"You should be putting out more if you're this tight. What do you think you're good for?"`>>
    <<elseif $speechmouthvirgin is 1 and $player.virginity.oral is _args[0]>>
        <<print $_stringsPre + `"Don't get any funny ideas. Just take it."`>>
    <<elseif $speechkissvirgin is 1 and $player.virginity.kiss is _args[0]>>
        <<print $_stringsPre + `"Surprised are you? You'll learn to kiss better soon."`>>
    <<elseif $speechnamedrop is 1>>
        <<set $speechnamedrop to 0>>
        <<switch _loveInterest>>
            <<case "Robin">>
                <<print $_stringsPre + `"That worthless brat can't save you."`>>
            <<case "Black Wolf" "Great Hawk">>
                <<print $_stringsPre + `"People would pay extra to see you ${$player.penisExist ? "fuck" : "get fucked by"} some beast."`>>
            <<case "Eden">>
                <<print $_stringsPre + `"You'll be going right back to <<nnpc_him 'Eden'>> if you keep this up."`>>
            <<case "Gwylan">>
                <<print `<<He>> pauses, then speaks. "Careful where you bring that name."`>>
            <<default>>
                <<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
        <</switch>>
    <<elseif $speechcum is 1>>
        <<set $_strings to [`"I hope you appreciate that."`,`"Just something to remember me by."`,`"We'll call that your going away gift."`]>>
        <<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
    <<elseif $arousal gte 9500>>
        <<set $_strings to [`"Nice look. Some people would pay big to see you hot and bothered like this."`,`"Should've brought a camera. Your profile would look great with this expression."`]>>
        <<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
    <<elseif $enemyanger lte 60>>
        <<if $rng gte 81>>
            <<set $_options to ["default"]>>
            <<if $hairlength gte 600>>
                <<run $_options.push("hair")>>
            <</if>>
            <<if $player.breastsize gte 6 or $player.penissize gte 4>>
                <<run $_options.push("cow")>>
            <</if>>
            <<if $athletics gte 750 or $physique gte $physiquesize * 0.75>>
                <<run $_options.push("healthy")>>
            <</if>>
            <<switch $_options[random(0, $_options.length - 1)]>>
                <<case "hair">><<print $_stringsPre + `"Kept your hair long? I know someone who will like that."`>>
                <<case "cow">><<print $_stringsPre + `"Cows fetch a high price these days, you know."`>>
                <<case "healthy">><<print $_stringsPre + `"You're strong. Good. Some people pay for the fight."`>>
                <<case "default">><<print $_stringsPre + `"Don't make this harder than it needs to be."`>>
            <</switch>>
        <<elseif $rng gte 61>>
            <<print $_stringsPre + `"You're so valuable!"`>>
        <<elseif $rng gte 41>>
            <<print $_stringsPre + `"Just relax. I'll handle everything like always."`>>
        <<elseif $rng gte 21>>
            <<print $_stringsPre + `"You were always the best looking little ` + ["bastard","shit","<<bitch>>"][random(0,2)] + `."`>>
        <<else>>
            <<print $_stringsPre + `"It's easier this way. Trust me."`>>
        <</if>>
    <<else>>
        <<if $rng gte 91 and $enemyanger lte 70>>
            <<print $_stringsPre + `"Maybe I should inspect you before we go."`>>
        <<else>>
            <<set $_strings to 
                [`Why do you shits have to make it harder on yourselves?`,
                `I told you to hold still.`,
                `You're making it harder on both of us.`,
                `You chose this.`,
                `Are you going to listen to me now?`,
                `I have someone willing to pay big for you.`,
                `You're coming with me, and that's that.`]>>
            <<print $_stringsPre + '"' + $_strings[random(0,6)] + '"'>>
        <</if>>
    <</if>>
<</widget>>