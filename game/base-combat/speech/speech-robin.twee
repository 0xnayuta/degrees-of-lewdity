:: Widgets speech-Robin [widget]
<<widget "speech-robin">>
	<<set _npc_speech to true>>
	<<rng>>
	<<if !$robin.sex.encounterLinesSaid>>
		<<set $robin.sex.encounterLinesSaid to []>>
	<</if>>
	<<if $robin.punishment.inLandfillMistFight>>
		<<speechPool "Robin" "noMouthAction">>
		<<if $speechPlayerHits>>
			<<addSpeechLine "playerHits">>
			<<speechLine>>
				<<He>> flinches as you strike. "Ugh!"
			<<speechLine>>
				<<He>> recoils as you hit <<him>>.
			<</addSpeechLine>>
		<</if>>
		<<if $speechScreamForHelp>>
			<<addSpeechLine "screamForHelp">>
			<<speechLine>>
				It goes over <<his>> head.
			<<speechLine>>
				<<He>> doesn't react.
			<<speechLine>>
				Robin tries to react to your screams, but fails.
			<</addSpeechLine>>
		<</if>>
		<<if $speechPepperSpray>>
			<<addSpeechLine "pepperSpray">>
				"Ouch!" <<He>> recoils with <<his>> hands over <<his>> eyes. <<stress 6>><<gstress>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechPlayerBeaten>>
			<<addSpeechLine "playerBeaten">>
			<<speechLine>>
				<<He>> grimaces. "I'm sorry. I'm so sorry."
			<<speechLine>>
				"P-please stop..." <<he>> pleads, but not at you.
			<</addSpeechLine>>
		<</if>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			Robin is crying. <<grtrauma>>
		<<speechLine>>
			Robin frantically tries to look away from you, but <<he>> doesn't stop. <<grtrauma>>
		<<speechLine>>
			"I d-don't...<<if !$robin.romance>> I don't want to...<</if>>" Robin whispers under <<his>> breath. <<grtrauma>>
		<<speechLine>>
			<<if $robin.romance>>"I love you!" Robin says, though <<hes>> not smiling.<<else>>"I'm so sorry!" Robin says, looking horrified.<</if>> <<grtrauma>>
		<<speechLine>>
			"P-please, I just need—" Robin gasps. <<He>> doesn't try to finish <<his>> sentence. <<grtrauma>>
		<<speechLine>>
			Robin closes <<his>> eyes, unable to meet your gaze. <<grtrauma>>
		<<speechLine>>
			Robin cries out. Tears are running down <<his>> face. <<grtrauma>>
		<<speechLine>>
			Robin shakes <<his>> head and closes <<his>> eyes. <<grtrauma>>
		<<speechLine>>
			"S-stop it!" Robin yells, but not at you. <<grtrauma>>
		<<speechLine>>
			"<<if $robin.romance>>I need you...<<else>>I'm sorry... I'm sorry... I need to...<</if>>" Robin says with teary eyes. <<grtrauma>>
		<</addSpeechLine>>
		<<if ($speechPenisVirgin and $player.virginity.penile is "Robin") or ($speechVaginaVirgin and $player.virginity.vaginal is "Robin")>>
			<<addSpeechLine "virginity">>
				"I'm sorry, I'm sorry, I'm sorry..." <<he>> repeats with tears.
			<</addSpeechLine>>
		<</if>>
		<<if $speechLINameDrop>>
			<<addSpeechLine "namedrop">>
			<<speechLine>>
				<<He>> doesn't react to your voice.
			<<speechLine>>
				<<He>> pants harder, unable to hear you.
			<</addSpeechLine>>
		<</if>>
		<<speechSay>>
	<<elseif $robin.ub.inMetalScene>>
		<<speechPool "Robin" "noMouthAction">>
		<<addSpeechLine "idle">>
		<<speechLine>>
			Robin can't maintain eye contact.
		<<speechLine>>
			<<if $robin.romance>>"Hurry," Robin whispers. "So they'll leave you alone."<<else>>"Please don't hate me," Robin whispers. "You have to... I'm sorry."<</if>>
		<<speechLine>>
			Robin struggles against <<his>> bindings.
		<<speechLine>>
			Robin struggles against the metal tentacles holding <<him>>. They don't budge.
		<<speechLine>>
			"Please," Robin whimpers.
		<<speechLine>>
			Robin stifles a sob.
		<<speechLine>>
			"I'm sorry," Robin hiccups.
		<<speechLine>>
			"They did something to me," Robin says shamefully. "I feel... numb."
		<<speechLine>>
			<<if $robin.romance>>"I'm sorry it's taking so long," Robin mutters.<<else>>"I'm so sorry," Robin mutters. "I'm trying to, I... I can't..."<</if>>
		<<speechLine>>
			<<if $robin.romance>>"They're using me against you," Robin sobs.<<else>>"You're my friend," Robin sobs. "I don't want to do this..."<</if>>
		<</addSpeechLine>>
		<<speechSay>>
	<<else>>
		<<speechPool "Robin">>
		<<set _robinInCombat to $NPCList.find(npc => npc.fullDescription === "Robin")>>
		<<set _robinHandFree to _robinInCombat.lefthand is 0 or _robinInCombat.righthand is 0>>
		<<if C.npc.Robin.trauma gte 20 and $rng gte 90 and !$weekly.robin.punishmentTalkHealed>>
			<<if $robin.punishment.placesSentTo.includes("mansion")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if C.npc.Robin.dom gte 70>>
						"I'd choose your touch over those... those rich creeps any day." <<He>> catches <<himself>> before saying anything harsher.
					<<else>>
						"Even after what happened at that party... I still like your touch the most," <<he>> whispers.
					<</if>>
					<<robinMemoryHeal "healedMansion">>
				<</addSpeechLine>>
			<</if>>
			<<if $robin.punishment.placesSentTo.includes("landfill") and C.npc.Robin.love gte 60>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if C.npc.Robin.trauma gte 60>>
						"I need you so badly," <<he>> <<= either("whispers","sobs","heaves")>>. "Those feelings were never just the mist."
					<<else>>
						"I know I was under the pink mist's influence back then, but... I do love you. So, so much." <<He>> smiles, <<his>> eyes glassy.
					<</if>>
					<<robinMemoryHeal "healedMist">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("rescuedFromPillory")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if Memories.Robin.has("strippedInPillory")>>
						"As long as you come for me, I know I'm safe in your hands," <<he>> whispers.
					<<else>>
						"My hero..." Robin's voice trembles. "You saved me from the wretched people of this town. I'm yours."
					<</if>>
					<<robinMemoryHeal "healedPilloryRescue">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("ubMetalTogether")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<print either(
						`"Take your time..." <<he>> <<= either("smiles warmly","whispers","murmurs")>>. "We don't have to put on a show anymore."`,
						`"You don't have to rush..." <<he>> <<= either("smiles warmly","whispers","murmurs")>>. "No one is forcing you to perform."`
					)>>
					<<robinMemoryHeal "healedUbMetal">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("ubPunishedTogether") and (C.npc.Robin.virginity.anal is "player" or C.npc.Robin.virginity.vaginal is "player" or C.npc.Robin.virginity.penile is "player" or C.npc.Robin.dom gte 70)>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if C.npc.Robin.virginity.anal is "player" or C.npc.Robin.virginity.vaginal is "player" or C.npc.Robin.virginity.penile is "player">>
						"I'm so glad I gave my virginity to you before those creeps could take it." <<He>> smiles.
					<<elseif C.npc.Robin.dom gte 70>>
						"Those people are nothing compared to you... to what we have, and what we're sharing right now." <<He>> smiles.
					<</if>>
					<<robinMemoryHeal "healedUbDouble">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("ubMachineTogether") and (!Memories.Robin.has("ubBeggedMachineSlower") or C.npc.Robin.trauma gte 60)>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if Memories.Robin.has("ubBeggedMachineSlower")>>
						"I'm sorry for what I said back then," <<he>> whispers. "I hope you've forgiven me..."
					<<else>>
						"You held back for me back then," <<he>> heaves. "I'll make it up to you tenfold."
					<</if>>
					<<robinMemoryHeal "healedUbMachine">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("ubEscapedAlone")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					"My hero..." <<he>> <<= either("whispers","sobs","heaves")>>. "They can't keep us apart anymore."
					<<robinMemoryHeal "healedUbEscape">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("ubEscapedTogether")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					<<if Memories.Robin.has("ubEscapedThroughHunt")>>
						"My hero..." Robin's voice trembles. "You came back and saved me. Let me make you feel just as cherished."
					<<elseif Memories.Robin.has("ubEscapedFromMetal")>>
						"They can't keep us there anymore," <<he>> whispers. "I'll come with you wherever you go."
					<<else>>
						"I'm so glad we made it out of that horrible place," <<he>> whispers. <<if C.npc.Robin.dom gte 70>>"I won't let Bailey take us again."<<else>>"I never want to go back."<</if>>
					<</if>>
					<<robinMemoryHeal "healedUbEscape">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("rescuedFromDocksAlone")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					"I can't thank you enough, my hero," <<he>> whispers. "You came for me and went through so much for me... I'll make it up to you tenfold."
					<<robinMemoryHeal "healedDocksAlone">>
				<</addSpeechLine>>
			<</if>>
			<<if Memories.Robin.has("rescuedFromDocksWithDockers")>>
				<<addSpeechLine "memory">>
					<<set $weekly.robin.punishmentTalkHealed to true>>
					"I don't remember much... but I remember you rallying people to save me," <<he>> whispers. "You were so gallant back then."
					<<robinMemoryHeal "healedDocksWithDockers">>
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $speechNPCPenisVirgin or $speechNPCVaginaVirgin>>
			<<addSpeechLine "virginity">>
				<<if $speechVaginaVirgin is 1 or $speechAnusVirgin is 1>>
					<<He>> gasps. "Sorry! It's my first time too! I hope I'm doing well."
				<<else>>
					<<He>> marvels. "Sorry! I didn't expect it to feel like this... let's keep going!"
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechNPCAnusVirgin>>
			<<addSpeechLine "virginity">>
				<<if $speechPenisVirgin is 1>>
					<<He>> grimaces. "This feels a bit weird." Then <<he>> smiles. "I hope I'm not doing a bad job for our first time!"
				<<else>>
					<<He>> grimaces. "This feels a bit weird." Then <<he>> brightens up. "I hope I'm doing alright."
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if ($speechPenisVirgin and $player.virginity.penile is "Robin") or ($speechVaginaVirgin and $player.virginity.vaginal is "Robin")>>
			<<if $speechVaginaVirgin>>
				<<set _robinVirginityTaken to C.npc.Robin.virginity.penile>>
			<<elseif $penisstate is "otheranus">>
				<<set _robinVirginityTaken to C.npc.Robin.virginity.anal>>
			<<else>>
				<<set _robinVirginityTaken to C.npc.Robin.virginity.vaginal>>
			<</if>>
			<<addSpeechLine "virginity">>
				<<if $speechNPCPenisVirgin or $speechNPCVaginaVirgin>>
					<<His>> eyes widen. "You were a virgin too? Thank you!" Tears roll down <<his>> cheeks. "I really don't deserve something so special..."
				<<elseif $speechVaginaVirgin and C.npc.Robin.penis isnot "none" and C.npc.Robin.penissize gte 3>>
					<<He>> gasps. "You saved yourself for me." <<He>> looks concerned. "Does it hurt? Tell me to stop if it becomes too painful."
				<<elseif _robinVirginityTaken isnot true and _robinVirginityTaken isnot "player">>
					<<He>> gasps softly. "You saved yourself for me." Tears roll down <<his>> cheeks. "I wish I had done the same for you."
				<<else>>
					<<He>> gasps. "You saved yourself for me. I don't deserve something so special. Thank you." Tears roll down <<his>> cheeks.
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $player.virginity.anal is "Robin" and $speechAnusVirgin>>
			<<addSpeechLine "virginity">>
				<<He>> gasps. "This is so naughty!"
			<</addSpeechLine>>
			<<if $player.virginity.vaginal isnot "Robin" and $player.virginity.penile isnot "Robin">>
				<<addSpeechLine "virginity">>
					<<He>> smiles. "Thank you for giving me something so special."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $player.virginity.oral is "Robin" and $speechOralVirgin>>
			<<addSpeechLine "virginity">>
				<<He>> gasps. "You're making me feel funny down there."
			<</addSpeechLine>>
		<</if>>
		<<if $speechKissVirgin and $player.virginity.kiss is "Robin">>
			<<addSpeechLine "virginity">>
				<<if $speechNPCKissVirgin>>
					<<He>> smiles with tears in <<his>> eyes. "I'm so glad we're each other's first kiss."
				<<else>>
					<<He>> smiles with tears in <<his>> eyes. "I'm so glad to be your first kiss."
				<</if>>
			<</addSpeechLine>>
		<<elseif $speechNPCKissVirgin>>
			<<addSpeechLine "virginity">>
				<<He>> smiles with tears in <<his>> eyes. "I'm so glad you're my first kiss."
			<</addSpeechLine>>
		<</if>>
		<<if $speechExposeBreasts>>
			<<addSpeechLine "expose">>
				<<if $player.breastsize gte 5 and !Memories.Robin.has("sawPcBigBreasts")>>
					<<run Memories.Robin.add("sawPcBigBreasts")>>
					<<His>> eyes widen in surprise. "I didn't expect them to be so big!"
				<<elseif $player.breastsize lte 2>>
					"Cute," <<he>> says.
					<<if insecurityExists("breasts_small") and !$robin.sex.encounterLinesSaid.includes("smallBreastsAcceptance")>><<set $robin.sex.encounterLinesSaid.pushUnique("smallBreastsAcceptance")>><<acceptance "breasts_small" 10>><<gacceptance>><</if>>
				<<else>>
					"Your breasts always surprise me," <<he>> says. "But I still love them!"
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechPenisBig>>
			<<if C.npc.Robin.penis isnot "none">>
				<<if C.npc.Robin.penissize gte 3>>
					<<addSpeechLine "penisSize">>
					<<speechLine>>
						<<He>> looks at your <<genitals>> in surprise. "We match! I'm so happy!"
					<<speechLine>>
						<<He>> looks at your <<genitals>>. "I will try my best!"
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "penisSize">>
					<<speechLine>>
						<<His>> eyes widen. "You're bigger than I thought!"
					<<speechLine>>
						<<He>> looks at your <<genitals>>. "I will try my best!"
					<</addSpeechLine>>
				<</if>>
			<<else>>
				<<addSpeechLine "penisSize">>
				<<speechLine>>
					<<He>> gasps. "Were you always this big?"
				<<speechLine>>
					<<He>> stares at your <<genitals>>. "I hope I will be able to take it!"
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $speechNoticeSexToy>>
			<<if C.npc.Robin.dom gte 70>>
				<<addSpeechLine "sexToy">>
					<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
				<<speechLine>>
					<<He>> looks at your $_sexToy and giggles. "I've wanted to do this with you for a while."
				<<speechLine>>
					<<He>> looks at your $_sexToy and giggles. "This is so dirty... keep going."
				<</addSpeechLine>>
			<<elseif C.npc.Robin.dom lte 30>>
				<<addSpeechLine "sexToy">>
					<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
				<<speechLine>>
					<<He>> looks at your $_sexToy and blushes. "Woah! Don't you feel embarrassed?"
				<<speechLine>>
					<<He>> looks at your $_sexToy and blushes. "Just take it slow, okay?"
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "sexToy">>
					<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
				<<speechLine>>
					<<He>> looks at your $_sexToy and giggles. "I can't believe you're touching that."
				<<speechLine>>
					<<He>> looks at your $_sexToy and giggles. "This is so dirty... keep going."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $speechChokedWheeze>>
			<<if C.npc.Robin.dom gte 70>>
				<<addSpeechLine "choked">>
				<<speechLine>>
					<<He>> <<= either("smiles","giggles","chuckles","grins")>>. "Is this too much? But you sound so lovely!"
				<<speechLine>>
					"Oh? You've got something to say?" <<he>> asks with a teasing smile.
				<</addSpeechLine>>
			<<elseif C.npc.Robin.dom lte 30>>
				<<addSpeechLine "choked">>
				<<speechLine>>
					<<He>> <<= either("stammers","stutters","is taken aback")>>. "S-sorry! Am I too rough?"
				<<speechLine>>
					<<He>> looks uncertain. "<<= either("Please tell me if you want me to stop","Should I keep going? I don't want to hurt you")>>."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "choked">>
				<<speechLine>>
					"What was that?" Robin tilts <<his>> ear closer to you.
				<<speechLine>>
					"Are you sure you want to be talking right now?" <<he>> says with a teasing smile.
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $speechApologise>>
			<<addSpeechLine "apologise">>
				<<if C.npc.Robin.dom gte 70>>
					<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
						"It's okay. We'll get through this together," <<he>> smiles at you<<if _robinHandFree>> and gives you a reassuring squeeze<</if>>.
					<<elseif $panicviolenceRecent>>
						"Don't worry about it. I know you've been through a lot," <<he>> says with a gentle smile.
					<<else>>
						<<He>> hesitates a moment before smiling. "I forgive you, but please don't do that again, okay?"
					<</if>>
				<<elseif C.npc.Robin.dom lte 30>>
					<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
						<<He>> heaves. "I... understand. It's okay. I'll stay with you."
					<<elseif $panicviolenceRecent>>
						"A-are you okay? Should we stop?" <<He>> seems uncertain.
					<<else>>
						<<He>> stares at you before breaking into a chuckle. "Ah, so you were just joking? It's okay then, I'm not mad."
					<</if>>
				<<else>>
					<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
						"It's okay. I understand what you're going through. You don't need to apologise." <<He>> smiles gently at you.
					<<elseif $panicviolenceRecent>>
						<<He>> looks concerned. "You're worrying me. Are you really okay?"
					<<else>>
						"It's okay! I'm not that mad." <<He>> <<= either("smiles","giggles","chuckles","grins")>>.
					<</if>>
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechApologiseRejected>>
			<<addSpeechLine "apologise">>
				<<if C.npc.Robin.dom gte 70>>
					<<if $panicviolenceRecent>>
						"Don't worry, I can handle this," <<he>> reassures you.
					<<else>>
						"Ugh, stop that!" Robin pouts, though there's no real bite to <<his>> words.
					<</if>>
				<<elseif C.npc.Robin.dom lte 30>>
					<<if $panicviolenceRecent>>
						Despite the pain, <<he>> manages a gentle smile.
					<<else>>
						<<He>> smiles awkwardly, unsure of how to respond.
					<</if>>
				<<else>>
					<<if $panicviolenceRecent>>
						"It's okay, just let it all out," <<he>> says. "I'll take care of you."
					<<else>>
						<<He>> raises an eyebrow and chuckles.
					<</if>>
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechAskRough>>
			<<if C.npc.Robin.dom gte 70>>
				<<addSpeechLine "askRough">>
				<<speechLine>>
					"Since you really want this, I guess I'll have to show you what I've got!"
				<<speechLine>>
					"Alright. Just let me know if it's too much, okay?" <<He>> smiles at you.
				<</addSpeechLine>>
			<<elseif C.npc.Robin.dom lte 30>>
				<<addSpeechLine "askRough">>
				<<speechLine>>
					<<His>> eyes widen. "W-why would you want that?"
				<<speechLine>>
					<<He>> looks uncertain. "I don't want to hurt you..."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "askRough">>
				<<speechLine>>
					<<He>> speaks. "You want me to be rougher? I'm sorry, I'm already being as rough as I can."
				<<speechLine>>
					"You really sure? I mean I can certainly try, but..." <<He>> gives you a hesitant look.
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $speechMoan>>
			<<addSpeechLine "moan">>
				<<if C.npc.Robin.dom gte 70>>
					<<print either(
						`<<He>> <<= either("smiles","giggles","chuckles","grins")>>. "Let me hear more," <<he>> moans back to you.`,
						`<<He>> <<= either("smiles","giggles","chuckles","grins")>>. "Keep going. I love hearing that."`,
						`<<He>> moans back to you, eyes glinting with excitement.`
					)>>
				<<elseif C.npc.Robin.dom lte 30>>
					<<if C.npc.Robin.trauma gte 80>>
						"Please," <<his>> voice breaks. "I'm nothing without you."
						<<set _moanHeal to true>>
					<<elseif C.npc.Robin.trauma gte 40>>
						<<He>> heaves, a smile barely cracking <<his>> blank face.
						<<set _moanHeal to true>>
					<<elseif C.npc.Robin.trauma gte 20>>
						"That's..." <<He>> fumbles for words as <<his>> eyes dart away.
						<<set _moanHeal to true>>
					<<else>>
						<<print either(
							`<<His>> cheeks and ears redden. "I can't believe you're saying that!"`,
							`<<He>> <<= either("smiles","giggles","chuckles","grins")>>. "That sounds so dirty."`,
							`<<He>> chuckles awkwardly. "Y-you're not embarrassed saying things like that?"`
						)>>
					<</if>>
				<<else>>
