			<</addinlineevent>>
		<</if>>
		<<if _eventpool.length gt 0>>
			<<set _robinMemory to true>>
		<</if>>
	<</if>>

	<<if $robinmist>>
		<<if $speechhit is 1>>
			<<print either(
				`<<He>> flinches as you strike. "Ugh!"`,
				`<<He>> recoils as you hit <<him>>.`
			)>>
