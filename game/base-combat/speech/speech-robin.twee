					`"T-that feels nice," <<he>> murmurs.`,
					`"This feels... This feels a little dirty," <<he>> admits as <<his>> cheeks redden.`
				)>>
			<<else>>
				<<print either(
					`<<His>> cheeks remain flushed despite the conflicted look on <<his>> face.`,
					`"You're making me blush," <<he>> <<= either("murmurs","whispers","smiles bashfully")>>.`
				)>>
			<</if>>
		<<else>>
			<<if currentSkillValue("oralskill") gte 400>>
				<<print either(
					`<<He>> smiles as <<he>> sighs in pleasure.`,
					`"You're awfully affectionate today." <<He>> <<= either("giggles","chuckles","smiles")>>.`
				)>>
			<<else>>
				<<print either(
					`<<He>> <<= either("gasps","chuckles","giggles")>>. "That tickles!"`,
					`"Is that all you're going to do?" <<he>> <<= either("chuckles","giggles","teases you")>>.`
				)>>
			<</if>>
		<</if>>
	<<elseif $speechvaginavagina is 1 and C.npc.Robin.dom gte 70 and $fame.sex gte 600>>
		"So... where would you rank mine?" <<He>> smiles.
	<<elseif $speechanallick is 1 and C.npc.Robin.dom lte 30>>
		<<print either(
			`"It feels a bit ticklish!" <<He>> <<= either("giggles", "smiles", "chuckles")>>.`,
			`"This feels a bit naughty," <<he>> <<= either("gasps", "says in surprise")>>.`
		)>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
