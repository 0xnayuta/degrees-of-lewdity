:: Widgets Speech Named NPCs [widget]

/* The NNPC's speech lines for this turn. Sets _noNameComment when the NNPC has no speech widget or passes, so generic comments or mouth actions play instead.
   <<namedNpcComments $NPCList[_n].fullDescription>> */
<<widget "namedNpcComments">>
	<<unset _noNameComment>>
	<<if !_silent>>
		<<switch _args[0]>>
			<<case "Alex">><<speech-alex>>
			<<case "Avery">><<speech-avery>>
			<<case "Bailey">><<speech-bailey>>
			<<case "Eden">><<speech-eden>>
			<<case "Gwylan">><<speech-gwylan>>
			<<case "Harper">><<speech-harper>>
			<<case "Kylar">><<speech-kylar>>
			<<case "Leighton">><<speech-leighton>>
			<<case "Morgan">><<speech-morgan>>
			<<case "Robin">><<speech-robin>>
			<<case "Sydney">><<speech-sydney>>
			<<case "Whitney">><<speech-whitney>>
			<<case "Zephyr">><<speech-zephyr>>
			<<case "Ivory Wraith">><<speechWraith>>
			<<default>><<set _noNameComment to true>>
		<</switch>>
	<</if>>
<</widget>>

/* The NNPC's reaction to something that just happened.
   <<namedNpcReaction _n "kissSkin" "thighs">> -> <<reaction-avery-kissSkin "thighs">>
   _args[0] is the $NPCList index
   _args[1] the event
   _args[2] the body part (for kissSkin and fondle) */
<<widget "namedNpcReaction">>
	<<switch $NPCList[_args[0]].fullDescription>>
		<<case "Avery">>
			<<switch _args[1]>>
				<<case "choke">><<reaction-avery-choke>>
				<<case "fondle">><<reaction-avery-fondle _args[2]>>
				<<case "initiative">><<reaction-avery-initiative>>
				<<case "kissImminent">><<reaction-avery-kissImminent>>
				<<case "kissSkin">><<reaction-avery-kissSkin _args[2]>>
				<<case "undress">><<reaction-avery-undress>>
			<</switch>>
		<<case "Gwylan">>
			<<switch _args[1]>>
				<<case "kiss">><<reaction-gwylan-kiss>>
				<<case "kissDeep">><<reaction-gwylan-kissDeep>>
			<</switch>>
		<<case "Sydney">>
			<<if _args[1] is "expose">><<reaction-sydney-expose>><</if>>
	<</switch>>
<</widget>>

