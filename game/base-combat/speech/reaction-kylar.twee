:: Widgets reaction-Kylar [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-kylar-plead">>
	<<addSpeechLine "plead">>
		"Kylar... I thought you loved me..."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-kylar-demand">>
	<<addSpeechLine "demand">>
		"I'm not in the mood for your shit right now, Kylar."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-kylar-moan">>
	<<addSpeechLine "moan">>
		"You're the only one I need, Kylar."
	<</addSpeechLine>>
<</widget>>
