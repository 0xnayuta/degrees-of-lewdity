				"You're not a bad <<girl>>, are you?"
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"You're <<cute>>, but you'll need more than this if you want my forgiveness."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"I needed this..."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"At least you're good for something."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"There. See? You can be good when you want to be."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"I'd really rather not have to be angry with you, <<pcpetname "Avery">>."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"This is all I wanted from you today. Was that so hard?"
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"Don't make me regret going easy on you."
			<</addSpeechLine>>
			<<addSpeechLine "idle">>
				"You're fortunate I'm so fond of you."
			<</addSpeechLine>>
		<</if>>
	<<elseif C.npc.Avery.love gte 60>>
		<<addSpeechLine "idle">>
			"You seem so fragile like this. <<= $speech_attitude is "meek" or $speech_attitude_avery ? "More so than usual" : $speech_attitude is "bratty" ? "Unlike usual" : "It's quite charming">>..."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			<<if $avery_mansion>>
				"I might want another round after this," <<he>> says with a breathy laugh.
			<<else>>
				"Be careful, <<pcpetname "Avery">>, or I'll want to keep you," <<he>> teases with a breathy laugh.
			<</if>>
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "idle">>
			<<He>> murmurs, "I wonder..." But <<he>> doesn't finish the thought, just <<= either("smirks lecherously","smiles secretively")>> at you.
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"Oh, I could just eat you up..."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"What sweet sounds..."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"Good <<girl>>..."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"Memories of you like this will tide me over the next time I'm <<= either("swamped with paperwork","stuck in traffic","forced to sit through another boring meeting")>>... For a while, at least."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"How did I ever manage without you..."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"I don't think I'll ever tire of this."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"I've been thinking about this all day, if you must know."
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"I picked well, didn't I?" <<he>> muses, <<= either("an impish","a coy","a sly")>> smile crossing <<his>> lips.
		<</addSpeechLine>>
		<<addSpeechLine "idle">>
			"I've acquired many fine things in life. None of them look quite like this."
		<</addSpeechLine>>
	<</if>>
<</widget>>

/* Transformation comments are weighted at 3 */
<<widget "averyTfComments">>
	<<set _tf to checkTFparts()>>
	<<set _tfWeight to 3>>
	<<if !$averyUniqueComments.includes("transformation")>>
		<<if Object.keys(_tf).length isnot 0>>
			/* There's at least one transformation - TFs are for speech. There's no admire action yet */

			/* Angel */
			<<if $angel gte 6 and (_tf.angelHalo or _tf.angelWings)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My innocent little angel..." <<He>> grins, and plucks a feather from one of your wings, making you gasp.
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My disobedient little angel..." <<He>> purses <<his>> lips, and pulls a feather from one of your wings, making you gasp.
					<</addSpeechLine>>
				<</if>>
			<</if>>

			/* Demon */
			<<if $demon gte 6 and (_tf.demonHorns or _tf.demonWings or _tf.demonTail)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My sinful little devil..." <<He>> smirks, and pulls on your tail, making you shiver.
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My defiant little devil..." <<He>> scowls, and yanks on your tail, making you jolt.
					<</addSpeechLine>>
				<</if>>
			<</if>>

			/* Fallen Angel */
			<<if $fallenangel gte 0 and (_tf.fallenAngelHalo or _tf.fallenAngelWings)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My poor little angel..." <<He>> grins, and plucks a feather from one of your wings, making you gasp.
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My wretched little angel..." <<He>> purses <<his>> lips, and plucks a feather from one of your wings, making you gasp.
					<</addSpeechLine>>
				<</if>>
			<</if>>

			/* Cat */
			<<if $cat gte 6 and (_tf.catEars or _tf.catTail)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My pretty little kitten..." <<He>> <<= either(
							"scratches behind one of your ears, making you shiver.", "pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My temperamental little kitten..." <<He>> <<= either("tugs on one of your ears, making you yowl.", "pulls on your tail, making you jolt.")>>
					<</addSpeechLine>>
				<</if>>
			<</if>>
			/* Wolf */
			<<if $wolfgirl gte 6 and (_tf.wolfEars or _tf.wolfTail)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My precious little puppy..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My ill-behaved little puppy..." <<He>> <<= either(
							"tugs on one of your ears, making you whimper.",
						"pulls on your tail, making you jolt.")>>
					<</addSpeechLine>>
				<</if>>
			<</if>>
			/* Cow */
			<<if $cow gte 6 and (_tf.cowHorns or _tf.cowTail)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						My cute little <<=$player.gender_appearance is "m" ? "cowboy" : "cowgirl">>..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						My cute little <<=$player.gender_appearance is "m" ? "cowboy" : "cowgirl">>..." <<He>> <<= either("tugs on one of your ears, making you moo with pain.","pulls on your tail, making you jolt.")>>
					<</addSpeechLine>>
				<</if>>
			<</if>>
			/* Fox */
			<<if $fox gte 6 and (_tf.foxEars or _tf.foxTail)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My adorable little fox..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My fickle little fox..." <<He>> <<= either("tugs on one of your ears, making you yip.","pulls on your tail, making you jolt.")>>
					<</addSpeechLine>>
				<</if>>
			<</if>>
			/* Harpy */
			<<if $harpy gte 6 and (_tf.birdWings or _tf.birdTail or _tf.birdPlumage)>>
				<<if $consensual>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My sweet little songbird..." <<He>> <<= either("pulls a feather from your plumage, making you gasp.","pulls a feather from your tail, making you whimper.","scratches underneath your chin, like a pet.")>>
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "idle" _tfWeight>>
						<<set $averyUniqueComments.pushUnique("transformation")>>
						"My wayward little songbird..." <<He>> <<= either("pulls a feather from your plumage, making you squawk.","pulls a feather from your tail, making you jolt.")>>
					<</addSpeechLine>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "averyCondomUseSpeech">>
	<<set _avery to $NPCList.find(npc => npc.fullDescription === "Avery")>>
	<<set _condomSpeechCase to _args[0]>>
	<<switch _condomSpeechCase>>
		<<case "accept" "acceptHas">>
			<<if $consensual>>
				<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
					<<He_Short>> seems irritated at your request<<if C.npc.Avery.lust gte 60>>, looking like <<he>> wants to say no<</if>>. <span class="green"><<if playerPregnancyRisk() gte 3>>"Better safe than sorry," <<else>>"Fine," <</if>><<he>> says<<if C.npc.Avery.lust gte 60>> eventually<</if>></span>. "But don't presume to tell me what to do again, <<girl>>."<<if _avery.lefthand is 0 or _avery.righthand is 0>> <<He_Short>> <<= either("spanks your ass","slaps your thigh","smacks the back of your head")>> punitively.<</if>> "You're lucky I'm in a forgiving mood."
					<<if !$averyUniqueComments.includes("condom")>><<set $averyUniqueComments.pushUnique("condom")>><<set $enemyanger += 15>><</if>>
				<<elseif $averyragerevealed is 1 and C.npc.Avery.rage gte 20>>
					<<He_Short>> <<= either(`rolls <<his>> eyes`,`sighs`,`purses <<his>> lips`)>><<if C.npc.Avery.lust gte 60>>, looking reluctant<</if>>. <span class="green">"If you insist," <<he>> says<<if C.npc.Avery.lust gte 60>> eventually<</if>></span>.
				<<else>>
					"A condom?" <<He_Short>> hums<<if C.npc.Avery.lust gte 60>>, looking conflicted<</if>>. After a weighty pause<<if $averyragerevealed gte 1>> and a put upon sigh<</if>>, <<he>> nods. <span class="green">"Very well."</span>
				<</if>>
			<<elseif C.npc.Avery.rage gte 60 or $enemyanger gt 100>>
				<<He_Short>> seems irritated at your request<<if C.npc.Avery.lust gte 60>>, looking like <<he>> wants to say no<</if>>. <span class="green">"I will," <<he>> says. "But not because you told me to, <<girl>>. <<if playerPregnancyRisk() gte 3>>Only because I don't want to be presented with a nuisance in the near future.<</if>>"</span><<if _avery.lefthand is 0 or _avery.righthand is 0>> <<He_Short>> <<= either("spanks your ass","slaps your thigh","smacks the back of your head")>> punitively.<</if>>
				<<if !$averyUniqueComments.includes("condom")>><<set $averyUniqueComments.pushUnique("condom")>><<set $enemyanger += 15>><</if>>
			<<elseif C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
				"You have some fucking nerve asking for that now," <<he>> snipes, narrowing <<his>> eyes at you.<<if C.npc.Avery.lust gte 60>> For a moment, it looks like <<he>> wants to say no.<</if>> <span class="green">"But fine."</span>
			<<else>>
				"A condom?" <<He_Short>> raises an eyebrow at you.<<if C.npc.Avery.lust gte 60>> <<Hes>> quiet long enough that you worry <<he>> intends to ignore your request, but finally says, <</if>><span class="green">"Fine. As a reward for good behavior."</span>
			<</if>>
		<<case "acceptGive">>
			/*Replace or adjust me; I don't think you're supposed to reach it*/
			<<He_Short>> raises an eyebrow. "I'm usually prepared to that kind of situation, and yet for some reason, <span class="blue">they're nowhere to be found on my belongings</span>. Have you been cheating, <<pcpetname "Avery">>?"
		<<case "reject">>
			/*Replace or adjust me*/
			<span class="red"><<He_Short>> refuses!</span>
	<</switch>>
<</widget>>
