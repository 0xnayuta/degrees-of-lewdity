:: Widgets reaction-Sydney [widget]

<<widget "reaction-sydney-expose">>
	<<sydneyExpose>>
<</widget>>

/* PC lines (plead / demand / moan). */

<<widget "pc-line-sydney-plead">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<addSpeechLine "plead">>
			"I thought... you said lust was a sin..."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "plead">>
			"I'm sorry, I'll be pure! Please stop!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-sydney-demand">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<addSpeechLine "demand">>
			"I miss when you were pure. At least you didn't pull shit like this."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "demand">>
			"What sort of punishment is this? Get off me!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-sydney-moan">>
	<<run statusCheck("Sydney")>>
	<<if !_sydneyChastity>>
		<<if _sydneyStatus.includes("corrupt")>>
			<<addSpeechLine "moan">>
				"You're the most delicious sin of all."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "moan">>
				"Forever, as one."
			<</addSpeechLine>>
		<</if>>
	<<else>>
		<<addSpeechLine "moan">>
			"You make me so lustful."
		<</addSpeechLine>>
	<</if>>
<</widget>>
