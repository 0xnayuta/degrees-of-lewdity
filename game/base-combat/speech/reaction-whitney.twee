:: Widgets reaction-Whitney [widget]

/* PC lines (plead / demand / forgive / moan / mock).
_args[0] of the mock widget is $mockaction. */
<<widget "pc-line-whitney-mock">>
	<<if _args[0] is "looks">>
		<<addPairedSpeechLine "Whitney" "mock">>
			<<pcLine>>"I know you can't control your cronies anymore," you spit. "But at least do something about that mug of yours!"
		<<npcLine>>
			<<if C.npc.Whitney.dom lte 10>>
				<<He>> stops, then gnashes <<his>> teeth together in rage. "You've got jokes.<<if $audiencepresent gte 1>> The slut's got fucking jokes!<</if>>"
			<<elseif C.npc.Whitney.dom gte 15>>
				<<He>> stops, then grins. "You're one to talk right now, slut. <<if $audiencepresent gte 1>>You guys hearing this shit?<</if>>"
			<<else>>
				<<He>> stops, then forces a grin. "Hah. You really got me there. Shut up!"
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>


<<widget "pc-line-whitney-plead">>
	<<addSpeechLine "plead">>
		"Please be gentle, Whitney..."
	<</addSpeechLine>>
	<<addSpeechLine "plead">>
		"Please," you cry. "I'm tired of being your punching bag!"
	<</addSpeechLine>>
	<<addPairedSpeechLine "Whitney" "plead">>
		<<pcLine>>"What did I do to make you target me like this?" you sob. "Please stop!"
	<<npcLine>>
		<<if C.npc.Whitney.dom gte 15>>
			<<He>> laughs. "Wouldn't you like to know? Know your fucking place!"
		<<elseif C.npc.Whitney.dom lte 10>>
			<<He>> glares at you. "After all the stunts you've pulled? You're lucky I'm only doing this much to you, whore!"
		<<else>>
			<<He>> snickers. "Have you tried being a little less fun to bully?"
		<</if>>
	<</addPairedSpeechLine>>
	<<if $loft_whitney gte 6>>
		<<addPairedSpeechLine "Whitney" "plead">>
			<<pcLine>>"Why are you still doing this to me? Do you love me or not?"
		<<npcLine>>
			<<if $audiencepresent gte 1 and C.npc.Whitney.dom gte 15>>
				The crowd starts to murmur, prompting Whitney to stop and turn to them. "Does anyone know what the fuck is this slut talking about?"
			<<elseif $audiencepresent gte 1 and C.npc.Whitney.dom lte 10>>
				The crowd starts to giggle, prompting Whitney to stop and click <<his>> tongue. "Stop making up shit!"
			<<elseif $audiencepresent gte 1>>
				The crowd starts to murmur, prompting Whitney to stop and scoff. "The slut's talking out of <<pher>> ass."
			<<else>>
				<<He>> stops, face now flushed in anger. "I have no idea what you're talking about. None!"
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-whitney-demand">>
	<<if C.npc.Whitney.dom gte 15 or C.npc.Whitney.dom lte 10>>
		<<addPairedSpeechLine "Whitney" "demand">>
			<<pcLine>>"You can't just fuck me whenever you want, Whitney!"
		<<npcLine>>
			<<if C.npc.Whitney.dom gte 15>>
				<<He>> sneers. "Stop making it so easy for me, then!"
			<<else>>
				<<He>> spits. "I can do whatever the hell I want!"
			<</if>>
		<</addPairedSpeechLine>>
	<<else>>
		<<addSpeechLine "demand">>
			"You can't just fuck me whenever you want, Whitney!"
		<</addSpeechLine>>
	<</if>>
	<<if C.npc.Whitney.dom gte 15>>
		<<addPairedSpeechLine "Whitney" "demand">>
			<<pcLine>>"You're nothing without your little gang!"
		<<npcLine>>
			<<if $enemyanger lte 100>>
				"What the fuck did you just say to me?!"
			<<else>>
				"Stupid whore. I don't need <<if $audiencepresent gte 1>>these<<else>>those<</if>> pricks to put you in your fucking place!"
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif C.npc.Whitney.dom lte 10>>
		<<addPairedSpeechLine "Whitney" "demand">>
			<<pcLine>>"Do you like seeing me send your reputation down the gutter?!"
		<<npcLine>>
			<<if $enemyanger lte 100>>
				<<He>> sneers. "Like I'll ever pass up the chance to make you look worse!"
			<<else>>
				<<He>> glares at you. "You really think you're doing some real damage to me? Think again!"
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
	<<if $loft_whitney gte 6>>
		<<addPairedSpeechLine "Whitney" "demand">>
			<<pcLine>>"Is hurting the person you said you love worth all this status?!"
		<<npcLine>>
			<<if $enemyanger lte 100>>
				<<He>> recoils, only to bounce back with a click of the tongue. "What the fuck are you talking about?!"
			<<else>>
				<<He>> recoils, only to bounce back with a snarl. "Stop making me out to be some bleeding heart bastard!"
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-whitney-forgive">>
	<<addSpeechLine "forgive">>
		"Better a perpetrator than a victim, right?" you say. "I understand, and I forgive you."
	<</addSpeechLine>>
	<<if $loft_whitney gte 6>>
		<<addPairedSpeechLine "Whitney" "forgive">>
			<<pcLine>>"You can be kind, Whitney," you say. "But I know that'll damn you in this town. I understand, and I forgive you."
		<<npcLine>>
			<<if $audiencepresent gte 1>>
				<<He>> recoils, before trying to save face. "Does anyone have any idea what the fuck <<pshe>>'s talking about?"
			<<else>>
				<<print either(
					`<<He>> spits. "Kind? Me? You're getting a lot of wrong ideas here."`,
					`<<He>> glares at you. "You don't know me at all, do you?!"`,
					`<<He>> recoils. "Shut up!"`
				)>>
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-whitney-moan">>
	<<addSpeechLine "moan">>
		"Use me, Whitney. I'm yours."
	<</addSpeechLine>>
<</widget>>
