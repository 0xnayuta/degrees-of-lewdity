:: Widgets reaction-Eden [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-eden-plead">>
	<<addSpeechLine "plead">>
		"N...not so rough, Eden..."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-eden-demand">>
	<<addSpeechLine "demand">>
		"I'm not your prey today, leave me alone."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-eden-moan">>
	<<addSpeechLine "moan">>
		"I belong to you, and you alone."
	<</addSpeechLine>>
<</widget>>
