:: Widgets speech-Leighton [widget]
<<widget "speech-leighton">>
	<<set _npc_speech to true>>
	<<speechPool "Leighton">>
	<<if $player.virginity.anal is "Leighton" and $speechAnusVirgin>>
		<<addSpeechLine "virginity">>
			<<He>> smirks. "You'll need plenty of training."
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.oral is "Leighton" and $speechOralVirgin>>
		<<addSpeechLine "virginity">>
			<<He>> smirks. "You lack skill... For now."
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.kiss is "Leighton" and $speechKissVirgin>>
		<<addSpeechLine "virginity">>
			<<He>> smirks. "Not terrible for a first time."
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<addSpeechLine "namedrop">>
					<<He>> smirks. "Another student? Perhaps I should invite <<nnpc_him "Robin">> to my office."
				<</addSpeechLine>>
			<<case "Kylar">>
				<<addSpeechLine "namedrop">>
					<<He>> frowns. "Kylar? That explains a lot of things."
				<</addSpeechLine>>
			<<case "Whitney">>
				<<addSpeechLine "namedrop">>
					<<He>> frowns. "You and that delinquent? I'm not surprised."
				<</addSpeechLine>>
			<<case "Sydney">>
				<<if $sydneySeen.includes("spank")>>
					<<addSpeechLine "namedrop">>
						<<He>> smirks. "Sydney? We could do <<nnpc_his "Sydney">> punishment in my office next time."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
						<<He>> smirks. "Sydney? I plan to have <<nnpc_him "Sydney">> in my office soon."
					<</addSpeechLine>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
					<<He>> frowns. "An animal? This requires extra discipline."
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
					<<He>> smirks. "I'm not familiar. This is a private matter, anyway."
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<addSpeechLine "sexToy">>
			<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<He>> looks at your $_sexToy and smirks. "I can teach you a thing or two with that."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Leighton") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Leighton")>>
		<<addSpeechLine "virginity">>
			<<He>> smirks. "Far from satisfactory. Come see me again for further improvement."
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>