:: Npc widgets or something [widget]


<<widget "createnpc">><<nobr>>
<<run $npc.push({
    name:$args[0]
    description:$args[1]
    pronoun:$args[2]

  })>>
<</nobr>><</widget>>

<<widget "addnpc">><<nobr>>
<<run $inthearea.push($npc[$npclist.$args[0]])>>
<</nobr>><</widget>>


<<widget "selectnpc">><<nobr>>
<<if 1 is 1>>/* npc is in the area. */
<<set $selectednpc to $inthearea[$args[0]]>>
<<else>>
<<set $selectednpc to $npclist.$args[0]>>
<</if>>


<<set $description to $selectednpc.description>>



<</nobr>><</widget>>
