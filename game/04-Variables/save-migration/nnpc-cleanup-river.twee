:: Widgets NNPC Cleanup Migration River [widget]
<<widget "nnpcCleanupMigrationRiver">>
	<!-- River's one-time flags moved into River's memories -->
	<<if $riverbite>><<run Memories.River.add("tuggedPcEars")>><</if>>
	<<if $kitchen_river>><<run Memories.River.add("letPcCookInSoupKitchen")>><</if>>
	<<if $soup_kitchen_init>><<run Memories.River.add("firstSoupKitchenMeeting")>><</if>>
	<<unset $riverbite $kitchen_river $soup_kitchen_init>>

	<!-- $monthly.soupKitchen was always true by the time it was read. $soupKitchen and $foodDropoff are never read. All safe to delete. -->
	<<run delete $monthly.soupKitchen>>
	<<unset $soupKitchen $foodDropoff>>
<</widget>>
