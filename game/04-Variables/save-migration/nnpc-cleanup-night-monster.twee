:: Widgets NNPC Cleanup Migration Night Monster [widget]
<<widget "nnpcCleanupMigrationNightMonster">>
	<!-- The Night Monster's lair variables moved onto $nightMonster -->
	<<set $nightMonster ??= {}>>
	<<if $monsterTowerSleep isnot undefined>>
		<<set $nightMonster.sleepDepth to $monsterTowerSleep>>
		<<unset $monsterTowerSleep>>
	<</if>>
	<<if $monsterTowerSheet isnot undefined>>
		<<set $nightMonster.timesPcAddedToSheetRope to $monsterTowerSheet>>
		<<unset $monsterTowerSheet>>
	<</if>>

	<!-- The Night Monster's one-time flags moved into its memories -->
	<<if $nightMonsterIntro gte 2>><<run Memories.NightMonster.add("carriedPcToLair")>><</if>>
	<<if $monsterTowerView is 1>><<run Memories.NightMonster.add("pcLookedOutOfLair")>><</if>>
	<<unset $nightMonsterIntro $monsterTowerView>>

	<!-- The Night Monster's daily flag moved into $daily.nightMonster -->
	<<set $daily.nightMonster ??= {}>>
	<<if $daily.streetNightMonster>>
		<<set $daily.nightMonster.ambushedPcOnStreet to true>>
		<<run delete $daily.streetNightMonster>>
	<</if>>
<</widget>>
