:: Widgets NNPC Cleanup Migration Winter [widget]
<<widget "nnpcCleanupMigrationWinter">>
	<<set $winter ??= {}>>
	<<set $weekly.winter ??= {}>>

	<!-- Winter's variables moved onto $winter -->
	<<if $winterLakeTalk isnot undefined>>
		<<set $winter.lakeResearchStage to $winterLakeTalk>>
	<</if>>
	<<if $halloween_winter_key>>
		<<set $winter.searchedCupboardsThisHalloween to true>>
	<</if>>
	<<unset $winterLakeTalk $halloween_winter_key>>

	<!-- Winter's weekly flags moved into $weekly.winter -->
	<<if $weekly.winterConfession isnot undefined>>
		<<set $weekly.winter.confessedToPc to $weekly.winterConfession>>
	<</if>>
	<<if $weekly.winterLakeTalk isnot undefined>>
		<<set $weekly.winter.pcAskedAboutLakeResearch to $weekly.winterLakeTalk>>
	<</if>>
	<<run delete $weekly.winterConfession>>
	<<run delete $weekly.winterLakeTalk>>

	<!-- Winter's one-time flags moved into Winter's memories -->
	<<if $museum_paintings_intro>><<run Memories.Winter.add("askedPcToFindPaintings")>><</if>>
	<<if $museumintro is 1>><<run Memories.Winter.add("firstMuseumVisit")>><</if>>
	<<if $breedingWard>><<run Memories.Winter.add("pcMadeBreedingWardJoke")>><</if>>
	<<if $winterlakeknown>><<run Memories.Winter.add("pcToldWhereGoldNecklaceWasFound")>><</if>>
	<<if $mine?.diamond_talk>><<run Memories.Winter.add("pcToldWherePurpleDiamondWasFound")>><</if>>
	<<unset $museum_paintings_intro $museumintro $breedingWard $winterlakeknown>>
	<<run delete $mine?.diamond_talk>>

	<<run delete $daily.breedingWard>>
<</widget>>
