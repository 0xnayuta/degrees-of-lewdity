:: Widgets NNPC Cleanup Migration Zephyr [widget]
<<widget "nnpcCleanupMigrationZephyr">>
	<!-- Zephyr's one-time flags moved into Zephyr's memories -->
	<<if $smuggler_pub_zephyr>><<run Memories.Zephyr.add("metPcAtSmugglerPub")>><</if>>
	<<if $zephyr_seen>><<run Memories.Zephyr.add("watchedPossessedPcJumpOverboard")>><</if>>
	<<unset $smuggler_pub_zephyr $zephyr_seen>>

	<!-- Misspelled $eventskip left in saves by the pirate deck -->
	<<unset $event_skip>>
<</widget>>
