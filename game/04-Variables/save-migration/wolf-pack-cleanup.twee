:: Widgets Wolf Pack Cleanup Migration [widget]
<<widget "wolfPackCleanupMigration">>
	<<if $wolfPack is undefined>>
		<<set $wolfPack to {
			standing: {},
			mood: {},
			sleep: {},
			hunt: {}
		}>>
		<!-- $wolf_plot_intro stays 1 until the wolf cave plots are made -->
		<<if $wolf_plot_intro isnot 1>>
			<<set $wolfPack.plotsMade to true>>
		<</if>>
	<</if>>
	<<unset $wolf_plot_intro>>
	<<set $daily.wolfPack ??= {}>>

	<!-- The wolf pack's variables moved onto $wolfPack -->
	<<if $wolfcavedig isnot undefined>>
		<<set $wolfPack.digProgress to $wolfcavedig>>
		<<unset $wolfcavedig>>
	<</if>>
	<<for _oldName, _newName range {
		wolfpacktrust: "trust",
		wolfpackfear: "fear",
		syndromewolves: "stockholm",
		wolfpackleader: "pcLeadsPack",
	}>>
		<<if V[_oldName] isnot undefined>>
			<<set $wolfPack.standing[_newName] to V[_oldName]>>
			<<run delete V[_oldName]>>
		<</if>>
	<</for>>
	<<for _oldName, _newName range {
		wolfpackharmony: "harmony",
		wolfpackferocity: "ferocity",
	}>>
		<<if V[_oldName] isnot undefined>>
			<<set $wolfPack.mood[_newName] to V[_oldName]>>
			<<run delete V[_oldName]>>
		<</if>>
	<</for>>
	<<for _oldName, _newName range {
		wolfbed: "inBedWithPc",
		wolfwake: "wokenByPackTonight",
	}>>
		<<if V[_oldName] isnot undefined>>
			<<set $wolfPack.sleep[_newName] to V[_oldName]>>
			<<run delete V[_oldName]>>
		<</if>>
	<</for>>
	<<for _oldName, _newName range {
		wolfstate: "packLocation",
		huntstate: "stage",
		wolfpackspray: "tookSprayCharge",
	}>>
		<<if V[_oldName] isnot undefined>>
			<<set $wolfPack.hunt[_newName] to V[_oldName]>>
			<<run delete V[_oldName]>>
		<</if>>
	<</for>>
	<<if $wolfevent isnot undefined>>
		<<set $wolfPack.eventDue to $wolfevent>>
		<<unset $wolfevent>>
	<</if>>

	<!-- The wolf pack's 0/1 flags turned into booleans -->
	<<if $wolfPack.standing.stockholm is 1>>
		<<set $wolfPack.standing.stockholm to true>>
	<<elseif $wolfPack.standing.stockholm is 0>>
		<<set $wolfPack.standing.stockholm to false>>
	<</if>>
	<<if $wolfPack.standing.pcLeadsPack is 1>>
		<<set $wolfPack.standing.pcLeadsPack to true>>
	<<elseif $wolfPack.standing.pcLeadsPack is 0>>
		<<set $wolfPack.standing.pcLeadsPack to false>>
	<</if>>
	<<if $wolfPack.sleep.inBedWithPc is 1>>
		<<set $wolfPack.sleep.inBedWithPc to true>>
	<<elseif $wolfPack.sleep.inBedWithPc is 0>>
		<<set $wolfPack.sleep.inBedWithPc to false>>
	<</if>>
	<<if $wolfPack.sleep.wokenByPackTonight is 1>>
		<<set $wolfPack.sleep.wokenByPackTonight to true>>
	<<elseif $wolfPack.sleep.wokenByPackTonight is 0>>
		<<set $wolfPack.sleep.wokenByPackTonight to false>>
	<</if>>
	<<if $wolfPack.hunt.tookSprayCharge is 1>>
		<<set $wolfPack.hunt.tookSprayCharge to true>>
	<</if>>
	<<if $wolfPack.eventDue is 1>>
		<<set $wolfPack.eventDue to true>>
	<<elseif $wolfPack.eventDue is 0>>
		<<set $wolfPack.eventDue to false>>
	<</if>>

	<!-- The wolf cave's daily values moved into $daily.wolfPack -->
	<<if $wolfcavebreast isnot undefined>>
		<<set $daily.wolfPack.pupsBreastfed to $wolfcavebreast>>
	<</if>>
	<<if $wolfcave_monster_roll isnot undefined>>
		<<set $daily.wolfPack.caveWolvesAreMonsters to $wolfcave_monster_roll>>
	<</if>>
	<<unset $wolfcavebreast $wolfcave_monster_roll>>

	<!-- $breastfeedend became $daily.wolfPack.pupsLastFedWhen.
	$wolfpackrob, which was never read -->
	<<unset $breastfeedend $wolfpackrob>>

	<!-- Moved Halloween event onto $wolfPack -->
	<<if $halloweenWolves is 1>>
		<<set $wolfPack.halloweenWolfHurtAtLake to true>>
	<</if>>
	<<unset $halloweenWolves>>
<</widget>>
