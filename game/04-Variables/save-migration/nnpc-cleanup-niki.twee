:: Widgets NNPC Cleanup Migration Niki [widget]
<<widget "nnpcCleanupMigrationNiki">>
	<!-- Niki's $nikiSeen and one-time flag moved into Niki's memories -->
	<<if $nikiSeen>>
		<<set _nikiSeenRenames to {
			adult_shop_opening: "photographedAdultShopOpening",
			chef: "photographedPcForCafeAdvert",
			danube_boulevard: "photographedPcWithAvery",
			farm: "photographedPcAtFarm",
			photo: "firstStudioVisit",
			street: "stoppedPcInStreet",
			winter: "volunteeredForWinter",
		}>>
		<<for _memory range $nikiSeen>>
			<<run $npcMemories.Niki.pushUnique(_nikiSeenRenames[_memory] ?? _memory)>>
		<</for>>
		<<unset $nikiSeen>>
	<</if>>
	<<if $photo?.niki_event>>
		<<run Memories.Niki.add("pcMetBriarAtStudio")>>
		<<run delete $photo.niki_event>>
	<</if>>
<</widget>>
