			butterfly_pea_flower_tea: "butterflyPeaFlowerTea",
			chastity_parasite: "chastityParasite",
			wolves_known: "wolvesKnown",
			hair_pull_bite: "hairPullBite",
			request_player_sample: "playerSampleRequest",
			ritual_poison_talk: "ritualPoisonTalk",
			chastity_temple: "templeChastityBeltRemoved",
		}>>
		<<for _memory range $gwylanSeen>>
			<<run $npcMemories.Gwylan.pushUnique(_gwylanSeenRenames[_memory] ?? _memory)>>
		<</for>>
		<<unset $gwylanSeen>>
	<</if>>


	<!-- $gwylan var renames -->
	<<if $gwylan>>
		<!-- Renames for props in $gwylan -->
		<<set _gwylanVarRenames to {
			punishment: "annoyed",
			robin: "robinInterest",
			sea: "seaWatchedCount",
			stage: "loveMilestone",
		}>>
		<!-- Renames for props not in $gwylan -->
		<<set _varRenames to {
			gwylanTalked: "clothesTalkedAbout",
			gwylan_cafe_walk_refused: "cafeWalkRefused",
			gwylan_school_walk_refused: "schoolWalkRefused",
			gwylanUniqueComments: "uniqueComments",
			gwylanbed: "inBed",
			gwylanCafeWake: "cafeWake",
			gwylanPassTime: "passTime",
			gwylanSteal: "steal",
			gwylanTea: "tea",
			gwylanTutorialShrooms: "tutorialShrooms",
			yearningLetter: "yearningLetter",
			yearningLetterExit: "yearningLetterExit",
			gwylanRescue: "rescue",
			gwylanWake: "wake",
		}>>

		<<run Object.entries(T.gwylanVarRenames).forEach(property => {
			if (V.gwylan[property[0]] !== undefined) {
				V.gwylan[property[1]] = V.gwylan[property[0]];
				delete V.gwylan[property[0]];
			}
		})>>
		<<run Object.entries(T.varRenames).forEach(property => {
			if (V[property[0]] !== undefined) {
				V.gwylan[property[1]] = V[property[0]];
				delete V[property[0]];
			}
		})>>
	<</if>>

	<!-- Daily Gwylan var renames, inside $daily.gwylan -->
	<<set $daily.gwylan ??= {}>>

	<<set _gwylanDailyVarRenames to {
		locked: "shopLocked",
		found: "foundInShop",
		greeting: "seenToday",
		sea: "watchedSea",
		request: "requestCompleted",
		collar_lock: "collarLock",
		SchoolDropOff: "streetMeetup",
	}>>
	<<run Object.entries(T.gwylanDailyVarRenames).forEach(property => {
		if (V.daily.gwylan[property[0]] !== undefined) {
			V.daily.gwylan[property[1]] = V.daily.gwylan[property[0]];
			delete V.daily.gwylan[property[0]];
		}
	})>>

	<<if $daily.gwylan_skip_school>>
		<<set $daily.gwylan.skipSchool to true>>
		<<unset $daily.gwylan_skip_school>>
	<</if>>

	<<if $daily.gwylan_sea_talk_weather>>
		<<set $daily.gwylan.weatherTalk to true>>
		<<unset $daily.gwylan_sea_talk_weather>>
	<</if>>

	<<if $daily.brownFox>>
		<<set $daily.gwylan.askedForBrownFox to true>>
		<<unset $daily.brownFox>>
	<</if>>


	<!-- Weekly Gwylan var renames -->
	<<set $weekly.gwylan ??= {}>>

	<<set _gwylanWeeklyVarRenames to {
		gwylanNoHeat: "noHeat",
		gwylanNoHunt: "noHunt",
		gwylanNoLure: "noLure",
		gwylanCafeConfront: "cafeConfront",
		gwylanDeepest: "deepestDevotion",
		gwylanPetBedHold: "petBedException",
		gwylanTrauma: "trauma",
		gwylanLIChance: "promenade",
		gwylan_school_talk_classes: "schoolClassesTalk",
	}>>
	<<run Object.entries(T.gwylanWeeklyVarRenames).forEach(property => {
		if (V.weekly[property[0]] !== undefined) {
			V.weekly.gwylan[property[1]] = V.weekly[property[0]];
			delete V.weekly[property[0]];
		}
	})>>


	<!-- Type changes -->
	<<if $gwylan?.hunting isnot undefined and typeof V.gwylan.hunting is "number">>
		<<if $gwylan.hunting is 0>>
			<<unset $gwylan.hunting>>
		<<else>>
			<<set $gwylan.hunting to ["meetupMissed", "ritualMissed", "ritualMissedRomanceState"][V.gwylan.hunting - 1]>>
		<</if>>
	<</if>>

	<<if $gwylan?.cafeWalkRefused is 1>>
		<<set $gwylan.cafeWalkRefused to true>>
	<</if>>

	<<if $gwylan?.schoolWalkRefused is 1>>
		<<set $gwylan.schoolWalkRefused to true>>
	<</if>>

	<<if $gwylan?.yearningLetter gte 1>>
		<<set $gwylan.yearningLetter to $gwylan.yearningLetter is 1 ? "sent" : "seen">>
	<</if>>

	<<if $weekly.gwylan.schoolClassesTalk is 1>>
		<<set $weekly.gwylan.schoolClassesTalk to true>>
	<</if>>


	<!-- One off vars to Memories -->
	<<if $gwylan?.robinShop isnot undefined>>
		<<run Memories.Gwylan.add("robinVisitedShop")>>
		<<unset $gwylan.robinShop>>
	<</if>>

	<<if $chef_gwylan or Memories.Gwylan.has("seenAtCafeOpening")>>
		<<run Memories.Gwylan.add("atCafeOpening")>>
		<<unset $chef_gwylan>>
	<</if>>

	<<if $gwylan_cafe_intro>>
		<<run Memories.Gwylan.add("cafeIntro")>>
		<<unset $gwylan_cafe_intro>>
	<</if>>

	<<if $gwylan_rescue>>
		<<run Memories.Gwylan.add("forestRescue")>>
		<<unset $gwylan_rescue>>
	<</if>>

	<<if $gwylan_hunt_intro>>
		<<run Memories.Gwylan.add("caughtDuringSafeHunt")>>
		<<unset $gwylan_hunt_intro>>
	<</if>>

	<<if $forest_shop_intro>>
		<<run Memories.Gwylan.add("forestShopIntro")>>
		<<unset $forest_shop_intro>>
	<</if>>

	<<if $gwylanJordanChastity>>
		<<run Memories.Gwylan.add("jordanChastityParasite")>>
		<<unset $gwylanJordanChastity>>
	<</if>>

	<<if $gwylanJordanSlime>>
		<<run Memories.Gwylan.add("jordanEarSlime")>>
		<<unset $gwylanJordanSlime>>
	<</if>>

	<<if $brownFoxRevealed>>
		<<run Memories.Gwylan.add("brownFoxRevealed")>>
		<<unset $brownFoxRevealed>>
	<</if>>


	<!-- Legacy vars -->
	<<unset $gwylangender>>
	<<unset $gwylangenitals>>
<</widget>>
