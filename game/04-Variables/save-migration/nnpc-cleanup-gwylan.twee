			exorcism: "ritualElkspawnExcised",
			fall_from_grace: "fallFromGrace",
			fallen_angel: "fallenAngel",
			fallen_fault: "fallenFault",
			familiar_collar: "familiarCollar",
			familiar_whitney: "whitneyVisitedShop",
			farm_defended: "farmDefended",
