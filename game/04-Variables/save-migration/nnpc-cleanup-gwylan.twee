			ritual_corruption_share: "ritualBeastCorruptionShare",
			ritual_corruption_share_dryad: "ritualDryadCorruptionShare",
			ritual_corruption_share_intimate: "ritualBeastCorruptionShareIntimate",
			ritual_sex_intro: "ritualSexIntro",
			ritual_stay: "ritualStay",
