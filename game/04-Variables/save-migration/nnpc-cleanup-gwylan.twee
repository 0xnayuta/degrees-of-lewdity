			kylar_parents: "kylarParents",
			likes_tentacles: "likesTentacles",
			likes_wolves: "likesWolves",
			mickey_snowglobe: "mickeySnowglobe",
			neck_bite: "neckBite",
			nectar_lick: "nectarLick",
			passout_hot_cold: "temperaturePassout",
			PCResentGwylan: "pcResentGwylan",
			pink_rose: "pinkRose",
