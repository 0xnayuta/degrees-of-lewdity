:: Widgets NNPC Cleanup Migration Briar [widget]
<<widget "nnpcCleanupMigrationBriar">>
	<<set $briar ??= {}>>
	<<set $briar.punishment ??= {}>>

	<!-- Briar's one-off flags became memories -->
	<<if $pubattack is 1>><<run Memories.Briar.add("abductedPcFromPub")>><</if>>
	<<if $brothel_rivalry isnot undefined>><<run Memories.Briar.add("askedPcToSpyOnDarryl")>><</if>>
	<<unset $pubattack>>

	<!-- Briar's rivalry with Darryl moved onto $briar -->
	<<if $brothel_rivalry isnot undefined>>
		<<set $briar.darrylRivalryScore to $brothel_rivalry>>
	<</if>>
	<<if $brothel_rivalry_timer isnot undefined>>
		<<set $briar.daysUntilGoonAtStripClub to $brothel_rivalry_timer>>
	<</if>>
	<<unset $brothel_rivalry $brothel_rivalry_timer>>

	<!-- Briar's punishment moved onto $briar.punishment -->
	<<if $briarPunishment isnot undefined>>
		<<set $briar.punishment.customersOwed to $briarPunishment>>
	<</if>>
	<<if $punishmenthole isnot undefined>>
		<<set $briar.punishment.customersLeft to $punishmenthole>>
	<</if>>
	<<if $briarPunishReason is "default">>
		<<set $briar.punishment.reason to "pcHackedLaptop">>
	<<elseif $briarPunishReason is "whore">>
		<<set $briar.punishment.reason to "pcSoldSexAtPub">>
	<</if>>
	<<unset $briarPunishment $punishmenthole $briarPunishReason>>
<</widget>>
