:: Widgets NNPC Cleanup Migration Charlie [widget]
<<widget "nnpcCleanupMigrationCharlie">>
	<<set $daily.charlie ??= {}>>

	<!-- Charlie's one-off flags became memories -->
	<<if $danceStudio.intro>><<run Memories.Charlie.add("firstLesson")>><</if>>
	<<if $charlie_breakdown is 1>><<run Memories.Charlie.add("pcToldAboutBailey")>><</if>>
	<<if $danceStudio.handVirginProtected>><<run Memories.Charlie.add("pcRefusedHandholding")>><</if>>
	<<run delete $danceStudio.intro>>
	<<run delete $danceStudio.handVirginProtected>>
	<<unset $charlie_breakdown>>

	<!-- Moved onto $daily.charlie -->
	<<if $daily.danceStudioHandVirginPrompt>>
		<<set $daily.charlie.reachedForPcHands to true>>
	<</if>>
	<<run delete $daily.danceStudioHandVirginPrompt>>
<</widget>>
