:: Widgets NNPC Cleanup Migration Jordan [widget]
<<widget "nnpcCleanupMigrationJordan">>
	<<set $jordan ??= {}>>
	<<set $daily.jordan ??= {}>>
	<<set $weekly.jordan ??= {}>>

	<!-- Jordan's quest moved onto $jordan -->
	<<if $jordan_ritual_dance isnot undefined>>
		<<switch $jordan_ritual_dance>>
			<<case 1>><<set $jordan.missingFlockQuest to "askedPc">>
			<<case 2>><<set $jordan.missingFlockQuest to "pcFoundRitual">>
			<<case 3>><<set $jordan.missingFlockQuest to "pcReportedRitual">>
			<<case 4>><<set $jordan.missingFlockQuest to "pcRescuedFlockMember">>
		<</switch>>
		<<unset $jordan_ritual_dance>>
	<</if>>

	<!-- Jordan's one-off flags became memories -->
	<<if $jordansong>><<run Memories.Jordan.add("pcHeardSingingInShower")>><</if>>
	<<if $jordanSin gte 1>><<run Memories.Jordan.add("pcPeekedInShower")>><</if>>
	<<if $jordanSin is 2>><<run Memories.Jordan.add("pcMasturbatedWatchingShower")>><</if>>
	<<if $forgiveintro is 1>><<run Memories.Jordan.add("pcAskedForForgiveness")>><</if>>
	<<if $temple_bailey_known is 1>><<run Memories.Jordan.add("pcWarnedAboutBailey")>><</if>>
	<<unset $jordansong $jordanSin $forgiveintro $temple_bailey_known>>

	<!-- Moved onto $daily.jordan -->
	<<if $daily.jordanMissing is 1>>
		<<set $daily.jordan.leftAfterRitualReport to true>>
	<</if>>
	<<if $temple_jordan_prayer is 1>>
		<<set $daily.jordan.foundPcInPrayerRoom to true>>
	<</if>>
	<<run delete $daily.jordanMissing>>
	<<unset $temple_jordan_prayer>>
<</widget>>
