{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Node",
		"target": "ES2020",
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"allowJs": true,
		"rootDir": "game",
		"outDir": "tsc-out",
		"incremental": true
	},
	"exclude": ["node_modules", "**/node_modules/*"],
	"include": ["game/**/*.js", "game/**/*.ts", "types/**/*.d.ts", "devTools/canvasmodel/**/*.d.ts"]
}
