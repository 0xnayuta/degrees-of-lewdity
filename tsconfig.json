{
	"compilerOptions": {
		/* This is experimental and could break. */
		"experimentalDecorators": false,
		/* This is experimental and could break. */
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		// I @aimozg enabled it and got 40 errors in renderer.ts TODO decide if we need it
		//		"strict": true,
		"esModuleInterop": true,
		"declaration": false,
		"resolveJsonModule": true,
		"moduleResolution": "Node",
		"module": "ES6",
		"target": "ES6",
		"lib": ["ES6", "DOM"]
	},
	"exclude": ["devTools", "node_modules"]
}
